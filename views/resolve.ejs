<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/document-head') %>

  <style>
    .oc-main-content {
      overflow:hidden !important;
      height:calc(100vh - var(--oc-header-height));
    }
    .oc-dashboard-area {
      display:flex !important;
      flex-direction:column !important;
      grid-template-columns:unset !important;
      overflow-y:auto !important;
      overflow-x:hidden !important;
      padding:1rem 1.25rem !important;
      gap:0 !important;
    }

    /* ── Top bar ── */
    .rv-topbar {
      display:flex; align-items:center; gap:0.6rem;
      flex-shrink:0; padding-bottom:0.75rem; flex-wrap:wrap;
    }
    .rv-back {
      font-size:0.78rem; color:var(--oc-text-muted); text-decoration:none;
      padding:2px 8px; border:1px solid var(--oc-border); border-radius:4px;
      white-space:nowrap;
    }
    .rv-back:hover { color:var(--oc-text); border-color:var(--oc-border-strong); }
    .rv-title {
      font-size:1.05rem; font-weight:700; color:var(--oc-text); margin:0;
      flex:1;
    }

    /* ── Error / loading banners ── */
    .rv-error {
      display:none; background:var(--oc-warning-soft); border:1px solid var(--oc-warning);
      border-radius:6px; padding:0.6rem 1rem; color:var(--oc-warning-text);
      font-size:0.82rem; margin-bottom:0.75rem; flex-shrink:0;
    }
    .rv-loading {
      color:var(--oc-text-faint); font-size:0.85rem; padding:2rem 0; text-align:center;
    }

    /* ── Content area ── */
    .rv-scroll {
      flex:1; overflow-y:auto; min-height:0;
      scrollbar-width:thin; scrollbar-color:var(--oc-border-strong) transparent;
    }

    /* ── Alert context card ── */
    .rv-context-card {
      background:rgba(194,65,12,0.09);
      border:1px solid var(--oc-border);
      border-radius:10px;
      padding:1rem 1.1rem;
      margin-bottom:1.25rem;
      max-width:820px;
    }
    .rv-ctx-header {
      display:flex; align-items:flex-start; gap:0.75rem;
      flex-wrap:wrap; margin-bottom:0.75rem;
    }
    .rv-ctx-badge {
      font-size:0.62rem; font-weight:700; text-transform:uppercase;
      letter-spacing:0.08em; padding:2px 7px; border-radius:4px;
      flex-shrink:0; margin-top:2px;
    }
    .rv-ctx-badge.sev-warning  { background:rgba(202,138,4,0.25); color:var(--oc-warning-text); border:1px solid rgba(202,138,4,0.35); }
    .rv-ctx-badge.sev-error    { background:rgba(220,38,38,0.25); color:var(--oc-danger-text); border:1px solid rgba(220,38,38,0.35); }
    .rv-ctx-badge.sev-info     { background:var(--oc-accent-soft); color:var(--oc-info-text); border:1px solid var(--oc-accent-soft); }
    .rv-ctx-badge.sev-default  { background:rgba(107,114,128,0.2); color:var(--oc-text-muted); border:1px solid var(--oc-border-strong); }
    .rv-ctx-alertid {
      font-family:'DM Mono', 'Fira Code', monospace;
      font-size:0.78rem; color:var(--oc-warning-text); word-break:break-all;
      flex:1;
    }
    .rv-ctx-doc-link {
      font-size:0.72rem; color:var(--oc-info-text); text-decoration:none;
      padding:1px 8px; border:1px solid var(--oc-status-inbox); border-radius:4px;
      flex-shrink:0; margin-left:auto;
    }
    .rv-ctx-doc-link:hover { color:var(--oc-info-text); border-color:var(--oc-info); }

    .rv-ctx-section { margin-bottom:0.7rem; }
    .rv-ctx-label {
      font-size:0.63rem; font-weight:700; text-transform:uppercase;
      letter-spacing:0.08em; color:var(--oc-text-muted); display:block; margin-bottom:3px;
    }
    .rv-ctx-value {
      font-size:0.83rem; color:var(--oc-text); line-height:1.55;
    }
    .rv-ctx-value.highlight { color:var(--oc-warning-text); }
    .rv-ctx-value.fix-box {
      background:var(--oc-accent-soft); border:1px solid var(--oc-accent-soft);
      border-radius:6px; padding:0.55rem 0.75rem; color:var(--oc-text);
    }
    .rv-ctx-meta-row {
      display:flex; gap:1.5rem; flex-wrap:wrap; margin-top:0.5rem;
      padding-top:0.5rem; border-top:1px solid rgba(124,45,18,0.4);
    }
    .rv-ctx-meta-item { font-size:0.72rem; color:var(--oc-text-muted); }
    .rv-ctx-meta-item strong { color:var(--oc-text-muted); }

    /* ── Already dispatched banner ── */
    .rv-dispatched-banner {
      display:none;
      background:var(--oc-success-soft);
      border:1px solid var(--oc-border);
      border-radius:8px;
      padding:0.65rem 1rem;
      color:var(--oc-success-text);
      font-size:0.82rem;
      margin-bottom:1rem;
      max-width:820px;
    }
    .rv-dispatched-banner strong { color:var(--oc-success-text); }

    /* ── Form ── */
    .rv-form {
      max-width:820px;
      display:flex; flex-direction:column; gap:1rem;
    }
    /* ── Mode tabs ── */
    .rv-mode-tabs {
      display:flex; gap:0; border:1px solid var(--oc-border-strong); border-radius:7px;
      overflow:hidden; flex-shrink:0; width:fit-content;
      margin-bottom:0.25rem;
    }
    .rv-mode-tab {
      padding:0.38rem 1rem; font-size:0.8rem; font-weight:600;
      cursor:pointer; border:none; background:transparent;
      color:var(--oc-text-muted); transition:background .12s, color .12s;
    }
    .rv-mode-tab.active {
      background:var(--oc-bg-hover); color:var(--oc-text);
    }
    .rv-mode-tab:first-child { border-right:1px solid var(--oc-border-strong); }
    /* ── Mode panels ── */
    .rv-panel { display:none; flex-direction:column; gap:1rem; }
    .rv-panel.active { display:flex; }
    .rv-form-section {
      font-size:0.7rem; font-weight:700; text-transform:uppercase;
      letter-spacing:0.08em; color:var(--oc-text-muted); margin-bottom:0.4rem;
    }
    .rv-field { display:flex; flex-direction:column; gap:5px; }
    .rv-label {
      font-size:0.77rem; font-weight:600; color:var(--oc-text-muted);
    }
    .rv-label span { font-weight:400; color:var(--oc-text-muted); margin-left:4px; }
    .rv-select, .rv-textarea {
      background:var(--oc-bg-card); border:1px solid var(--oc-border-strong); border-radius:6px;
      color:var(--oc-text); font-family:inherit; font-size:0.85rem;
      padding:0.45rem 0.65rem;
      transition:border-color .15s;
    }
    .rv-select:focus, .rv-textarea:focus {
      outline:none; border-color:var(--oc-accent);
    }
    .rv-select { cursor:pointer; }
    .rv-textarea {
      resize:vertical; min-height:130px; line-height:1.55;
    }
    .rv-hint {
      font-size:0.72rem; color:var(--oc-text-faint); line-height:1.4;
    }

    /* ── Submit button ── */
    .rv-submit-row {
      display:flex; align-items:center; gap:0.75rem;
      padding-top:0.25rem;
    }
    .rv-submit-btn {
      background:var(--oc-accent); color:var(--oc-text-on-accent); border:none;
      border-radius:7px; padding:0.5rem 1.4rem;
      font-size:0.88rem; font-weight:600; cursor:pointer;
      transition:background .15s;
    }
    .rv-submit-btn:hover { background:var(--oc-accent-hover); }
    .rv-submit-btn:disabled { opacity:.5; cursor:default; }
    .rv-submit-status {
      font-size:0.78rem; color:var(--oc-text-muted);
    }

    /* ── Success state ── */
    .rv-success {
      display:none;
      background:var(--oc-success-soft);
      border:1px solid var(--oc-border);
      border-radius:10px;
      padding:1.1rem 1.25rem;
      max-width:820px;
    }
    .rv-success h3 { color:var(--oc-success-text); font-size:1rem; margin:0 0 0.5rem; }
    .rv-success p  { color:var(--oc-success-text); font-size:0.83rem; margin:0.3rem 0; line-height:1.55; }
    .rv-success .rv-success-meta { color:var(--oc-text-faint); font-size:0.72rem; margin-top:0.75rem; }
    .rv-success a { color:var(--oc-info-text); }
  </style>
</head>
<body>
  <%- include('partials/app-header') %>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/resolve' }) %>

    <main class="oc-dashboard-area">

      <!-- Top bar -->
      <div class="rv-topbar">
        <a class="rv-back" href="/swarm">← Swarm</a>
        <h1 class="rv-title">🔧 Resolve Alert</h1>
      </div>

      <!-- Error -->
      <div class="rv-error" id="rv-error"></div>

      <!-- Scrollable area -->
      <div class="rv-scroll">

        <div id="rv-loading" class="rv-loading">Loading alert context…</div>

        <!-- Already-dispatched banner (shown when resolution_status=dispatched) -->
        <div class="rv-dispatched-banner" id="rv-dispatched-banner">
          ⚠️ This alert was already dispatched for resolution.
          You can submit updated instructions below  -  they will be appended to the history.
        </div>

        <!-- Context card -->
        <div id="rv-context-card" style="display:none">
          <!-- filled by JS -->
        </div>

        <!-- Form -->
        <div id="rv-form-wrap" style="display:none">
          <div class="rv-form">

            <!-- Mode tabs -->
            <div class="rv-mode-tabs">
              <button class="rv-mode-tab active" id="tab-close"   onclick="switchMode('close')">  ✅ Mark Resolved</button>
              <button class="rv-mode-tab"         id="tab-dispatch" onclick="switchMode('dispatch')">📤 Dispatch to Agent</button>
            </div>

            <!-- PANEL: Mark Resolved -->
            <div class="rv-panel active" id="panel-close">
              <div class="rv-form-section">✅ Mark this alert as resolved</div>
              <div class="rv-field">
                <label class="rv-label" for="rv-close-note">
                  Resolution note
                  <span> -  what fixed it? (brief is fine)</span>
                </label>
                <textarea
                  class="rv-textarea"
                  id="rv-close-note"
                  style="min-height:80px"
                  placeholder="e.g. Operator confirmed the webhook is active again."
                ></textarea>
                <div class="rv-hint">
                  The alert file will be renamed <code>HANDLED-*</code>, the note appended to its
                  Resolution History, and the vault committed immediately.
                  No agent notification is sent.
                </div>
              </div>
              <div class="rv-submit-row">
                <button class="rv-submit-btn" id="rv-close-btn" onclick="submitClose()">
                  ✅ Mark Resolved
                </button>
                <span class="rv-submit-status" id="rv-close-status"></span>
              </div>
            </div>

            <!-- PANEL: Dispatch to Agent -->
            <div class="rv-panel" id="panel-dispatch">
              <div class="rv-form-section">📤 Dispatch resolution instructions to an agent</div>

              <!-- Agent picker -->
              <div class="rv-field">
                <label class="rv-label" for="rv-agent">
                  Route to agent
                  <span> -  who should fix this?</span>
                </label>
                <select class="rv-select" id="rv-agent">
                  <!-- filled by JS -->
                </select>
              </div>

              <!-- Instructions -->
              <div class="rv-field">
                <label class="rv-label" for="rv-instructions">
                  Your instructions
                  <span> -  be specific: what to do, what to check, what the fix is</span>
                </label>
                <textarea
                  class="rv-textarea"
                  id="rv-instructions"
                  placeholder="e.g. Rotate the incoming webhook, update the password manager item, then re-run the job to confirm delivery."
                ></textarea>
                <div class="rv-hint">
                  This will be appended to the alert file as a permanent resolution record
                  and sent to the agent via their Notification folder.
                  The primary agent on this machine will also be woken immediately if it supports wake.
                </div>
              </div>

              <div class="rv-submit-row">
                <button class="rv-submit-btn" id="rv-submit-btn" onclick="submitDispatch()">
                  Dispatch Resolution →
                </button>
                <span class="rv-submit-status" id="rv-submit-status"></span>
              </div>
            </div>

          </div>
        </div>

        <!-- Success -->
        <div class="rv-success" id="rv-success" style="display:none">
          <h3>✅ Resolution dispatched</h3>
          <p id="rv-success-msg"></p>
          <div class="rv-success-meta" id="rv-success-meta"></div>
        </div>

      </div><!-- /rv-scroll -->

    </main>
  </div>

  <script>

/* ── State ── */
    const alertPath  = '<%= alertPath %>';
    let   contextData = null;

    /* ── Error helpers ── */
    function showErr(msg) {
      const el = document.getElementById('rv-error');
      el.style.display = 'block';
      el.textContent   = '⚠️ ' + msg;
    }
    function hideErr() {
      document.getElementById('rv-error').style.display = 'none';
    }

    /* ── Severity badge class ── */
    function sevClass(sev) {
      if (!sev) return 'sev-default';
      const s = sev.toLowerCase();
      if (s === 'warning') return 'sev-warning';
      if (s === 'error' || s === 'critical') return 'sev-error';
      if (s === 'info') return 'sev-info';
      return 'sev-default';
    }

    /* ── Escape HTML ── */
    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    /* ── Render context card ── */
    function renderContext(ctx) {
      const card = document.getElementById('rv-context-card');
      const docHref = '/vault/doc?path=' + encodeURIComponent(ctx.filePath);

      let html = '<div class="rv-context-card">';

      // Header row: badge + alertId + doc link
      html += `<div class="rv-ctx-header">`;
      if (ctx.severity) {
        html += `<span class="rv-ctx-badge ${sevClass(ctx.severity)}">${esc(ctx.severity)}</span>`;
      }
      html += `<span class="rv-ctx-alertid">${esc(ctx.alertId)}</span>`;
      html += `<a class="rv-ctx-doc-link" href="${docHref}" target="_blank">📄 View doc</a>`;
      html += `</div>`;

      // What is it / the gap
      if (ctx.issue) {
        html += `<div class="rv-ctx-section">
          <span class="rv-ctx-label">Issue / Gap</span>
          <div class="rv-ctx-value highlight">${esc(ctx.issue)}</div>
        </div>`;
      }

      // Recommended fix
      if (ctx.actionRequested) {
        html += `<div class="rv-ctx-section">
          <span class="rv-ctx-label">Recommended Fix</span>
          <div class="rv-ctx-value fix-box">${esc(ctx.actionRequested)}</div>
        </div>`;
      }

      // If HB-error (no issue/action in frontmatter) show status fields
      if (!ctx.issue && (ctx.status || ctx.deliveryStatus)) {
        const detail = [
          ctx.status         ? `Status: ${ctx.status}` : '',
          ctx.deliveryStatus ? `Delivery: ${ctx.deliveryStatus}` : '',
        ].filter(Boolean).join(' · ');
        html += `<div class="rv-ctx-section">
          <span class="rv-ctx-label">Error Details</span>
          <div class="rv-ctx-value highlight">${esc(detail)}</div>
        </div>`;
      }

      // Meta row
      const metaItems = [
        ctx.job       ? `<div class="rv-ctx-meta-item"><strong>Job:</strong> ${esc(ctx.job)}</div>` : '',
        ctx.writtenBy ? `<div class="rv-ctx-meta-item"><strong>Reported by:</strong> ${esc(ctx.writtenBy)}</div>` : '',
        ctx.forAgent  ? `<div class="rv-ctx-meta-item"><strong>For agent:</strong> ${esc(ctx.forAgent)}</div>` : '',
        ctx.writtenAt ? `<div class="rv-ctx-meta-item"><strong>Reported at:</strong> ${esc(ctx.writtenAt)}</div>` : '',
        ctx.agent     ? `<div class="rv-ctx-meta-item"><strong>Inferred owner:</strong> ${esc(ctx.agent.label)}</div>` : '',
      ].filter(Boolean).join('');
      if (metaItems) {
        html += `<div class="rv-ctx-meta-row">${metaItems}</div>`;
      }

      html += '</div>';
      card.innerHTML = html;
      card.style.display = 'block';
    }

    /* ── Populate agent picker ── */
    function populateAgentPicker(ctx) {
      const sel = document.getElementById('rv-agent');
      sel.innerHTML = '';
      (ctx.allAgents || []).forEach(a => {
        const opt = document.createElement('option');
        opt.value = a.key;
        opt.textContent = a.label + (a.canWake ? ' ⚡ (wakes immediately)' : ' 📬 (notif on next heartbeat)');
        if (ctx.agent && a.key === ctx.agent.key) opt.selected = true;
        sel.appendChild(opt);
      });
    }

    /* ── Load context ── */
    async function loadContext() {
      document.getElementById('rv-loading').style.display = 'block';
      hideErr();
      try {
        const resp = await fetch('/api/resolve/context?alert=' + encodeURIComponent(alertPath));
        const ctx  = await resp.json();
        if (!resp.ok || ctx.error) { showErr(ctx.error || 'Failed to load alert context'); return; }

        contextData = ctx;

        // Already dispatched?
        if (ctx.resolutionStatus === 'dispatched') {
          document.getElementById('rv-dispatched-banner').style.display = 'block';
        }

        renderContext(ctx);
        populateAgentPicker(ctx);
        document.getElementById('rv-loading').style.display   = 'none';
        document.getElementById('rv-form-wrap').style.display = 'block';

      } catch (e) {
        showErr(e.message);
        document.getElementById('rv-loading').style.display = 'none';
      }
    }

    /* ── Mode switcher ── */
    function switchMode(mode) {
      document.getElementById('panel-close').classList.toggle('active',    mode === 'close');
      document.getElementById('panel-dispatch').classList.toggle('active', mode === 'dispatch');
      document.getElementById('tab-close').classList.toggle('active',      mode === 'close');
      document.getElementById('tab-dispatch').classList.toggle('active',   mode === 'dispatch');
    }

    /* ── Submit: Mark Resolved ── */
    async function submitClose() {
      const btn      = document.getElementById('rv-close-btn');
      const statusEl = document.getElementById('rv-close-status');
      const note     = document.getElementById('rv-close-note').value.trim();

      btn.disabled = true;
      statusEl.textContent = 'Closing…';
      statusEl.style.color = 'var(--oc-text-muted)';

      try {
        const resp   = await fetch('/api/resolve/close', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ alertPath, note }),
        });
        const result = await resp.json();
        if (!resp.ok || result.error) {
          statusEl.textContent = '❌ ' + (result.error || 'Server error');
          statusEl.style.color = 'var(--oc-danger-text)';
          btn.disabled = false;
          return;
        }
        showSuccess(
          `Alert marked as <strong>HANDLED</strong>. Renamed to <code>${esc(result.handledName)}</code> and vault committed.`,
          result
        );
      } catch (e) {
        statusEl.textContent = '❌ ' + e.message;
        statusEl.style.color = 'var(--oc-danger-text)';
        btn.disabled = false;
      }
    }

    /* ── Submit: Dispatch to Agent ── */
    async function submitDispatch() {
      const btn          = document.getElementById('rv-submit-btn');
      const statusEl     = document.getElementById('rv-submit-status');
      const instructions = document.getElementById('rv-instructions').value.trim();
      const agentKey     = document.getElementById('rv-agent').value;

      if (!instructions) {
        statusEl.textContent = '⚠️ Instructions are required.';
        statusEl.style.color = 'var(--oc-danger-text)';
        return;
      }

      btn.disabled = true;
      statusEl.textContent = 'Dispatching…';
      statusEl.style.color = 'var(--oc-text-muted)';

      const agentLabel = document.getElementById('rv-agent')
        .options[document.getElementById('rv-agent').selectedIndex].textContent
        .replace(/\s*[⚡📬].*$/, '').trim();

      try {
        const resp   = await fetch('/api/resolve', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ alertPath, agentKey, agentLabel, instructions }),
        });
        const result = await resp.json();
        if (!resp.ok || result.error) {
          statusEl.textContent = '❌ ' + (result.error || 'Server error');
          statusEl.style.color = 'var(--oc-danger-text)';
          btn.disabled = false;
          return;
        }
        showSuccess(
          `Instructions dispatched to <strong>${esc(agentLabel)}</strong>. ` +
          (result.woke
            ? `The primary agent was <strong>woken immediately</strong> via gateway wake event.`
            : `The agent will pick this up on their <strong>next heartbeat</strong>.`),
          result
        );
      } catch (e) {
        statusEl.textContent = '❌ ' + e.message;
        statusEl.style.color = 'var(--oc-danger-text)';
        btn.disabled = false;
      }
    }

    /* ── Shared success renderer ── */
    function showSuccess(msg, result) {
      document.getElementById('rv-form-wrap').style.display = 'none';
      const success = document.getElementById('rv-success');
      success.style.display = 'block';

      const docHref = '/vault/doc?path=' + encodeURIComponent('08 - QA-and-Monitoring/Heartbeats/' + alertPath);
      document.getElementById('rv-success-msg').innerHTML = msg;

      const metaParts = [
        `Alert: <code>${esc(result.alertId || alertPath)}</code>`,
        `Vault: ${result.synced ? '✅ synced' : '⚠️ sync failed (saved locally)'}`,
      ];
      if (result.syncWarning) metaParts.push(`Sync warning: ${esc(result.syncWarning)}`);
      metaParts.push(`<a href="/swarm">← Back to Swarm</a>`);
      document.getElementById('rv-success-meta').innerHTML = metaParts.join(' &nbsp;·&nbsp; ');
    }

    /* ── Boot ── */
    loadContext();
  
    fetch('/api/instance').then(r=>r.json()).then(inst=>{
      const ph=inst.resolvePlaceholders||{};
      const close=document.getElementById('rv-close-note');
      const instr=document.getElementById('rv-instructions');
      if (close && ph.closeNote) close.placeholder=ph.closeNote;
      if (instr && ph.instructions) instr.placeholder=ph.instructions;
    }).catch(()=>{});
</script>
<%- include('partials/chrome-end') %>
</body>
</html>
