<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .oc-main-content {
      overflow: hidden !important;
      height: calc(100vh - 60px);
    }
    .oc-dashboard-area {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: unset !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      padding: 1rem 1.25rem !important;
      gap: 0 !important;
    }

    /* ── Top bar ── */
    .rv-topbar {
      display: flex; align-items: center; gap: 0.6rem;
      flex-shrink: 0; padding-bottom: 0.75rem; flex-wrap: wrap;
    }
    .rv-back {
      font-size: 0.78rem; color: #6b7280; text-decoration: none;
      padding: 2px 8px; border: 1px solid #1f2937; border-radius: 4px;
      white-space: nowrap;
    }
    .rv-back:hover { color: #e2e8f0; border-color: #374151; }
    .rv-title {
      font-size: 1.05rem; font-weight: 700; color: #e2e8f0; margin: 0;
      flex: 1;
    }

    /* ── Error / loading banners ── */
    .rv-error {
      display: none; background: #1c1917; border: 1px solid #78350f;
      border-radius: 6px; padding: 0.6rem 1rem; color: #fde68a;
      font-size: 0.82rem; margin-bottom: 0.75rem; flex-shrink: 0;
    }
    .rv-loading {
      color: #4b5563; font-size: 0.85rem; padding: 2rem 0; text-align: center;
    }

    /* ── Content area ── */
    .rv-scroll {
      flex: 1; overflow-y: auto; min-height: 0;
      scrollbar-width: thin; scrollbar-color: #374151 transparent;
    }

    /* ── Alert context card ── */
    .rv-context-card {
      background: rgba(194,65,12,0.09);
      border: 1px solid #7c2d12;
      border-radius: 10px;
      padding: 1rem 1.1rem;
      margin-bottom: 1.25rem;
      max-width: 820px;
    }
    .rv-ctx-header {
      display: flex; align-items: flex-start; gap: 0.75rem;
      flex-wrap: wrap; margin-bottom: 0.75rem;
    }
    .rv-ctx-badge {
      font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; padding: 2px 7px; border-radius: 4px;
      flex-shrink: 0; margin-top: 2px;
    }
    .rv-ctx-badge.sev-warning  { background: rgba(202,138,4,0.25); color: #fbbf24; border: 1px solid rgba(202,138,4,0.35); }
    .rv-ctx-badge.sev-error    { background: rgba(220,38,38,0.25); color: #f87171; border: 1px solid rgba(220,38,38,0.35); }
    .rv-ctx-badge.sev-info     { background: rgba(99,102,241,0.2); color: #a5b4fc; border: 1px solid rgba(99,102,241,0.3); }
    .rv-ctx-badge.sev-default  { background: rgba(107,114,128,0.2); color: #9ca3af; border: 1px solid #374151; }
    .rv-ctx-alertid {
      font-family: 'DM Mono', 'Fira Code', monospace;
      font-size: 0.78rem; color: #fb923c; word-break: break-all;
      flex: 1;
    }
    .rv-ctx-doc-link {
      font-size: 0.72rem; color: #818cf8; text-decoration: none;
      padding: 1px 8px; border: 1px solid #312e5f; border-radius: 4px;
      flex-shrink: 0; margin-left: auto;
    }
    .rv-ctx-doc-link:hover { color: #a5b4fc; border-color: #4338ca; }

    .rv-ctx-section { margin-bottom: 0.7rem; }
    .rv-ctx-label {
      font-size: 0.63rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: #6b7280; display: block; margin-bottom: 3px;
    }
    .rv-ctx-value {
      font-size: 0.83rem; color: #cbd5e1; line-height: 1.55;
    }
    .rv-ctx-value.highlight { color: #fde68a; }
    .rv-ctx-value.fix-box {
      background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25);
      border-radius: 6px; padding: 0.55rem 0.75rem; color: #c7d2fe;
    }
    .rv-ctx-meta-row {
      display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.5rem;
      padding-top: 0.5rem; border-top: 1px solid rgba(124,45,18,0.4);
    }
    .rv-ctx-meta-item { font-size: 0.72rem; color: #6b7280; }
    .rv-ctx-meta-item strong { color: #9ca3af; }

    /* ── Already dispatched banner ── */
    .rv-dispatched-banner {
      display: none;
      background: rgba(5,150,105,0.12);
      border: 1px solid #065f46;
      border-radius: 8px;
      padding: 0.65rem 1rem;
      color: #6ee7b7;
      font-size: 0.82rem;
      margin-bottom: 1rem;
      max-width: 820px;
    }
    .rv-dispatched-banner strong { color: #34d399; }

    /* ── Form ── */
    .rv-form {
      max-width: 820px;
      display: flex; flex-direction: column; gap: 1rem;
    }
    .rv-form-section {
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: #6b7280; margin-bottom: 0.4rem;
    }
    .rv-field { display: flex; flex-direction: column; gap: 5px; }
    .rv-label {
      font-size: 0.77rem; font-weight: 600; color: #9ca3af;
    }
    .rv-label span { font-weight: 400; color: #6b7280; margin-left: 4px; }
    .rv-select, .rv-textarea {
      background: #111827; border: 1px solid #374151; border-radius: 6px;
      color: #e2e8f0; font-family: inherit; font-size: 0.85rem;
      padding: 0.45rem 0.65rem;
      transition: border-color .15s;
    }
    .rv-select:focus, .rv-textarea:focus {
      outline: none; border-color: #4f46e5;
    }
    .rv-select { cursor: pointer; }
    .rv-textarea {
      resize: vertical; min-height: 130px; line-height: 1.55;
    }
    .rv-hint {
      font-size: 0.72rem; color: #4b5563; line-height: 1.4;
    }

    /* ── Submit button ── */
    .rv-submit-row {
      display: flex; align-items: center; gap: 0.75rem;
      padding-top: 0.25rem;
    }
    .rv-submit-btn {
      background: #4f46e5; color: #fff; border: none;
      border-radius: 7px; padding: 0.5rem 1.4rem;
      font-size: 0.88rem; font-weight: 600; cursor: pointer;
      transition: background .15s;
    }
    .rv-submit-btn:hover { background: #4338ca; }
    .rv-submit-btn:disabled { opacity: .5; cursor: default; }
    .rv-submit-status {
      font-size: 0.78rem; color: #6b7280;
    }

    /* ── Success state ── */
    .rv-success {
      display: none;
      background: rgba(5,150,105,0.12);
      border: 1px solid #065f46;
      border-radius: 10px;
      padding: 1.1rem 1.25rem;
      max-width: 820px;
    }
    .rv-success h3 { color: #34d399; font-size: 1rem; margin: 0 0 0.5rem; }
    .rv-success p  { color: #6ee7b7; font-size: 0.83rem; margin: 0.3rem 0; line-height: 1.55; }
    .rv-success .rv-success-meta { color: #4b5563; font-size: 0.72rem; margin-top: 0.75rem; }
    .rv-success a { color: #818cf8; }
  </style>
</head>
<body>
  <header class="oc-header">
    <div class="logo">
      <h1 class="main-title">OVERCLAW</h1>
      <span class="tagline">RESOLVE ALERT</span>
    </div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/resolve' }) %>

    <main class="oc-dashboard-area">

      <!-- Top bar -->
      <div class="rv-topbar">
        <a class="rv-back" href="/swarm">← Swarm</a>
        <h1 class="rv-title">🔧 Resolve Alert</h1>
      </div>

      <!-- Error -->
      <div class="rv-error" id="rv-error"></div>

      <!-- Scrollable area -->
      <div class="rv-scroll">

        <div id="rv-loading" class="rv-loading">Loading alert context…</div>

        <!-- Already-dispatched banner (shown when resolution_status=dispatched) -->
        <div class="rv-dispatched-banner" id="rv-dispatched-banner">
          ⚠️ This alert was already dispatched for resolution.
          You can submit updated instructions below — they will be appended to the history.
        </div>

        <!-- Context card -->
        <div id="rv-context-card" style="display:none">
          <!-- filled by JS -->
        </div>

        <!-- Form -->
        <div id="rv-form-wrap" style="display:none">
          <div class="rv-form">
            <div class="rv-form-section">🔧 Resolution Instructions</div>

            <!-- Agent picker -->
            <div class="rv-field">
              <label class="rv-label" for="rv-agent">
                Route to agent
                <span>— who should fix this?</span>
              </label>
              <select class="rv-select" id="rv-agent">
                <!-- filled by JS -->
              </select>
            </div>

            <!-- Instructions -->
            <div class="rv-field">
              <label class="rv-label" for="rv-instructions">
                Your instructions
                <span>— be specific: what to do, what to check, what the fix is</span>
              </label>
              <textarea
                class="rv-textarea"
                id="rv-instructions"
                placeholder="e.g. Regenerate the Incoming Webhook for #agent-monitoring in the BrightMove Slack workspace, update Bitwarden item slack-webhook-brightmove-agent-monitoring with the new URL, then re-run the brightmove-research job to confirm delivery."
              ></textarea>
              <div class="rv-hint">
                This will be appended to the alert file as a permanent resolution record,
                and sent to the agent via their Notification folder.
                Spike (on this machine) will also be woken immediately.
              </div>
            </div>

            <div class="rv-submit-row">
              <button class="rv-submit-btn" id="rv-submit-btn" onclick="submitResolve()">
                Dispatch Resolution →
              </button>
              <span class="rv-submit-status" id="rv-submit-status"></span>
            </div>
          </div>
        </div>

        <!-- Success -->
        <div class="rv-success" id="rv-success" style="display:none">
          <h3>✅ Resolution dispatched</h3>
          <p id="rv-success-msg"></p>
          <div class="rv-success-meta" id="rv-success-meta"></div>
        </div>

      </div><!-- /rv-scroll -->

    </main>
  </div>

  <script>
    /* ── Sidebar / theme (standard OverClaw pattern) ── */
    const toggle  = document.getElementById('sidebar-toggle');
    const sidebar = document.querySelector('.oc-sidebar');
    if (toggle && sidebar) {
      let collapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
      if (collapsed) sidebar.classList.add('collapsed');
      toggle.addEventListener('click', () => {
        collapsed = !collapsed;
        sidebar.classList.toggle('collapsed', collapsed);
        localStorage.setItem('overclaw-sidebar-collapsed', collapsed);
      });
    }
    const themeBtn = document.getElementById('theme-toggle');
    if (themeBtn) {
      const prefer = window.matchMedia('(prefers-color-scheme: dark)');
      let theme = localStorage.getItem('overclaw-theme') || (prefer.matches ? 'dark' : 'light');
      document.body.classList.add(theme + '-mode');
      themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
      themeBtn.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        document.body.classList.toggle('dark-mode',  theme === 'dark');
        document.body.classList.toggle('light-mode', theme === 'light');
        themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
        localStorage.setItem('overclaw-theme', theme);
      });
    }

    /* ── State ── */
    const alertPath  = '<%= alertPath %>';
    let   contextData = null;

    /* ── Error helpers ── */
    function showErr(msg) {
      const el = document.getElementById('rv-error');
      el.style.display = 'block';
      el.textContent   = '⚠️ ' + msg;
    }
    function hideErr() {
      document.getElementById('rv-error').style.display = 'none';
    }

    /* ── Severity badge class ── */
    function sevClass(sev) {
      if (!sev) return 'sev-default';
      const s = sev.toLowerCase();
      if (s === 'warning') return 'sev-warning';
      if (s === 'error' || s === 'critical') return 'sev-error';
      if (s === 'info') return 'sev-info';
      return 'sev-default';
    }

    /* ── Escape HTML ── */
    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    /* ── Render context card ── */
    function renderContext(ctx) {
      const card = document.getElementById('rv-context-card');
      const docHref = '/vault/doc?path=' + encodeURIComponent(ctx.filePath);

      let html = '<div class="rv-context-card">';

      // Header row: badge + alertId + doc link
      html += `<div class="rv-ctx-header">`;
      if (ctx.severity) {
        html += `<span class="rv-ctx-badge ${sevClass(ctx.severity)}">${esc(ctx.severity)}</span>`;
      }
      html += `<span class="rv-ctx-alertid">${esc(ctx.alertId)}</span>`;
      html += `<a class="rv-ctx-doc-link" href="${docHref}" target="_blank">📄 View doc</a>`;
      html += `</div>`;

      // What is it / the gap
      if (ctx.issue) {
        html += `<div class="rv-ctx-section">
          <span class="rv-ctx-label">Issue / Gap</span>
          <div class="rv-ctx-value highlight">${esc(ctx.issue)}</div>
        </div>`;
      }

      // Recommended fix
      if (ctx.actionRequested) {
        html += `<div class="rv-ctx-section">
          <span class="rv-ctx-label">Recommended Fix</span>
          <div class="rv-ctx-value fix-box">${esc(ctx.actionRequested)}</div>
        </div>`;
      }

      // If HB-error (no issue/action in frontmatter) show status fields
      if (!ctx.issue && (ctx.status || ctx.deliveryStatus)) {
        const detail = [
          ctx.status         ? `Status: ${ctx.status}` : '',
          ctx.deliveryStatus ? `Delivery: ${ctx.deliveryStatus}` : '',
        ].filter(Boolean).join(' · ');
        html += `<div class="rv-ctx-section">
          <span class="rv-ctx-label">Error Details</span>
          <div class="rv-ctx-value highlight">${esc(detail)}</div>
        </div>`;
      }

      // Meta row
      const metaItems = [
        ctx.job       ? `<div class="rv-ctx-meta-item"><strong>Job:</strong> ${esc(ctx.job)}</div>` : '',
        ctx.writtenBy ? `<div class="rv-ctx-meta-item"><strong>Reported by:</strong> ${esc(ctx.writtenBy)}</div>` : '',
        ctx.forAgent  ? `<div class="rv-ctx-meta-item"><strong>For agent:</strong> ${esc(ctx.forAgent)}</div>` : '',
        ctx.writtenAt ? `<div class="rv-ctx-meta-item"><strong>Reported at:</strong> ${esc(ctx.writtenAt)}</div>` : '',
        ctx.agent     ? `<div class="rv-ctx-meta-item"><strong>Inferred owner:</strong> ${esc(ctx.agent.label)}</div>` : '',
      ].filter(Boolean).join('');
      if (metaItems) {
        html += `<div class="rv-ctx-meta-row">${metaItems}</div>`;
      }

      html += '</div>';
      card.innerHTML = html;
      card.style.display = 'block';
    }

    /* ── Populate agent picker ── */
    function populateAgentPicker(ctx) {
      const sel = document.getElementById('rv-agent');
      sel.innerHTML = '';
      (ctx.allAgents || []).forEach(a => {
        const opt = document.createElement('option');
        opt.value = a.key;
        opt.textContent = a.label + (a.canWake ? ' ⚡ (wakes immediately)' : ' 📬 (notif on next heartbeat)');
        if (ctx.agent && a.key === ctx.agent.key) opt.selected = true;
        sel.appendChild(opt);
      });
    }

    /* ── Load context ── */
    async function loadContext() {
      document.getElementById('rv-loading').style.display = 'block';
      hideErr();
      try {
        const resp = await fetch('/api/resolve/context?alert=' + encodeURIComponent(alertPath));
        const ctx  = await resp.json();
        if (!resp.ok || ctx.error) { showErr(ctx.error || 'Failed to load alert context'); return; }

        contextData = ctx;

        // Already dispatched?
        if (ctx.resolutionStatus === 'dispatched') {
          document.getElementById('rv-dispatched-banner').style.display = 'block';
        }

        renderContext(ctx);
        populateAgentPicker(ctx);
        document.getElementById('rv-loading').style.display   = 'none';
        document.getElementById('rv-form-wrap').style.display = 'block';

      } catch (e) {
        showErr(e.message);
        document.getElementById('rv-loading').style.display = 'none';
      }
    }

    /* ── Submit ── */
    async function submitResolve() {
      const btn         = document.getElementById('rv-submit-btn');
      const statusEl    = document.getElementById('rv-submit-status');
      const instructions = document.getElementById('rv-instructions').value.trim();
      const agentKey    = document.getElementById('rv-agent').value;

      if (!instructions) {
        statusEl.textContent = '⚠️ Instructions are required.';
        statusEl.style.color = '#f87171';
        return;
      }

      btn.disabled = true;
      statusEl.textContent = 'Dispatching…';
      statusEl.style.color = '#6b7280';

      const agentLabel = document.getElementById('rv-agent')
        .options[document.getElementById('rv-agent').selectedIndex].textContent
        .replace(/\s*[⚡📬].*$/, '').trim();

      try {
        const resp = await fetch('/api/resolve', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ alertPath, agentKey, agentLabel, instructions }),
        });
        const result = await resp.json();
        if (!resp.ok || result.error) {
          statusEl.textContent = '❌ ' + (result.error || 'Server error');
          statusEl.style.color = '#f87171';
          btn.disabled = false;
          return;
        }

        // Show success
        document.getElementById('rv-form-wrap').style.display = 'none';
        const success = document.getElementById('rv-success');
        success.style.display = 'block';

        const docHref = '/vault/doc?path=' + encodeURIComponent('08 - QA-and-Monitoring/Heartbeats/' + alertPath);
        document.getElementById('rv-success-msg').innerHTML =
          `Instructions dispatched to <strong>${esc(agentLabel)}</strong>. ` +
          `A notification file has been written to their inbox. ` +
          (result.woke
            ? `Spike was <strong>woken immediately</strong> via the gateway wake event.`
            : `The agent will pick this up on their <strong>next heartbeat</strong>.`);

        const metaParts = [
          `Alert: <code>${esc(result.alertId)}</code>`,
          `Vault: ${result.synced ? '✅ synced' : '⚠️ sync failed (saved locally)'}`,
        ];
        if (result.syncWarning) metaParts.push(`Sync warning: ${esc(result.syncWarning)}`);
        metaParts.push(`<a href="${docHref}" target="_blank">View updated alert doc →</a>`);
        document.getElementById('rv-success-meta').innerHTML = metaParts.join(' &nbsp;·&nbsp; ');

      } catch (e) {
        statusEl.textContent = '❌ ' + e.message;
        statusEl.style.color = '#f87171';
        btn.disabled = false;
      }
    }

    /* ── Boot ── */
    loadContext();
  </script>
</body>
</html>
