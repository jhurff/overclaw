<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/document-head') %>

    </head>
<body>
    <%- include('partials/app-header') %>

    <div class="oc-main-content">
<%- include('partials/sidebar', { currentPath: typeof currentPath !== 'undefined' ? currentPath : '/version' }) %>

        <main class="oc-dashboard-area">
          <style>
            .sw-section { font-size:.7rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--oc-text-faint); padding:.6rem 0 .5rem; border-bottom:1px solid var(--oc-border); margin-bottom:.75rem; }
            .ver-card { background:var(--oc-bg-card); border:1px solid var(--oc-border); border-radius:10px; padding:1rem 1.15rem; margin-bottom:1rem; max-width:720px; }
            .ver-table { width:100%; border-collapse:collapse; }
            .ver-table th { text-align:left; font-size:.72rem; font-weight:600; color:var(--oc-text-muted); padding:.45rem .4rem .45rem 0; width:11.5rem; vertical-align:top; }
            .ver-table td { font-size:.82rem; color:var(--oc-text); padding:.45rem 0; vertical-align:top; word-break:break-word; }
            .ver-table tr + tr th, .ver-table tr + tr td { border-top:1px solid var(--oc-border); }
            .ver-table code { font-size:.78rem; color:var(--oc-info-text); }
            .ver-sub { display:block; font-size:.72rem; color:var(--oc-text-muted); margin-top:.15rem; }
            .ver-note { font-size:.75rem; color:var(--oc-text-muted); margin-top:.25rem; }
            .ver-note a { color:var(--oc-info-text); text-decoration:none; }
            .ver-note a:hover { color:var(--oc-text); }
          </style>

          <div class="sw-section">Build version</div>
          <div class="ver-card">
            <table class="ver-table">
              <tr><th>App</th><td><%= version.name %></td></tr>
              <tr><th>Version</th><td><code><%= version.version %></code></td></tr>
              <tr><th>Repo</th><td><%= version.repo %></td></tr>
              <tr>
                <th>Commit</th>
                <td>
                  <code><%= version.git.commitShort %></code>
                  <span class="ver-sub"><code><%= version.git.commit %></code></span>
                </td>
              </tr>
              <tr>
                <th>Commit date</th>
                <td>
                  <%= version.git.commitDateUtc %>
                  <span class="ver-sub"><%= version.git.commitDateAmericaNewYork %></span>
                </td>
              </tr>
              <tr><th>Commit subject</th><td><%= version.git.commitSubject %></td></tr>
              <tr><th>Branch</th><td><code><%= version.git.branch %></code></td></tr>
              <tr>
                <th>Started</th>
                <td>
                  <%= version.deployed.startedAtUtc %>
                  <span class="ver-sub"><%= version.deployed.startedAtAmericaNewYork %></span>
                </td>
              </tr>
              <tr>
                <th>Uptime</th>
                <td><%= version.deployed.uptime %> <span class="ver-sub"><%= version.deployed.uptimeSeconds %> seconds</span></td>
              </tr>
              <tr><th>Node</th><td><code><%= version.runtime.node %></code></td></tr>
              <tr><th>Hostname</th><td><%= version.runtime.hostname %></td></tr>
            </table>
            <p class="ver-note">JSON: <a href="/api/version">/api/version</a>. Times are shown in ISO UTC and America/New_York.</p>
          </div>
        </main>
    </div>

    <script>
      
    </script>
<%- include('partials/chrome-end') %>
</body>
</html>
