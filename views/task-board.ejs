<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ---- Task Board styles ---- */
    .kanban-board {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      align-items: start;
    }
    @media (max-width: 1100px) {
      .kanban-board { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .kanban-board { grid-template-columns: 1fr; }
    }
    .kb-column {
      background: var(--card-bg, #1a1f2e);
      border: 1px solid var(--border, #2d3548);
      border-radius: 10px;
      padding: 1rem;
      min-height: 200px;
    }
    .kb-column-header {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.8rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .kb-count {
      font-size: 0.72rem;
      background: #374151;
      color: #d1d5db;
      padding: 1px 7px;
      border-radius: 9999px;
      font-weight: 600;
    }
    .kb-card {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 8px;
      padding: 0.75rem;
      margin-bottom: 0.6rem;
      font-size: 0.83rem;
    }
    .kb-card.is-blocked {
      border-color: #991b1b;
      background: #1c0a0a;
    }
    .kb-card .task-id {
      font-size: 0.68rem;
      font-family: monospace;
      color: #60a5fa;
      margin-bottom: 3px;
    }
    .kb-card .task-title {
      font-weight: 600;
      color: #e2e8f0;
      line-height: 1.35;
      margin-bottom: 5px;
    }
    .kb-card .task-footer {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      align-items: center;
    }
    .chip {
      display: inline-block;
      padding: 1px 7px;
      border-radius: 9999px;
      font-size: 0.68rem;
      font-weight: 600;
    }
    .chip-agent    { background: #1e3a5f; color: #93c5fd; }
    .chip-high     { background: #7f1d1d; color: #fca5a5; }
    .chip-medium   { background: #78350f; color: #fde68a; }
    .chip-low      { background: #14532d; color: #86efac; }
    .chip-critical { background: #4c0519; color: #fda4af; }
    .chip-default  { background: #374151; color: #d1d5db; }
    .kb-date { font-size: 0.66rem; color: #6b7280; }

    .show-more-btn {
      background: none;
      border: 1px solid #374151;
      color: #9ca3af;
      font-size: 0.75rem;
      border-radius: 6px;
      padding: 3px 10px;
      cursor: pointer;
      margin-top: 4px;
      width: 100%;
    }
    .show-more-btn:hover { border-color: #6b7280; color: #e2e8f0; }

    .vault-unavailable {
      background: #1c1917;
      border: 1px solid #78350f;
      border-radius: 8px;
      padding: 1rem 1.2rem;
      color: #fde68a;
      font-size: 0.88rem;
      margin-bottom: 1.5rem;
    }
    .refresh-note { font-size: 0.75rem; color: #6b7280; margin-top: 1rem; }

    /* Inbox header color */
    .col-inbox .kb-column-header     { color: #a78bfa; }
    .col-inprogress .kb-column-header { color: #60a5fa; }
    .col-blocked .kb-column-header   { color: #f87171; }
    .col-done .kb-column-header      { color: #34d399; }
  </style>
</head>
<body>
  <header class="oc-header">
    <div class="logo">
      <h1 class="main-title">OVERCLAW</h1>
      <span class="tagline">AGENT DASHBOARD</span>
    </div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/task-board' }) %>

    <main class="oc-dashboard-area">
      <h1 style="margin-bottom:0.25rem;">📋 Task Board</h1>
      <p style="color:var(--muted,#8892a4); font-size:0.87rem; margin-bottom:1.5rem;">
        Swarm task board from the shared vault — all four agents.
      </p>

      <div id="vault-error" class="vault-unavailable" style="display:none;"></div>

      <div class="kanban-board" id="kanban-board">
        <div class="kb-column col-inbox">
          <div class="kb-column-header">📥 Inbox <span class="kb-count" id="count-inbox">—</span></div>
          <div id="col-inbox-cards"><div style="color:#6b7280;font-size:0.8rem;">Loading…</div></div>
        </div>
        <div class="kb-column col-inprogress">
          <div class="kb-column-header">🔄 In Progress <span class="kb-count" id="count-inprogress">—</span></div>
          <div id="col-inprogress-cards"><div style="color:#6b7280;font-size:0.8rem;">Loading…</div></div>
        </div>
        <div class="kb-column col-blocked">
          <div class="kb-column-header">🚫 Blocked <span class="kb-count" id="count-blocked">—</span></div>
          <div id="col-blocked-cards"><div style="color:#6b7280;font-size:0.8rem;">Loading…</div></div>
        </div>
        <div class="kb-column col-done">
          <div class="kb-column-header">✅ Done <span class="kb-count" id="count-done">—</span></div>
          <div id="col-done-cards"><div style="color:#6b7280;font-size:0.8rem;">Loading…</div></div>
        </div>
      </div>

      <p class="refresh-note" id="refresh-note">Auto-refreshes every 60 seconds.</p>
    </main>
  </div>

  <script>
    // --- Sidebar / theme boilerplate ---
    (function () {
      const toggle  = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('oc-sidebar');
      if (toggle && sidebar) {
        let collapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (collapsed) sidebar.classList.add('collapsed');
        toggle.addEventListener('click', () => {
          collapsed = !collapsed;
          sidebar.classList.toggle('collapsed', collapsed);
          localStorage.setItem('overclaw-sidebar-collapsed', collapsed);
        });
      }
      const themeBtn = document.getElementById('theme-toggle');
      const prefer   = window.matchMedia('(prefers-color-scheme: dark)');
      let theme      = localStorage.getItem('overclaw-theme') || (prefer.matches ? 'dark' : 'light');
      document.body.classList.add(theme + '-mode');
      themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
      themeBtn.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        document.body.classList.toggle('dark-mode',  theme === 'dark');
        document.body.classList.toggle('light-mode', theme === 'light');
        themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
        localStorage.setItem('overclaw-theme', theme);
      });
    })();

    const DONE_TRUNCATE = 10;
    let currentData = null;
    let doneExpanded = false;

    function priorityChip(priority) {
      if (!priority) return '';
      const p = priority.toLowerCase();
      let cls = 'chip-default';
      if (p.includes('critical'))  cls = 'chip-critical';
      else if (p.includes('high')) cls = 'chip-high';
      else if (p.includes('med'))  cls = 'chip-medium';
      else if (p.includes('low'))  cls = 'chip-low';
      return `<span class="chip ${cls}">${priority}</span>`;
    }

    function taskCard(task, extraClass) {
      const idHtml = task.taskId
        ? `<div class="task-id">${task.taskId}</div>`
        : '';
      const titleEl = task.link
        ? `<a href="${task.link}" class="task-title" style="color:inherit;text-decoration:none;" target="_blank">${task.title || '(untitled)'}</a>`
        : `<div class="task-title">${task.title || '(untitled)'}</div>`;
      const agentChip = task.agent
        ? `<span class="chip chip-agent">${task.agent}</span>`
        : '';
      const dateStr = task.created || task.deadline || '';
      const dateEl  = dateStr ? `<span class="kb-date">${dateStr}</span>` : '';

      return `
        <div class="kb-card ${extraClass || ''}">
          ${idHtml}
          ${titleEl}
          <div class="task-footer">
            ${agentChip}
            ${priorityChip(task.priority)}
            ${dateEl}
          </div>
        </div>`;
    }

    function renderColumn(containerId, tasks, isBlocked, isDone) {
      const container = document.getElementById(containerId);
      if (!tasks || tasks.length === 0) {
        container.innerHTML = '<div style="color:#4b5563;font-size:0.8rem;text-align:center;padding:1rem;">Empty</div>';
        return;
      }

      const extraClass = isBlocked ? 'is-blocked' : '';

      if (isDone && !doneExpanded && tasks.length > DONE_TRUNCATE) {
        const visible = tasks.slice(0, DONE_TRUNCATE);
        const rest    = tasks.length - DONE_TRUNCATE;
        container.innerHTML =
          visible.map(t => taskCard(t, '')).join('') +
          `<button class="show-more-btn" onclick="expandDone()">Show ${rest} more…</button>`;
      } else {
        container.innerHTML = tasks.map(t => taskCard(t, extraClass)).join('');
        if (isDone && tasks.length > DONE_TRUNCATE && doneExpanded) {
          container.innerHTML += `<button class="show-more-btn" onclick="collapseDone()">Show less</button>`;
        }
      }
    }

    function expandDone() {
      doneExpanded = true;
      if (currentData) renderColumn('col-done-cards', currentData.done, false, true);
    }

    function collapseDone() {
      doneExpanded = false;
      if (currentData) renderColumn('col-done-cards', currentData.done, false, true);
    }

    async function loadBoard() {
      const errBox = document.getElementById('vault-error');
      try {
        const resp = await fetch('/api/vault/task-board');
        const data = await resp.json();

        if (data.error) {
          errBox.style.display = 'block';
          errBox.textContent   = '⚠️ Vault unavailable: ' + (data.details || data.error);
          ['inbox','inprogress','blocked','done'].forEach(k => {
            document.getElementById('col-' + k + '-cards').innerHTML =
              '<div style="color:#6b7280;font-size:0.8rem;">No data</div>';
          });
          return;
        }

        errBox.style.display = 'none';
        currentData = data;

        document.getElementById('count-inbox').textContent      = data.inbox.length;
        document.getElementById('count-inprogress').textContent = data.inProgress.length;
        document.getElementById('count-blocked').textContent    = data.blocked.length;
        document.getElementById('count-done').textContent       = data.done.length;

        renderColumn('col-inbox-cards',     data.inbox,      false, false);
        renderColumn('col-inprogress-cards', data.inProgress, false, false);
        renderColumn('col-blocked-cards',   data.blocked,    true,  false);
        renderColumn('col-done-cards',      data.done,       false, true);

        document.getElementById('refresh-note').textContent =
          'Last updated: ' + new Date().toLocaleTimeString() + ' · Auto-refreshes every 60s';

      } catch (err) {
        errBox.style.display = 'block';
        errBox.textContent   = '⚠️ Failed to fetch task board: ' + err.message;
      }
    }

    loadBoard();
    setInterval(loadBoard, 60000);
  </script>
</body>
</html>
