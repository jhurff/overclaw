<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ── Force the dashboard area into a flex column (override global grid) ── */
    .oc-main-content {
      overflow: hidden !important;
      height: calc(100vh - 60px);
    }
    .oc-dashboard-area {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: unset !important;
      overflow: hidden !important;
      padding: 0.75rem 1rem 0 1rem !important;
      gap: 0 !important;
    }

    /* ── Top strip ── */
    .tb-topbar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-shrink: 0;
      padding-bottom: 0.6rem;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .tb-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--oc-text-dark, #e2e8f0);
      margin: 0;
    }
    .tb-meta {
      font-size: 0.75rem;
      color: #6b7280;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .tb-sync-btn {
      font-size: 0.73rem;
      padding: 0.18rem 0.6rem;
      border-radius: 4px;
      border: 1px solid #374151;
      background: transparent;
      color: #9ca3af;
      cursor: pointer;
      transition: border-color .15s, color .15s;
    }
    .tb-sync-btn:hover { border-color: #6b7280; color: #e2e8f0; }
    .tb-sync-btn:disabled { opacity: 0.5; cursor: default; }

    /* ── Error banner ── */
    .tb-error {
      display: none;
      background: #1c1917;
      border: 1px solid #78350f;
      border-radius: 6px;
      padding: 0.6rem 1rem;
      color: #fde68a;
      font-size: 0.82rem;
      margin-bottom: 0.6rem;
      flex-shrink: 0;
    }

    /* ── Board ── */
    .kb-board {
      display: flex;
      flex: 1;
      gap: 0.6rem;
      min-height: 0;
      overflow-x: auto;      /* scroll horizontally if viewport too narrow */
      overflow-y: hidden;
      padding-bottom: 0.75rem;
    }

    /* ── Column ── */
    .kb-col {
      flex: 1 1 0;
      min-width: 210px;
      display: flex;
      flex-direction: column;
      background: var(--oc-card-bg, #111827);
      border: 1px solid var(--oc-border-color, #1f2937);
      border-radius: 8px;
      overflow: hidden;
    }
    .kb-col-header {
      padding: 0.55rem 0.8rem;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--oc-border-color, #1f2937);
      flex-shrink: 0;
    }
    .kb-col-body {
      flex: 1;
      overflow-y: auto;
      min-height: 0;
      padding: 0.5rem;
      scrollbar-width: thin;
      scrollbar-color: #374151 transparent;
    }
    .kb-col-body::-webkit-scrollbar { width: 4px; }
    .kb-col-body::-webkit-scrollbar-track { background: transparent; }
    .kb-col-body::-webkit-scrollbar-thumb { background: #374151; border-radius: 2px; }

    /* Column accent colors */
    .col-inbox    .kb-col-header { color: #a78bfa; border-bottom-color: #312e5f; }
    .col-inbox    { border-top: 2px solid #7c3aed; }
    .col-inprogress .kb-col-header { color: #60a5fa; border-bottom-color: #1e3a5f; }
    .col-inprogress { border-top: 2px solid #2563eb; }
    .col-blocked  .kb-col-header { color: #f87171; border-bottom-color: #4c1414; }
    .col-blocked  { border-top: 2px solid #dc2626; }
    .col-done     .kb-col-header { color: #6ee7b7; border-bottom-color: #0d3326; }
    .col-done     { border-top: 2px solid #059669; }

    .kb-count {
      font-size: 0.68rem;
      background: #374151;
      color: #d1d5db;
      padding: 1px 6px;
      border-radius: 9999px;
      font-weight: 600;
    }

    /* ── Card ── */
    .kb-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid #1f2937;
      border-radius: 6px;
      padding: 0.55rem 0.65rem;
      margin-bottom: 0.45rem;
      font-size: 0.8rem;
      cursor: default;
      transition: border-color .12s;
    }
    .kb-card:hover { border-color: #374151; }
    .kb-card.is-blocked {
      border-color: #7f1d1d;
      background: rgba(127,29,29,0.15);
    }
    .kb-card .task-id,
    .kb-card a.task-id {
      font-size: 0.63rem;
      font-family: monospace;
      color: #4b9edb;
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-decoration: none;
      display: block;
    }
    .kb-card a.task-id:hover { text-decoration: underline; }
    .kb-card .task-title,
    .kb-card a.task-title {
      font-weight: 500;
      color: #cbd5e1;
      line-height: 1.35;
      margin-bottom: 6px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-decoration: none;
    }
    .kb-card a.task-title:hover { color: #93c5fd; }
    .kb-card .task-footer {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
      align-items: center;
    }

    /* ── Chips ── */
    .chip {
      display: inline-block;
      padding: 1px 6px;
      border-radius: 9999px;
      font-size: 0.63rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .chip-agent    { background: #1e3a5f; color: #93c5fd; }
    .chip-high     { background: #7f1d1d; color: #fca5a5; }
    .chip-medium   { background: #78350f; color: #fde68a; }
    .chip-low      { background: #14532d; color: #86efac; }
    .chip-critical { background: #4c0519; color: #fda4af; }
    .chip-default  { background: #2d3748; color: #a0aec0; }
    .kb-date { font-size: 0.62rem; color: #6b7280; }

    /* ── Show more ── */
    .show-more-btn {
      background: none;
      border: 1px solid #2d3748;
      color: #6b7280;
      font-size: 0.72rem;
      border-radius: 5px;
      padding: 3px 8px;
      cursor: pointer;
      width: 100%;
      margin-top: 2px;
    }
    .show-more-btn:hover { border-color: #4a5568; color: #e2e8f0; }

    /* ── Next-step / action strip ── */
    .task-action {
      font-size: 0.71rem;
      line-height: 1.35;
      padding: 0.28rem 0.45rem;
      border-radius: 4px;
      margin: 4px 0 3px;
    }
    /* blocked: red tint, prominent Jimmy-action line */
    .blocked-action {
      background: rgba(127,29,29,0.22);
      border-left: 2px solid #b91c1c;
      color: #fca5a5;
    }
    .action-context { color: #9ca3af; font-size: 0.67rem; margin-bottom: 2px; }
    .action-jimmy   { color: #fbbf24; font-weight: 600; }
    /* in-progress: quiet dates */
    .progress-action { color: #6b7280; font-size: 0.69rem; }
    /* inbox: subtle due-date hint */
    .inbox-action { color: #a78bfa; font-size: 0.69rem; }
    /* done: muted output summary */
    .done-action {
      background: rgba(5,150,105,0.08);
      border-left: 2px solid #059669;
      color: #6b7280;
    }
    /* title line-clamp per status */
    .kb-card.st-blocked    .task-title { -webkit-line-clamp: 2; }
    .kb-card.st-inProgress .task-title { -webkit-line-clamp: 4; }
    .kb-card.st-done       .task-title { -webkit-line-clamp: 2; }

    /* ── Empty state ── */
    .kb-empty {
      color: #374151;
      font-size: 0.78rem;
      text-align: center;
      padding: 1.5rem 0;
    }

    /* ── Mobile column tabs (hidden on desktop) ── */
    .kb-tabs { display: none; }

    @media (max-width: 820px) {
      /* Safe-area: header may be taller on iPhone with notch */
      .oc-main-content {
        height: calc(100dvh - 60px) !important;
        height: calc(100vh - 60px - env(safe-area-inset-top, 0px)) !important;
      }

      /* Tab bar */
      .kb-tabs {
        display: flex !important;
        flex-shrink: 0;
        border-bottom: 1px solid #1f2937;
        background: var(--oc-card-bg, #111827);
      }
      .kb-tab {
        flex: 1;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.55rem 0.2rem;
        font-size: 0.78rem;
        font-weight: 600;
        color: #6b7280;
        cursor: pointer;
        text-align: center;
        white-space: nowrap;
        font-family: inherit;
        transition: color .15s, border-color .15s;
        -webkit-tap-highlight-color: transparent;
      }
      .kb-tab.active.tab-inbox      { color: #a78bfa; border-bottom-color: #7c3aed; }
      .kb-tab.active.tab-inprogress { color: #60a5fa; border-bottom-color: #2563eb; }
      .kb-tab.active.tab-blocked    { color: #f87171; border-bottom-color: #dc2626; }
      .kb-tab.active.tab-done       { color: #6ee7b7; border-bottom-color: #059669; }
      .kb-tab-count {
        display: inline-block;
        background: #374151;
        border-radius: 9999px;
        padding: 0 5px;
        font-size: 0.65rem;
        margin-left: 3px;
        vertical-align: middle;
      }

      /* Board: horizontal snap — one column at a time */
      .kb-board {
        gap: 0 !important;
        padding: 0 !important;
        scroll-snap-type: x mandatory !important;
        -webkit-overflow-scrolling: touch !important;
        scrollbar-width: none !important;
      }
      .kb-board::-webkit-scrollbar { display: none; }

      /* Each column fills the full board width and snaps */
      .kb-col {
        flex: 0 0 100% !important;
        min-width: 0 !important;
        scroll-snap-align: start !important;
        border-radius: 0 !important;
        border-left: none !important;
        border-right: none !important;
      }

      /* Tighten topbar on mobile */
      .tb-topbar {
        padding-bottom: 0.4rem;
        gap: 0.5rem;
      }
      .tb-title { font-size: 0.95rem; }
    }

    /* ── Stuck tasks (stale / overdue in-progress) ── */
    .kb-card.is-stuck { border-left: 2px solid #f97316 !important; background: rgba(249,115,22,0.07) !important; }
    .stuck-action {
      background: rgba(249,115,22,0.12); border-left: 2px solid #f97316;
      padding: 0.3rem 0.5rem; border-radius: 4px; margin: 4px 0 3px;
    }
    .stuck-action-label { font-size: 0.7rem; font-weight: 600; color: #fb923c; margin-bottom: 4px; }
    .escalate-btn {
      display: inline-block; background: transparent;
      border: 1px solid #f97316; color: #f97316;
      font-size: 0.68rem; border-radius: 4px; padding: 2px 9px;
      cursor: pointer; font-family: inherit;
      transition: background .12s, color .12s;
    }
    .escalate-btn:hover  { background: #f97316; color: #111827; }
    .escalate-btn.confirm-state { background: #f97316; color: #111827; font-weight: 700; }
    .escalate-btn:disabled { opacity: 0.5; cursor: default; }
    .stuck-count-badge {
      font-size: 0.63rem; background: rgba(249,115,22,0.22);
      color: #f97316; border-radius: 9999px;
      padding: 1px 6px; font-weight: 700; margin-left: 4px;
    }

    /* ── Assign task to agent ── */
    .assign-row {
      display: flex; align-items: center; gap: 0.4rem;
      margin-top: 0.45rem; flex-wrap: wrap;
    }
    .assign-select {
      font-size: 0.74rem; background: #1a1f2e; color: #9ca3af;
      border: 1px solid #2d3748; border-radius: 4px; padding: 2px 6px;
      flex: 1; min-width: 100px; max-width: 150px; cursor: pointer;
    }
    .assign-select:focus { outline: none; border-color: #4f46e5; }
    .assign-btn, .reassign-btn {
      font-size: 0.74rem; padding: 2px 8px;
      border: 1px solid #4f46e5; background: transparent; color: #818cf8;
      border-radius: 4px; cursor: pointer; white-space: nowrap; transition: background .15s;
    }
    .assign-btn:hover, .reassign-btn:hover { background: #4f46e511; }
    .assign-btn.confirm-state, .reassign-btn.confirm-state {
      border-color: #f59e0b; color: #fbbf24; background: #f59e0b11;
    }
    .assign-btn:disabled, .reassign-btn:disabled { opacity:.5; cursor:default; }
    .reassign-section { border-top: 1px solid #1f2937; margin-top: 0.45rem; padding-top: 0.45rem; }



    /* ── Light mode overrides ── */
    body.light-mode .tb-topbar { border-bottom-color: #e2e8f0; }
    body.light-mode .tb-sync-btn { color: #475569; border-color: #e2e8f0; }
    body.light-mode .tb-sync-btn:hover { color: #1e293b; border-color: #94a3b8; }
    body.light-mode .tb-meta { color: #64748b; }
    body.light-mode .kb-col {
      background: #ffffff;
      border-color: #e2e8f0;
    }
    body.light-mode .kb-col-header {
      color: #1e293b;
      border-bottom-color: #e2e8f0;
    }
    body.light-mode .kb-col-body::-webkit-scrollbar-thumb { background: #cbd5e1; }
    body.light-mode .kb-card {
      background: #f8fafc;
      border-color: #e2e8f0;
    }
    body.light-mode .kb-card:hover { border-color: #94a3b8; background: #ffffff; }
    body.light-mode .kb-card.is-blocked {
      border-color: #fca5a5;
      background: rgba(220,38,38,0.04);
    }
    body.light-mode .kb-card .task-title,
    body.light-mode .kb-card a.task-title { color: #1e293b; }
    body.light-mode .kb-card a.task-title:hover { color: #4f46e5; }
    body.light-mode .kb-card .task-id,
    body.light-mode .kb-card a.task-id { color: #4f46e5; }
    body.light-mode .kb-date { color: #64748b; }
    body.light-mode .task-action { color: #475569; }
    body.light-mode .blocked-action { color: #b91c1c; }
    body.light-mode .action-context { color: #64748b; }
    body.light-mode .action-jimmy   { color: #b45309; }
    body.light-mode .progress-action { color: #64748b; }
    body.light-mode .inbox-action { color: #6d28d9; }
    body.light-mode .done-action { color: #047857; background: rgba(5,150,105,0.06); }
    body.light-mode .kb-empty { color: #94a3b8; }
    body.light-mode .show-more-btn { color: #64748b; border-color: #e2e8f0; background: #f8fafc; }
    body.light-mode .show-more-btn:hover { border-color: #94a3b8; color: #1e293b; }
    body.light-mode .chip-default { background: #f1f5f9; color: #475569; }
    body.light-mode .chip-agent   { background: #eff6ff; color: #1d4ed8; }
    body.light-mode .chip-high    { background: #fef2f2; color: #b91c1c; }
    body.light-mode .chip-medium  { background: #fffbeb; color: #b45309; }
    body.light-mode .chip-low     { background: #f0fdf4; color: #15803d; }
    body.light-mode .stuck-action-label { color: #c2410c; }
    body.light-mode .escalate-btn { border-color: #f97316; color: #c2410c; }
    body.light-mode .kb-card.is-stuck {
      border-left-color: #f97316 !important;
      background: rgba(249,115,22,0.05) !important;
    }
    body.light-mode .assign-select { background: #f8fafc; color: #475569; border-color: #e2e8f0; }
    body.light-mode .assign-btn, body.light-mode .reassign-btn {
      color: #4f46e5; border-color: #c7d2fe; background: transparent;
    }
    body.light-mode .assign-btn:hover, body.light-mode .reassign-btn:hover { background: #eef2ff; }
    body.light-mode .reassign-section { border-top-color: #e2e8f0; }
    body.light-mode .vault-error { background: #fef2f2; color: #b91c1c; border-color: #fca5a5; }
    body.light-mode .col-inbox    { border-top-color: #7c3aed; }
    body.light-mode .col-inbox    .kb-col-header { color: #6d28d9; border-bottom-color: #ddd6fe; }
    body.light-mode .col-inprogress { border-top-color: #2563eb; }
    body.light-mode .col-inprogress .kb-col-header { color: #1d4ed8; border-bottom-color: #bfdbfe; }
    body.light-mode .col-blocked  { border-top-color: #dc2626; }
    body.light-mode .col-blocked  .kb-col-header { color: #b91c1c; border-bottom-color: #fecaca; }
    body.light-mode .col-done     { border-top-color: #059669; }
    body.light-mode .col-done     .kb-col-header { color: #047857; border-bottom-color: #a7f3d0; }
    body.light-mode .stuck-count-badge { background: rgba(249,115,22,0.15); color: #c2410c; }


    /* ── Drag and drop ── */
    .kb-card[draggable] { cursor: grab; }
    .kb-card[draggable]:active { cursor: grabbing; }
    .kb-card.is-dragging { opacity: 0.35; pointer-events: none; }
    .kb-col-body.drag-over {
      outline: 2px dashed #4f46e5;
      outline-offset: -3px;
      background: rgba(79,70,229,0.06);
    }
    .kb-col-body.drag-over-blocked {
      outline-color: #dc2626;
      background: rgba(220,38,38,0.06);
    }
    /* Drop action panel */
    #drop-panel {
      position: fixed; z-index: 9999;
      background: #1a1f2e; border: 1px solid #374151; border-radius: 8px;
      padding: 0.8rem 1rem; box-shadow: 0 8px 24px rgba(0,0,0,0.5);
      min-width: 230px; max-width: 280px;
      display: none;
    }
    #drop-panel.open { display: block; }
    #drop-panel h4 { font-size: 0.78rem; color: #e2e8f0; margin: 0 0 0.55rem; }
    #drop-panel select, #drop-panel textarea {
      width: 100%; font-size: 0.78rem; background: #0f1117; color: #d1d5db;
      border: 1px solid #374151; border-radius: 4px; padding: 4px 7px;
      box-sizing: border-box; font-family: inherit;
    }
    #drop-panel textarea { resize: none; height: 60px; margin-top: 0.4rem; }
    #drop-panel .dp-actions { display: flex; gap: 0.4rem; margin-top: 0.55rem; }
    #drop-panel .dp-confirm {
      flex: 1; font-size: 0.78rem; padding: 3px 8px;
      background: #4f46e5; color: #fff; border: none; border-radius: 4px; cursor: pointer;
    }
    #drop-panel .dp-confirm:hover { background: #4338ca; }
    #drop-panel .dp-cancel {
      font-size: 0.78rem; padding: 3px 8px;
      background: transparent; color: #6b7280; border: 1px solid #374151; border-radius: 4px; cursor: pointer;
    }
    body.light-mode #drop-panel {
      background: #ffffff; border-color: #e2e8f0; box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    body.light-mode #drop-panel h4 { color: #1e293b; }
    body.light-mode #drop-panel select, body.light-mode #drop-panel textarea {
      background: #f8fafc; color: #1e293b; border-color: #e2e8f0;
    }
    body.light-mode #drop-panel .dp-cancel { color: #64748b; border-color: #e2e8f0; }

  </style>
</head>
<body>
  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">TASK BOARD</span></a></div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/task-board' }) %>

    <main class="oc-dashboard-area">

      <!-- Top strip -->
      <div class="tb-topbar">
        <h1 class="tb-title">📋 Task Board</h1>
        <div class="tb-meta">
          <span id="tb-refresh-note">Loading…</span>
          <span id="tb-sync-ts"></span>
          <button class="tb-sync-btn" id="sync-btn" onclick="syncVault()">↻ Sync</button>
        </div>
      </div>

      <!-- Vault error -->
      <div class="tb-error" id="vault-error"></div>

      <!-- Mobile column tabs -->
      <div class="kb-tabs">
        <button class="kb-tab tab-inbox active" id="ktab-inbox">📥 <span class="kb-tab-count" id="tab-count-inbox">—</span></button>
        <button class="kb-tab tab-inprogress" id="ktab-inprogress">🔄 <span class="kb-tab-count" id="tab-count-inprogress">—</span></button>
        <button class="kb-tab tab-blocked" id="ktab-blocked">🚫 <span class="kb-tab-count" id="tab-count-blocked">—</span></button>
        <button class="kb-tab tab-done" id="ktab-done">✅ <span class="kb-tab-count" id="tab-count-done">—</span></button>
      </div>

      <!-- Board -->
      <div class="kb-board" id="kanban-board">
        <div class="kb-col col-inbox">
          <div class="kb-col-header">
            <span>📥 Inbox</span>
            <span class="kb-count" id="count-inbox">—</span>
          </div>
          <div class="kb-col-body" id="col-inbox-cards" data-section="inbox">
            <div class="kb-empty">Loading…</div>
          </div>
        </div>

        <div class="kb-col col-inprogress">
          <div class="kb-col-header">
            <span>🔄 In Progress</span>
            <span class="kb-count" id="count-inprogress">—</span>
          </div>
          <div class="kb-col-body" id="col-inprogress-cards" data-section="inProgress">
            <div class="kb-empty">Loading…</div>
          </div>
        </div>

        <div class="kb-col col-blocked">
          <div class="kb-col-header">
            <span>🚫 Blocked</span>
            <span class="kb-count" id="count-blocked">—</span>
          </div>
          <div class="kb-col-body" id="col-blocked-cards" data-section="blocked">
            <div class="kb-empty">Loading…</div>
          </div>
        </div>

        <div class="kb-col col-done">
          <div class="kb-col-header">
            <span>✅ Done</span>
            <span class="kb-count" id="count-done">—</span>
          </div>
          <div class="kb-col-body" id="col-done-cards" data-section="done">
            <div class="kb-empty">Loading…</div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <script>
    /* ── Sidebar / theme boilerplate ── */
    (function () {
      const toggle  = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('oc-sidebar');
      if (toggle && sidebar) {
        let collapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (collapsed) sidebar.classList.add('collapsed');
        toggle.addEventListener('click', () => {
          collapsed = !collapsed;
          sidebar.classList.toggle('collapsed', collapsed);
          localStorage.setItem('overclaw-sidebar-collapsed', collapsed);
        });
      }
      const themeBtn = document.getElementById('theme-toggle');
      const prefer   = window.matchMedia('(prefers-color-scheme: dark)');
      let theme = localStorage.getItem('overclaw-theme') || (prefer.matches ? 'dark' : 'light');
      document.body.classList.add(theme + '-mode');
      themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
      themeBtn.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        document.body.classList.toggle('dark-mode',  theme === 'dark');
        document.body.classList.toggle('light-mode', theme === 'light');
        themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
        localStorage.setItem('overclaw-theme', theme);
      });
    })();

    /* ── State ── */
    const DONE_LIMIT = 10;
    let currentData  = null;
    let doneExpanded = false;

    /* ── Helpers ── */
    function priorityChip(p) {
      if (!p) return '';
      const lp = p.toLowerCase();
      let cls = '';
      if (lp.includes('critical'))   cls = 'chip-critical';
      else if (lp.includes('high'))  cls = 'chip-high';
      else if (lp.includes('med'))   cls = 'chip-medium';
      else if (lp.includes('low'))   cls = 'chip-low';
      else return ''; /* skip date strings / empty */
      return `<span class="chip ${cls}">${p}</span>`;
    }

    function agentColor(agent) {
      const map = { spike:'#7c3aed', steve:'#2563eb', lex:'#0891b2', bill:'#d97706', jimmy:'#059669' };
      const col = map[(agent||'').toLowerCase()] || '#4b5563';
      return `background:${col}22; color:${col};`;
    }

    function card(task, extraCls) {
      // task.link is like "Tasks/TASK-20260730-007.md" — relative to "03 - Agents/Coordination/"
      const docPath = task.link
        ? '03 - Agents/Coordination/' + task.link
        : null;
      const title = (task.title || '(untitled)').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      const titleEl = docPath
        ? `<a href="/vault/doc?path=${encodeURIComponent(docPath)}" class="task-title" target="_blank">${title}</a>`
        : `<div class="task-title">${title}</div>`;
      const idBadge = task.taskId && docPath
        ? `<a href="/vault/doc?path=${encodeURIComponent(docPath)}" class="task-id" target="_blank">${task.taskId}</a>`
        : task.taskId ? `<div class="task-id">${task.taskId}</div>` : '';

      /* ── Next-step / action section ── */
      let actionEl = '';
      const st = task.status || '';
      if (st === 'blocked') {
        let blockedBody = '';
        if (task.reason) {
          const r = task.reason.replace(/</g,'&lt;').replace(/>/g,'&gt;');
          const jiIdx = r.search(/Jimmy:/i);
          if (jiIdx >= 0) {
            const pre = r.slice(0, jiIdx).trim();
            const ji  = r.slice(jiIdx);
            const jiShort = ji.length > 180 ? ji.slice(0,180)+'…' : ji;
            blockedBody = `<div class="task-action blocked-action">`
              + (pre ? `<div class="action-context">${pre.length>100?pre.slice(0,100)+'…':pre}</div>` : '')
              + `<div class="action-jimmy">→ ${jiShort}</div></div>`;
          } else {
            const s = r.length > 180 ? r.slice(0,180)+'…' : r;
            blockedBody = `<div class="task-action blocked-action">${s}</div>`;
          }
        }
        const tid2 = (task.taskId||'').replace(/[^A-Z0-9\-]/g,'');
        actionEl = blockedBody +
          `<div class="reassign-section assign-row">` +
          `<select class="assign-select" id="rsel-${tid2}">` +
          `<option value="">↻ Reassign to…</option>` +
          `<option value="spike">Spike</option>` +
          `<option value="steve">Steve</option>` +
          `<option value="lex">Lex</option>` +
          `<option value="bill">Bill</option>` +
          `</select>` +
          `<button class="reassign-btn" data-task-id="${tid2}" data-from="blocked" onclick="assignTask(this)">↻ Reassign</button>` +
          `</div>`;
      } else if (st === 'inProgress') {
        if (task.isStuck) {
          const icon  = task.isOverdue ? '\u23f0' : '\u23f1';
          const label = task.isOverdue ? `Overdue ${task.overdueDays}d` : `Stale ${task.staleDays}d`;
          const sub   = task.created && task.created !== '\u2014' ? ' \u00b7 Started ' + task.created : '';
          actionEl = `<div class="task-action stuck-action">`
            + `<div class="stuck-action-label">${icon} ${label}${sub}</div>`
            + `<button class="escalate-btn" data-task-id="${task.taskId}" onclick="escalateTask(this.dataset.taskId,this)">→ Move to Blocked</button>`
            + `</div>`;
        } else {
          const parts = [];
          if (task.created && task.created !== '\u2014') parts.push('Started ' + task.created);
          if (task.deadline && task.deadline !== '\u2014') parts.push('Due ' + task.deadline);
          if (parts.length) actionEl = `<div class="task-action progress-action">${parts.join(' \u00b7 ')}</div>`;
        }
      } else if (st === 'inbox') {
        const parts = [];
        if (task.deadline && task.deadline !== '—') parts.push('Due: ' + task.deadline.replace(/</g,'&lt;'));
        const dueHtml = parts.length ? `<div class="task-action inbox-action">${parts.join(' · ')}</div>` : '';
        const tid = (task.taskId||'').replace(/[^A-Z0-9\-]/g,'');
        actionEl = dueHtml +
          `<div class="assign-row">` +
          `<select class="assign-select" id="asel-${tid}">` +
          `<option value="">Assign &amp; start…</option>` +
          `<option value="spike">Spike</option>` +
          `<option value="steve">Steve</option>` +
          `<option value="lex">Lex</option>` +
          `<option value="bill">Bill</option>` +
          `</select>` +
          `<button class="assign-btn" data-task-id="${tid}" data-from="inbox" onclick="assignTask(this)">→ Start</button>` +
          `</div>`;
      } else if (st === 'done' && task.output) {
        const out = task.output.replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const s = out.length > 120 ? out.slice(0,120)+'…' : out;
        actionEl = `<div class="task-action done-action">${s}</div>`;
      }

      const stCls  = { inbox:'st-inbox', inProgress:'st-wip', blocked:'st-blocked', done:'st-done' };
      const agentEl = task.agent
        ? `<span class="chip chip-agent" style="${agentColor(task.agent)}">${task.agent}</span>` : '';
      const pri = priorityChip(task.priority);
      /* avoid double-showing date when actionEl already has it */
      const rawDate = (st === 'inProgress') ? '' : (task.deadline || task.created || '');
      const date = rawDate.replace(/</g,'&lt;');
      const dateEl = date && date !== '—' ? `<span class="kb-date">${date}</span>` : '';
      const draggable = (st !== 'done') ? 'draggable="true"' : '';
      return `<div class="kb-card ${extraCls||''} ${stCls[st]||''} ${task.isStuck ? 'is-stuck' : ''}" ${draggable} data-task-id="${task.taskId||''}" data-section="${st}">
        ${idBadge}${titleEl}${actionEl}
        <div class="task-footer">${agentEl}${pri}${dateEl}</div>
      </div>`;
    }

    function renderCol(id, tasks, blocked, isDone) {
      const el = document.getElementById(id);
      if (!tasks || !tasks.length) {
        el.innerHTML = '<div class="kb-empty">Empty</div>';
        return;
      }
      const cls = blocked ? 'is-blocked' : '';
      if (isDone && !doneExpanded && tasks.length > DONE_LIMIT) {
        const rest = tasks.length - DONE_LIMIT;
        el.innerHTML = tasks.slice(0, DONE_LIMIT).map(t => card(t, '')).join('') +
          `<button class="show-more-btn" onclick="expandDone()">+${rest} more</button>`;
      } else {
        el.innerHTML = tasks.map(t => card(t, cls)).join('');
        if (isDone && tasks.length > DONE_LIMIT)
          el.innerHTML += `<button class="show-more-btn" onclick="collapseDone()">Show less</button>`;
      }
    }

    function expandDone()  { doneExpanded = true;  if (currentData) renderCol('col-done-cards', currentData.done, false, true); }
    function collapseDone(){ doneExpanded = false; if (currentData) renderCol('col-done-cards', currentData.done, false, true); }

    /* ── Escalate stuck task → Blocked ── */
    async function escalateTask(taskId, btn) {
      if (!taskId) return;
      const orig = btn.textContent;
      if (btn.dataset.confirming) {
        // Second click: execute
        btn.disabled = true; btn.textContent = '\u2026';
        try {
          const r = await fetch('/api/vault/task-board/escalate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskId }),
          }).then(res => res.json());
          if (r.ok) {
            btn.textContent = '\u2713 Moved';
            setTimeout(loadBoard, 1200);
          } else {
            btn.textContent = orig; btn.disabled = false; delete btn.dataset.confirming;
            btn.classList.remove('confirm-state');
            alert('\u26a0\ufe0f ' + (r.details || r.error || 'Escalation failed'));
          }
        } catch (e) {
          btn.textContent = orig; btn.disabled = false; delete btn.dataset.confirming;
          btn.classList.remove('confirm-state');
        }
      } else {
        // First click: enter confirm state, auto-revert after 3s
        btn.textContent = 'Confirm \u2192';
        btn.classList.add('confirm-state');
        btn.dataset.confirming = '1';
        setTimeout(() => {
          if (btn.dataset.confirming) {
            btn.textContent = orig;
            btn.classList.remove('confirm-state');
            delete btn.dataset.confirming;
          }
        }, 3000);
      }
    }


    /* ── Load board ── */
    async function loadBoard() {
      const err = document.getElementById('vault-error');
      try {
        const data = await fetch('/api/vault/task-board').then(r => r.json());
        if (data.error) {
          err.style.display = 'block';
          err.textContent = '⚠️ Vault unavailable: ' + (data.details || data.error);
          ['inbox','inprogress','blocked','done'].forEach(k =>
            document.getElementById('col-'+k+'-cards').innerHTML = '<div class="kb-empty">No data</div>');
          return;
        }
        err.style.display = 'none';
        currentData = data;
        document.getElementById('count-inbox').textContent      = data.inbox.length;
        const stuckCount = (data.inProgress || []).filter(t => t.isStuck).length;
        const wipCountEl  = document.getElementById('count-inprogress');
        wipCountEl.innerHTML = stuckCount > 0
          ? data.inProgress.length + ' <span class="stuck-count-badge">\u26a0\ufe0f\u2009' + stuckCount + ' stuck</span>'
          : String(data.inProgress.length);
        document.getElementById('count-blocked').textContent    = data.blocked.length;
        document.getElementById('count-done').textContent       = data.done.length;
        // Sync mobile tab counts
        var _tc = { inbox: data.inbox.length, inprogress: data.inProgress.length, blocked: data.blocked.length, done: data.done.length };
        Object.keys(_tc).forEach(function(k) { var el = document.getElementById('tab-count-' + k); if (el) el.textContent = _tc[k]; });
        renderCol('col-inbox-cards',      data.inbox,      false, false);
        renderCol('col-inprogress-cards', data.inProgress, false, false);
        renderCol('col-blocked-cards',    data.blocked,    true,  false);
        renderCol('col-done-cards',       data.done,       false, true);
        document.getElementById('tb-refresh-note').textContent =
          'Updated ' + new Date().toLocaleTimeString();
      } catch(e) {
        err.style.display = 'block';
        err.textContent = '⚠️ ' + e.message;
      }
    }

    /* ── Sync vault ── */
    async function syncVault() {
      const btn = document.getElementById('sync-btn');
      const ts  = document.getElementById('tb-sync-ts');
      btn.disabled = true; btn.textContent = '↻ Syncing…';
      try {
        const d = await fetch('/api/vault/sync', { method:'POST' }).then(r => r.json());
        if (d.ok) {
          ts.textContent = '· synced ' + new Date().toLocaleTimeString();
          await loadBoard();
        } else {
          ts.textContent = '· sync failed: ' + (d.error || d.stderr || 'unknown');
        }
      } catch(e) {
        ts.textContent = '· error: ' + e.message;
      } finally {
        btn.disabled = false; btn.textContent = '↻ Sync';
      }
    }

    /* ── Boot ── */

    /* ── Assign / start a task ── */
    async function assignTask(btn) {
      const taskId      = btn.dataset.taskId;
      const fromSection = btn.dataset.from;
      const selId       = (fromSection === 'inbox' ? 'asel-' : 'rsel-') + taskId;
      const agentKey    = document.getElementById(selId)?.value;
      if (!agentKey) { alert('Pick an agent first.'); return; }
      const origLabel = btn.textContent;
      if (btn.dataset.confirming) {
        btn.disabled = true; btn.textContent = '…';
        try {
          const r = await fetch('/api/vault/task-board/assign', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskId, agentKey, fromSection }),
          }).then(res => res.json());
          if (r.ok) {
            btn.textContent = '✓ Done';
            setTimeout(loadBoard, 1200);
          } else {
            btn.textContent = origLabel; btn.disabled = false;
            delete btn.dataset.confirming; btn.classList.remove('confirm-state');
            alert('⚠️ ' + (r.details || r.error || 'Assign failed'));
          }
        } catch (e) {
          btn.textContent = origLabel; btn.disabled = false;
          delete btn.dataset.confirming; btn.classList.remove('confirm-state');
        }
      } else {
        btn.textContent = 'Confirm →';
        btn.classList.add('confirm-state');
        btn.dataset.confirming = '1';
        setTimeout(() => {
          if (btn.dataset.confirming) {
            btn.textContent = origLabel;
            btn.classList.remove('confirm-state');
            delete btn.dataset.confirming;
          }
        }, 3000);
      }
    }


    /* ── Drag and drop ── */
    let _dragState = null;

    function initDragDrop() {
      // Drag start on cards
      document.getElementById('kanban-board').addEventListener('dragstart', e => {
        const card = e.target.closest('.kb-card[draggable]');
        if (!card) return;
        _dragState = { taskId: card.dataset.taskId, section: card.dataset.section };
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', card.dataset.taskId);
        setTimeout(() => card.classList.add('is-dragging'), 0);
      });

      document.getElementById('kanban-board').addEventListener('dragend', e => {
        document.querySelectorAll('.kb-card.is-dragging').forEach(c => c.classList.remove('is-dragging'));
        document.querySelectorAll('.kb-col-body.drag-over, .kb-col-body.drag-over-blocked').forEach(c => {
          c.classList.remove('drag-over', 'drag-over-blocked');
        });
      });

      // Delegated dragover/dragleave/drop on column bodies
      // (must use delegation — column bodies are created dynamically by loadBoard)
      const board = document.getElementById('kanban-board');

      // Resolve the nearest .kb-col-body from any element inside a column
      // (handles drops on column headers, gaps, cards, or the body itself)
      function nearestColBody(target) {
        const body = target.closest('.kb-col-body');
        if (body) return body;
        const col = target.closest('.kb-col');
        return col ? col.querySelector('.kb-col-body') : null;
      }

      board.addEventListener('dragover', e => {
        if (!_dragState) return;
        e.preventDefault(); // Must always prevent to allow drop anywhere in the board
        const col = nearestColBody(e.target);
        document.querySelectorAll('.kb-col-body').forEach(c => c.classList.remove('drag-over', 'drag-over-blocked'));
        if (!col) return;
        const target = col.dataset.section;
        col.classList.toggle('drag-over-blocked', target === 'blocked');
        col.classList.toggle('drag-over', target !== 'blocked');
      });

      board.addEventListener('dragleave', e => {
        const col = e.target.closest('.kb-col-body');
        if (!col) return;
        if (!e.relatedTarget || !col.contains(e.relatedTarget)) {
          col.classList.remove('drag-over', 'drag-over-blocked');
        }
      });

      board.addEventListener('drop', e => {
        e.preventDefault();
        document.querySelectorAll('.kb-col-body').forEach(c => c.classList.remove('drag-over', 'drag-over-blocked'));
        const col = nearestColBody(e.target);
        if (!col) return;
        if (!_dragState) return;
        const { taskId, section: from } = _dragState;
        const to = col.dataset.section;
        _dragState = null;
        if (from === to || to === 'done') return;
        showDropPanel(taskId, from, to, e.clientX, e.clientY);
      });
    }

    function showDropPanel(taskId, from, to, cx, cy) {
      const panel     = document.getElementById('drop-panel');
      const title     = document.getElementById('dp-title');
      const agentSel  = document.getElementById('dp-agent-select');
      const reasonTA  = document.getElementById('dp-reason');
      const confirmBtn= document.getElementById('dp-confirm');

      agentSel.style.display  = 'none';
      reasonTA.style.display  = 'none';
      agentSel.value = '';
      reasonTA.value = '';
      confirmBtn.disabled    = false;
      confirmBtn.textContent = 'Confirm';

      let action = null;

      if (to === 'inProgress') {
        title.textContent = from === 'inbox'
          ? '\u2192 Assign & start: ' + taskId
          : '\u21bb Reassign: ' + taskId;
        agentSel.style.display = '';
        action = async () => {
          const agentKey = agentSel.value;
          if (!agentKey) { agentSel.focus(); return; }
          const r = await fetch('/api/vault/task-board/assign', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskId, agentKey, fromSection: from }),
          }).then(r => r.json());
          if (!r.ok) throw new Error(r.details || r.error);
          closeDropPanel(); setTimeout(loadBoard, 800);
        };
      } else if (to === 'blocked') {
        title.textContent = '\u{1F6A7} Block: ' + taskId;
        reasonTA.style.display = '';
        reasonTA.focus();
        action = async () => {
          const reason = reasonTA.value.trim() || 'Manually moved to Blocked';
          const r = await fetch('/api/vault/task-board/escalate', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskId, reason }),
          }).then(r => r.json());
          if (!r.ok) throw new Error(r.details || r.error);
          closeDropPanel(); setTimeout(loadBoard, 800);
        };
      } else if (to === 'inbox') {
        title.textContent = '\u21a9 Return to Inbox: ' + taskId;
        action = async () => {
          const r = await fetch('/api/vault/task-board/return-to-inbox', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskId, fromSection: from }),
          }).then(r => r.json());
          if (!r.ok) throw new Error(r.details || r.error);
          closeDropPanel(); setTimeout(loadBoard, 800);
        };
      } else {
        return; // unsupported transition
      }

      confirmBtn.onclick = async () => {
        confirmBtn.disabled = true; confirmBtn.textContent = '\u2026';
        try {
          await action();
        } catch (err) {
          confirmBtn.disabled = false; confirmBtn.textContent = 'Confirm';
          alert('\u26a0\ufe0f ' + err.message);
        }
      };

      // Position panel near drop point, keep inside viewport
      const W = window.innerWidth, H = window.innerHeight;
      let left = cx + 8, top = cy - 20;
      panel.style.display = 'block'; // temp show to measure
      const pw = panel.offsetWidth || 260, ph = panel.offsetHeight || 150;
      panel.style.display = '';
      if (left + pw > W - 12) left = W - pw - 12;
      if (top + ph > H - 12) top = H - ph - 12;
      if (top < 8) top = 8;
      panel.style.left = left + 'px';
      panel.style.top  = top  + 'px';
      panel.classList.add('open');
    }

    function closeDropPanel() {
      document.getElementById('drop-panel').classList.remove('open');
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDropPanel(); });
    document.addEventListener('mousedown', e => {
      const panel = document.getElementById('drop-panel');
      if (panel.classList.contains('open') && !panel.contains(e.target)) closeDropPanel();
    });

    initDragDrop();
    loadBoard();
    setInterval(loadBoard, 60000);

    /* ── Mobile column tabs ── */
    (function () {
      if (window.innerWidth > 820) return;
      var board = document.getElementById('kanban-board');
      var tabs  = ['inbox','inprogress','blocked','done'].map(function(k) {
        return document.getElementById('ktab-' + k);
      });

      function setActive(idx) {
        tabs.forEach(function (t, i) { if (t) t.classList.toggle('active', i === idx); });
      }

      // Tap a tab → scroll to that column
      tabs.forEach(function (tab, i) {
        if (!tab) return;
        tab.addEventListener('click', function () {
          board.scrollTo({ left: i * board.clientWidth, behavior: 'smooth' });
          setActive(i);
        });
      });

      // Swipe → sync active tab
      board.addEventListener('scroll', function () {
        var idx = Math.round(board.scrollLeft / Math.max(1, board.clientWidth));
        setActive(Math.max(0, Math.min(tabs.length - 1, idx)));
      }, { passive: true });
    })();
    /* ── Filter from URL param (?filter=inbox|inprogress|blocked|done) ── */
    (function () {
      var params = new URLSearchParams(window.location.search);
      var filter = (params.get('filter') || '').toLowerCase();
      if (!filter) return;
      var colOrder = ['inbox', 'inprogress', 'blocked', 'done'];
      var idx = colOrder.indexOf(filter);
      if (idx < 0) return;
      var board = document.getElementById('kanban-board');
      // Mobile: snap to column + activate tab
      if (board && window.innerWidth <= 820) {
        setTimeout(function () {
          board.scrollTo({ left: idx * board.clientWidth, behavior: 'instant' });
          colOrder.forEach(function (k, i) {
            var t = document.getElementById('ktab-' + k);
            if (t) t.classList.toggle('active', i === idx);
          });
        }, 120);
      }
      // Desktop: briefly glow the target column
      if (window.innerWidth > 820) {
        setTimeout(function () {
          var cls = filter === 'inprogress' ? '.col-inprogress' : '.col-' + filter;
          var col = document.querySelector(cls);
          if (col) {
            col.style.transition = 'box-shadow 0.4s';
            col.style.boxShadow  = '0 0 0 2px rgba(96,165,250,0.55)';
            setTimeout(function () { col.style.boxShadow = ''; }, 1800);
          }
        }, 600);
      }
    })();

    fetch('/api/vault/status').then(r=>r.json()).then(d=>{
      if (d.lastSyncAt)
        document.getElementById('tb-sync-ts').textContent =
          '· synced ' + new Date(d.lastSyncAt).toLocaleTimeString();
    }).catch(()=>{});
  </script>
<div id="drop-panel">
    <h4 id="dp-title"></h4>
    <select id="dp-agent-select" style="display:none">
      <option value="">Pick agent…</option>
      <option value="spike">Spike</option>
      <option value="steve">Steve</option>
      <option value="lex">Lex</option>
      <option value="bill">Bill</option>
    </select>
    <textarea id="dp-reason" placeholder="Reason for blocking…" style="display:none"></textarea>
    <div class="dp-actions">
      <button class="dp-confirm" id="dp-confirm">Confirm</button>
      <button class="dp-cancel" onclick="closeDropPanel()">Cancel</button>
    </div>
  </div>
</body>
