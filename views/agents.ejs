<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
<style>
  .zone-badge { display:inline-block;padding:1px 7px;border-radius:8px;font-size:10px;font-weight:700;vertical-align:middle;margin-left:4px; }
  .zbadge-localhost   { background:rgba(99,102,241,.15);color:#a5b4fc; }
  .zbadge-localnet    { background:rgba(16,185,129,.12);color:#6ee7b7; }
  .zbadge-private_wan { background:rgba(245,158,11,.12);color:#fcd34d; }
  .zbadge-public_wan  { background:rgba(239,68,68,.12); color:#fca5a5; }
  .zbadge-unknown     { background:rgba(75,85,99,.15);  color:#9ca3af; }
</style>

  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">AGENT DASHBOARD</span></a></div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>
  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/agents' }) %>
    <main class="oc-dashboard-area">
      <div class="oc-data-wrap">
        <div class="oc-table-toolbar">
          <input type="search" id="q" class="oc-search-input" placeholder="Search agents…">
          <select id="f-type" class="oc-filter-select">
            <option value="">All types</option>
            <option value="OpenClaw">OpenClaw</option>
            <option value="Claude Cowork">Claude Cowork</option>
            <option value="Cursor">Cursor</option>
            <option value="ChatGPT">ChatGPT</option>
          </select>
          <select id="f-status" class="oc-filter-select">
            <option value="">All statuses</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Unknown">Unknown</option>
          </select>
          <span class="oc-count-badge" id="row-count">–</span>
        </div>
        <div class="oc-table-scroll">
        <table class="oc-data-table" id="agents-tbl">
          <thead><tr>
            <th data-sort="name">Agent</th>
            <th data-sort="type">Type</th>
            <th data-sort="machine">Machine</th>
            <th data-sort="role">Role</th>
            <th data-sort="hbDate">Heartbeat</th>
            <th data-sort="statusLabel">Status</th>
            <th data-sort="since">Since</th>
            <th class="no-sort">Actions</th>
          </tr></thead>
          <tbody id="agents-tbody">
            <tr><td colspan="8" style="text-align:center;color:#4b5563;padding:1.5rem">Loading…</td></tr>
          </tbody>
        </table>
        </div>
      </div>
    </main>
  </div>
  <script>
    /* ── sidebar/theme ── */
    (function(){
      const sb=document.getElementById('oc-sidebar'),btn=document.getElementById('sidebar-toggle');
      let col=localStorage.getItem('overclaw-sidebar-collapsed')==='true';
      if(col)sb.classList.add('collapsed');
      btn.addEventListener('click',()=>{col=!col;sb.classList.toggle('collapsed',col);localStorage.setItem('overclaw-sidebar-collapsed',col);});
      const th=document.getElementById('theme-toggle');
      let tm=localStorage.getItem('overclaw-theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
      document.body.classList.add(tm+'-mode');th.textContent=tm==='dark'?'🌙':'☀️';
      th.addEventListener('click',()=>{tm=tm==='light'?'dark':'light';document.body.classList.toggle('light-mode',tm==='light');document.body.classList.toggle('dark-mode',tm==='dark');localStorage.setItem('overclaw-theme',tm);th.textContent=tm==='dark'?'🌙':'☀️';});
    })();

    const AGENT_META = {
      Spike: {emoji:'🦞',color:'#f97316'},
      Steve: {emoji:'📈',color:'#3b82f6'},
      Lex:   {emoji:'💻',color:'#a855f7'},
      Bill:  {emoji:'🐟',color:'#10b981'},
      Luther:{emoji:'🤖',color:'#eab308'},
    };
    const HB_KEY = {Spike:'OpenClaw',Steve:'BrightMove-MBP',Lex:'BrightMove-MBP/Cursor',Bill:'H2FClanker1',Luther:'Grok-Bot'};

    function timeAgo(d){
      if(!d)return null;
      const ms=Date.now()-new Date(d).getTime(),h=ms/3600000;
      if(h<1)return Math.round(ms/60000)+'m ago';
      if(h<24)return Math.round(h)+'h ago';
      if(h<48)return 'yesterday';
      if(h<168)return Math.round(h/24)+'d ago';
      return Math.round(h/168)+'w ago';
    }
    function hbDot(d){
      if(!d)return 'gray';
      const h=(Date.now()-new Date(d).getTime())/3600000;
      return h<24?'green':h<72?'yellow':'red';
    }
    function badgeCls(s){
      if(!s)return 'badge-unknown';
      const l=s.toLowerCase();
      if(l.includes('active'))return 'badge-active';
      if(l.includes('inactive')||l.includes('offline'))return 'badge-inactive';
      return 'badge-unknown';
    }

    let rows=[], sortKey='name', sortDir=1, filterType='', filterStatus='', searchQ='';

    function applyAndRender(){
      let vis=rows.filter(r=>{
        if(searchQ){
          const h=[r.name,r.type,r.machine,r.role,r.statusLabel,r.since].join(' ').toLowerCase();
          if(!h.includes(searchQ))return false;
        }
        if(filterType && r.type!==filterType)return false;
        if(filterStatus && r.statusLabel!==filterStatus)return false;
        return true;
      });
      if(sortKey){
        vis=[...vis].sort((a,b)=>{
          const va=String(a[sortKey]||'').toLowerCase(),vb=String(b[sortKey]||'').toLowerCase();
          return sortDir*va.localeCompare(vb);
        });
      }
      const tbody=document.getElementById('agents-tbody');
      tbody.innerHTML=vis.length ? vis.map(r=>`
        <tr>
          <td><div class="oc-row-name">
            <span style="font-size:1.1rem;color:${r.color}">${r.emoji}</span>
            <span style="font-weight:700;color:${r.color}">${r.name}</span>
            ${r.zone ? `<span class="zone-badge zbadge-${r.zone}">${r.zone.replace('_',' ')}</span>` : ''}
          </div></td>
          <td class="${r.type?'':'dim'}">${r.type||'—'}</td>
          <td style="font-size:.75rem;color:#9ca3af">${r.machine||'—'}</td>
          <td style="max-width:180px;font-size:.75rem;color:#9ca3af">${r.role||'—'}</td>
          <td style="white-space:nowrap;font-size:.78rem">
            <span class="oc-hb-dot ${r.hbDot}"></span>${r.hbAgo||'<span style="color:#374151;font-style:italic">never</span>'}
          </td>
          <td><span class="oc-badge ${r.statusCls}">${r.statusLabel}</span></td>
          <td class="dim" style="font-size:.73rem">${r.since||'—'}</td>
          <td><div class="oc-action-btns">
            <a href="/activity?agent=${encodeURIComponent(r.name)}" class="oc-action-btn">📡 Activity</a>
            <a href="/vault/doc?path=${encodeURIComponent('03 - Agents/Agent Registry.md')}" class="oc-action-btn">📋 Registry</a>
            <button class="oc-action-btn" onclick="showOnboarding(this.dataset.agent)" data-agent="${r.name}">🚀 Onboard</button>
          </div></td>
        </tr>`).join('')
        : '<tr class="oc-empty-row"><td colspan="8">No agents match the current filters.</td></tr>';
      document.getElementById('row-count').textContent=vis.length+' / '+rows.length;
      document.querySelectorAll('#agents-tbl th[data-sort]').forEach(th=>{
        th.classList.remove('sort-asc','sort-desc');
        if(th.dataset.sort===sortKey)th.classList.add(sortDir>0?'sort-asc':'sort-desc');
      });
    }

    document.addEventListener('click',e=>{
      const th=e.target.closest('#agents-tbl th[data-sort]');
      if(!th)return;
      const k=th.dataset.sort;
      if(sortKey===k)sortDir*=-1;else{sortKey=k;sortDir=1;}
      applyAndRender();
    });
    document.getElementById('q').addEventListener('input',e=>{searchQ=e.target.value.toLowerCase().trim();applyAndRender();});
    document.getElementById('f-type').addEventListener('change',e=>{filterType=e.target.value;applyAndRender();});
    document.getElementById('f-status').addEventListener('change',e=>{filterStatus=e.target.value;applyAndRender();});

    async function load(){
      try{
        const [agents,summary,cfg]=await Promise.all([
          fetch('/api/vault/agents').then(r=>r.json()),
          fetch('/api/swarm/summary').then(r=>r.json()),
          fetch('/api/overclaw-config').then(r=>r.json()),
        ]);
        const agentZones = cfg.agentZones || {};
        const hbMap=summary.lastHeartbeat||{};
        rows=agents.map(a=>{
          const name=a.nickname||a.agent||'Agent';
          const meta=AGENT_META[name]||{emoji:'🤖',color:'#6b7280'};
          const hb=hbMap[HB_KEY[name]];
          const hbDate=hb?hb.date||null:null;
          const statusRaw=a.status||'';
          const statusLabel=statusRaw.replace(/^[^\w]*/,'').trim()||'Unknown';
          return{
            name,emoji:meta.emoji,color:meta.color,
            type:a.type||'',
            machine:a.machine||'',
            role:(a.primary_role||a.role||'').split(' — ')[0]||'',
            statusLabel,statusCls:badgeCls(statusRaw),
            hbDate:hbDate||'',hbAgo:timeAgo(hbDate)||null,hbDot:hbDot(hbDate),
            since:a.registered||'',
            zone: agentZones[name.toLowerCase()] || '',
          };
        });
        applyAndRender();
      }catch(e){
        document.getElementById('agents-tbody').innerHTML=
          `<tr><td colspan="8" style="color:#f87171;padding:1rem">⚠️ Failed to load: ${e.message}</td></tr>`;
      }
    }
    load();
  </script>

<!-- ── Onboarding Modal ──────────────────────────────────────────────────── -->
<div id="onboardModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:500;align-items:center;justify-content:center;">
  <div style="background:#12122a;border:1px solid #2a2a4a;border-radius:12px;width:min(720px,94vw);max-height:88vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 16px 48px rgba(0,0,0,.6)">
    <div style="padding:14px 18px;border-bottom:1px solid #2a2a4a;display:flex;align-items:center;gap:10px">
      <span style="font-size:1.25rem">🚀</span>
      <span id="onboardTitle" style="font-weight:700;color:#e2e8f0;font-size:1rem;flex:1">Onboarding Snippet</span>
      <button onclick="closeOnboard()" style="background:#1f1f3a;border:1px solid #374151;border-radius:6px;color:#aaa;padding:4px 10px;cursor:pointer;font-size:12px">✕ Close</button>
    </div>
    <div style="padding:12px 18px;border-bottom:1px solid #1e1e38;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <span style="font-size:12px;color:#9098b8">Copy this snippet and paste it into the agent's context at session start, or use the MCP connection details below.</span>
      <button onclick="copySnippet()" style="margin-left:auto;background:#6366f1;border:none;border-radius:6px;color:#fff;padding:5px 14px;cursor:pointer;font-size:12px;font-weight:600">📋 Copy All</button>
    </div>
    <div style="flex:1;overflow-y:auto;padding:16px 18px">
      <div id="onboardLoading" style="text-align:center;padding:24px;color:#555">Loading…</div>
      <pre id="onboardSnippet" style="display:none;white-space:pre-wrap;word-break:break-word;background:#0c0c1a;border:1px solid #2a2a4a;border-radius:8px;padding:16px;font-family:'DM Mono','Fira Code',monospace;font-size:12.5px;color:#c8d4e8;line-height:1.7;margin:0"></pre>
    </div>
    <div style="padding:10px 18px;border-top:1px solid #2a2a4a;display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <a id="onboardBrainLink" href="#" target="_blank" style="font-size:11px;color:#818cf8">📚 Open Brain README</a>
      <span style="color:#374151;font-size:11px">·</span>
      <a href="/swarm" style="font-size:11px;color:#818cf8">🌐 Swarm Overview</a>
      <span style="color:#374151;font-size:11px">·</span>
      <a href="/brain?path=03%20-%20Agents%2FAgent%20Registry.md" style="font-size:11px;color:#818cf8">📋 Agent Registry</a>
    </div>
  </div>
</div>

<script>
async function showOnboarding(agentName) {
  const modal = document.getElementById('onboardModal');
  modal.style.display = 'flex';
  document.getElementById('onboardTitle').textContent = '🚀 Onboarding — ' + agentName;
  document.getElementById('onboardLoading').style.display = 'block';
  document.getElementById('onboardSnippet').style.display = 'none';
  document.getElementById('onboardBrainLink').href = 'http://192.168.68.42:8355/brain?path=README.md';

  try {
    const r = await fetch('/api/agents/onboarding-snippet?agent=' + encodeURIComponent(agentName.toLowerCase()));
    const d = await r.json();
    document.getElementById('onboardSnippet').textContent = d.snippet || '(no snippet)';
    document.getElementById('onboardLoading').style.display = 'none';
    document.getElementById('onboardSnippet').style.display = 'block';
  } catch(e) {
    document.getElementById('onboardLoading').textContent = '❌ Failed to load: ' + e.message;
  }
}

function closeOnboard() {
  document.getElementById('onboardModal').style.display = 'none';
}

function copySnippet() {
  const text = document.getElementById('onboardSnippet').textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.querySelector('#onboardModal button[onclick="copySnippet()"]');
    const orig = btn.textContent;
    btn.textContent = '✅ Copied!';
    setTimeout(() => btn.textContent = orig, 1800);
  }).catch(() => {
    const el = document.getElementById('onboardSnippet');
    const range = document.createRange();
    range.selectNodeContents(el);
    window.getSelection().removeAllRanges();
    window.getSelection().addRange(range);
  });
}

// Close on backdrop click
document.getElementById('onboardModal').addEventListener('click', function(e) {
  if (e.target === this) closeOnboard();
});
// Close on Escape
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeOnboard(); });
</script>

</body>
</html>
