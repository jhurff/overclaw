<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
        <aside class="oc-sidebar" id="oc-sidebar">
            <nav>
                <div class="nav-group-title">Control</div>
                <ul>
                    <li><a href="/"><span class="icon">🏠</span>Dashboard</a></li>
                    <li><a href="/sessions"><span class="icon">💬</span>Sessions</a></li>
                    <li><a href="/cron-jobs"><span class="icon">⏰</span>Cron Jobs</a></li>
                </ul>
                <div class="nav-group-title">Agent</div>
                <ul>
                    <li><a href="/agents" class="active"><span class="icon">🤖</span>Agents</a></li>
                    <li><a href="/skills"><span class="icon">🧠</span>Skills</a></li>
                    <li><a href="/nodes"><span class="icon">🖥️</span>Nodes</a></li>
                </ul>
                <div class="nav-group-title">Settings</div>
                <ul>
                    <li><a href="/config"><span class="icon">⚙️</span>Config</a></li>
                    <li><a href="/logs"><span class="icon">📜</span>Logs</a></li>
                    <li><a href="/debug"><span class="icon">🐛</span>Debug</a></li>
                </ul>
                <div class="nav-group-title">Resources</div>
                <ul>
                    <li><a href="/docs"><span class="icon">📚</span>Docs</a></li>
                </ul>
            </nav>
        </aside>

        <main class="oc-dashboard-area">
            <div class="oc-card full-width">
                <h2>OpenClaw Agents Overview</h2>
                <div id="agents-detail-list">
                    <p>Loading detailed agent information...</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');

        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed');
        }

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
            } else {
                sidebar.classList.remove('collapsed');
            }
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");

        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        if (currentTheme === 'dark') {
            themeToggle.textContent = '🌙';
        } else {
            themeToggle.textContent = '☀️';
        }

        themeToggle.addEventListener('click', () => {
            currentTheme = (currentTheme === 'light') ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggle.textContent = '🌙';
            } else {
                themeToggle.textContent = '☀️';
            }
        });

        prefersDarkScheme.addEventListener('change', (e) => {
            if (!localStorage.getItem('overclaw-theme')) {
                currentTheme = e.matches ? 'dark' : 'light';
                document.body.classList.toggle('light-mode', currentTheme === 'light');
                document.body.classList.toggle('dark-mode', currentTheme === 'dark');
                if (currentTheme === 'dark') {
                    themeToggle.textContent = '🌙';
                } else {
                    themeToggle.textContent = '☀️';
                }
            }
        });

        // --- Fetch Agent and Session Data ---
        async function fetchAgentDetails() {
            const agentsDetailListDiv = document.getElementById('agents-detail-list');
            try {
                // Fetch agents list for names and IDs
                const agentsResponse = await fetch('/api/agents');
                const agents = await agentsResponse.json();

                if (agents.error) {
                    agentsDetailListDiv.innerHTML = `<p style="color: red;">Error fetching agents: ${agents.error}</p>`;
                    return;
                }

                // Fetch session details for status and last activity
                const sessionsResponse = await fetch('/api/sessions-detail');
                const sessions = await sessionsResponse.json();

                if (sessions.error) {
                    agentsDetailListDiv.innerHTML = `<p style="color: red;">Error fetching sessions: ${sessions.error}</p>`;
                    return;
                }

                // Combine agent and session data
                const combinedData = agents.map(agent => {
                    const agentSessions = sessions.filter(session => session.agentId === agent.id);
                    const lastActivity = agentSessions.length > 0 
                        ? new Date(Math.max(...agentSessions.map(s => s.updatedAtMs))).toLocaleString() 
                        : 'N/A';
                    const activeSessionsCount = agentSessions.filter(s => s.active).length;
                    const lastMessage = agentSessions.length > 0 ? agentSessions[0].lastMessage?.message : 'N/A'; // Assuming newest session first

                    return {
                        ...agent,
                        lastActivity,
                        activeSessionsCount,
                        lastMessage,
                        // Add more details from sessions if needed, e.g., current task from message history
                    };
                });

                if (combinedData.length === 0) {
                    agentsDetailListDiv.innerHTML = '<p>No detailed agent information available.</p>';
                    return;
                }

                const ul = document.createElement('ul');
                ul.style.listStyle = 'none';
                ul.style.paddingLeft = '0';
                combinedData.forEach(agent => {
                    const li = document.createElement('li');
                    li.className = 'oc-card-item'; // Add a class for styling
                    li.innerHTML = `
                        <h3><span class="icon">🤖</span> ${agent.name} (ID: <code>${agent.id}</code>)</h3>
                        <p><strong>Active Sessions:</strong> ${agent.activeSessionsCount}</p>
                        <p><strong>Last Activity:</strong> ${agent.lastActivity}</p>
                        <p><strong>Last Message:</strong> ${agent.lastMessage}</p>
                        <!-- Add more details here -->
                    `;
                    ul.appendChild(li);
                });
                agentsDetailListDiv.innerHTML = '';
                agentsDetailListDiv.appendChild(ul);

            } catch (error) {
                console.error('Error fetching agent details:', error);
                agentsDetailListDiv.innerHTML = '<p style="color: red;">Failed to load detailed agent data.</p>';
            }
        }

        document.addEventListener('DOMContentLoaded', fetchAgentDetails);
    </script>
</body>
</html>
