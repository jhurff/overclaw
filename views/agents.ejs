<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
<%- include('partials/sidebar', { currentPath: '/agents' }) %>

        <main class="oc-dashboard-area">
          <style>
            .sw-section { font-size:.7rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#4b5563; padding:.6rem 0 .5rem; border-bottom:1px solid #1f2937; margin-bottom:.75rem; }
            .sw-section:first-of-type { margin-top:0; }

            .roster-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:.75rem; }

            .persona-card {
              background:#111827; border:1px solid #1f2937; border-radius:10px;
              padding:1rem 1.1rem; display:flex; flex-direction:column; gap:.3rem;
              border-top:3px solid var(--ac,#374151);
            }
            .pc-header { display:flex; align-items:flex-start; gap:.6rem; }
            .pc-emoji  { font-size:1.6rem; line-height:1; flex-shrink:0; }
            .pc-name   { font-size:1.05rem; font-weight:800; color:var(--ac,#e2e8f0); }
            .pc-type   { font-size:.68rem; color:#6b7280; text-transform:uppercase; letter-spacing:.06em; }
            .pc-machine{ font-size:.74rem; color:#9ca3af; margin-top:.1rem; }
            .pc-role-title  { font-size:.78rem; font-weight:600; color:#cbd5e1; margin-top:.25rem; }
            .pc-role-detail { font-size:.73rem; color:#6b7280; line-height:1.4;
              display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
            .pc-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.3rem; margin-top:.45rem; }
            .pc-reg    { font-size:.67rem; color:#374151; }
            .pc-links  { display:flex; gap:.35rem; }
            .pc-link   { font-size:.69rem; color:#6b7280; text-decoration:none; padding:2px 6px; border-radius:4px; border:1px solid #1f2937; }
            .pc-link:hover { color:#e2e8f0; border-color:#374151; }
            .pc-badge  { font-size:.64rem; font-weight:600; padding:1px 7px; border-radius:9999px; white-space:nowrap; margin-left:auto; flex-shrink:0; }
            .badge-active   { background:#14532d; color:#86efac; }
            .badge-inactive { background:#7f1d1d; color:#fca5a5; }
            .badge-unknown  { background:#1f2937; color:#6b7280; }
            #agents-err { display:none; color:#f87171; font-size:.82rem; margin-bottom:.5rem; }
          </style>

          <div class="sw-section">🤖 Swarm Roster</div>
          <div id="agents-err"></div>
          <div class="roster-grid" id="roster-grid">
            <div style="color:#4b5563;font-size:.8rem;">Loading…</div>
          </div>
        </main>
    </div>

    <script>
      /* ── sidebar/theme boilerplate ── */
      (function(){
        const sb = document.getElementById('oc-sidebar');
        const btn = document.getElementById('sidebar-toggle');
        let col = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if(col) sb.classList.add('collapsed');
        btn.addEventListener('click',()=>{ col=!col; sb.classList.toggle('collapsed',col); localStorage.setItem('overclaw-sidebar-collapsed',col); });
        const th = document.getElementById('theme-toggle');
        let tm = localStorage.getItem('overclaw-theme') || (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
        document.body.classList.add(tm+'-mode'); th.textContent = tm==='dark'?'🌙':'☀️';
        th.addEventListener('click',()=>{ tm=tm==='light'?'dark':'light'; document.body.classList.toggle('light-mode',tm==='light'); document.body.classList.toggle('dark-mode',tm==='dark'); localStorage.setItem('overclaw-theme',tm); th.textContent=tm==='dark'?'🌙':'☀️'; });
      })();

      /* ── Agents roster ── */
      const AGENT_META = {
        Spike: { emoji:'🦞', color:'#f97316' },
        Steve: { emoji:'📈', color:'#3b82f6' },
        Lex:   { emoji:'💻', color:'#a855f7' },
        Bill:  { emoji:'🐟', color:'#10b981' },
      };

      function badgeCls(s) {
        if (!s) return 'badge-unknown';
        const l = s.toLowerCase();
        if (l.includes('active')) return 'badge-active';
        if (l.includes('inactive') || l.includes('offline')) return 'badge-inactive';
        return 'badge-unknown';
      }
      function badgeText(s) {
        return (s||'Unknown').replace(/^[^\w]*/,'').trim();
      }

      async function loadRoster() {
        const grid = document.getElementById('roster-grid');
        const err  = document.getElementById('agents-err');
        try {
          const data = await fetch('/api/vault/agents').then(r => r.json());
          if (!Array.isArray(data) || !data.length) {
            grid.innerHTML = '<div style="color:#6b7280;font-size:.8rem;">No agents in registry.</div>';
            return;
          }
          grid.innerHTML = data.map(a => {
            const name    = a.nickname || a.agent || 'Agent';
            const meta    = AGENT_META[name] || { emoji:'🤖', color:'#6b7280' };
            const parts   = (a.primary_role || a.role || '').split(' — ');
            const roleT   = parts[0] ? parts[0].trim() : '';
            const roleD   = parts.slice(1).join(' — ').trim();
            return `<div class="persona-card" style="--ac:${meta.color}">
              <div class="pc-header">
                <span class="pc-emoji">${meta.emoji}</span>
                <div style="flex:1;min-width:0">
                  <div class="pc-name">${name}</div>
                  <div class="pc-type">${a.type || 'AI Agent'}</div>
                </div>
                <span class="pc-badge ${badgeCls(a.status)}">${badgeText(a.status)}</span>
              </div>
              <div class="pc-machine">💻 ${a.machine || '—'}</div>
              ${roleT   ? `<div class="pc-role-title">${roleT}</div>` : ''}
              ${roleD   ? `<div class="pc-role-detail">${roleD}</div>` : ''}
              <div class="pc-footer">
                <span class="pc-reg">Since ${a.registered || '—'}</span>
                <div class="pc-links">
                  <a href="/activity?agent=${encodeURIComponent(name)}" class="pc-link">📡 Activity</a>
                  <a href="/vault/doc?path=${encodeURIComponent('03 - Agents/Agent Registry.md')}" class="pc-link">📋 Registry</a>
                </div>
              </div>
            </div>`;
          }).join('');
        } catch(e) {
          err.style.display = 'block';
          err.textContent   = '⚠️ Failed to load agents: ' + e.message;
          grid.innerHTML    = '';
        }
      }
      loadRoster();
    </script>
</body>
</html>
