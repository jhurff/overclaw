<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">AGENT DASHBOARD</span></a></div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>
  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/agents' }) %>
    <main class="oc-dashboard-area">
      <div class="oc-data-wrap">
        <div class="oc-table-toolbar">
          <input type="search" id="q" class="oc-search-input" placeholder="Search agents…">
          <select id="f-type" class="oc-filter-select">
            <option value="">All types</option>
            <option value="OpenClaw">OpenClaw</option>
            <option value="Claude Cowork">Claude Cowork</option>
            <option value="Cursor">Cursor</option>
            <option value="ChatGPT">ChatGPT</option>
          </select>
          <select id="f-status" class="oc-filter-select">
            <option value="">All statuses</option>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
            <option value="Unknown">Unknown</option>
          </select>
          <span class="oc-count-badge" id="row-count">–</span>
        </div>
        <div class="oc-table-scroll">
        <table class="oc-data-table" id="agents-tbl">
          <thead><tr>
            <th data-sort="name">Agent</th>
            <th data-sort="type">Type</th>
            <th data-sort="machine">Machine</th>
            <th data-sort="role">Role</th>
            <th data-sort="hbDate">Heartbeat</th>
            <th data-sort="statusLabel">Status</th>
            <th data-sort="since">Since</th>
            <th class="no-sort">Actions</th>
          </tr></thead>
          <tbody id="agents-tbody">
            <tr><td colspan="8" style="text-align:center;color:#4b5563;padding:1.5rem">Loading…</td></tr>
          </tbody>
        </table>
        </div>
      </div>
    </main>
  </div>
  <script>
    /* ── sidebar/theme ── */
    (function(){
      const sb=document.getElementById('oc-sidebar'),btn=document.getElementById('sidebar-toggle');
      let col=localStorage.getItem('overclaw-sidebar-collapsed')==='true';
      if(col)sb.classList.add('collapsed');
      btn.addEventListener('click',()=>{col=!col;sb.classList.toggle('collapsed',col);localStorage.setItem('overclaw-sidebar-collapsed',col);});
      const th=document.getElementById('theme-toggle');
      let tm=localStorage.getItem('overclaw-theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
      document.body.classList.add(tm+'-mode');th.textContent=tm==='dark'?'🌙':'☀️';
      th.addEventListener('click',()=>{tm=tm==='light'?'dark':'light';document.body.classList.toggle('light-mode',tm==='light');document.body.classList.toggle('dark-mode',tm==='dark');localStorage.setItem('overclaw-theme',tm);th.textContent=tm==='dark'?'🌙':'☀️';});
    })();

    const AGENT_META = {
      Spike:{emoji:'🦞',color:'#f97316'},
      Steve:{emoji:'📈',color:'#3b82f6'},
      Lex:  {emoji:'💻',color:'#a855f7'},
      Bill: {emoji:'🐟',color:'#10b981'},
    };
    const HB_KEY = {Spike:'OpenClaw',Steve:'BrightMove-MBP',Lex:'BrightMove-MBP/Cursor',Bill:'H2FClanker1'};

    function timeAgo(d){
      if(!d)return null;
      const ms=Date.now()-new Date(d).getTime(),h=ms/3600000;
      if(h<1)return Math.round(ms/60000)+'m ago';
      if(h<24)return Math.round(h)+'h ago';
      if(h<48)return 'yesterday';
      if(h<168)return Math.round(h/24)+'d ago';
      return Math.round(h/168)+'w ago';
    }
    function hbDot(d){
      if(!d)return 'gray';
      const h=(Date.now()-new Date(d).getTime())/3600000;
      return h<24?'green':h<72?'yellow':'red';
    }
    function badgeCls(s){
      if(!s)return 'badge-unknown';
      const l=s.toLowerCase();
      if(l.includes('active'))return 'badge-active';
      if(l.includes('inactive')||l.includes('offline'))return 'badge-inactive';
      return 'badge-unknown';
    }

    let rows=[], sortKey='name', sortDir=1, filterType='', filterStatus='', searchQ='';

    function applyAndRender(){
      let vis=rows.filter(r=>{
        if(searchQ){
          const h=[r.name,r.type,r.machine,r.role,r.statusLabel,r.since].join(' ').toLowerCase();
          if(!h.includes(searchQ))return false;
        }
        if(filterType && r.type!==filterType)return false;
        if(filterStatus && r.statusLabel!==filterStatus)return false;
        return true;
      });
      if(sortKey){
        vis=[...vis].sort((a,b)=>{
          const va=String(a[sortKey]||'').toLowerCase(),vb=String(b[sortKey]||'').toLowerCase();
          return sortDir*va.localeCompare(vb);
        });
      }
      const tbody=document.getElementById('agents-tbody');
      tbody.innerHTML=vis.length ? vis.map(r=>`
        <tr>
          <td><div class="oc-row-name">
            <span style="font-size:1.1rem;color:${r.color}">${r.emoji}</span>
            <span style="font-weight:700;color:${r.color}">${r.name}</span>
          </div></td>
          <td class="${r.type?'':'dim'}">${r.type||'—'}</td>
          <td style="font-size:.75rem;color:#9ca3af">${r.machine||'—'}</td>
          <td style="max-width:180px;font-size:.75rem;color:#9ca3af">${r.role||'—'}</td>
          <td style="white-space:nowrap;font-size:.78rem">
            <span class="oc-hb-dot ${r.hbDot}"></span>${r.hbAgo||'<span style="color:#374151;font-style:italic">never</span>'}
          </td>
          <td><span class="oc-badge ${r.statusCls}">${r.statusLabel}</span></td>
          <td class="dim" style="font-size:.73rem">${r.since||'—'}</td>
          <td><div class="oc-action-btns">
            <a href="/activity?agent=${encodeURIComponent(r.name)}" class="oc-action-btn">📡 Activity</a>
            <a href="/vault/doc?path=${encodeURIComponent('03 - Agents/Agent Registry.md')}" class="oc-action-btn">📋 Registry</a>
          </div></td>
        </tr>`).join('')
        : '<tr class="oc-empty-row"><td colspan="8">No agents match the current filters.</td></tr>';
      document.getElementById('row-count').textContent=vis.length+' / '+rows.length;
      document.querySelectorAll('#agents-tbl th[data-sort]').forEach(th=>{
        th.classList.remove('sort-asc','sort-desc');
        if(th.dataset.sort===sortKey)th.classList.add(sortDir>0?'sort-asc':'sort-desc');
      });
    }

    document.addEventListener('click',e=>{
      const th=e.target.closest('#agents-tbl th[data-sort]');
      if(!th)return;
      const k=th.dataset.sort;
      if(sortKey===k)sortDir*=-1;else{sortKey=k;sortDir=1;}
      applyAndRender();
    });
    document.getElementById('q').addEventListener('input',e=>{searchQ=e.target.value.toLowerCase().trim();applyAndRender();});
    document.getElementById('f-type').addEventListener('change',e=>{filterType=e.target.value;applyAndRender();});
    document.getElementById('f-status').addEventListener('change',e=>{filterStatus=e.target.value;applyAndRender();});

    async function load(){
      try{
        const [agents,summary]=await Promise.all([
          fetch('/api/vault/agents').then(r=>r.json()),
          fetch('/api/swarm/summary').then(r=>r.json()),
        ]);
        const hbMap=summary.lastHeartbeat||{};
        rows=agents.map(a=>{
          const name=a.nickname||a.agent||'Agent';
          const meta=AGENT_META[name]||{emoji:'🤖',color:'#6b7280'};
          const hb=hbMap[HB_KEY[name]];
          const hbDate=hb?hb.date||null:null;
          const statusRaw=a.status||'';
          const statusLabel=statusRaw.replace(/^[^\w]*/,'').trim()||'Unknown';
          return{
            name,emoji:meta.emoji,color:meta.color,
            type:a.type||'',
            machine:a.machine||'',
            role:(a.primary_role||a.role||'').split(' — ')[0]||'',
            statusLabel,statusCls:badgeCls(statusRaw),
            hbDate:hbDate||'',hbAgo:timeAgo(hbDate)||null,hbDot:hbDot(hbDate),
            since:a.registered||'',
          };
        });
        applyAndRender();
      }catch(e){
        document.getElementById('agents-tbody').innerHTML=
          `<tr><td colspan="8" style="color:#f87171;padding:1rem">⚠️ Failed to load: ${e.message}</td></tr>`;
      }
    }
    load();
  </script>
</body>
</html>
