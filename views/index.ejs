<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <!-- Using Google Fonts for DM Sans and Outfit, similar to OpenClaw -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Placeholder for icons, e.g., using Font Awesome for now or simple SVG -->
    <!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> -->
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button> <!-- Placeholder for theme toggle -->
        </div>
    </header>

    <div class="oc-main-content">
        <aside class="oc-sidebar" id="oc-sidebar">
            <nav>
                <div class="nav-group-title">Control</div>
                <ul>
                    <li><a href="/" class="active"><span class="icon">🏠</span>Dashboard</a></li>
                    <li><a href="/sessions"><span class="icon">💬</span>Sessions</a></li>
                    <li><a href="/cron-jobs"><span class="icon">⏰</span>Cron Jobs</a></li>
                </ul>
                <div class="nav-group-title">Agent</div>
                <ul>
                    <li><a href="/agents"><span class="icon">🤖</span>Agents</a></li>
                    <li><a href="/skills"><span class="icon">🧠</span>Skills</a></li>
                    <li><a href="/nodes"><span class="icon">🖥️</span>Nodes</a></li>
                </ul>
                <div class="nav-group-title">Settings</div>
                <ul>
                    <li><a href="/config"><span class="icon">⚙️</span>Config</a></li>
                    <li><a href="/logs"><span class="icon">📜</span>Logs</a></li>
                    <li><a href="/debug"><span class="icon">🐛</span>Debug</a></li>
                </ul>
                <div class="nav-group-title">Projects</div>
                <ul>
                    <li><a href="/projects/kanban"><span class="icon">📋</span>Kanban</a></li>
                </ul>
                <div class="nav-group-title">Learnings</div>
                <ul>
                    <li><a href="/activity"><span class="icon">📖</span>Activity & Audit Log</a></li>
                </ul>
                <div class="nav-group-title">Resources</div>
                <ul>
                    <li><a href="/docs"><span class="icon">📚</span>Docs</a></li>
                </ul>
            </nav>
        </aside>

        <main class="oc-dashboard-area" id="oc-dashboard-area">
            <a href="/agents" class="oc-card" id="agent-status-card" style="cursor: pointer;">
                <h2>Agent Status Overview</h2>
                <div id="agent-list">
                    <p>Loading agents...</p>
                </div>
            </a>
            <div class="oc-card">
                <h2>Recent Project Updates</h2>
                <p>View the latest progress and changes across active projects. This pane should show a summary of ongoing tasks.</p>
            </div>
            <div class="oc-card">
                <h2>Latest Reports</h2>
                <p>Access recently generated reports and documents. This will integrate with the `DELIVERABLES.md` and document tracking.</p>
            </div>
            <div class="oc-card">
                <h2>System Health</h2>
                <p>Quick glance at gateway and agent system health metrics. Will display CPU, memory, and uptime.</p>
            </div>
            <div class="oc-card">
                <h2>Active Sessions</h2>
                <p>List of currently running agent sessions and their status.</p>
            </div>
            <div class="oc-card">
                <h2>Recent Logs</h2>
                <p>Snippet of the most recent OpenClaw gateway logs.</p>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');
        const mainContentArea = document.getElementById('oc-dashboard-area');

        // Initialize sidebar state based on a preference or default to open
        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed'); // Ensure it's not collapsed on initial load if preference is open
        }

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
            } else {
                sidebar.classList.remove('collapsed');
            }
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        // Theme Toggle (Light/Dark Mode)
        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");

        // Load theme from localStorage or system preference
        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        if (currentTheme === 'dark') {
            themeToggle.textContent = '🌙';
        } else {
            themeToggle.textContent = '☀️';
        }

        themeToggle.addEventListener('click', () => {
            currentTheme = (currentTheme === 'light') ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggle.textContent = '🌙';
            } else {
                themeToggle.textContent = '☀️';
            }
        });

        // Listen for system theme changes
        prefersDarkScheme.addEventListener('change', (e) => {
            if (!localStorage.getItem('overclaw-theme')) { // Only update if no explicit user preference
                currentTheme = e.matches ? 'dark' : 'light';
                document.body.classList.toggle('light-mode', currentTheme === 'light');
                document.body.classList.toggle('dark-mode', currentTheme === 'dark');
                if (currentTheme === 'dark') {
                    themeToggle.textContent = '🌙';
                } else {
                    themeToggle.textContent = '☀️';
                }
            }
        });

        // --- Fetch Agent Data ---
        async function fetchAgents() {
            const agentListDiv = document.getElementById('agent-list');
            try {
                const response = await fetch('/api/agents');
                const agents = await response.json();

                if (agents.error) {
                    agentListDiv.innerHTML = `<p style="color: red;">Error: ${agents.error}</p><p>Details: ${agents.details}</p>`;
                    return;
                }

                if (agents.length === 0) {
                    agentListDiv.innerHTML = '<p>No agents configured.</p>';
                    return;
                }

                const ul = document.createElement('ul');
                ul.style.listStyle = 'none';
                ul.style.paddingLeft = '0';
                agents.forEach(agent => {
                    const li = document.createElement('li');
                    li.innerHTML = `<strong>${agent.name}</strong> (ID: <code>${agent.id}</code>)`;
                    ul.appendChild(li);
                });
                agentListDiv.innerHTML = ''; // Clear loading message
                agentListDiv.appendChild(ul);

            } catch (error) {
                console.error('Error fetching agents:', error);
                agentListDiv.innerHTML = '<p style="color: red;">Failed to load agent data.</p>';
            }
        }

        // Fetch agents when the page loads
        document.addEventListener('DOMContentLoaded', fetchAgents);

    </script>
</body>
</html>
