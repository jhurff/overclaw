<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <!-- Placeholder for Theme/Mode Operator -->
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
        <aside class="oc-sidebar" id="oc-sidebar">
            <nav>
                <ul>
                    <li><a href="/" class="active">Dashboard</a></li>
                    <li><a href="/agents">Agents</a></li>
                    <li><a href="/projects">Projects</a></li>
                    <li><a href="/reports">Reports</a></li>
                    <li><a href="/logs">Logs</a></li>
                    <li><a href="/config">Configuration</a></li>
                </ul>
            </nav>
        </aside>

        <main class="oc-dashboard-area">
            <div class="oc-card">
                <h2>Agent Status Overview</h2>
                <p>Monitor the health and activity of all configured agents.</p>
            </div>
            <div class="oc-card">
                <h2>Recent Project Updates</h2>
                <p>View the latest progress and changes across active projects.</p>
            </div>
            <div class="oc-card">
                <h2>Latest Reports</h2>
                <p>Access recently generated reports and documents.</p>
            </div>
            <div class="oc-card">
                <h2>System Health</h2>
                <p>Quick glance at gateway and agent system health metrics.</p>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');
        const mainContent = document.querySelector('.oc-main-content');

        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
            // Optionally adjust main content margin if needed based on design
            // if (sidebar.classList.contains('collapsed')) {
            //     mainContent.style.marginLeft = '0';
            // } else {
            //     mainContent.style.marginLeft = sidebar.offsetWidth + 'px';
            // }
        });

        // Basic theme toggle placeholder
        const themeToggle = document.getElementById('theme-toggle');
        themeToggle.addEventListener('click', () => {
            alert('Theme toggle functionality coming soon!');
            // Implement actual theme switching logic here
        });
    </script>
</body>
</html>
