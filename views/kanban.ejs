<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">PROJECT MANAGEMENT</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
        <aside class="oc-sidebar" id="oc-sidebar">
            <nav>
                <div class="nav-group-title">Control</div>
                <ul>
                    <li><a href="/"><span class="icon">🏠</span>Dashboard</a></li>
                    <li><a href="/sessions"><span class="icon">💬</span>Sessions</a></li>
                    <li><a href="/cron-jobs"><span class="icon">⏰</span>Cron Jobs</a></li>
                </ul>
                <div class="nav-group-title">Agent</div>
                <ul>
                    <li><a href="/agents"><span class="icon">🤖</span>Agents</a></li>
                    <li><a href="/skills"><span class="icon">🧠</span>Skills</a></li>
                    <li><a href="/nodes"><span class="icon">🖥️</span>Nodes</a></li>
                </ul>
                <div class="nav-group-title">Settings</div>
                <ul>
                    <li><a href="/config"><span class="icon">⚙️</span>Config</a></li>
                    <li><a href="/logs"><span class="icon">📜</span>Logs</a></li>
                    <li><a href="/debug"><span class="icon">🐛</span>Debug</a></li>
                </ul>
                <div class="nav-group-title">Projects</div>
                <ul>
                    <li><a href="/projects/kanban" class="active"><span class="icon">📋</span>Kanban</a></li>
                </ul>
                <div class="nav-group-title">Resources</div>
                <ul>
                    <li><a href="/docs"><span class="icon">📚</span>Docs</a></li>
                </ul>
            </nav>
        </aside>

        <main class="oc-dashboard-area">
            <div class="kanban-header">
                <h1>Kanban Board</h1>
                <div class="kanban-controls">
                    <button id="new-project-btn" class="btn-primary">
                        <i class="fas fa-plus"></i> New Project
                    </button>
                    <div class="filters">
                        <select id="filter-agent">
                            <option value="">All Agents</option>
                        </select>
                        <select id="filter-schedule">
                            <option value="">All Schedule Status</option>
                            <option value="on_schedule">On Schedule</option>
                            <option value="at_risk">At Risk</option>
                            <option value="behind">Behind</option>
                        </select>
                        <button id="clear-filters" class="btn-secondary">Clear Filters</button>
                    </div>
                </div>
            </div>

            <div class="kanban-board">
                <div class="swimlane" data-status="backlog">
                    <div class="swimlane-header">
                        <h3>Backlog</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="backlog">
                        <!-- Cards will be inserted here by JavaScript -->
                    </div>
                </div>
                <div class="swimlane" data-status="plan">
                    <div class="swimlane-header">
                        <h3>Plan</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="plan">
                    </div>
                </div>
                <div class="swimlane" data-status="to_do">
                    <div class="swimlane-header">
                        <h3>To Do</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="to_do">
                    </div>
                </div>
                <div class="swimlane" data-status="in_progress">
                    <div class="swimlane-header">
                        <h3>In Progress</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="in_progress">
                    </div>
                </div>
                <div class="swimlane" data-status="review">
                    <div class="swimlane-header">
                        <h3>Review</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="review">
                    </div>
                </div>
                <div class="swimlane" data-status="done">
                    <div class="swimlane-header">
                        <h3>Done</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="done">
                    </div>
                </div>
                <div class="swimlane" data-status="cancelled">
                    <div class="swimlane-header">
                        <h3>Cancelled</h3>
                        <span class="card-count">0</span>
                    </div>
                    <div class="cards-container" data-status="cancelled">
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Project Detail Modal -->
    <div id="project-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modal-title">Project Details</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <div class="project-detail-section">
                    <h3>Basic Info</h3>
                    <p><strong>Title:</strong> <span id="detail-title"></span></p>
                    <p><strong>Description:</strong> <span id="detail-description"></span></p>
                    <p><strong>Agent:</strong> <span id="detail-agent"></span></p>
                    <p><strong>Status:</strong> <span id="detail-status"></span></p>
                    <p><strong>Due Date:</strong> <span id="detail-due"></span></p>
                    <p><strong>ETA:</strong> <span id="detail-eta"></span></p>
                    <p><strong>Schedule:</strong> <span id="detail-schedule"></span></p>
                </div>
                <div class="project-detail-section">
                    <h3>Progress Notes</h3>
                    <ul id="detail-notes"></ul>
                    <textarea id="new-note" placeholder="Add a progress note..."></textarea>
                    <button id="add-note-btn" class="btn-secondary">Add Note</button>
                </div>
                <div class="project-detail-section">
                    <h3>Impediments</h3>
                    <ul id="detail-impediments"></ul>
                </div>
                <div class="project-detail-section">
                    <h3>Blockers</h3>
                    <ul id="detail-blockers"></ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="edit-project-btn" class="btn-primary">Edit Project</button>
                <button id="delete-project-btn" class="btn-danger">Delete Project</button>
            </div>
        </div>
    </div>

    <!-- New Project Modal -->
    <div id="new-project-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>New Project</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <form id="new-project-form">
                    <div class="form-group">
                        <label for="project-title">Title</label>
                        <input type="text" id="project-title" required>
                    </div>
                    <div class="form-group">
                        <label for="project-description">Description</label>
                        <textarea id="project-description" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="project-agent">Agent</label>
                        <select id="project-agent">
                            <option value="spike">spike</option>
                            <option value="sheeba-m">sheeba-m</option>
                            <option value="buster-mcthunderstick">buster-mcthunderstick</option>
                            <option value="main">main</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="project-status">Initial Status</label>
                        <select id="project-status">
                            <option value="backlog">Backlog</option>
                            <option value="plan">Plan</option>
                            <option value="to_do">To Do</option>
                            <option value="in_progress">In Progress</option>
                            <option value="review">Review</option>
                            <option value="done">Done</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="project-due">Due Date</label>
                        <input type="date" id="project-due">
                    </div>
                    <div class="form-group">
                        <label for="project-eta">ETA</label>
                        <input type="date" id="project-eta">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button id="save-project-btn" class="btn-primary">Create Project</button>
                <button id="cancel-project-btn" class="btn-secondary">Cancel</button>
            </div>
        </div>
    </div>

    <script src="/kanban.js"></script>
    <script>
        // Sidebar toggle (same as other pages)
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');
        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed');
        }
        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
            } else {
                sidebar.classList.remove('collapsed');
            }
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        // Theme toggle (same as other pages)
        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        if (currentTheme === 'dark') {
            themeToggle.textContent = '🌙';
        } else {
            themeToggle.textContent = '☀️';
        }
        themeToggle.addEventListener('click', () => {
            currentTheme = (currentTheme === 'light') ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggle.textContent = '🌙';
            } else {
                themeToggle.textContent = '☀️';
            }
        });
        prefersDarkScheme.addEventListener('change', (e) => {
            if (!localStorage.getItem('overclaw-theme')) {
                currentTheme = e.matches ? 'dark' : 'light';
                document.body.classList.toggle('light-mode', currentTheme === 'light');
                document.body.classList.toggle('dark-mode', currentTheme === 'dark');
                if (currentTheme === 'dark') {
                    themeToggle.textContent = '🌙';
                } else {
                    themeToggle.textContent = '☀️';
                }
            }
        });
    </script>
</body>
</html>