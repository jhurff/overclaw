<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* ── Override global grid so content flows as a column ── */
    .oc-main-content {
      overflow: hidden !important;
      height: calc(100vh - 60px);
    }
    .oc-dashboard-area {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: unset !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      padding: 1rem 1.25rem !important;
      gap: 0 !important;
    }

    /* ── Top bar ── */
    .sw-topbar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-shrink: 0;
      margin-bottom: 1rem;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .sw-title { font-size: 1.1rem; font-weight: 700; color: var(--oc-text-dark, #e2e8f0); margin: 0; }
    .sw-meta  { font-size: 0.73rem; color: #6b7280; display: flex; align-items: center; gap: 0.75rem; }
    .sw-sync-btn {
      font-size: 0.72rem; padding: 0.18rem 0.55rem;
      border-radius: 4px; border: 1px solid #374151;
      background: transparent; color: #9ca3af; cursor: pointer;
    }
    .sw-sync-btn:hover { border-color: #6b7280; color: #e2e8f0; }
    .sw-sync-btn:disabled { opacity: .5; cursor: default; }

    /* ── Error banner ── */
    .sw-error {
      display: none;
      background: #1c1917; border: 1px solid #78350f;
      border-radius: 6px; padding: 0.6rem 1rem;
      color: #fde68a; font-size: 0.82rem; margin-bottom: 1rem;
    }

    /* ── Section label ── */
    .sw-section {
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: #6b7280;
      margin: 1.1rem 0 0.55rem;
    }
    .sw-section:first-of-type { margin-top: 0; }

    /* ── Task board stat pills ── */
    .stats-strip {
      display: flex; gap: 0.6rem; flex-wrap: wrap;
    }
    .stat-pill {
      background: var(--oc-card-bg, #111827);
      border: 1px solid var(--oc-border-color, #1f2937);
      border-radius: 8px; padding: 0.6rem 1rem;
      text-align: center; min-width: 88px;
      text-decoration: none;
      transition: border-color .15s;
    }
    a.stat-pill:hover { border-color: #4b5563; }
    .stat-num   { font-size: 1.5rem; font-weight: 800; color: var(--oc-text-dark, #e2e8f0); line-height: 1; }
    .stat-label { font-size: 0.67rem; color: #6b7280; margin-top: 3px; text-transform: uppercase; letter-spacing: 0.06em; }

    /* ── Agent cards ── */
    .agent-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 0.75rem;
    }
    .agent-card {
      background: var(--oc-card-bg, #111827);
      border: 1px solid var(--oc-border-color, #1f2937);
      border-radius: 8px;
      padding: 0.85rem 1rem;
      display: flex; flex-direction: column; gap: 0.35rem;
    }
    .ac-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
    .ac-name   { font-size: 1rem; font-weight: 700; color: #e2e8f0; }
    .ac-type   { font-size: 0.72rem; color: #6b7280; }
    .ac-machine{ font-size: 0.75rem; color: #9ca3af; }
    .ac-role   { font-size: 0.73rem; color: #6b7280; font-style: italic; line-height: 1.35;
                 display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .ac-hb     { font-size: 0.68rem; color: #4b5563; margin-top: 2px; }

    /* ── Status badge ── */
    .badge {
      display: inline-block; padding: 1px 7px;
      border-radius: 9999px; font-size: 0.67rem; font-weight: 600;
      white-space: nowrap;
    }
    .badge-green  { background: #14532d; color: #86efac; }
    .badge-red    { background: #7f1d1d; color: #fca5a5; }
    .badge-yellow { background: #78350f; color: #fde68a; }
    .badge-gray   { background: #1f2937; color: #6b7280; }

    /* ── Agent card links ── */
    .ac-links { display: flex; gap: 0.5rem; margin-top: 0.35rem; }
    .ac-link   { font-size: 0.7rem; color: #6b7280; text-decoration: none; padding: 1px 5px; border-radius: 4px; border: 1px solid #1f2937; }
    .ac-link:hover { color: #e2e8f0; border-color: #374151; }

    /* ── Heatmap styles ── */
    .heatmap-section { margin-top: 0; }
    .heatmap-grid {
      display: grid;
      grid-template-columns: 52px repeat(7, 1fr);
      gap: 3px;
      font-size: 0.68rem;
    }
    .hm-agent-label {
      display: flex; align-items: center;
      font-size: 0.7rem; font-weight: 600;
      color: #9ca3af; padding-right: 4px;
    }
    .hm-day-label {
      text-align: center; color: #4b5563;
      padding-bottom: 3px; font-size: 0.62rem;
    }
    .hm-cell {
      height: 26px; border-radius: 3px;
      background: #111827; border: 1px solid #1f2937;
      cursor: default; position: relative;
      transition: transform .1s;
    }
    .hm-cell:hover { transform: scale(1.15); z-index: 5; }
    .hm-cell .hm-tip {
      display: none; position: absolute;
      bottom: calc(100% + 5px); left: 50%;
      transform: translateX(-50%);
      background: #1f2937; border: 1px solid #374151;
      border-radius: 4px; padding: 3px 7px;
      white-space: nowrap; font-size: 0.68rem;
      color: #e2e8f0; pointer-events: none; z-index: 20;
    }
    .hm-cell:hover .hm-tip { display: block; }
    .hm-legend {
      display: flex; gap: 10px; align-items: center;
      margin-top: 8px; font-size: 0.65rem; color: #4b5563;
    }
    .hm-legend-swatch {
      width: 11px; height: 11px; border-radius: 2px; display: inline-block;
    }

    /* ── Pipeline styles ── */
    .pipeline-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.7rem;
    }
    .pipe-col { }
    .pipe-col-header {
      font-size: 0.68rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.07em;
      display: flex; align-items: center; gap: 6px;
      margin-bottom: 0.45rem;
    }
    .pipe-count {
      background: #1f2937; border-radius: 9999px;
      padding: 0px 6px; font-size: 0.65rem; color: #9ca3af;
    }
    .pipe-inbox    .pipe-col-header { color: #9ca3af; }
    .pipe-wip      .pipe-col-header { color: #60a5fa; }
    .pipe-blocked  .pipe-col-header { color: #f87171; }
    .pipe-done     .pipe-col-header { color: #6ee7b7; }
    .pipe-task {
      background: #111827; border: 1px solid #1f2937;
      border-radius: 5px; padding: 0.5rem 0.65rem;
      margin-bottom: 0.4rem; font-size: 0.75rem;
    }
    .pipe-task-id { font-size: 0.62rem; color: #4b5563; font-family: monospace; margin-bottom: 2px; }
    .pipe-task-title { color: #d1d5db; line-height: 1.35; }
    .pipe-task-agent {
      margin-top: 5px; font-size: 0.62rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.04em;
    }
    .ta-spike { color: #f97316; } .ta-steve { color: #60a5fa; }
    .ta-lex   { color: #c084fc; } .ta-bill  { color: #6ee7b7; }
    .ta-jimmy { color: #fbbf24; } .ta-other { color: #9ca3af; }
    .pipe-empty { font-size: 0.75rem; color: #374151; padding: 4px 0; }
    @media (max-width: 700px) {
      .pipeline-grid { grid-template-columns: repeat(2, 1fr); }
      .heatmap-grid  { grid-template-columns: 44px repeat(7, 1fr); }
    } display: flex; flex-direction: column; gap: 0.45rem; }
    .alert-item {
      background: rgba(194,65,12,0.12);
      border: 1px solid #9a3412;
      border-radius: 6px; padding: 0.5rem 0.75rem;
      display: flex; gap: 0.6rem; align-items: baseline;
      flex-wrap: wrap; font-size: 0.8rem;
      text-decoration: none;
      transition: background .12s, border-color .12s;
    }
    a.alert-item:hover {
      background: rgba(194,65,12,0.22);
      border-color: #c2410c;
    }
    .al-machine { font-weight: 600; color: #fb923c; }
    .al-type    { color: #fdba74; flex: 1; min-width: 0; }
    .al-date    { color: #6b7280; font-size: 0.7rem; white-space: nowrap; }
    .al-open    { font-size: 0.67rem; color: #6b7280; white-space: nowrap; opacity: .7; }
    a.alert-item:hover .al-open { opacity: 1; color: #9ca3af; }
    .no-alerts  { font-size: 0.82rem; color: #374151; padding: 0.5rem 0; }
  </style>
</head>
<body>
  <header class="oc-header">
    <div class="logo">
      <h1 class="main-title">OVERCLAW</h1>
      <span class="tagline">SWARM OVERVIEW</span>
    </div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/swarm' }) %>

    <main class="oc-dashboard-area">

      <!-- Top bar -->
      <div class="sw-topbar">
        <h1 class="sw-title">🌐 Swarm Overview</h1>
        <div class="sw-meta">
          <span id="sw-refresh-note"></span>
          <span id="sw-sync-ts"></span>
          <button class="sw-sync-btn" id="sync-btn" onclick="syncVault()">↻ Sync</button>
        </div>
      </div>

      <!-- Error -->
      <div class="sw-error" id="vault-error"></div>

      <!-- Task board stats -->
      <div class="sw-section">📋 Task Board</div>
      <div class="stats-strip">
        <div class="stat-pill">
          <div class="stat-num" id="stat-inbox">—</div>
          <div class="stat-label">Inbox</div>
        </div>
        <div class="stat-pill">
          <div class="stat-num" id="stat-inprogress">—</div>
          <div class="stat-label">In Progress</div>
        </div>
        <div class="stat-pill">
          <div class="stat-num" id="stat-blocked" style="color:#f87171;">—</div>
          <div class="stat-label">Blocked</div>
        </div>
        <div class="stat-pill">
          <div class="stat-num" id="stat-done" style="color:#6ee7b7;">—</div>
          <div class="stat-label">Done</div>
        </div>
        <a href="/task-board" class="stat-pill" style="border-color:#374151;">
          <div class="stat-num" style="font-size:1.1rem; color:#6b7280;">→</div>
          <div class="stat-label">View Board</div>
        </a>
      </div>

      <!-- Agents -->
      <div class="sw-section">🤖 Agents</div>
      <div class="agent-grid" id="agent-grid">
        <div style="color:#4b5563; font-size:0.8rem;">Loading…</div>
      </div>

      <!-- Alerts -->
      <div class="sw-section">🚨 Needs Attention</div>
      <div id="alerts-container">
        <div style="color:#4b5563; font-size:0.8rem;">Loading…</div>
      </div>

      <!-- Activity Heatmap -->
      <div class="sw-section">📊 7-Day Activity</div>
      <div class="heatmap-section">
        <div class="heatmap-grid" id="heatmap-grid">
          <div style="color:#4b5563;font-size:.75rem;">Loading…</div>
        </div>
        <div class="hm-legend">
          <span>Less</span>
          <span class="hm-legend-swatch" style="background:#111827;border:1px solid #1f2937"></span>
          <span class="hm-legend-swatch" style="background:#1e3a5f"></span>
          <span class="hm-legend-swatch" style="background:#1d4ed8"></span>
          <span class="hm-legend-swatch" style="background:#3b82f6"></span>
          <span class="hm-legend-swatch" style="background:#93c5fd"></span>
          <span>More</span>
        </div>
      </div>

      <!-- Pipeline -->
      <div class="sw-section">🗂️ Task Pipeline</div>
      <div class="pipeline-grid" id="pipeline-grid">
        <div style="color:#4b5563;font-size:.75rem;">Loading…</div>
      </div>

      <!-- Bottom padding -->
      <div style="height:1.5rem; flex-shrink:0;"></div>

    </main>
  </div>

  <script>
    /* ── Sidebar / theme boilerplate ── */
    (function () {
      const toggle  = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('oc-sidebar');
      if (toggle && sidebar) {
        let collapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (collapsed) sidebar.classList.add('collapsed');
        toggle.addEventListener('click', () => {
          collapsed = !collapsed;
          sidebar.classList.toggle('collapsed', collapsed);
          localStorage.setItem('overclaw-sidebar-collapsed', collapsed);
        });
      }
      const themeBtn = document.getElementById('theme-toggle');
      const prefer   = window.matchMedia('(prefers-color-scheme: dark)');
      let theme = localStorage.getItem('overclaw-theme') || (prefer.matches ? 'dark' : 'light');
      document.body.classList.add(theme + '-mode');
      themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
      themeBtn.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        document.body.classList.toggle('dark-mode',  theme === 'dark');
        document.body.classList.toggle('light-mode', theme === 'light');
        themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
        localStorage.setItem('overclaw-theme', theme);
      });
    })();

    /* ── Helpers ── */
    function fmtDate(str) {
      if (!str) return 'never';
      try { return new Date(str).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }); }
      catch { return str; }
    }

    function statusBadge(raw) {
      if (!raw) return '<span class="badge badge-gray">unknown</span>';
      const s = raw.toLowerCase();
      if (s.includes('active') || s.includes('online') || s.includes('🟢'))
        return '<span class="badge badge-green">Active</span>';
      if (s.includes('offline') || s.includes('down') || s.includes('🔴'))
        return '<span class="badge badge-red">Offline</span>';
      if (s.includes('idle') || s.includes('🟡'))
        return '<span class="badge badge-yellow">Idle</span>';
      return '<span class="badge badge-gray">' + raw.replace(/🟢|🔴|🟡/g,'').trim() + '</span>';
    }

    /* ── Load ── */
    async function loadSummary() {
      const err = document.getElementById('vault-error');
      try {
        const data = await fetch('/api/swarm/summary').then(r => r.json());

        if (data.error) {
          err.style.display = 'block';
          err.textContent = '⚠️ Vault unavailable: ' + (data.details || data.error);
          document.getElementById('agent-grid').innerHTML =
            '<div style="color:#4b5563;font-size:.8rem;">No data</div>';
          document.getElementById('alerts-container').innerHTML =
            '<div style="color:#4b5563;font-size:.8rem;">No data</div>';
          return;
        }
        err.style.display = 'none';

        /* stats */
        const s = data.taskBoardStats || {};
        document.getElementById('stat-inbox').textContent      = s.inbox      ?? '—';
        document.getElementById('stat-inprogress').textContent = s.inProgress ?? '—';
        document.getElementById('stat-blocked').textContent    = s.blocked    ?? '—';
        document.getElementById('stat-done').textContent       = s.done       ?? '—';

        /* agents */
        const agents = data.agents || [];
        document.getElementById('agent-grid').innerHTML = agents.length
          ? agents.map(a => {
              const hbMap  = data.lastHeartbeat || {};
              const hbKey  = Object.keys(hbMap).find(k =>
                k.toLowerCase().includes((a.nickname||'').toLowerCase()) ||
                k.toLowerCase().includes((a.machine||'').toLowerCase().split(' ')[0])
              );
              const hb = hbKey ? hbMap[hbKey] : null;
              const hbStr = hb ? fmtDate(hb.date) : '—';
              const roleTxt = (a.primary_role || a.role || '').replace(/\s—\s.*/, ''); /* first segment only */
              return `
                <div class="agent-card">
                  <div class="ac-header">
                    <span class="ac-name">${a.nickname || a.agent || 'Agent'}</span>
                    ${statusBadge(a.status || '')}
                  </div>
                  <div class="ac-type">${a.type || ''}</div>
                  <div class="ac-machine">💻 ${a.machine || ''}</div>
                  ${roleTxt ? `<div class="ac-role">${roleTxt}</div>` : ''}
                  <div class="ac-hb">Last heartbeat: ${hbStr}</div>
                  <div class="ac-links">
                    <a href="/vault/graph" class="ac-link">🕸️ Graph</a>
                    <a href="/vault/doc?path=${encodeURIComponent('03 - Agents/Agent Registry.md')}" class="ac-link">📋 Registry</a>
                  </div>
                </div>`;
            }).join('')
          : '<div style="color:#4b5563;font-size:.8rem;">No agents in registry.</div>';

        /* alerts */
        const alerts = data.alerts || [];
        document.getElementById('alerts-container').innerHTML = alerts.length
          ? '<div class="alert-list">' + alerts.map(a => {
              const docPath = a.relPath
                ? '08 - QA-and-Monitoring/Heartbeats/' + a.relPath
                : null;
              const href = docPath
                ? `/vault/doc?path=${encodeURIComponent(docPath)}`
                : null;
              const tag   = href ? 'a' : 'div';
              const attrs = href ? ` href="${href}" target="_blank"` : '';
              const label = (a.type || a.filename || '').replace(/[-_]/g,' ').trim();
              return `<${tag} class="alert-item"${attrs}>
                <span class="al-machine">${a.machine !== 'unknown' ? a.machine : '⚠️'}</span>
                <span class="al-type">${label}</span>
                <span class="al-date">${fmtDate(a.date)}</span>
                ${href ? '<span class="al-open">open →</span>' : ''}
              </${tag}>`;
            }).join('') + '</div>'
          : '<div class="no-alerts">✅ No unhandled alerts</div>';

        /* heatmap */
        renderHeatmap(data.heatmap || { days: [], agents: [] });

        /* pipeline */
        renderPipeline(data.taskBoard || {});

        document.getElementById('sw-refresh-note').textContent =
          'Updated ' + new Date().toLocaleTimeString();

      } catch(e) {
        err.style.display = 'block';
        err.textContent = '⚠️ ' + e.message;
      }
    }

    async function syncVault() {
      const btn = document.getElementById('sync-btn');
      const ts  = document.getElementById('sw-sync-ts');
      btn.disabled = true; btn.textContent = '↻ Syncing…';
      try {
        const d = await fetch('/api/vault/sync', { method:'POST' }).then(r => r.json());
        ts.textContent = d.ok
          ? '· synced ' + new Date().toLocaleTimeString()
          : '· sync failed: ' + (d.error || d.stderr || 'err');
        if (d.ok) await loadSummary();
      } catch(e) {
        ts.textContent = '· error: ' + e.message;
      } finally {
        btn.disabled = false; btn.textContent = '↻ Sync';
      }
    }

    loadSummary();
    setInterval(loadSummary, 30000);

    /* ── Heatmap renderer ── */
    function renderHeatmap({ days, agents }) {
      const grid = document.getElementById('heatmap-grid');
      if (!days || !days.length) { grid.innerHTML = '<div style="color:#4b5563;font-size:.75rem;">No data</div>'; return; }

      // Color scale per agent (4 levels + zero)
      const scales = {
        Spike: ['#111827','#431407','#7c2d12','#c2410c','#f97316'],
        Steve: ['#111827','#1e3a5f','#1e40af','#2563eb','#60a5fa'],
        Lex:   ['#111827','#3b0764','#6b21a8','#9333ea','#c084fc'],
        Bill:  ['#111827','#052e16','#065f46','#059669','#6ee7b7'],
      };
      function cellColor(name, n) {
        const s = scales[name] || scales.Spike;
        if (n === 0) return s[0];
        if (n <= 3)  return s[1];
        if (n <= 7)  return s[2];
        if (n <= 14) return s[3];
        return s[4];
      }

      const dayLabels = days.map(d => {
        const dt = new Date(d + 'T12:00:00');
        return dt.toLocaleDateString([], { month:'short', day:'numeric' });
      });

      let html = '';
      // Day header row
      html += '<div></div>'; // blank corner
      for (const lbl of dayLabels) {
        html += `<div class="hm-day-label">${lbl}</div>`;
      }
      // Agent rows
      for (const agent of agents) {
        html += `<div class="hm-agent-label" style="color:${(scales[agent.name]||scales.Spike)[3]}">${agent.name}</div>`;
        agent.counts.forEach((n, i) => {
          const bg  = cellColor(agent.name, n);
          const tip = `${agent.name} · ${dayLabels[i]} · ${n} commit${n!==1?'s':''}`;
          html += `<div class="hm-cell" style="background:${bg}" title="${tip}"><span class="hm-tip">${tip}</span></div>`;
        });
      }
      grid.innerHTML = html;
    }

    /* ── Pipeline renderer ── */
    function agentClass(a) {
      if (!a) return 'ta-other';
      const s = a.toLowerCase();
      if (s.includes('spike')) return 'ta-spike';
      if (s.includes('steve')) return 'ta-steve';
      if (s.includes('lex'))   return 'ta-lex';
      if (s.includes('bill'))  return 'ta-bill';
      if (s.includes('jimmy')) return 'ta-jimmy';
      return 'ta-other';
    }
    function taskCard(t) {
      const title = (t.title || t.description || '').replace(/\*\*/g,'').replace(/—.*$/,'').trim();
      const short = title.length > 70 ? title.slice(0,70)+'…' : title;
      const id = t.id || t.taskId || '';
      const agent = t.assignedTo || t.agent || '';
      return `<div class="pipe-task">
        ${id ? `<div class="pipe-task-id">${id}</div>` : ''}
        <div class="pipe-task-title">${short}</div>
        ${agent ? `<div class="pipe-task-agent ${agentClass(agent)}">${agent.toUpperCase()}</div>` : ''}
      </div>`;
    }
    function renderPipeline({ inbox=[], inProgress=[], blocked=[], done=[] }) {
      const cols = [
        { key:'pipe-inbox',   label:'📥 Inbox',       items: inbox },
        { key:'pipe-wip',     label:'🔄 In Progress', items: inProgress },
        { key:'pipe-blocked', label:'🔴 Blocked',     items: blocked },
        { key:'pipe-done',    label:'✅ Done',        items: done },
      ];
      document.getElementById('pipeline-grid').innerHTML = cols.map(col => `
        <div class="pipe-col ${col.key}">
          <div class="pipe-col-header">${col.label} <span class="pipe-count">${col.items.length}</span></div>
          ${col.items.length ? col.items.map(taskCard).join('') : '<div class="pipe-empty">Empty</div>'}
        </div>`
      ).join('');
    }
    fetch('/api/vault/status').then(r=>r.json()).then(d => {
      if (d.lastSyncAt)
        document.getElementById('sw-sync-ts').textContent =
          '· synced ' + new Date(d.lastSyncAt).toLocaleTimeString();
    }).catch(()=>{});
  </script>
</body>
</html>
