<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/document-head') %>

  <style>
    /* ── Override global grid so content flows as a column ── */
    .oc-main-content {
      overflow:hidden !important;
      height:calc(100vh - var(--oc-header-height));
    }
    .oc-dashboard-area {
      display:flex !important;
      flex-direction:column !important;
      grid-template-columns:unset !important;
      overflow-y:auto !important;
      overflow-x:hidden !important;
      padding:1rem 1.25rem !important;
      gap:0 !important;
    }

    /* ── Top bar ── */
    .sw-topbar {
      display:flex;
      align-items:baseline;
      justify-content:space-between;
      flex-shrink:0;
      margin-bottom:1rem;
      gap:1rem;
      flex-wrap:wrap;
    }
    .sw-title { font-size:1.1rem; font-weight:700; color:var(--oc-text); margin:0; }
    .sw-meta  { font-size:0.73rem; color:var(--oc-text-muted); display:flex; align-items:center; gap:0.75rem; }
    .sw-sync-btn {
      font-size:0.72rem; padding:0.18rem 0.55rem;
      border-radius:4px; border:1px solid var(--oc-border-strong);
      background:transparent; color:var(--oc-text-muted); cursor:pointer;
    }
    @media (max-width: 767px) {
      .sw-sync-btn, .ac-link { min-height:44px; font-size:0.875rem; display:inline-flex; align-items:center; }
      .ac-links { flex-wrap:wrap; }
      .stats-grid, .agent-grid, .health-grid { grid-template-columns:1fr 1fr; }
      .sc-label, .sc-preview, .ac-type, .ac-role, .ac-hb, .badge { font-size:0.8rem; }
      .heatmap-grid { grid-template-columns:4.5rem repeat(7, minmax(0, 1fr)); }
      .sw-meta { flex-wrap:wrap; }
    }
    .sw-sync-btn:hover { border-color:var(--oc-border-strong); color:var(--oc-text); }
    .sw-sync-btn:disabled { opacity:.5; cursor:default; }

    /* ── Error banner ── */
    .sw-error {
      display:none;
      background:var(--oc-warning-soft); border:1px solid var(--oc-warning);
      border-radius:6px; padding:0.6rem 1rem;
      color:var(--oc-warning-text); font-size:0.82rem; margin-bottom:1rem;
    }

    /* ── Section label ── */
    .sw-section {
      font-size:0.7rem; font-weight:700; text-transform:uppercase;
      letter-spacing:0.08em; color:var(--oc-text-muted);
      margin:1.1rem 0 0.55rem;
    }
    .sw-section:first-of-type { margin-top:0; }

    /* ── Task board stat cards (2×2 mobile grid) ── */
    .stats-grid {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:0.5rem;
    }
    .stat-card {
      background:var(--oc-bg-card);
      border:1px solid var(--oc-border);
      border-radius:8px; padding:0.65rem 0.85rem;
      text-decoration:none; display:flex;
      flex-direction:column; gap:0.15rem;
      transition:border-color .15s, background .1s;
      -webkit-tap-highlight-color:transparent;
      cursor:pointer;
    }
    .stat-card:hover { border-color:var(--oc-border-strong); background:var(--oc-bg-hover); }
    .sc-top   { display:flex; align-items:baseline; justify-content:space-between; gap:0.4rem; }
    .sc-num   { font-size:1.75rem; font-weight:800; line-height:1; flex-shrink:0; }
    .sc-label { font-size:0.64rem; font-weight:700; text-transform:uppercase;
                letter-spacing:0.06em; text-align:right; line-height:1.2; }
    .sc-preview { font-size:0.66rem; color:var(--oc-text-muted); line-height:1.35;
                  display:-webkit-box; -webkit-line-clamp:2;
                  -webkit-box-orient:vertical; overflow:hidden;
                  margin-top:2px; }
    /* column accent colors */
    .sc-inbox   { border-top:2px solid var(--oc-status-inbox); }
    .sc-inbox   .sc-num   { color:var(--oc-status-inbox-text); }
    .sc-inbox   .sc-label { color:var(--oc-status-inbox-text); }
    .sc-wip     { border-top:2px solid var(--oc-info); }
    .sc-wip     .sc-num   { color:var(--oc-info-text); }
    .sc-wip     .sc-label { color:var(--oc-info-text); }
    .sc-blocked { border-top:2px solid var(--oc-danger); }
    .sc-blocked .sc-num   { color:var(--oc-danger-text); }
    .sc-blocked .sc-label { color:var(--oc-danger-text); }
    .sc-done    { border-top:2px solid var(--oc-success); }
    .sc-done    .sc-num   { color:var(--oc-success-text); }
    .sc-done    .sc-label { color:var(--oc-success-text); }

    /* ── Agent cards (merged with health) ── */
    .agent-grid {
      display:grid;
      grid-template-columns:repeat(2, 1fr);
      gap:0.6rem;
    }
    .agent-card {
      background:var(--oc-bg-card);
      border:1px solid var(--oc-border);
      border-radius:8px;
      padding:0.75rem 0.9rem;
      display:flex; flex-direction:column; gap:0.28rem;
    }
    .ac-header { display:flex; align-items:center; justify-content:space-between; gap:0.5rem; }
    .ac-name   { font-size:0.97rem; font-weight:700; }
    .ac-type   { font-size:0.67rem; color:var(--oc-text-muted); }
    .ac-role   { font-size:0.71rem; color:var(--oc-text-muted); font-style:italic; line-height:1.3;
                 display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .ac-hb     { font-size:0.68rem; color:var(--oc-text-muted); }
    .ac-footer-row { display:flex; align-items:center; justify-content:space-between; margin-top:2px; }
    .ac-clear  { font-size:0.67rem; color:var(--oc-text-faint); }

    /* ── Status badge ── */
    .badge {
      display:inline-block; padding:1px 7px;
      border-radius:9999px; font-size:0.67rem; font-weight:600;
      white-space:nowrap;
    }
    .badge-green  { background:var(--oc-success-soft); color:var(--oc-success-text); }
    .badge-red    { background:var(--oc-danger-soft); color:var(--oc-danger-text); }
    .badge-yellow { background:var(--oc-warning-soft); color:var(--oc-warning-text); }
    .badge-gray   { background:var(--oc-bg-hover); color:var(--oc-text-muted); }

    /* ── Agent card links ── */
    .ac-links { display:flex; gap:0.5rem; margin-top:0.35rem; }
    .ac-link   { font-size:0.7rem; color:var(--oc-text-muted); text-decoration:none; padding:1px 5px; border-radius:4px; border:1px solid var(--oc-border); }
    .ac-link:hover { color:var(--oc-text); border-color:var(--oc-border-strong); }

    /* ── Heatmap styles ── */
    .heatmap-section { margin-top:0; }
    .heatmap-grid {
      display:grid;
      grid-template-columns:52px repeat(7, 1fr);
      gap:3px;
      font-size:0.68rem;
    }
    .hm-agent-label {
      display:flex; align-items:center;
      font-size:0.7rem; font-weight:600;
      color:var(--oc-text-muted); padding-right:4px;
    }
    .hm-day-label {
      text-align:center; color:var(--oc-text-faint);
      padding-bottom:3px; font-size:0.62rem;
    }
    .hm-cell {
      height:26px; border-radius:3px;
      background:var(--oc-bg-card); border:1px solid var(--oc-border);
      cursor:default; position:relative;
      transition:transform .1s;
    }
    .hm-cell:hover { transform:scale(1.15); z-index:5; }
    .hm-cell .hm-tip {
      display:none; position:absolute;
      bottom:calc(100% + 5px); left:50%;
      transform:translateX(-50%);
      background:var(--oc-bg-hover); border:1px solid var(--oc-border-strong);
      border-radius:4px; padding:3px 7px;
      white-space:nowrap; font-size:0.68rem;
      color:var(--oc-text); pointer-events:none; z-index:20;
    }
    .hm-cell:hover .hm-tip { display:block; }
    .hm-legend {
      display:flex; gap:10px; align-items:center;
      margin-top:8px; font-size:0.65rem; color:var(--oc-text-faint);
    }
    .hm-legend-swatch {
      width:11px; height:11px; border-radius:2px; display:inline-block;
    }

    /* ── Agent health grid ── */
    .health-grid {
      display:grid; grid-template-columns:repeat(2, 1fr); gap:0.5rem;
    }
    .health-card {
      background:var(--oc-bg-card); border:1px solid var(--oc-border);
      border-radius:8px; padding:0.65rem 0.85rem;
      display:flex; flex-direction:column; gap:0.22rem;
      text-decoration:none;
      transition:border-color .15s, background .1s;
      -webkit-tap-highlight-color:transparent;
    }
    .health-card:hover { border-color:var(--oc-border-strong); background:var(--oc-bg-hover); }
    .hc-top     { display:flex; align-items:center; justify-content:space-between; gap:0.4rem; }
    .hc-name    { font-size:0.95rem; font-weight:700; }
    .hc-machine { font-size:0.67rem; color:var(--oc-text-muted); }
    .hc-hb      { font-size:0.7rem;  color:var(--oc-text-muted); }
    .hc-footer  { display:flex; align-items:center; justify-content:space-between; margin-top:3px; }
    .hc-alert   { font-size:0.67rem; font-weight:700; color:var(--oc-danger-text); }
    .hc-link    { font-size:0.67rem; color:var(--oc-text-muted); }
    .health-card:hover .hc-link { color:var(--oc-text); }
    .hc-dot        { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .hc-dot-green  { background:var(--oc-success); box-shadow: var(--oc-shadow); }
    .hc-dot-yellow { background:var(--oc-warning); }
    .hc-dot-red    { background:var(--oc-danger); }
    .hc-dot-gray   { background:var(--oc-bg-sunken); }
    /* ── Brain connectivity globe ── */
    .ac-brain-globe {
      display:inline-flex; align-items:center; justify-content:center;
      width:14px; height:14px; border-radius:50%;
      font-size:0.78rem; line-height:1;
      cursor:default; flex-shrink:0;
      position:relative;
    }
    /* tooltip on hover */
    .ac-brain-globe[data-tip]:hover::after {
      content:attr(data-tip);
      position:absolute; bottom:calc(100% + 4px); left:50%;
      transform:translateX(-50%);
      background:var(--oc-bg-hover); border:1px solid var(--oc-border-strong);
      border-radius:4px; padding:2px 7px;
      white-space:nowrap; font-size:0.64rem;
      color:var(--oc-text); pointer-events:none; z-index:20;
    }
    .globe-green  { text-shadow: var(--oc-shadow); }
    .globe-yellow { text-shadow: var(--oc-shadow); }
    .globe-red    { text-shadow: var(--oc-shadow); filter:grayscale(0.3); }
    .globe-gray   { opacity:0.35; }
    /* ── Top-of-page alert banner ── */
    #alert-banner {
      display:none;
      background:rgba(153,27,27,0.25);
      border:1px solid var(--oc-danger);
      border-radius:8px;
      padding:0.6rem 1rem;
      margin-bottom:1rem;
      font-size:0.82rem;
      color:var(--oc-danger-text);
      display:flex; align-items:center; gap:0.5rem;
    }
    #alert-banner .ab-count {
      font-weight:700; color:var(--oc-danger-text);
      font-size:1.05rem; line-height:1;
    }
    #alert-banner a {
      color:var(--oc-danger-text); text-decoration:underline; margin-left:auto;
      font-size:0.75rem; white-space:nowrap;
    }
    .alert-item {
      background:rgba(194,65,12,0.12);
      border:1px solid var(--oc-danger);
      border-radius:6px; padding:0.5rem 0.75rem;
      display:flex; gap:0.6rem; align-items:baseline;
      flex-wrap:wrap; font-size:0.8rem;
    }
    .al-actions { margin-left:auto; display:flex; gap:0.5rem; align-items:center; flex-shrink:0; }
    .al-action-link {
      font-size:0.68rem; font-weight:600; padding:2px 8px; border-radius:4px;
      text-decoration:none; white-space:nowrap; transition:background .12s;
    }
    .al-action-view {
      border:1px solid var(--oc-danger); color:var(--oc-warning-text);
      background:rgba(194,65,12,0.1);
    }
    .al-action-view:hover  { background:rgba(194,65,12,0.25); }
    .al-action-resolve {
      border:1px solid var(--oc-info); color:var(--oc-info-text);
      background:rgba(79,70,229,0.15);
    }
    .al-action-resolve:hover { background:rgba(79,70,229,0.3); border-color:var(--oc-accent); color:var(--oc-text); }
    .al-machine { font-weight:600; color:var(--oc-warning-text); }
    .al-type    { color:var(--oc-danger-text); flex:1; min-width:0; }
    .al-detail  { color:var(--oc-danger-text); font-size:0.72rem; width:100%; margin-top:2px;
                  padding-top:2px; border-top:1px solid rgba(154,52,18,0.3);
                  word-break:break-word; }
    .al-src-badge { font-size:0.62rem; font-weight:700; border-radius:3px;
                    padding:1px 4px; white-space:nowrap; flex-shrink:0; }
    .al-src-na    { background:rgba(220,38,38,0.25); color:var(--oc-danger-text); }
    .al-src-hberr { background:rgba(202,138,4,0.2);  color:var(--oc-warning-text); }
    .al-date    { color:var(--oc-text-muted); font-size:0.7rem; white-space:nowrap; }
    .al-open    { font-size:0.67rem; color:var(--oc-text-muted); white-space:nowrap; opacity:.7; }
    a.alert-item:hover .al-open { opacity:1; color:var(--oc-text-muted); }
    .no-alerts  { font-size:0.82rem; color:var(--oc-text-faint); padding:0.5rem 0; }

    /* ── Resolved / pending-verification alert row ── */
    .alert-item-resolved {
      background:rgba(120,53,15,0.06);
      border:1px solid var(--oc-border);
      border-left:3px solid var(--oc-warning);
      border-radius:6px; padding:0.5rem 0.75rem;
      display:flex; gap:0.6rem; align-items:baseline;
      flex-wrap:wrap; font-size:0.8rem;
      opacity:0.8;
    }
    .al-src-pending   { background:rgba(180,83,9,0.2);  color:var(--oc-danger-text); }
    .al-machine-res   { font-weight:600; color:var(--oc-danger-text); }
    .al-type-res      { color:var(--oc-danger-text); flex:1; min-width:0; }
    .al-date-res      { color:var(--oc-text-faint); font-size:0.7rem; white-space:nowrap; }
    .al-resolved-info {
      font-size:0.67rem; color:var(--oc-text-muted); font-style:italic;
      width:100%; margin-top:2px; padding-top:2px;
      border-top:1px solid rgba(69,26,3,0.4);
    }
    /* Resolution note  -  operator instructions, shown inline under PENDING VERIFY row */
    .al-resolution-note {
      display:block; font-style:normal; font-size:0.72rem;
      color:var(--oc-danger-text); margin-top:5px;
      padding:4px 8px;
      background:rgba(180,83,9,0.1);
      border-left:2px solid var(--oc-warning);
      border-radius:0 3px 3px 0;
      word-break:break-word;
    }

    /* ── Agent heartbeat sparkline ── */
    .ac-sparkline { margin-top:7px; }
    .ac-sparkline-hdr {
      display:flex; justify-content:space-between; align-items:baseline;
      font-size:0.6rem; color:var(--oc-text-faint); margin-bottom:3px;
    }
    .ac-sparkline-total { font-weight:700; font-size:0.7rem; }
    .ac-sparkline svg { overflow:visible; }
  </style>
</head>
<body>
  <%- include('partials/app-header') %>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/swarm' }) %>

    <main class="oc-dashboard-area">

      <!-- Top bar -->
      <div class="sw-topbar">
        <h1 class="sw-title">🌐 Swarm Overview</h1>
        <div class="sw-meta">
          <span id="sw-refresh-note"></span>
          <span id="sw-sync-ts"></span>
          <button class="sw-sync-btn" id="sync-btn" onclick="syncVault()">↻ Sync</button>
        </div>
      </div>

      <!-- Error -->
      <div class="sw-error" id="vault-error"></div>

      <!-- Alert banner (shown when there are unresolved issues) -->
      <div id="alert-banner" style="display:none">
        <span>🚨</span>
        <span><span class="ab-count" id="ab-count">0</span> active<span id="ab-pending-text" style="color:var(--oc-danger-text);font-weight:600"></span>  -  see Needs Attention below</span>
        <a href="#alerts-section">jump ↓</a>
      </div>

      <!-- Task board stats (2×2 grid, each links to filtered board) -->
      <div class="sw-section">📋 Project Tasks</div>
      <div class="stats-grid">
        <a href="/task-board?filter=inbox" class="stat-card sc-inbox">
          <div class="sc-top">
            <span class="sc-num" id="stat-inbox"> - </span>
            <span class="sc-label">📥 Inbox</span>
          </div>
          <div class="sc-preview" id="stat-inbox-preview">Loading…</div>
        </a>
        <a href="/task-board?filter=inprogress" class="stat-card sc-wip">
          <div class="sc-top">
            <span class="sc-num" id="stat-inprogress"> - </span>
            <span class="sc-label">🔄 In Progress</span>
          </div>
          <div id="stat-stuck" style="display:none;font-size:.63rem;font-weight:700;color:var(--oc-warning);margin-bottom:1px"></div>
          <div class="sc-preview" id="stat-wip-preview">Loading…</div>
        </a>
        <a href="/task-board?filter=blocked" class="stat-card sc-blocked">
          <div class="sc-top">
            <span class="sc-num" id="stat-blocked"> - </span>
            <span class="sc-label">🔴 Blocked</span>
          </div>
          <div class="sc-preview" id="stat-blocked-preview">Loading…</div>
        </a>
        <a href="/task-board?filter=done" class="stat-card sc-done">
          <div class="sc-top">
            <span class="sc-num" id="stat-done"> - </span>
            <span class="sc-label">✅ Done</span>
          </div>
          <div class="sc-preview" id="stat-done-preview">Loading…</div>
        </a>
      </div>

      <!-- Alerts (above Agents so issues are visible without scrolling) -->
      <div class="sw-section" id="alerts-section" style="display:flex;align-items:center;justify-content:space-between;">
        <span>🚨 Needs Attention <span id="alert-section-count" style="font-size:0.7rem;font-weight:400;color:var(--oc-text-muted);"></span></span>
      </div>
      <div id="alerts-container">
        <div style="color:var(--oc-text-faint); font-size:0.8rem;">Loading…</div>
      </div>

      <!-- Agents + Health -->
      <div class="sw-section" style="display:flex;align-items:center;justify-content:space-between;">
        <span>🤖 Agents</span>
        <a href="/activity" style="font-size:0.72rem;color:var(--oc-text-muted);text-decoration:none;font-weight:500;">Full Activity Log →</a>
      </div>
      <div class="agent-grid" id="agent-grid">
        <div style="color:var(--oc-text-faint); font-size:0.8rem;">Loading…</div>
      </div>

      <!-- Activity Heatmap -->
      <div class="sw-section">📊 7-Day Activity</div>
      <div class="heatmap-section">
        <div class="heatmap-grid" id="heatmap-grid">
          <div style="color:var(--oc-text-faint);font-size:.75rem;">Loading…</div>
        </div>
        <div class="hm-legend">
          <span>Less</span>
          <span class="hm-legend-swatch" style="background:var(--oc-bg-card);border:1px solid var(--oc-border)"></span>
          <span class="hm-legend-swatch" style="background:var(--oc-info-soft)"></span>
          <span class="hm-legend-swatch" style="background:var(--oc-info)"></span>
          <span class="hm-legend-swatch" style="background:var(--oc-info)"></span>
          <span class="hm-legend-swatch" style="background:var(--oc-bg-hover)"></span>
          <span>More</span>
        </div>
      </div>

      <!-- Agent Health section removed – merged into Agents above -->

      <!-- Bottom padding -->
      <div style="height:1.5rem; flex-shrink:0;"></div>

    </main>
  </div>

  <script>


    /* ── Helpers ── */
    function fmtDate(str) {
      if (!str) return 'never';
      try { return new Date(str).toLocaleString([], { month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }); }
      catch { return str; }
    }

    function statusBadge(raw) {
      if (!raw) return '<span class="badge badge-gray">unknown</span>';
      const s = raw.toLowerCase();
      if (s.includes('active') || s.includes('online') || s.includes('🟢'))
        return '<span class="badge badge-green">Active</span>';
      if (s.includes('offline') || s.includes('down') || s.includes('🔴'))
        return '<span class="badge badge-red">Offline</span>';
      if (s.includes('idle') || s.includes('🟡'))
        return '<span class="badge badge-yellow">Idle</span>';
      return '<span class="badge badge-gray">' + raw.replace(/🟢|🔴|🟡/g,'').trim() + '</span>';
    }

    /* ── Load ── */
    async function loadSummary() {
      const err = document.getElementById('vault-error');
      try {
        const [data, hbHistory, inst] = await Promise.all([
          fetch('/api/swarm/summary').then(r => r.json()),
          fetch('/api/heartbeat-history').then(r => r.json()).catch(() => ({})),
          fetch('/api/instance').then(r => r.json()).catch(() => ({})),
        ]);
        window.__OC_INSTANCE__ = inst || {};
        window.__OC_HEARTBEAT_AGENTS__ = inst.heartbeatAgents || {};
        window.__OC_HEARTBEAT_RULES__ = inst.heartbeatKeyRules || [];

        if (data.error) {
          err.style.display = 'block';
          err.textContent = '⚠️ Vault unavailable: ' + (data.details || data.error);
          document.getElementById('agent-grid').innerHTML =
            '<div style="color:var(--oc-text-faint);font-size:.8rem;">No data</div>';
          document.getElementById('alerts-container').innerHTML =
            '<div style="color:var(--oc-text-faint);font-size:.8rem;">No data</div>';
          return;
        }
        err.style.display = 'none';

        /* stats */
        const s  = (data.taskBoard && data.taskBoard.stats) || {};
        const tb = data.taskBoard || {};
        document.getElementById('stat-inbox').textContent      = s.inbox      ?? ' - ';
        document.getElementById('stat-inprogress').textContent = s.inProgress ?? ' - ';
        const stuckEl = document.getElementById('stat-stuck');
        if ((s.stuck || 0) > 0) { stuckEl.textContent = '\u26a0\ufe0f ' + s.stuck + ' stuck'; stuckEl.style.display = 'block'; }
        else { stuckEl.style.display = 'none'; }
        document.getElementById('stat-blocked').textContent    = s.blocked    ?? ' - ';
        document.getElementById('stat-done').textContent       = s.done       ?? ' - ';

        /* stat card previews */
        function scPreview(items, emptyText) {
          if (!items || !items.length) return emptyText || ' - ';
          const t = (items[0].title || '').replace(/\*\*/g,'').replace(/—.*$/,'').trim();
          return t.length > 80 ? t.slice(0,80)+'…' : (t||' - ');
        }
        document.getElementById('stat-inbox-preview').textContent =
          scPreview(tb.inbox, 'Nothing to assign');
        document.getElementById('stat-wip-preview').textContent =
          scPreview(tb.inProgress, 'Nothing active');
        document.getElementById('stat-blocked-preview').textContent = (() => {
          if (!tb.blocked || !tb.blocked.length) return '✅ Clear';
          const b = tb.blocked[0];
          const text = (b.reason || b.title || '').replace(/\*\*/g,'').trim();
          return text.length > 80 ? text.slice(0,80)+'…' : (text||' - ');
        })();
        document.getElementById('stat-done-preview').textContent = (() => {
          if (!tb.done || !tb.done.length) return 'None yet';
          const t = (tb.done[0].title || '').replace(/\*\*/g,'').replace(/—.*$/,'').trim();
          return t.length > 75 ? t.slice(0,75)+'…' : (t||' - ');
        })();

        /* agents + health */
        renderAgents(data, hbHistory);

        /* alerts */
        const alerts = data.alerts || [];

        // Top banner  -  separate active from pending-verification
        const activeAlerts  = alerts.filter(a => !a.isResolved);
        const pendingAlerts = alerts.filter(a => !!a.isResolved);
        const alertBanner   = document.getElementById('alert-banner');
        const abCountEl     = document.getElementById('ab-count');
        const abPendingEl   = document.getElementById('ab-pending-text');
        const alertSectCnt  = document.getElementById('alert-section-count');
        if (alerts.length > 0) {
          alertBanner.style.display = 'flex';
          abCountEl.textContent = activeAlerts.length;
          if (abPendingEl) abPendingEl.textContent = pendingAlerts.length > 0
            ? ' · ' + pendingAlerts.length + ' pending verify' : '';
          alertSectCnt.textContent = '(' + activeAlerts.length + ' active'
            + (pendingAlerts.length > 0 ? ', ' + pendingAlerts.length + ' pending verify' : '') + ')';
        } else {
          alertBanner.style.display = 'none';
          if (abPendingEl) abPendingEl.textContent = '';
          alertSectCnt.textContent = '';
        }

        document.getElementById('alerts-container').innerHTML = alerts.length
          ? '<div class="alert-list">' + alerts.map(a => {
              const isRes      = !!a.isResolved;
              const itemCls    = isRes ? 'alert-item-resolved' : 'alert-item';
              const docPath    = a.relPath ? '08 - QA-and-Monitoring/Heartbeats/' + a.relPath : null;
              const viewHref   = docPath ? `/vault/doc?path=${encodeURIComponent(docPath)}` : null;
              const resolveHref = (!isRes && a.relPath) ? `/resolve?alert=${encodeURIComponent(a.relPath)}` : null;
              const label      = (a.type || a.filename || '').replace(/[-_]/g,' ').trim();
              // Build "AgentName: HostName" label for the machine column
              const ALERT_AGENTS = Object.entries((window.__OC_HEARTBEAT_AGENTS__) || {}).map(([name, keys]) => ({ name, keys }));
              const machineRaw  = a.machine !== 'unknown' ? a.machine : null;
              const alertAgent  = ALERT_AGENTS.find(ag =>
                machineRaw && ag.keys.some(k => machineRaw.toLowerCase().startsWith(k.split('/')[0].toLowerCase()))
              );
              const machineLabel = machineRaw
                ? (alertAgent ? alertAgent.name + ': ' + machineRaw : machineRaw)
                : '⚠️';
              const srcCls     = isRes ? 'al-src-pending'
                               : a.alertSource === 'needs-attention' ? 'al-src-na' : 'al-src-hberr';
              const srcLbl     = isRes ? 'PENDING VERIFY'
                               : a.alertSource === 'needs-attention' ? 'NEEDS-ATTN' : 'HB-ERROR';
              const machineCls = isRes ? 'al-machine-res' : 'al-machine';
              const typeCls    = isRes ? 'al-type-res'    : 'al-type';
              const dateCls    = isRes ? 'al-date-res'    : 'al-date';
              // Active items show error detail; resolved items show resolution note
              const detail = (!isRes && a.alertDetail)
                ? `<span class="al-detail">${a.alertDetail.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</span>`
                : '';
              const resolvedMeta = isRes
                ? '<span class="al-resolved-info">✓ '
                  + (a.resolvedBy || 'Marked resolved').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                  + (a.resolvedAt ? ' · ' + fmtDate(a.resolvedAt) : '')
                  + '  -  awaiting next clean run to confirm</span>'
                  + (a.resolutionNote
                    ? '<span class="al-resolution-note">'
                      + a.resolutionNote.replace(/</g,'&lt;').replace(/>/g,'&gt;')
                      + '</span>'
                    : '')
                : '';
              const actions = (viewHref || resolveHref) ? `
                <span class="al-actions">
                  ${viewHref    ? `<a class="al-action-link al-action-view"    href="${viewHref}"    target="_blank">View</a>` : ''}
                  ${resolveHref ? `<a class="al-action-link al-action-resolve" href="${resolveHref}">Resolve</a>` : ''}
                </span>` : '';
              return `<div class="${itemCls}">
                <span class="${machineCls}">${machineLabel}</span>
                <span class="al-src-badge ${srcCls}">${srcLbl}</span>
                <span class="${typeCls}">${label}</span>
                <span class="${dateCls}">${fmtDate(a.date)}</span>
                ${actions}
                ${detail}${resolvedMeta}
              </div>`;
            }).join('') + '</div>'
          : '<div class="no-alerts">✅ No unhandled alerts</div>';

        /* heatmap */
        renderHeatmap(data.heatmap || { days: [], agents: [] });

        /* agent health merged into renderAgents above */

        document.getElementById('sw-refresh-note').textContent =
          'Updated ' + new Date().toLocaleTimeString();

      } catch(e) {
        err.style.display = 'block';
        err.textContent = '⚠️ ' + e.message;
      }
    }

    async function syncVault() {
      const btn = document.getElementById('sync-btn');
      const ts  = document.getElementById('sw-sync-ts');
      btn.disabled = true; btn.textContent = '↻ Refreshing…';
      try {
        await loadSummary();
        ts.textContent = '· refreshed ' + new Date().toLocaleTimeString();
      } catch(e) {
        ts.textContent = '· error: ' + e.message;
      } finally {
        btn.disabled = false; btn.textContent = '↻ Sync';
      }
    }

    loadSummary();
    setInterval(loadSummary, 30000);

    /* ── Heatmap renderer ── */
    function renderHeatmap({ days, agents }) {
      const grid = document.getElementById('heatmap-grid');
      if (!days || !days.length) { grid.innerHTML = '<div style="color:var(--oc-text-faint);font-size:.75rem;">No data</div>'; return; }

      // Color scale per agent (4 levels + zero)
      const defaultScale = ['var(--oc-heat-0)','var(--oc-heat-1)','var(--oc-heat-2)','var(--oc-heat-3)','var(--oc-heat-4)'];
      const scales = Object.assign({}, (window.__OC_INSTANCE__ && window.__OC_INSTANCE__.heatmapScales) || {});
      function cellColor(name, n) {
        const s = scales[name] || defaultScale;
        if (n === 0) return s[0];
        if (n <= 3)  return s[1];
        if (n <= 7)  return s[2];
        if (n <= 14) return s[3];
        return s[4];
      }

      const dayLabels = days.map(d => {
        const dt = new Date(d + 'T12:00:00');
        return dt.toLocaleDateString([], { month:'short', day:'numeric' });
      });

      let html = '';
      // Day header row
      html += '<div></div>'; // blank corner
      for (const lbl of dayLabels) {
        html += `<div class="hm-day-label">${lbl}</div>`;
      }
      // Agent rows
      for (const agent of agents) {
        html += `<div class="hm-agent-label" style="color:${(scales[agent.name]||defaultScale)[3]}">${agent.name}</div>`;
        agent.counts.forEach((n, i) => {
          const bg  = cellColor(agent.name, n);
          const tip = `${agent.name} · ${dayLabels[i]} · ${n} commit${n!==1?'s':''}`;
          html += `<div class="hm-cell" style="background:${bg}" title="${tip}"><span class="hm-tip">${tip}</span></div>`;
        });
      }
      grid.innerHTML = html;
    }

    /* ── Sparkline renderer (per-agent heartbeat history) ── */
    function renderSparkline(hist, color) {
      const days   = (hist && hist.days)   ? hist.days   : Array(7).fill('');
      const counts = (hist && hist.counts) ? hist.counts : Array(7).fill(0);
      const n      = days.length;
      const max    = Math.max(...counts, 1);
      const total  = counts.reduce((a, b) => a + b, 0);
      const W = 100, H = 20, barW = W / n;

      let rects = '';
      for (let i = 0; i < n; i++) {
        const c  = counts[i];
        const bh = c > 0 ? Math.max(3, (c / max) * H) : 2;
        const bx = (i * barW + 0.5).toFixed(1);
        const by = (H - bh).toFixed(1);
        const op = c > 0 ? (0.35 + 0.65 * (c / max)).toFixed(2) : '0.07';
        let tipEl = '/>';
        if (days[i]) {
          try {
            const lbl = new Date(days[i] + 'T12:00:00')
              .toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });
            tipEl = '><title>' + lbl + ': ' + c + ' check-in' + (c !== 1 ? 's' : '') + '</title></rect>';
          } catch { tipEl = '/>'; }
        }
        rects += '<rect x="' + bx + '" y="' + by + '" width="' + (barW - 1.5).toFixed(1)
          + '" height="' + bh.toFixed(1) + '" fill="' + color + '" opacity="' + op + '" rx="1.5"' + tipEl;
      }
      // subtle baseline
      rects += '<line x1="0" y1="' + H + '" x2="' + W + '" y2="' + H
        + '" stroke="' + color + '" stroke-opacity="0.15" stroke-width="0.75"/>';

      // day-of-week labels
      const dayLabels = days.map(function(d) {
        if (!d) return '\u00b7';
        const dt = new Date(d + 'T12:00:00');
        if (Number.isNaN(dt.getTime())) return '\u00b7';
        try { return dt.toLocaleDateString([], { weekday: 'narrow' }); }
        catch  { return '\u00b7'; }
      });
      const lblRow = dayLabels.map(function(l, i) {
        return '<span style="font-size:.55rem;color:' + (i === n - 1 ? color : 'var(--oc-text-faint)')
          + ';font-weight:' + (i === n - 1 ? '700' : '400') + '">' + l + '</span>';
      }).join('');

      return '<div class="ac-sparkline">'
        + '<div class="ac-sparkline-hdr"><span>\u{1F493} 7d history</span>'
        + '<span class="ac-sparkline-total" style="color:' + color + '">' + total + '</span></div>'
        + '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" height="20" preserveAspectRatio="none" style="display:block;margin-bottom:2px">'
        + rects + '</svg>'
        + '<div style="display:flex;justify-content:space-around">' + lblRow + '</div>'
        + '</div>';
    }

    /* ── Agent + health renderer ── */
    function renderAgents(data, hbHistory = {}) {
      const grid     = document.getElementById('agent-grid');
      const hbMap    = data.lastHeartbeat || {};
      const alts     = data.alerts || [];
      const regs     = data.agents || [];
      // Brain activity map: agent (lowercase) → { last_ts, last_read_ts, last_write_ts, recent_error }
      const brainAct = {};
      (data.brainActivity || []).forEach(b => { brainAct[b.agent.toLowerCase()] = b; });

      // Derive heartbeat dir key(s) from vault registry row machine/type fields
      function deriveHeartbeatKeys(reg) {
        const nick = (reg.nickname || '').toLowerCase();
        const mach = (reg.machine || '').toLowerCase();
        const type = (reg.type || '').toLowerCase();
        const rules = window.__OC_HEARTBEAT_RULES__ || [];
        for (const rule of rules) {
          const m = rule.match || {};
          if (m.requireNickname && nick !== String(m.requireNickname).toLowerCase()) continue;
          const checks = [];
          if (Array.isArray(m.nicknameIn)) checks.push(m.nicknameIn.map(s => String(s).toLowerCase()).includes(nick));
          if (Array.isArray(m.machineIncludes)) checks.push(m.machineIncludes.some(s => mach.includes(String(s).toLowerCase())));
          if (Array.isArray(m.typeIncludes)) checks.push(m.typeIncludes.some(s => type.includes(String(s).toLowerCase())));
          if (m.nickname) checks.push(nick === String(m.nickname).toLowerCase());
          if (!checks.length) continue;
          const ok = rule.requireAll ? checks.every(Boolean) : checks.some(Boolean);
          if (ok && Array.isArray(rule.keys) && rule.keys.length) return rule.keys;
        }
        return [reg.nickname || 'unknown'];
      }
      const _HM_COLORS = {};
      ((data.heatmap && data.heatmap.agents) || []).forEach(a => {
        _HM_COLORS[a.name.toLowerCase()] = a.color;
      });
      const _PALETTE = ['var(--oc-series-1)','var(--oc-series-2)','var(--oc-series-3)','var(--oc-series-4)','var(--oc-series-5)','var(--oc-series-6)','var(--oc-series-7)','var(--oc-series-8)'];
      // Build AGENTS dynamically  -  any active agent in the vault registry shows up automatically
      const AGENTS = regs
        .filter(r => (r.status || '').includes('Active'))
        .map((r, i) => {
          const name  = (r.nickname || r.agent || 'Agent').trim();
          const color = _HM_COLORS[name.toLowerCase()] || _PALETTE[i % _PALETTE.length];
          return { name, color, keys: deriveHeartbeatKeys(r) };
        });

      function timeAgo(d) {
        if (!d) return 'never';
        const ms = Date.now() - new Date(d).getTime();
        const h  = ms / 3600000;
        if (h < 1)  return Math.round(ms / 60000) + 'm ago';
        if (h < 24) return Math.round(h) + 'h ago';
        if (h < 48) return 'yesterday';
        return Math.round(h / 24) + 'd ago';
      }

      function dotCls(d) {
        if (!d) return 'hc-dot-gray';
        const h = (Date.now() - new Date(d).getTime()) / 3600000;
        if (h < 24) return 'hc-dot-green';
        if (h < 72) return 'hc-dot-yellow';
        return 'hc-dot-red';
      }

      grid.innerHTML = AGENTS.map(ag => {
        const hb   = ag.keys.map(k => hbMap[k]).find(Boolean) || null;
        const date = hb ? (hb.date || null) : null;
        const cnt  = alts.filter(a =>
          !a.isResolved &&
          ag.keys.some(k => (a.machine || '').toLowerCase().startsWith(k.split('/')[0].toLowerCase()))
        ).length;
        const pendingCnt = alts.filter(a =>
          !!a.isResolved &&
          ag.keys.some(k => (a.machine || '').toLowerCase().startsWith(k.split('/')[0].toLowerCase()))
        ).length;
        const reg  = regs.find(r => (r.nickname || r.agent || '').toLowerCase().includes(ag.name.toLowerCase())) || {};
        const role = (reg.primary_role || reg.role || '').replace(/\s—\s.*/, '').trim();
        const mach = reg.machine || ag.keys[0];
        const type = reg.type || 'AI Agent';

        //  -  Brain connectivity globe  - 
        const act    = brainAct[ag.name.toLowerCase()] || null;
        const NOW    = Date.now();
        const WINDOW = 15 * 60 * 1000; // 15 min
        let globeCls = 'globe-gray', globeTip = 'No brain activity recorded';
        if (act) {
          const last   = act.last_ts || 0;
          const recent = (NOW - last) < WINDOW;
          const hasErr = !!act.recent_error;
          if (hasErr) {
            globeCls = 'globe-yellow';
            const ago = timeAgo(new Date(last));
            globeTip = `Brain errors in last 15 min · last activity ${ago} (${act.last_op || '?'})`;
          } else if (recent) {
            globeCls = 'globe-green';
            const ago = timeAgo(new Date(last));
            globeTip = `Brain connected · last ${act.last_op || 'activity'} ${ago}`;
            if (act.last_path) globeTip += `: ${act.last_path.split('/').pop()}`;
          } else {
            globeCls = 'globe-red';
            const ago = timeAgo(new Date(last));
            globeTip = `No brain activity in 15+ min · last ${act.last_op || 'activity'} ${ago}`;
          }
        }
        const globeIcon = `<span class="ac-brain-globe ${globeCls}" data-tip="${globeTip}" title="${globeTip}">🌐</span>`;

        return `<div class="agent-card">
          <div class="ac-header">
            <span class="ac-name" style="color:${ag.color}">${ag.name}</span>
            ${globeIcon}
            <span class="hc-dot ${dotCls(date)}"></span>
          </div>
          <div class="ac-type">${type} · ${mach}</div>
          ${role ? `<div class="ac-role">${role}</div>` : ''}
          <div class="ac-footer-row">
            <span class="ac-hb">💓 ${timeAgo(date)}</span>
            ${cnt > 0
              ? `<span class="hc-alert">⚠️ ${cnt} alert${cnt > 1 ? 's' : ''}</span>`
              
                : pendingCnt > 0
                  ? `<span style="font-size:0.67rem;font-weight:700;color:var(--oc-danger-text);">⏳ ${pendingCnt} pending verify</span>`
                  : '<span class="ac-clear">✓ clear</span>'}
          </div>
          ${renderSparkline(hbHistory[ag.name], ag.color)}
          <div class="ac-links">
            <a href="/vault/graph" class="ac-link">🕸️ Graph</a>
            <a href="/vault/doc?path=${encodeURIComponent('03 - Agents/Agent Registry.md')}" class="ac-link">📋 Registry</a>
            <a href="/activity?agent=${encodeURIComponent(ag.name)}" class="ac-link">📡 Activity</a>
          </div>
        </div>`;
      }).join('');
    }
    fetch('/api/brain/stats').then(r=>r.json()).then(d => {
      if (d.last_updated)
        document.getElementById('sw-sync-ts').textContent =
          '\u00b7 brain updated ' + new Date(d.last_updated).toLocaleTimeString();
    }).catch(()=>{});
  </script>
<%- include('partials/chrome-end') %>
</body>
</html>
