<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">AGENT DASHBOARD</span></a></div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>
  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/nodes' }) %>
    <main class="oc-dashboard-area">
      <div id="nodes-err" style="display:none;color:#f87171;font-size:.82rem;margin-bottom:.5rem"></div>
      <div id="nodes-setup" style="display:none;color:#6b7280;font-size:.82rem;line-height:1.7;padding:.4rem 0;margin-bottom:.75rem">
        <strong style="color:#9ca3af">No nodes configured.</strong><br>
        Copy <code style="font-size:.75rem;color:#818cf8">config/instance.example.json</code>
        to <code style="font-size:.75rem;color:#818cf8">config/instance.json</code>
        and fill in your machine details.<br>
        <span style="font-size:.72rem;color:#4b5563">That file is gitignored — safe to include IPs, Tailscale addresses, and ports.</span>
      </div>
      <div id="nodes-table-wrap" style="display:none">
        <div class="oc-table-toolbar">
          <input type="search" id="q" class="oc-search-input" placeholder="Search nodes…">
          <span class="oc-count-badge" id="row-count">–</span>
        </div>
        <div class="oc-table-wrap">
          <table class="oc-data-table" id="nodes-tbl">
            <thead><tr>
              <th data-sort="name">Name</th>
              <th data-sort="os">OS</th>
              <th data-sort="ip">IP</th>
              <th data-sort="tailscale">Tailscale</th>
              <th data-sort="agentsStr">Agents</th>
              <th data-sort="hbDate">Heartbeat</th>
              <th class="no-sort">Actions</th>
            </tr></thead>
            <tbody id="nodes-tbody"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <script>
    /* ── sidebar/theme ── */
    (function(){
      const sb=document.getElementById('oc-sidebar'),btn=document.getElementById('sidebar-toggle');
      let col=localStorage.getItem('overclaw-sidebar-collapsed')==='true';
      if(col)sb.classList.add('collapsed');
      btn.addEventListener('click',()=>{col=!col;sb.classList.toggle('collapsed',col);localStorage.setItem('overclaw-sidebar-collapsed',col);});
      const th=document.getElementById('theme-toggle');
      let tm=localStorage.getItem('overclaw-theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
      document.body.classList.add(tm+'-mode');th.textContent=tm==='dark'?'🌙':'☀️';
      th.addEventListener('click',()=>{tm=tm==='light'?'dark':'light';document.body.classList.toggle('light-mode',tm==='light');document.body.classList.toggle('dark-mode',tm==='dark');localStorage.setItem('overclaw-theme',tm);th.textContent=tm==='dark'?'🌙':'☀️';});
    })();

    function timeAgo(d){
      if(!d)return null;
      const ms=Date.now()-new Date(d).getTime(),h=ms/3600000;
      if(h<1)return Math.round(ms/60000)+'m ago';
      if(h<24)return Math.round(h)+'h ago';
      if(h<48)return 'yesterday';
      if(h<168)return Math.round(h/24)+'d ago';
      return Math.round(h/168)+'w ago';
    }
    function hbDot(d){
      if(!d)return 'gray';
      const h=(Date.now()-new Date(d).getTime())/3600000;
      return h<24?'green':h<72?'yellow':'red';
    }

    let rows=[], sortKey='name', sortDir=1, searchQ='';

    function applyAndRender(){
      let vis=rows.filter(r=>{
        if(searchQ){
          const h=[r.name,r.os,r.ip||'',r.tailscale||'',r.agentsStr].join(' ').toLowerCase();
          if(!h.includes(searchQ))return false;
        }
        return true;
      });
      if(sortKey){
        vis=[...vis].sort((a,b)=>{
          const va=String(a[sortKey]||'').toLowerCase(),vb=String(b[sortKey]||'').toLowerCase();
          return sortDir*va.localeCompare(vb);
        });
      }
      const tbody=document.getElementById('nodes-tbody');
      tbody.innerHTML=vis.length ? vis.map(r=>`
        <tr>
          <td style="font-weight:700;color:${r.color||'#e2e8f0'}">${r.name}</td>
          <td style="font-size:.75rem;color:#9ca3af">${r.os||'—'}</td>
          <td class="${r.ip?'':'dim'}" style="font-family:monospace;font-size:.74rem">${r.ip||'—'}</td>
          <td class="${r.tailscale?'':'dim'}" style="font-family:monospace;font-size:.74rem">${r.tailscale||'—'}</td>
          <td style="font-size:.75rem;color:#9ca3af">${r.agentsStr||'—'}</td>
          <td style="white-space:nowrap;font-size:.78rem">
            <span class="oc-hb-dot ${r.hbDot}"></span>${r.hbAgo||'<span style="color:#374151;font-style:italic">never</span>'}
          </td>
          <td><div class="oc-action-btns">
            ${r.links.map(l=>`<a href="${l.href}" class="oc-action-btn">${l.label}</a>`).join('')}
          </div></td>
        </tr>`).join('')
        : '<tr class="oc-empty-row"><td colspan="7">No nodes match.</td></tr>';
      document.getElementById('row-count').textContent=vis.length+' / '+rows.length;
      document.querySelectorAll('#nodes-tbl th[data-sort]').forEach(th=>{
        th.classList.remove('sort-asc','sort-desc');
        if(th.dataset.sort===sortKey)th.classList.add(sortDir>0?'sort-asc':'sort-desc');
      });
    }

    document.addEventListener('click',e=>{
      const th=e.target.closest('#nodes-tbl th[data-sort]');
      if(!th)return;
      const k=th.dataset.sort;
      if(sortKey===k)sortDir*=-1;else{sortKey=k;sortDir=1;}
      applyAndRender();
    });
    document.getElementById('q').addEventListener('input',e=>{searchQ=e.target.value.toLowerCase().trim();applyAndRender();});

    async function load(){
      const err=document.getElementById('nodes-err');
      const setup=document.getElementById('nodes-setup');
      const wrap=document.getElementById('nodes-table-wrap');
      try{
        const [nodes,summary]=await Promise.all([
          fetch('/api/instance-nodes').then(r=>r.json()),
          fetch('/api/swarm/summary').then(r=>r.json()),
        ]);
        if(!nodes.length){setup.style.display='block';return;}
        const hbMap=summary.lastHeartbeat||{};
        rows=nodes.map(n=>{
          const hb=hbMap[n.hbKey];
          const hbDate=hb?hb.date||null:null;
          return{
            name:n.name,os:n.os||'',
            ip:n.ip||null,tailscale:n.tailscale||null,
            agentsStr:(n.agents||[]).join(', '),
            color:n.color||'#e2e8f0',
            hbDate:hbDate||'',hbAgo:timeAgo(hbDate)||null,hbDot:hbDot(hbDate),
            links:n.links||[],
          };
        });
        wrap.style.display='block';
        applyAndRender();
      }catch(e){
        err.style.display='block';
        err.textContent='⚠️ Failed to load: '+e.message;
      }
    }
    load();
  </script>
</body>
</html>
