<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
<%- include('partials/sidebar', { currentPath: '/cron-jobs' }) %>

        <main class="oc-dashboard-area">
            <div class="oc-card full-width">
                <h2>OpenClaw Cron Jobs</h2>
                <div id="cron-list">
                    <p>Loading cron job information...</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');

        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) sidebar.classList.add('collapsed');

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            sidebarCollapsed ? sidebar.classList.add('collapsed') : sidebar.classList.remove('collapsed');
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        themeToggle.textContent = currentTheme === 'dark' ? '🌙' : '☀️';

        themeToggle.addEventListener('click', () => {
            currentTheme = currentTheme === 'light' ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            themeToggle.textContent = currentTheme === 'dark' ? '🌙' : '☀️';
        });

        async function fetchCronJobs() {
            const cronListDiv = document.getElementById('cron-list');
            try {
                const response = await fetch('/api/cron-jobs');
                const data = await response.json();

                if (data.error) {
                    cronListDiv.innerHTML = `<p style="color: red;">Error: ${data.error}</p>`;
                    return;
                }

                const jobs = data.jobs || [];
                if (jobs.length === 0) {
                    cronListDiv.innerHTML = '<p>No cron jobs found.</p>';
                    return;
                }

                const table = document.createElement('table');
                table.className = 'oc-agent-table';
                table.innerHTML = `
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Schedule</th>
                            <th>Enabled</th>
                            <th>Last Run</th>
                            <th>Status</th>
                            <th>Last Error / Output</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                `;
                const tbody = table.querySelector('tbody');

                jobs.forEach(job => {
                    const row = tbody.insertRow();
                    const schedule = job.schedule?.expr || (job.schedule?.everyMs ? `${job.schedule.everyMs / 1000 / 60} min` : 'Unknown');
                    const lastRunMs = job.state?.lastRunAtMs;
                    const lastRun = lastRunMs ? new Date(lastRunMs).toLocaleString() : 'Never';
                    const status = job.state?.lastRunStatus || 'Unknown';
                    
                    let lastErrorOrOutput = 'N/A';
                    if (job.state?.lastError) {
                        lastErrorOrOutput = `<span style="color: red;">${job.state.lastError.substring(0, 100)}...</span>`; // Truncate long errors
                    } else if (job.payload?.message) {
                        lastErrorOrOutput = job.payload.message.substring(0, 100) + '...'; // Display task message
                    }

                    row.innerHTML = `
                        <td>${job.name || 'Unnamed'}</td>
                        <td><code>${schedule}</code></td>
                        <td>${job.enabled ? '✅ Yes' : '❌ No'}</td>
                        <td>${lastRun}</td>
                        <td>${status}</td>
                        <td>${lastErrorOrOutput}</td>
                    `;
                });

                cronListDiv.innerHTML = '';
                cronListDiv.appendChild(table);

            } catch (error) {
                console.error('Error fetching cron jobs:', error);
                cronListDiv.innerHTML = '<p style="color: red;">Failed to load cron jobs.</p>';
            }
        }

        document.addEventListener('DOMContentLoaded', fetchCronJobs);
    </script>
</body>
</html>
