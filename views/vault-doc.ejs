<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Markdown renderer -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- Syntax highlighting -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github-dark.min.css">
  <script src="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/lib/highlight.min.js"></script>
  <style>
    /* ── Layout overrides ── */
    .oc-main-content {
      overflow: hidden !important;
      height: calc(100vh - 60px);
    }
    .oc-dashboard-area {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: unset !important;
      overflow: hidden !important;
      padding: 0.75rem 1.25rem !important;
      gap: 0 !important;
    }

    /* ── Top bar ── */
    .vd-topbar {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-shrink: 0;
      padding-bottom: 0.65rem;
      flex-wrap: wrap;
      min-height: 36px;
    }
    .vd-back {
      font-size: 0.78rem;
      color: #6b7280;
      text-decoration: none;
      padding: 2px 8px;
      border: 1px solid #1f2937;
      border-radius: 4px;
      white-space: nowrap;
    }
    .vd-back:hover { color: #e2e8f0; border-color: #374151; }
    .vd-breadcrumb {
      font-size: 0.78rem;
      color: #6b7280;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.15rem;
      flex: 1;
      min-width: 0;
    }
    .vd-crumb {
      color: #9ca3af;
      text-decoration: none;
      white-space: nowrap;
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .vd-crumb:hover { color: #e2e8f0; }
    .vd-crumb-sep { color: #374151; }
    .vd-crumb-last { color: #e2e8f0; font-weight: 500; }
    .vd-graph-link {
      font-size: 0.75rem;
      color: #818cf8;
      text-decoration: none;
      padding: 2px 8px;
      border: 1px solid #312e5f;
      border-radius: 4px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .vd-graph-link:hover { color: #a5b4fc; border-color: #4338ca; }

    /* ── Error / loading banners ── */
    .vd-error {
      display: none;
      background: #1c1917;
      border: 1px solid #78350f;
      border-radius: 6px;
      padding: 0.55rem 1rem;
      color: #fde68a;
      font-size: 0.82rem;
      margin-bottom: 0.6rem;
      flex-shrink: 0;
    }
    .vd-loading {
      color: #4b5563;
      font-size: 0.82rem;
      padding: 2rem;
      text-align: center;
    }

    /* ── Content scroll area ── */
    .vd-scroll {
      flex: 1;
      overflow-y: auto;
      min-height: 0;
      scrollbar-width: thin;
      scrollbar-color: #374151 transparent;
    }
    .vd-scroll::-webkit-scrollbar { width: 5px; }
    .vd-scroll::-webkit-scrollbar-track { background: transparent; }
    .vd-scroll::-webkit-scrollbar-thumb { background: #374151; border-radius: 3px; }

    /* ── Rendered markdown ── */
    .vault-doc-body { max-width: 820px; padding-bottom: 3rem; }
    .vault-doc-body h1, .vault-doc-body h2, .vault-doc-body h3, .vault-doc-body h4 { color: #e2e8f0; margin-top: 1.5rem; }
    .vault-doc-body h1 { font-size: 1.4rem; border-bottom: 1px solid #374151; padding-bottom: 0.4rem; }
    .vault-doc-body h2 { font-size: 1.15rem; }
    .vault-doc-body h3 { font-size: 1rem; }
    .vault-doc-body h4 { font-size: 0.9rem; }
    .vault-doc-body p  { color: #cbd5e1; line-height: 1.7; }
    .vault-doc-body a  { color: #60a5fa; }
    .vault-doc-body a:hover { color: #93c5fd; }
    .vault-doc-body code { background: #1e2533; padding: 1px 5px; border-radius: 3px; font-size: 0.85em; color: #a5f3fc; }
    .vault-doc-body pre  { background: #0f1117; border: 1px solid #1f2937; border-radius: 6px; padding: 1rem; overflow-x: auto; }
    .vault-doc-body pre code { background: none; padding: 0; font-size: 0.82em; color: inherit; }
    .vault-doc-body blockquote { border-left: 3px solid #374151; margin-left: 0; padding-left: 1rem; color: #6b7280; }
    .vault-doc-body table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
    .vault-doc-body th, .vault-doc-body td { border: 1px solid #374151; padding: 6px 10px; text-align: left; }
    .vault-doc-body th { background: #1f2937; color: #e2e8f0; }
    .vault-doc-body ul, .vault-doc-body ol { color: #cbd5e1; line-height: 1.7; padding-left: 1.5rem; }
    .vault-doc-body hr { border: none; border-top: 1px solid #374151; margin: 1.5rem 0; }
    .vault-doc-body img { max-width: 100%; border-radius: 4px; }

    /* ── Directory listing ── */
    .dir-listing {
      display: flex; flex-direction: column; gap: 2px;
      max-width: 680px;
    }
    .dir-group-label {
      font-size: 0.65rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: #4b5563;
      margin: 0.9rem 0 0.3rem;
    }
    .dir-entry {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.38rem 0.6rem;
      border-radius: 5px;
      font-size: 0.85rem; color: #cbd5e1;
      text-decoration: none;
      border: 1px solid transparent;
      transition: background .1s, border-color .1s;
    }
    .dir-entry:hover {
      background: #1f2937; border-color: #374151; color: #e2e8f0;
    }
    .dir-entry[href*="type=dir"], .dir-entry.dir-up {
      color: #93c5fd;
    }
    .dir-up { color: #6b7280 !important; font-size: 0.78rem; }
    .dir-readme-divider {
      margin: 1.5rem 0 0.75rem;
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.08em; color: #4b5563;
      border-top: 1px solid #1f2937; padding-top: 1rem;
    }
  </style>
</head>
<body>
  <header class="oc-header">
    <div class="logo">
      <h1 class="main-title">OVERCLAW</h1>
      <span class="tagline">VAULT DOC</span>
    </div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/vault/doc' }) %>

    <main class="oc-dashboard-area">

      <!-- Top bar -->
      <div class="vd-topbar">
        <a href="javascript:history.back()" class="vd-back">← Back</a>
        <div class="vd-breadcrumb" id="vd-breadcrumb"></div>
        <a href="/vault/graph" class="vd-graph-link">🕸️ Graph</a>
      </div>

      <!-- Error banner -->
      <div class="vd-error" id="vd-error"></div>

      <!-- Content -->
      <div class="vd-scroll">
        <div id="vd-body">
          <div class="vd-loading">Loading…</div>
        </div>
      </div>

    </main>
  </div>

  <script>
    /* ── Sidebar / theme boilerplate ── */
    (function () {
      const toggle  = document.getElementById('sidebar-toggle');
      const sidebar = document.getElementById('oc-sidebar');
      if (toggle && sidebar) {
        let collapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (collapsed) sidebar.classList.add('collapsed');
        toggle.addEventListener('click', () => {
          collapsed = !collapsed;
          sidebar.classList.toggle('collapsed', collapsed);
          localStorage.setItem('overclaw-sidebar-collapsed', collapsed);
        });
      }
      const themeBtn = document.getElementById('theme-toggle');
      const prefer   = window.matchMedia('(prefers-color-scheme: dark)');
      let theme = localStorage.getItem('overclaw-theme') || (prefer.matches ? 'dark' : 'light');
      document.body.classList.add(theme + '-mode');
      themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
      themeBtn.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        document.body.classList.toggle('dark-mode',  theme === 'dark');
        document.body.classList.toggle('light-mode', theme === 'light');
        themeBtn.textContent = theme === 'dark' ? '🌙' : '☀️';
        localStorage.setItem('overclaw-theme', theme);
      });
    })();

    /* ── Marked config ── */
    marked.use({ gfm: true, breaks: true });

    /* ── Breadcrumb ── */
    function renderBreadcrumb(filePath) {
      if (!filePath) return;
      const parts = filePath.split('/');
      const crumbEl = document.getElementById('vd-breadcrumb');
      let html = '';
      let builtPath = '';
      parts.forEach((part, i) => {
        builtPath += (i > 0 ? '/' : '') + part;
        const isLast = i === parts.length - 1;
        if (i > 0) html += '<span class="vd-crumb-sep">/</span>';
        if (isLast) {
          html += `<span class="vd-crumb vd-crumb-last">${esc(part)}</span>`;
        } else {
          html += `<a class="vd-crumb" href="/vault/doc?path=${encodeURIComponent(builtPath)}">${esc(part)}</a>`;
        }
      });
      crumbEl.innerHTML = html;
    }

    function esc(s) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    /* ── Pre-process wiki links before passing to marked ── */
    function preprocessWikiLinks(raw) {
      // [[Page Name|Display Text]] -> [Display Text](/vault/doc?path=__wiki__Page%20Name)
      // [[Page Name]] -> [Page Name](/vault/doc?path=__wiki__Page%20Name)
      return raw
        .replace(/\[\[([^\]|]+)\|([^\]]+)\]\]/g, (_, link, display) =>
          `[${display}](/vault/doc?path=__wiki__${encodeURIComponent(link.trim())})`)
        .replace(/\[\[([^\]|]+)\]\]/g, (_, link) =>
          `[${link.trim()}](/vault/doc?path=__wiki__${encodeURIComponent(link.trim())})`);
    }

    /* ── Rewrite relative .md links ── */
    function rewriteMdLinks(raw, filePath) {
      const fileDir = filePath.includes('/') ? filePath.substring(0, filePath.lastIndexOf('/')) : '';
      return raw.replace(/\[([^\]]*)\]\(([^)]+\.md[^)]*)\)/g, (match, text, href) => {
        if (href.startsWith('http') || href.startsWith('/') || href.startsWith('__wiki__')) {
          return match;
        }
        // strip anchor
        const [hrefPath, anchor] = href.split('#');
        const resolved = fileDir ? fileDir + '/' + hrefPath : hrefPath;
        const encoded  = encodeURIComponent(resolved.replace(/\/\.\//g, '/'));
        return `[${text}](/vault/doc?path=${encoded}${anchor ? '#' + anchor : ''})`;
      });
    }

    /* ── Handle wiki link clicks ── */
    function attachWikiLinkHandlers() {
      document.querySelectorAll('#vd-body a[href*="__wiki__"]').forEach(a => {
        a.addEventListener('click', async function(e) {
          e.preventDefault();
          const href   = this.getAttribute('href');
          const match  = href.match(/__wiki__(.+?)(?:[&#]|$)/);
          if (!match) return;
          const name   = decodeURIComponent(match[1]);
          try {
            const resp = await fetch('/api/vault/resolve?name=' + encodeURIComponent(name.toLowerCase()));
            if (resp.ok) {
              const data = await resp.json();
              window.location.href = '/vault/doc?path=' + encodeURIComponent(data.path);
            } else {
              showError('Could not resolve wiki link: ' + name);
            }
          } catch (err) {
            showError('Wiki link error: ' + err.message);
          }
        });
      });
    }

    /* ── Error helpers ── */
    function showError(msg) {
      const el = document.getElementById('vd-error');
      el.style.display = 'block';
      el.textContent   = '⚠️ ' + msg;
    }
    function hideError() {
      document.getElementById('vd-error').style.display = 'none';
    }

    /* ── Directory listing renderer ── */
    function renderDir(data) {
      const body = document.getElementById('vd-body');
      const { path: dirPath, name, entries, readme } = data;

      // Breadcrumb for the dir itself
      renderBreadcrumb(dirPath || '');
      document.title = name + ' — Vault';

      // Build parent link
      const parentPath = dirPath && dirPath.includes('/')
        ? dirPath.substring(0, dirPath.lastIndexOf('/'))
        : null;

      const dirs  = entries.filter(e => e.type === 'dir');
      const files = entries.filter(e => e.type === 'file');

      function entryLink(e) {
        const icon = e.type === 'dir' ? '📁' : '📄';
        const label = e.type === 'file' ? e.name.replace(/\.md$/, '') : e.name;
        return `<a class="dir-entry" href="/vault/doc?path=${encodeURIComponent(e.path)}">${icon} ${label}</a>`;
      }

      let html = `<div class="dir-listing">`;

      if (parentPath !== null) {
        html += `<a class="dir-entry dir-up" href="/vault/doc?path=${encodeURIComponent(parentPath)}">⬆ ..</a>`;
      } else if (dirPath) {
        html += `<a class="dir-entry dir-up" href="/vault/doc?path=">⬆ Vault Root</a>`;
      }

      if (dirs.length) {
        html += `<div class="dir-group-label">Folders</div>`;
        html += dirs.map(entryLink).join('');
      }
      if (files.length) {
        html += `<div class="dir-group-label">Files</div>`;
        html += files.map(entryLink).join('');
      }
      if (!dirs.length && !files.length) {
        html += `<div style="color:#4b5563;font-size:.82rem;padding:.5rem 0;">Empty directory</div>`;
      }

      html += `</div>`;

      // README preview below listing
      if (readme) {
        html += `<div class="dir-readme-divider">📖 README</div><div id="dir-readme-content"><div class="vd-loading">Loading README…</div></div>`;
      }

      body.innerHTML = html;

      // Load README async
      if (readme) {
        loadMarkdownInto('dir-readme-content', readme);
      }
    }

    /* ── Render markdown content into a container by id ── */
    async function loadMarkdownInto(containerId, filePath) {
      const container = document.getElementById(containerId);
      if (!container) return;
      try {
        const resp = await fetch('/api/vault/file?path=' + encodeURIComponent(filePath));
        const data = await resp.json();
        if (!resp.ok || data.error) { container.innerHTML = `<div style="color:#f87171;font-size:.8rem;">${data.error}</div>`; return; }
        let raw = preprocessWikiLinks(data.content);
        raw = rewriteMdLinks(raw, filePath);
        container.innerHTML = `<div class="vault-doc-body">${marked.parse(raw)}</div>`;
        container.querySelectorAll('pre code').forEach(b => hljs.highlightElement(b));
        attachWikiLinkHandlers();
      } catch(e) {
        container.innerHTML = `<div style="color:#f87171;font-size:.8rem;">${e.message}</div>`;
      }
    }

    /* ── Main load ── */
    async function loadDoc(filePath) {
      // empty = vault root directory
      renderBreadcrumb(filePath || '');

      const body = document.getElementById('vd-body');
      body.innerHTML = '<div class="vd-loading">Loading…</div>';

      try {
        const resp = await fetch('/api/vault/file?path=' + encodeURIComponent(filePath || ''));
        const data = await resp.json();

        if (!resp.ok || data.error) {
          showError(data.error || 'Failed to load');
          body.innerHTML = '';
          return;
        }

        hideError();

        // Directory?
        if (data.type === 'directory') {
          renderDir(data);
          return;
        }

        // File — render markdown
        renderBreadcrumb(filePath);
        let raw = preprocessWikiLinks(data.content);
        raw = rewriteMdLinks(raw, filePath);
        const html = marked.parse(raw);
        body.innerHTML = `<div class="vault-doc-body">${html}</div>`;
        body.querySelectorAll('pre code').forEach(b => hljs.highlightElement(b));
        attachWikiLinkHandlers();
        const filename = filePath.split('/').pop().replace(/\.md$/, '');
        document.title = filename + ' — Vault Doc';

      } catch (err) {
        showError(err.message);
        body.innerHTML = '';
      }
    }

    /* ── Boot ── */
    const filePath = '<%= filePath %>';
    loadDoc(filePath);
  </script>
</body>
</html>
