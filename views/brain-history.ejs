<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/document-head') %>

  <style>
    body.bh-page { height:100dvh; overflow:hidden; }
    .bh-shell  { display:flex; flex-direction:column; flex:1; height:100%; overflow:hidden; min-height:0; }
    .bh-more   { display:none; align-items:center; justify-content:center; width:44px; height:44px; min-width:44px; padding:0; border:0; background:transparent; color:var(--oc-text); cursor:pointer; flex-shrink:0; }
    .oc-dots   { width:4px; height:4px; border-radius:50%; background:currentColor; box-shadow:0 -7px 0 currentColor, 0 7px 0 currentColor; }
    .bh-menu   { display:contents; }
    .bh-menu-extra, .bh-list-menu, .bh-menu-path, .bh-back-short { display:none; }
    .bh-tabs   { display:flex; gap:4px; margin-left:8px; align-items:center; }
    .bh-spacer { flex:1; }
    .bh-ptitle { min-width:0; }
    .oc-focus-exit {
      display:none; position:fixed; z-index:120;
      top:calc(8px + env(safe-area-inset-top, 0px)); right:8px;
      min-height:36px; padding:6px 12px; border-radius:999px;
      border:1px solid var(--oc-border-strong);
      background:var(--oc-bg-card); color:var(--oc-text);
      font-size:13px; font-weight:700; cursor:pointer;
    }
    .oc-focus-exit[hidden] { display:none !important; }
    .bh-topbar { padding:10px 18px; border-bottom:1px solid var(--oc-border); display:flex; align-items:center; gap:12px; flex-shrink:0; }
    .bh-back   { color:var(--oc-info-text); text-decoration:none; font-size:13px; display:inline-flex; align-items:center; gap:4px; }
    .bh-back:hover { text-decoration:underline; }
    .bh-title  { font-size:15px; font-weight:700; color:var(--oc-text); }
    .bh-path   { font-size:11px; color:var(--oc-text-faint); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:400px; }
    .bh-body   { display:flex; flex:1; overflow:hidden; min-height:0; }

    /* Version list */
    .bh-list   { width:300px; min-width:220px; border-right:1px solid var(--oc-border); overflow-y:auto; flex-shrink:0; }
    .bh-ver    { padding:12px 14px; border-bottom:1px solid var(--oc-border); cursor:pointer; display:flex; align-items:flex-start; gap:10px; }
    .bh-ver:hover { background:var(--oc-bg-hover); }
    .bh-ver.active { background:var(--oc-accent-soft); border-left:3px solid var(--oc-accent); }
    .bh-ver-num  { font-size:18px; font-weight:800; color:var(--oc-info-text); min-width:32px; line-height:1.2; }
    .bh-ver-meta { flex:1; min-width:0; }
    .bh-ver-by   { font-size:12px; font-weight:600; color:var(--oc-info-text); }
    .bh-ver-when { font-size:11px; color:var(--oc-text-faint); }
    .bh-ver-note { font-size:11px; color:var(--oc-accent-text); font-style:italic; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .bh-ver-size { font-size:10px; color:var(--oc-text-faint); white-space:nowrap; }

    /* Content panel */
    .bh-panel  { flex:1; display:flex; flex-direction:column; overflow:hidden; }
    .bh-ptoolbar { padding:8px 14px; border-bottom:1px solid var(--oc-border); display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .bh-btn    { padding:5px 12px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; border:none; }
    .bh-btn-primary   { background:var(--oc-accent); color:var(--oc-text-on-accent); }
    .bh-btn-secondary { background:var(--oc-bg-input); color:var(--oc-text-muted); border:1px solid var(--oc-border); }
    .bh-btn-danger    { background:rgba(239,68,68,.15); color:var(--oc-danger-text); border:1px solid rgba(239,68,68,.3); }
    .bh-btn:hover { opacity:.85; }
    .bh-btn:disabled { opacity:.4; cursor:default; }
    .bh-tab    { padding:4px 12px; border-radius:6px; font-size:12px; cursor:pointer; border:1px solid transparent; color:var(--oc-accent-text); }
    .bh-tab.active { border-color:var(--oc-border); background:var(--oc-bg-card); color:var(--oc-info-text); }

    .bh-content { flex:1; overflow-y:auto; padding:20px 24px; }
    .bh-empty   { color:var(--oc-text-faint); font-size:14px; text-align:center; padding:60px 20px; }

    /* Rendered markdown */
    .bh-preview h1,h2,h3,h4 { color:var(--oc-text); margin-top:1.2em; }
    .bh-preview p { color:var(--oc-info-text); line-height:1.7; }
    .bh-preview code { background:var(--oc-bg-hover); padding:2px 6px; border-radius:4px; font-size:12px; }
    .bh-preview pre { background:var(--oc-overlay); padding:12px; border-radius:8px; overflow-x:auto; max-width:100vw; white-space:pre; word-break:normal; overflow-wrap:normal; }

    /* Raw text */
    .bh-raw    { white-space:pre-wrap; font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--oc-info-text); line-height:1.6; }

    /* Diff */
    .diff-line      { display:flex; gap:8px; font-family:monospace; font-size:12px; line-height:1.6; padding:1px 8px; }
    .diff-line-num  { color:var(--oc-text-faint); min-width:36px; text-align:right; flex-shrink:0; user-select:none; }
    .diff-line-text { flex:1; white-space:pre; word-break:normal; overflow-wrap:normal; }
    .diff-add  { background:rgba(34,197,94,.12); }
    .diff-add .diff-line-text { color:var(--oc-success-text); }
    .diff-del  { background:rgba(239,68,68,.12); }
    .diff-del .diff-line-text { color:var(--oc-danger-text); }
    .diff-ctx  { }
    .diff-ctx .diff-line-text { color:var(--oc-info-text); }
    .diff-hunk { padding:4px 8px; color:var(--oc-info-text); font-size:11px; font-family:monospace; background:var(--oc-accent-soft); }

    .bh-current-badge { font-size:10px; background:var(--oc-accent-soft); color:var(--oc-info-text); padding:2px 6px; border-radius:4px; margin-left:6px; }
    .bh-empty-list { color:var(--oc-text-faint); font-size:13px; padding:24px; text-align:center; }
    .bh-versions-back { display:none; }
    .bh-preview, .bh-raw { overflow-wrap:break-word; word-break:normal; }
    .bh-preview pre, .bh-code-scroll, .bh-diff-scroll {
      display:block; width:100%; max-width:100vw; overflow-x:auto; -webkit-overflow-scrolling:touch;
    }
    .bh-preview pre code, .bh-code-scroll { white-space:pre; word-break:normal; overflow-wrap:normal; }
    .bh-table-scroll { display:block; width:100%; max-width:100vw; overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .bh-preview table { border-collapse:collapse; width:max-content; min-width:100%; }
    .bh-preview th, .bh-preview td {
      border:1px solid var(--oc-border); padding:6px 8px; text-align:left;
      min-width:9rem; white-space:normal; word-break:normal; overflow-wrap:break-word; vertical-align:top;
    }
    .bh-diff { min-width:max-content; }
    .diff-line { width:max-content; min-width:100%; }
    .bh-preview img { max-width:100%; height:auto; }

    @media (max-width: 767px) {
      body.bh-page { height:auto; max-height:none; overflow:visible; display:block; }
      .bh-shell {
        display:block; height:auto; overflow:visible;
        padding-top:calc(48px + env(safe-area-inset-top, 0px));
      }
      body.bh-focus .bh-shell { padding-top:0; }
      .bh-topbar, body.bh-ver-open .bh-ptoolbar {
        position:fixed; top:var(--oc-vv-top, 0px); left:0; right:0; z-index:80;
        box-sizing:border-box;
        height:calc(48px + env(safe-area-inset-top, 0px));
        min-height:0; margin:0;
        padding:env(safe-area-inset-top, 0px) 4px 0;
        flex-wrap:nowrap; gap:4px; align-items:center;
        background:var(--oc-bg-header); border-bottom:1px solid var(--oc-border);
      }
      body.bh-ver-open .bh-topbar,
      body.bh-focus .bh-topbar,
      body.bh-focus .bh-ptoolbar { display:none !important; }
      .bh-back, .bh-versions-back {
        display:inline-flex; align-items:center; justify-content:center;
        height:44px; min-height:44px; min-width:44px; padding:0 12px;
        font-size:16px; font-weight:700; text-decoration:none;
        border-radius:6px; border:1px solid var(--oc-border-strong);
        background:var(--oc-bg-input); color:var(--oc-text);
      }
      .bh-back-long { display:none; }
      .bh-back-short { display:inline; }
      .bh-topbar .bh-sep, .bh-topbar .bh-path, .bh-topbar #verCount { display:none; }
      .bh-title, .bh-ptitle {
        flex:1; min-width:0; font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
        color:var(--oc-text-header);
      }
      .bh-topbar .bh-more, .bh-ptoolbar .bh-more { color:var(--oc-text-header); }
      .bh-current-badge { display:none; }
      .bh-more { display:inline-flex; }
      .bh-body { display:block; overflow:visible; height:auto; }
      .bh-list {
        width:100%; min-width:0; overflow:visible; height:auto; border-right:0;
        min-height:calc(var(--oc-vv-h, 100dvh) - 48px - env(safe-area-inset-top, 0px));
      }
      body:not(.bh-ver-open) .bh-panel { display:none; }
      body.bh-ver-open .bh-list { display:none; min-height:0; }
      body.bh-ver-open .bh-panel { display:block; width:100%; overflow:visible; height:auto; }
      .bh-ver { min-height:44px; }
      .bh-ver-note { white-space:normal; }
      .bh-menu {
        display:none; position:absolute; top:100%; right:6px;
        width:min(18rem, calc(100vw - 12px));
        flex-direction:column; align-items:stretch; gap:0;
        background:var(--oc-bg-card); border:1px solid var(--oc-border);
        box-shadow:var(--oc-shadow-lg); z-index:90; padding:4px;
      }
      body.bh-menu-open .bh-menu,
      body.bh-list-menu-open .bh-list-menu {
        display:flex; position:absolute; top:100%; right:6px;
        width:min(18rem, calc(100vw - 12px));
        flex-direction:column; background:var(--oc-bg-card);
        border:1px solid var(--oc-border); box-shadow:var(--oc-shadow-lg); z-index:90; padding:4px;
      }
      .bh-menu .bh-spacer { display:none; }
      .bh-menu .bh-tabs { display:flex; flex-direction:column; margin:0; gap:0; align-items:stretch; }
      .bh-menu .bh-tab, .bh-menu .bh-btn, .bh-menu .bh-menu-extra,
      .bh-list-menu button {
        display:flex; align-items:center; justify-content:flex-start;
        min-height:44px; width:100%; padding:8px 12px; margin:0;
        font-size:16px; font-weight:700; text-align:left; text-decoration:none;
        background:transparent; border:0; border-radius:4px; color:var(--oc-text); box-sizing:border-box;
      }
      .bh-menu .bh-tab.active { background:var(--oc-accent-soft); color:var(--oc-accent-text); }
      .bh-menu-path, .bh-menu-meta {
        display:block; padding:8px 12px 10px; font-size:12px; line-height:1.4;
        color:var(--oc-text-faint); white-space:normal; word-break:break-word;
      }
      .bh-content {
        overflow:visible; height:auto; padding:12px 12px 28px;
        min-height:calc(var(--oc-vv-h, 100dvh) - 48px - env(safe-area-inset-top, 0px));
      }
      body.bh-focus .bh-list,
      body.bh-focus .bh-content { min-height:var(--oc-vv-h, 100dvh); }
      body.bh-focus .oc-focus-exit:not([hidden]) { display:inline-flex; }
      .bh-preview, .bh-raw { font-size:16px; line-height:1.55; }
    }
  </style>
</head>
<body class="oc-body bh-page">
  <%- include('partials/app-header') %>
  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/brain' }) %>
    <main class="oc-dashboard-area" style="padding:0;overflow:hidden;display:flex;flex-direction:column;min-height:0">

      <div class="bh-shell">
        <!-- Top bar -->
        <div class="bh-topbar">
          <a class="bh-back" href="/brain?path=<%= encodeURIComponent(docPath) %>">
            <span class="bh-back-long">&#8592; Back to doc</span>
            <span class="bh-back-short">Back</span>
          </a>
          <span class="bh-sep" style="color:var(--oc-text-faint)">|</span>
          <span class="bh-title">Version History</span>
          <span class="bh-path" title="<%= docPath %>"><%= docPath %></span>
          <span id="verCount" style="font-size:11px;color:var(--oc-text-faint);margin-left:auto"></span>
          <button type="button" class="bh-more" id="histListMore" aria-label="More actions" aria-expanded="false" onclick="toggleHistListMenu(event)">
            <span class="oc-dots" aria-hidden="true"></span>
          </button>
          <div class="bh-list-menu" id="histListMenu">
            <button type="button" id="histListFocus" onclick="toggleHistFocus()">Focus</button>
            <div class="bh-menu-path"><%= docPath %></div>
            <div class="bh-menu-meta" id="verCountMenu"></div>
          </div>
        </div>

        <!-- Two-pane body -->
        <div class="bh-body">
          <!-- Version list -->
          <div class="bh-list" id="verList">
            <div class="bh-empty-list">Loading…</div>
          </div>

          <!-- Content panel -->
          <div class="bh-panel">
            <div class="bh-ptoolbar" id="ptoolbar" style="display:none">
              <button type="button" class="bh-btn bh-btn-secondary bh-versions-back" id="verBack" onclick="closeVersion()">Back</button>
              <span id="ptitle" class="bh-ptitle" style="font-size:13px;font-weight:700"></span>
              <button type="button" class="bh-more" id="histMore" aria-label="More actions" aria-expanded="false" onclick="toggleHistMenu(event)">
                <span class="oc-dots" aria-hidden="true"></span>
              </button>
              <div class="bh-menu" id="histMenu">
                <div class="bh-tabs">
                  <span class="bh-tab active" id="tabDiff"    onclick="setPanelTab('diff')">Diff</span>
                  <span class="bh-tab"        id="tabPreview" onclick="setPanelTab('preview')">Preview</span>
                  <span class="bh-tab"        id="tabRaw"     onclick="setPanelTab('raw')">Raw</span>
                </div>
                <div class="bh-spacer"></div>
                <button class="bh-btn bh-btn-primary" id="restoreBtn" onclick="doRestore()">&#8617; Restore</button>
                <a class="bh-menu-extra" href="/brain?path=<%= encodeURIComponent(docPath) %>">Back to doc</a>
                <button type="button" class="bh-menu-extra" id="histFocus" onclick="toggleHistFocus()">Focus</button>
                <div class="bh-menu-path"><%= docPath %></div>
              </div>
            </div>
            <div class="bh-content" id="panelContent">
              <div class="bh-empty">Select a version from the list</div>
            </div>
          </div>
        </div>
      </div>
      <button type="button" class="oc-focus-exit" id="histFocusExit" hidden onclick="toggleHistFocus(false)">Exit focus</button>

    </main>
  </div>

<script src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>
<script>
const docPath      = <%- JSON.stringify(docPath) %>;
let selectedVersion = null;
let selectedContent = '';
let currentContent  = '';
let panelTab        = 'diff';

// ── Boot ───────────────────────────────────────────────────────────────────
async function boot() {
  // Load current doc content + version list in parallel
  const [docRes, histRes] = await Promise.all([
    apiFetch('/api/brain/doc?path=' + enc(docPath)),
    apiFetch('/api/brain/history?path=' + enc(docPath) + '&limit=100'),
  ]);
  if (!docRes || !histRes) return;
  currentContent = docRes.content || '';
  renderList(histRes.history || []);
  const params = new URLSearchParams(location.search);
  const initial = params.get('v');
  history.replaceState({ ocHist: initial ? 'ver' : 'list', v: initial, pushed: false }, '', location.href);
  if (initial) {
    const el = document.getElementById('ver-' + initial);
    if (el) selectVersion(Number(initial), el, { fromPop: true });
  }
  if (window.visualViewport) {
    visualViewport.addEventListener('resize', syncHistViewport);
    visualViewport.addEventListener('scroll', syncHistViewport);
  }
  window.addEventListener('resize', syncHistViewport);
  syncHistViewport();
  window.addEventListener('popstate', () => {
    const v = new URLSearchParams(location.search).get('v');
    if (v) {
      const row = document.getElementById('ver-' + v);
      if (row) selectVersion(Number(v), row, { fromPop: true });
    } else showVersionList();
  });
}

function renderList(history) {
  const list = document.getElementById('verList');
  const label = history.length + ' version' + (history.length !== 1 ? 's' : '');
  document.getElementById('verCount').textContent = label;
  const menuCount = document.getElementById('verCountMenu');
  if (menuCount) menuCount.textContent = label;
  if (!history.length) {
    list.innerHTML = '<div class="bh-empty-list">No saved versions yet.<br>Versions are created each time you save a document.</div>';
    return;
  }
  list.innerHTML = history.map(v => `
    <div class="bh-ver" id="ver-${v.version}" onclick="selectVersion(${v.version}, this)">
      <div class="bh-ver-num">v${v.version}</div>
      <div class="bh-ver-meta">
        <div class="bh-ver-by">${esc(v.saved_by || 'unknown')}</div>
        <div class="bh-ver-when">${new Date(v.saved_at).toLocaleString()}</div>
        ${v.change_note ? `<div class="bh-ver-note">${esc(v.change_note)}</div>` : ''}
        <div class="bh-ver-size">${(v.size_bytes/1024).toFixed(1)} KB</div>
      </div>
    </div>
  `).join('');
}

function phoneHist() { return window.matchMedia('(max-width: 767px)').matches; }

function syncHistViewport() {
  if (!phoneHist()) return;
  const vv = window.visualViewport;
  const top = vv ? vv.offsetTop : 0;
  const height = vv ? vv.height : window.innerHeight;
  document.documentElement.style.setProperty('--oc-vv-top', top + 'px');
  document.documentElement.style.setProperty('--oc-vv-h', height + 'px');
}

function toggleHistMenu(event) {
  if (event) event.stopPropagation();
  if (!phoneHist()) return;
  const open = !document.body.classList.contains('bh-menu-open');
  document.body.classList.toggle('bh-menu-open', open);
  document.body.classList.remove('bh-list-menu-open');
  const btn = document.getElementById('histMore');
  if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
}

function toggleHistListMenu(event) {
  if (event) event.stopPropagation();
  if (!phoneHist()) return;
  const open = !document.body.classList.contains('bh-list-menu-open');
  document.body.classList.toggle('bh-list-menu-open', open);
  document.body.classList.remove('bh-menu-open');
  const btn = document.getElementById('histListMore');
  if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
}

function closeHistMenus() {
  document.body.classList.remove('bh-menu-open', 'bh-list-menu-open');
  const a = document.getElementById('histMore');
  const b = document.getElementById('histListMore');
  if (a) a.setAttribute('aria-expanded', 'false');
  if (b) b.setAttribute('aria-expanded', 'false');
}

function toggleHistFocus(force) {
  const on = typeof force === 'boolean' ? force : !document.body.classList.contains('bh-focus');
  document.body.classList.toggle('bh-focus', on);
  const exit = document.getElementById('histFocusExit');
  if (exit) exit.hidden = !on;
  const label = on ? 'Exit focus' : 'Focus';
  const a = document.getElementById('histFocus');
  const b = document.getElementById('histListFocus');
  if (a) a.textContent = label;
  if (b) b.textContent = label;
  closeHistMenus();
}

document.addEventListener('click', (event) => {
  if (!document.body.classList.contains('bh-menu-open') && !document.body.classList.contains('bh-list-menu-open')) return;
  if (event.target.closest && (event.target.closest('.bh-topbar') || event.target.closest('.bh-ptoolbar'))) return;
  closeHistMenus();
});
document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return;
  if (document.body.classList.contains('bh-focus')) toggleHistFocus(false);
  else closeHistMenus();
});

function showVersionList() {
  document.body.classList.remove('bh-ver-open');
}

function closeVersion() {
  if (phoneHist() && history.state && history.state.ocHist === 'ver' && history.state.pushed) {
    history.back();
    return;
  }
  showVersionList();
  if (phoneHist()) history.pushState({ ocHist: 'list' }, '', '/brain/history?path=' + enc(docPath));
}

async function selectVersion(v, el, opts) {
  opts = opts || {};
  document.querySelectorAll('.bh-ver.active').forEach(e => e.classList.remove('active'));
  if (el) el.classList.add('active');

  const data = await apiFetch('/api/brain/version?path=' + enc(docPath) + '&v=' + v);
  if (!data) return;
  selectedVersion = v;
  selectedContent = data.content || '';

  if (phoneHist()) {
    document.body.classList.add('bh-ver-open');
    if (!opts.fromPop) {
      history.pushState({ ocHist: 'ver', v: v, pushed: true }, '', '/brain/history?path=' + enc(docPath) + '&v=' + v);
    }
  }

  document.getElementById('ptitle').innerHTML = 'Version ' + v +
    ' <span class="bh-current-badge">snapshot before this save</span>';
  document.getElementById('ptoolbar').style.display = 'flex';
  setPanelTab(panelTab);
}

// ── Panel tabs ─────────────────────────────────────────────────────────────
function setPanelTab(tab) {
  panelTab = tab;
  ['diff','preview','raw'].forEach(t => {
    document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1))
      .classList.toggle('active', t === tab);
  });
  closeHistMenus();
  renderPanel();
}

function wrapRich(root) {
  root.querySelectorAll('pre').forEach(pre => pre.classList.add('bh-code-scroll'));
  root.querySelectorAll('table').forEach(table => {
    if (table.parentElement && table.parentElement.classList.contains('bh-table-scroll')) return;
    const wrap = document.createElement('div');
    wrap.className = 'bh-table-scroll';
    table.parentNode.insertBefore(wrap, table);
    wrap.appendChild(table);
  });
}

function renderPanel() {
  const el = document.getElementById('panelContent');
  if (panelTab === 'diff') {
    el.innerHTML = '<div class="bh-diff-scroll"><div class="bh-raw bh-diff">' + renderDiff(selectedContent, currentContent) + '</div></div>';
  } else if (panelTab === 'preview') {
    el.innerHTML = '<div class="bh-preview">' + (window.marked ? marked.parse(selectedContent) : esc(selectedContent)) + '</div>';
    const preview = el.querySelector('.bh-preview');
    if (preview) wrapRich(preview);
  } else {
    el.innerHTML = '<pre class="bh-raw bh-code-scroll">' + esc(selectedContent) + '</pre>';
  }
}

// ── Diff renderer (unified, context 3 lines) ───────────────────────────────
function renderDiff(oldText, newText) {
  const oldLines = oldText.split('\n');
  const newLines = newText.split('\n');
  const lcs = computeLCS(oldLines, newLines);
  const hunks = buildHunks(oldLines, newLines, lcs, 3);
  if (!hunks.length) return '<div style="color:var(--oc-text-faint);padding:20px">No differences  -  this version matches the current document.</div>';
  return hunks.map(renderHunk).join('');
}

function computeLCS(a, b) {
  // Myers-inspired simple LCS via DP (capped at 500 lines each for perf)
  const A = a.slice(0, 500), B = b.slice(0, 500);
  const m = A.length, n = B.length;
  const dp = Array.from({length: m+1}, () => new Uint16Array(n+1));
  for (let i = 1; i <= m; i++)
    for (let j = 1; j <= n; j++)
      dp[i][j] = A[i-1] === B[j-1] ? dp[i-1][j-1]+1 : Math.max(dp[i-1][j], dp[i][j-1]);
  // Backtrack
  const ops = [];
  let i = m, j = n;
  while (i > 0 || j > 0) {
    if (i > 0 && j > 0 && A[i-1] === B[j-1]) { ops.push({t:'=',ai:i-1,bi:j-1}); i--; j--; }
    else if (j > 0 && (i === 0 || dp[i][j-1] >= dp[i-1][j])) { ops.push({t:'+',bi:j-1}); j--; }
    else { ops.push({t:'-',ai:i-1}); i--; }
  }
  return ops.reverse();
}

function buildHunks(oldLines, newLines, ops, ctx) {
  // Group ops into visible hunks with context
  const lines = [];
  for (const op of ops) {
    if (op.t === '=') lines.push({type:'ctx', old:op.ai, new:op.bi, text:oldLines[op.ai]});
    else if (op.t === '-') lines.push({type:'del', old:op.ai, text:oldLines[op.ai]});
    else lines.push({type:'add', new:op.bi, text:newLines[op.bi]});
  }
  // Mark which ctx lines are "near" a change
  const changed = lines.map(l => l.type !== 'ctx');
  const visible = lines.map((l,i) => {
    if (l.type !== 'ctx') return true;
    for (let d = -ctx; d <= ctx; d++) {
      if (changed[i+d]) return true;
    }
    return false;
  });
  // Build hunks (groups of visible lines)
  const hunks = [];
  let cur = null;
  for (let i = 0; i < lines.length; i++) {
    if (visible[i]) {
      if (!cur) { cur = []; hunks.push(cur); }
      cur.push(lines[i]);
    } else {
      cur = null;
    }
  }
  return hunks;
}

function renderHunk(lines) {
  const firstOld = lines.find(l => l.old !== undefined)?.old ?? '?';
  const firstNew = lines.find(l => l.new !== undefined)?.new ?? '?';
  let html = `<div class="diff-hunk">@@ -${firstOld+1} +${firstNew+1} @@</div>`;
  for (const l of lines) {
    const cls = l.type === 'add' ? 'diff-add' : l.type === 'del' ? 'diff-del' : 'diff-ctx';
    const pfx = l.type === 'add' ? '+' : l.type === 'del' ? '-' : ' ';
    const lineNum = l.old !== undefined ? String(l.old+1) : '';
    html += `<div class="diff-line ${cls}">
      <span class="diff-line-num">${lineNum}</span>
      <span class="diff-line-text">${pfx} ${esc(l.text)}</span>
    </div>`;
  }
  return html;
}

// ── Restore ────────────────────────────────────────────────────────────────
async function doRestore() {
  if (!selectedVersion) return;
  if (!confirm('Restore version ' + selectedVersion + '?\nThe current document will be saved as a new version first.')) return;
  const btn = document.getElementById('restoreBtn');
  btn.disabled = true; btn.textContent = '⏳ Restoring…';
  const r = await fetch('/api/brain/restore', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ path: docPath, version: selectedVersion })
  });
  if (r.status === 401) { location.href = '/brain/login'; return; }
  const data = await r.json();
  if (data.ok) {
    location.href = '/brain?path=' + enc(docPath);
  } else {
    alert('Restore failed: ' + (data.error || 'unknown'));
    btn.disabled = false; btn.textContent = '↩ Restore';
  }
}

// ── Helpers ────────────────────────────────────────────────────────────────
async function apiFetch(url) {
  const r = await fetch(url);
  if (r.status === 401) { location.href = '/brain/login?next=' + encodeURIComponent(location.href); return null; }
  if (!r.ok) { console.error('API error', r.status, url); return null; }
  return r.json().catch(() => null);
}

function enc(s) { return encodeURIComponent(s); }
function esc(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

boot();
</script>
<%- include('partials/chrome-end') %>
</body>
</html>
