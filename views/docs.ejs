<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
<%- include('partials/sidebar', { currentPath: '/docs' }) %>

        <main class="oc-dashboard-area">
            <div class="oc-card full-width">
                <h2>OverClaw Documentation</h2>
                <div style="margin-top: 1rem;">
                    <h3>Getting Started</h3>
                    <ul>
                        <li><strong>Dashboard:</strong> Overview of all agents and sessions</li>
                        <li><strong>Agents:</strong> View active agents, their status, and activity</li>
                        <li><strong>Sessions:</strong> Monitor OpenClaw sessions across all agents</li>
                        <li><strong>Config:</strong> View and audit agent configuration files and memory</li>
                    </ul>

                    <h3>Administration</h3>
                    <ul>
                        <li><strong>Cron Jobs:</strong> Manage and monitor scheduled tasks</li>
                        <li><strong>Logs:</strong> View system and application logs</li>
                        <li><strong>Debug:</strong> System diagnostics and troubleshooting</li>
                    </ul>

                    <h3>Resources</h3>
                    <ul>
                        <li><a href="https://docs.openclaw.ai" target="_blank">OpenClaw Official Docs</a></li>
                        <li><a href="https://github.com/openclaw/openclaw" target="_blank">GitHub Repository</a></li>
                        <li><a href="https://discord.com/invite/clawd" target="_blank">Community Discord</a></li>
                    </ul>
                </div>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');

        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) sidebar.classList.add('collapsed');

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            sidebarCollapsed ? sidebar.classList.add('collapsed') : sidebar.classList.remove('collapsed');
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");
        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        themeToggle.textContent = currentTheme === 'dark' ? '🌙' : '☀️';

        themeToggle.addEventListener('click', () => {
            currentTheme = currentTheme === 'light' ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            themeToggle.textContent = currentTheme === 'dark' ? '🌙' : '☀️';
        });
    </script>
</body>
</html>
