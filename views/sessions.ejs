<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
        <aside class="oc-sidebar" id="oc-sidebar">
            <nav>
                <div class="nav-group-title">Control</div>
                <ul>
                    <li><a href="/"><span class="icon">🏠</span>Dashboard</a></li>
                    <li><a href="/sessions" class="active"><span class="icon">💬</span>Sessions</a></li>
                    <li><a href="/cron-jobs"><span class="icon">⏰</span>Cron Jobs</a></li>
                </ul>
                <div class="nav-group-title">Agent</div>
                <ul>
                    <li><a href="/agents"><span class="icon">🤖</span>Agents</a></li>
                    <li><a href="/skills"><span class="icon">🧠</span>Skills</a></li>
                    <li><a href="/nodes"><span class="icon">🖥️</span>Nodes</a></li>
                </ul>
                <div class="nav-group-title">Settings</div>
                <ul>
                    <li><a href="/config"><span class="icon">⚙️</span>Config</a></li>
                    <li><a href="/logs"><span class="icon">📜</span>Logs</a></li>
                    <li><a href="/debug"><span class="icon">🐛</span>Debug</a></li>
                </ul>
                <div class="nav-group-title">Resources</div>
                <ul>
                    <li><a href="/docs"><span class="icon">📚</span>Docs</a></li>
                </ul>
            </nav>
        </aside>

        <main class="oc-dashboard-area">
            <div class="oc-card full-width">
                <h2>OpenClaw Sessions Overview</h2>
                <div id="sessions-list">
                    <p>Loading session information...</p>
                </div>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');

        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed');
        }

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
            } else {
                sidebar.classList.remove('collapsed');
            }
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");

        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        if (currentTheme === 'dark') {
            themeToggle.textContent = '🌙';
        } else {
            themeToggle.textContent = '☀️';
        }

        themeToggle.addEventListener('click', () => {
            currentTheme = (currentTheme === 'light') ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggle.textContent = '🌙';
            } else {
                themeToggle.textContent = '☀️';
            }
        });

        prefersDarkScheme.addEventListener('change', (e) => {
            if (!localStorage.getItem('overclaw-theme')) {
                currentTheme = e.matches ? 'dark' : 'light';
                document.body.classList.toggle('light-mode', currentTheme === 'light');
                document.body.classList.toggle('dark-mode', currentTheme === 'dark');
                if (currentTheme === 'dark') {
                    themeToggle.textContent = '🌙';
                } else {
                    themeToggle.textContent = '☀️';
                }
            }
        });

        // Helper function to extract agent ID from session key
        function getAgentIdFromSessionKey(sessionKey) {
            const parts = sessionKey.split(':');
            if (parts.length > 1 && parts[0] === 'agent') {
                return parts[1]; 
            }
            return null; 
        }

        async function fetchSessionDetails() {
            const sessionsListDiv = document.getElementById('sessions-list');
            try {
                const response = await fetch('/api/sessions-detail');
                const sessionsData = await response.json();

                if (sessionsData.error) {
                    sessionsListDiv.innerHTML = `<p style="color: red;">Error fetching sessions: ${sessionsData.error}</p><p>Details: ${sessionsData.details || 'N/A'}</p><p>Stdout (partial): ${sessionsData.stdout || 'N/A'}</p>`;
                    return;
                }

                const sessions = sessionsData.sessions || [];
                if (sessions.length === 0) {
                    sessionsListDiv.innerHTML = '<p>No active or recent sessions found.</p>';
                    return;
                }

                // Sort sessions by updatedAtMs in descending order (most recent first)
                sessions.sort((a, b) => (b.updatedAtMs || 0) - (a.updatedAtMs || 0));

                const table = document.createElement('table');
                table.className = 'oc-agent-table'; // Reusing existing table style
                table.innerHTML = `
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Agent</th>
                            <th>Type</th>
                            <th>Last Activity</th>
                            <th>Last Message / Task</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                `;
                const tbody = table.querySelector('tbody');

                sessions.forEach(session => {
                    const row = tbody.insertRow();
                    const agentId = getAgentIdFromSessionKey(session.key) || session.agentId || 'Unknown';
                    const sessionType = session.key.split(':')[2] || 'Unknown';
                    const lastActivity = session.updatedAt ? new Date(session.updatedAt).toLocaleString() : 'N/A';
                    let lastMessage = session.lastMessage?.message || session.message || 'N/A';
                    lastMessage = lastMessage.length > 100 ? lastMessage.substring(0, 97) + '...' : lastMessage; // Truncate
                    const status = session.status || session.state?.status || 'N/A';

                    row.innerHTML = `
                        <td><code>${session.id || 'N/A'}</code></td>
                        <td>${agentId}</td>
                        <td>${sessionType}</td>
                        <td>${lastActivity}</td>
                        <td>${lastMessage}</td>
                        <td>${status}</td>
                    `;
                });

                sessionsListDiv.innerHTML = '';
                sessionsListDiv.appendChild(table);

            } catch (error) {
                console.error('Error fetching session details:', error);
                sessionsListDiv.innerHTML = '<p style="color: red;">Failed to load session data due to client-side error. Check console for details.</p>';
            }
        }

        document.addEventListener('DOMContentLoaded', fetchSessionDetails);
    </script>
</body>
</html>
