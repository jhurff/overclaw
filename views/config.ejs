<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Simple Markdown Renderer for client-side, if needed. For now, display raw. -->
    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/4.0.10/marked.min.js"></script> -->
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
        <aside class="oc-sidebar" id="oc-sidebar">
            <nav>
                <div class="nav-group-title">Control</div>
                <ul>
                    <li><a href="/"><span class="icon">🏠</span>Dashboard</a></li>
                    <li><a href="/sessions"><span class="icon">💬</span>Sessions</a></li>
                    <li><a href="/cron-jobs"><span class="icon">⏰</span>Cron Jobs</a></li>
                </ul>
                <div class="nav-group-title">Agent</div>
                <ul>
                    <li><a href="/agents"><span class="icon">🤖</span>Agents</a></li>
                    <li><a href="/skills"><span class="icon">🧠</span>Skills</a></li>
                    <li><a href="/nodes"><span class="icon">🖥️</span>Nodes</a></li>
                </ul>
                <div class="nav-group-title">Settings</div>
                <ul>
                    <li><a href="/config" class="active"><span class="icon">⚙️</span>Config</a></li>
                    <li><a href="/logs"><span class="icon">📜</span>Logs</a></li>
                    <li><a href="/debug"><span class="icon">🐛</span>Debug</a></li>
                </ul>
                <div class="nav-group-title">Resources</div>
                <ul>
                    <li><a href="/docs"><span class="icon">📚</span>Docs</a></li>
                </ul>
            </nav>
        </aside>

        <main class="oc-dashboard-area">
            <div class="oc-card full-width">
                <h2>Agent Configuration Viewer</h2>
                <div id="config-viewer-content">
                    <div id="agent-select-container">
                        <h3>Select an Agent:</h3>
                        <select id="agent-selector" class="oc-select"></select>
                    </div>
                    <div id="file-list-container" style="display: none;">
                        <h3>Files for <span id="selected-agent-name"></span>: <button id="back-to-agents" class="oc-button-secondary">Back to Agents</button></h3>
                        <ul id="config-file-list" class="oc-list-group"></ul>
                    </div>
                    <div id="file-content-container" style="display: none;">
                        <h3>Viewing <span id="viewing-file-name"></span> for <span id="viewing-agent-name"></span>: <button id="back-to-file-list" class="oc-button-secondary">Back to Files</button></h3>
                        <pre id="file-content" class="oc-code-block"></pre>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');

        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed');
        }

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
            } else {
                sidebar.classList.remove('collapsed');
            }
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");

        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        if (currentTheme === 'dark') {
            themeToggle.textContent = '🌙';
        } else {
            themeToggle.textContent = '☀️';
        }

        themeToggle.addEventListener('click', () => {
            currentTheme = (currentTheme === 'light') ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggle.textContent = '🌙';
            } else {
                themeToggle.textContent = '☀️';
            }
        });

        prefersDarkScheme.addEventListener('change', (e) => {
            if (!localStorage.getItem('overclaw-theme')) {
                currentTheme = e.matches ? 'dark' : 'light';
                document.body.classList.toggle('light-mode', currentTheme === 'light');
                document.body.classList.toggle('dark-mode', currentTheme === 'dark');
                if (currentTheme === 'dark') {
                    themeToggle.textContent = '🌙';
                } else {
                    themeToggle.textContent = '☀️';
                }
            }
        });

        // --- Config Viewer Logic ---
        const agentSelector = document.getElementById('agent-selector');
        const agentSelectContainer = document.getElementById('agent-select-container');
        const fileListContainer = document.getElementById('file-list-container');
        const configFileList = document.getElementById('config-file-list');
        const selectedAgentNameSpan = document.getElementById('selected-agent-name');
        const backToAgentsButton = document.getElementById('back-to-agents');
        const fileContentContainer = document.getElementById('file-content-container');
        const fileContentPre = document.getElementById('file-content');
        const viewingFileNameSpan = document.getElementById('viewing-file-name');
        const viewingAgentNameSpan = document.getElementById('viewing-agent-name');
        const backToFileListButton = document.getElementById('back-to-file-list');

        let currentAgents = [];
        let selectedAgentId = null;

        async function fetchAndPopulateAgents() {
            try {
                const response = await fetch('/api/agents');
                const agents = await response.json();
                currentAgents = agents; // Store agents for later use

                agentSelector.innerHTML = '<option value="">-- Select Agent --</option>';
                agents.forEach(agent => {
                    const option = document.createElement('option');
                    option.value = agent.id;
                    option.textContent = agent.name;
                    agentSelector.appendChild(option);
                });

                agentSelectContainer.style.display = 'block';
                fileListContainer.style.display = 'none';
                fileContentContainer.style.display = 'none';

            } catch (error) {
                console.error('Error fetching agents for config viewer:', error);
                agentSelectContainer.innerHTML = `<p style="color: red;">Failed to load agents for configuration viewer.</p>`;
            }
        }

        async function fetchAndPopulateFiles(agentId) {
            try {
                const response = await fetch(`/api/agent-config-files/${agentId}`);
                const files = await response.json();

                if (files.error) {
                    configFileList.innerHTML = `<li style="color: red;">Error: ${files.error}</li>`;
                    return;
                }

                configFileList.innerHTML = ''; // Clear previous files
                if (files.length === 0) {
                    configFileList.innerHTML = '<li>No discoverable config/memory files.</li>';
                    return;
                }

                files.forEach(file => {
                    const li = document.createElement('li');
                    li.className = 'oc-list-item oc-link';
                    li.dataset.filePath = file.path;
                    li.textContent = file.name + (file.type === 'memory' ? ' (Memory)' : ' (Config)');
                    configFileList.appendChild(li);
                });

                const selectedAgent = currentAgents.find(a => a.id === agentId);
                selectedAgentNameSpan.textContent = selectedAgent ? selectedAgent.name : agentId;

                agentSelectContainer.style.display = 'none';
                fileListContainer.style.display = 'block';

            } catch (error) {
                console.error(`Error fetching files for agent ${agentId}:`, error);
                configFileList.innerHTML = `<li style="color: red;">Failed to load files for agent ${agentId}.</li>`;
            }
        }

        async function fetchAndDisplayFileContent(agentId, filePath) {
            try {
                const response = await fetch(`/api/file-content?agentId=${agentId}&filePath=${filePath}`);
                const data = await response.json();

                if (data.error) {
                    fileContentPre.textContent = `Error: ${data.error}\nDetails: ${data.details || 'N/A'}`; 
                    fileContentPre.style.color = 'red';
                    return;
                }

                fileContentPre.textContent = data.content;
                fileContentPre.style.color = 'var(--oc-text-dark)'; // Reset color

                viewingFileNameSpan.textContent = filePath;
                viewingAgentNameSpan.textContent = currentAgents.find(a => a.id === agentId)?.name || agentId;

                fileListContainer.style.display = 'none';
                fileContentContainer.style.display = 'block';

            } catch (error) {
                console.error(`Error fetching content for ${filePath}:`, error);
                fileContentPre.textContent = `Failed to load content for ${filePath}.`;
                fileContentPre.style.color = 'red';
            }
        }

        // Event Listeners
        agentSelector.addEventListener('change', (event) => {
            selectedAgentId = event.target.value;
            if (selectedAgentId) {
                fetchAndPopulateFiles(selectedAgentId);
            }
        });

        configFileList.addEventListener('click', (event) => {
            const targetLi = event.target.closest('li.oc-list-item');
            if (targetLi && targetLi.dataset.filePath && selectedAgentId) {
                fetchAndDisplayFileContent(selectedAgentId, targetLi.dataset.filePath);
            }
        });

        backToAgentsButton.addEventListener('click', fetchAndPopulateAgents);
        backToFileListButton.addEventListener('click', () => {
            fileListContainer.style.display = 'block';
            fileContentContainer.style.display = 'none';
        });

        // Initial load
        document.addEventListener('DOMContentLoaded', fetchAndPopulateAgents);

    </script>
</body>
</html>
