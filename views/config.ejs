<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
    <!-- Simple Markdown Renderer for client-side, if needed. For now, display raw. -->
    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/4.0.10/marked.min.js"></script> -->
</head>
<body>
    <header class="oc-header">
        <div class="logo">
            <h1 class="main-title">OVERCLAW</h1>
            <span class="tagline">AGENT DASHBOARD</span>
        </div>
        <div class="header-controls">
            <button id="sidebar-toggle" class="control-button">☰</button>
            <button id="theme-toggle" class="control-button">☀️</button>
        </div>
    </header>

    <div class="oc-main-content">
<%- include('partials/sidebar', { currentPath: '/config' }) %>

        <main class="oc-dashboard-area">
            <div class="oc-card full-width">
                <h2>Agent Configuration Viewer</h2>
                <div id="config-viewer-content">
                    <div id="agent-select-container">
                        <h3>Select an Agent:</h3>
                        <select id="agent-selector" class="oc-select"></select>
                    </div>
                    <div id="file-list-container" style="display: none;">
                        <h3>Files for <span id="selected-agent-name"></span>: 
                            <button id="back-to-agents" class="oc-button-secondary">Back to Agents</button>
                        </h3>
                        <ul id="config-file-list" class="oc-list-group"></ul>
                    </div>
                    <div id="file-content-container" style="display: none;">
                        <h3>Viewing <span id="viewing-file-name"></span> for <span id="viewing-agent-name"></span>: 
                            <button id="back-to-file-list" class="oc-button-secondary">Back to Files</button>
                        </h3>
                        <pre id="file-content" class="oc-code-block"></pre>
                    </div>
                    <div id="file-history-container" style="display: none;">
                        <h3>History for <span id="history-file-name"></span>: 
                            <button id="back-from-history" class="oc-button-secondary">Back to Files</button>
                        </h3>
                        <div id="history-list" class="oc-list-group"></div>
                    </div>
                    <div id="model-settings-container" style="display: none;">
                        <h3>Model Settings for <span id="model-settings-agent-name"></span>: 
                            <button id="back-from-model-settings" class="oc-button-secondary">Back to Files</button>
                        </h3>
                        <div id="model-settings-content" class="oc-code-block"></div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        const sidebarToggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('oc-sidebar');

        let sidebarCollapsed = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
        if (sidebarCollapsed) {
            sidebar.classList.add('collapsed');
        } else {
            sidebar.classList.remove('collapsed');
        }

        sidebarToggle.addEventListener('click', () => {
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('collapsed');
            } else {
                sidebar.classList.remove('collapsed');
            }
            localStorage.setItem('overclaw-sidebar-collapsed', sidebarCollapsed);
        });

        const themeToggle = document.getElementById('theme-toggle');
        const prefersDarkScheme = window.matchMedia("(prefers-color-scheme: dark)");

        let currentTheme = localStorage.getItem('overclaw-theme') || (prefersDarkScheme.matches ? 'dark' : 'light');
        document.body.classList.add(currentTheme + '-mode');
        if (currentTheme === 'dark') {
            themeToggle.textContent = '🌙';
        } else {
            themeToggle.textContent = '☀️';
        }

        themeToggle.addEventListener('click', () => {
            currentTheme = (currentTheme === 'light') ? 'dark' : 'light';
            document.body.classList.toggle('light-mode', currentTheme === 'light');
            document.body.classList.toggle('dark-mode', currentTheme === 'dark');
            localStorage.setItem('overclaw-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggle.textContent = '🌙';
            } else {
                themeToggle.textContent = '☀️';
            }
        });

        prefersDarkScheme.addEventListener('change', (e) => {
            if (!localStorage.getItem('overclaw-theme')) {
                currentTheme = e.matches ? 'dark' : 'light';
                document.body.classList.toggle('light-mode', currentTheme === 'light');
                document.body.classList.toggle('dark-mode', currentTheme === 'dark');
                if (currentTheme === 'dark') {
                    themeToggle.textContent = '🌙';
                } else {
                    themeToggle.textContent = '☀️';
                }
            }
        });

        // --- Config Viewer Logic ---
        const agentSelector = document.getElementById('agent-selector');
        const agentSelectContainer = document.getElementById('agent-select-container');
        const fileListContainer = document.getElementById('file-list-container');
        const configFileList = document.getElementById('config-file-list');
        const selectedAgentNameSpan = document.getElementById('selected-agent-name');
        const backToAgentsButton = document.getElementById('back-to-agents');
        const fileContentContainer = document.getElementById('file-content-container');
        const fileContentPre = document.getElementById('file-content');
        const viewingFileNameSpan = document.getElementById('viewing-file-name');
        const viewingAgentNameSpan = document.getElementById('viewing-agent-name');
        const backToFileListButton = document.getElementById('back-to-file-list');
        const fileHistoryContainer = document.getElementById('file-history-container');
        const historyFileNameSpan = document.getElementById('history-file-name');
        const historyListDiv = document.getElementById('history-list');
        const backFromHistoryButton = document.getElementById('back-from-history');
        const modelSettingsContainer = document.getElementById('model-settings-container');
        const modelSettingsAgentNameSpan = document.getElementById('model-settings-agent-name');
        const modelSettingsContentDiv = document.getElementById('model-settings-content');
        const backFromModelSettingsButton = document.getElementById('back-from-model-settings');

        let currentAgents = [];
        let selectedAgentId = null;
        let currentFiles = []; // To store the fetched files with their metadata

        function showContainer(containerId) {
            agentSelectContainer.style.display = 'none';
            fileListContainer.style.display = 'none';
            fileContentContainer.style.display = 'none';
            fileHistoryContainer.style.display = 'none';
            modelSettingsContainer.style.display = 'none';

            document.getElementById(containerId).style.display = 'block';
        }

        async function fetchAndPopulateAgents() {
            try {
                const response = await fetch('/api/agents');
                const agents = await response.json();
                currentAgents = agents; 

                agentSelector.innerHTML = '<option value="">-- Select Agent --</option>';
                agents.forEach(agent => {
                    const option = document.createElement('option');
                    option.value = agent.id;
                    option.textContent = agent.name;
                    agentSelector.appendChild(option);
                });

                showContainer('agent-select-container');

            } catch (error) {
                console.error('Error fetching agents for config viewer:', error);
                agentSelectContainer.innerHTML = `<p style="color: red;">Failed to load agents for configuration viewer.</p>`;
            }
        }

        async function fetchAndPopulateFiles(agentId) {
            try {
                const response = await fetch(`/api/agent-config-files/${agentId}`);
                const files = await response.json();
                currentFiles = files; // Store files with metadata including isVersionControlled

                if (files.error) {
                    configFileList.innerHTML = `<li style="color: red;">Error: ${files.error}</li>`;
                    return;
                }

                configFileList.innerHTML = ''; // Clear previous files
                if (files.length === 0) {
                    configFileList.innerHTML = '<li>No discoverable config/memory files.</li>';
                    return;
                }

                files.forEach(file => {
                    const li = document.createElement('li');
                    li.className = 'oc-list-item';

                    const fileNameSpan = document.createElement('span');
                    fileNameSpan.className = 'oc-link';
                    fileNameSpan.dataset.filePath = file.path;
                    fileNameSpan.textContent = file.name + 
                        (file.type === 'memory' ? ' (Memory)' : 
                         (file.type === 'setting' ? ' (Settings)' : 
                          (file.type === 'project' ? ' (Project)' : ' (Config)')));
                    fileNameSpan.style.marginRight = '10px';
                    li.appendChild(fileNameSpan);

                    if (file.isVersionControlled) {
                        const historyButton = document.createElement('button');
                        historyButton.className = 'oc-button-inline'; 
                        historyButton.textContent = 'View History';
                        historyButton.dataset.filePath = file.path;
                        historyButton.addEventListener('click', (e) => {
                            e.stopPropagation(); // Prevent li click event
                            fetchAndDisplayFileHistory(selectedAgentId, file.path);
                        });
                        li.appendChild(historyButton);
                    }
                    configFileList.appendChild(li);
                });

                const selectedAgent = currentAgents.find(a => a.id === agentId);
                selectedAgentNameSpan.textContent = selectedAgent ? selectedAgent.name : agentId;

                showContainer('file-list-container');

            } catch (error) {
                console.error(`Error fetching files for agent ${agentId}:`, error);
                configFileList.innerHTML = `<li style="color: red;">Failed to load files for agent ${agentId}.</li>`;
            }
        }

        async function fetchAndDisplayFileContent(agentId, filePath) {
            if (filePath === '__model_settings__') {
                fetchAndDisplayModelSettings(agentId);
                return;
            }

            try {
                const response = await fetch(`/api/file-content?agentId=${agentId}&filePath=${filePath}`);
                const data = await response.json();

                if (data.error) {
                    fileContentPre.textContent = `Error: ${data.error}\nDetails: ${data.details || 'N/A'}`; 
                    fileContentPre.style.color = 'red';
                    return;
                }

                fileContentPre.textContent = data.content;
                fileContentPre.style.color = 'var(--oc-text-dark)'; // Reset color

                viewingFileNameSpan.textContent = filePath;
                viewingAgentNameSpan.textContent = currentAgents.find(a => a.id === agentId)?.name || agentId;

                showContainer('file-content-container');

            } catch (error) {
                console.error(`Error fetching content for ${filePath}:`, error);
                fileContentPre.textContent = `Failed to load content for ${filePath}.`;
                fileContentPre.style.color = 'red';
            }
        }

        async function fetchAndDisplayFileHistory(agentId, filePath) {
            try {
                const response = await fetch(`/api/file-history?agentId=${agentId}&filePath=${filePath}`);
                const history = await response.json();

                if (history.error) {
                    historyListDiv.innerHTML = `<div style="color: red; padding: 1rem;">Error: ${history.error}<br>Details: ${history.details || 'N/A'}</div>`;
                    return;
                }

                historyFileNameSpan.textContent = filePath;
                historyListDiv.innerHTML = ''; // Clear previous history

                if (history.length === 0) {
                    historyListDiv.innerHTML = '<div class="oc-list-item">No Git history found for this file.</div>';
                    showContainer('file-history-container');
                    return;
                }

                history.forEach(commit => {
                    const div = document.createElement('div');
                    div.className = 'oc-list-item oc-commit-item';
                    div.innerHTML = `
                        <strong>${commit.subject}</strong><br>
                        <small>Hash: <code>${commit.hash}</code> | Author: ${commit.author} | Date: ${commit.date}</small>
                    `;
                    historyListDiv.appendChild(div);
                });

                showContainer('file-history-container');

            } catch (error) {
                console.error(`Error fetching history for ${filePath}:`, error);
                historyListDiv.innerHTML = `<div style="color: red; padding: 1rem;">Failed to load history for ${filePath}.</div>`;
            }
        }

        async function fetchAndDisplayModelSettings(agentId) {
            try {
                const response = await fetch(`/api/agent-model-settings/${agentId}`);
                const settings = await response.json();

                if (settings.error) {
                    modelSettingsContentDiv.innerHTML = `<div style="color: red; padding: 1rem;">Error: ${settings.error}<br>Details: ${settings.details || 'N/A'}</div>`;
                    return;
                }

                let contentHtml = `
                    <h4>Global Default Model: <code>${settings.globalDefaultModel}</code></h4>
                    <h4>Agent-Specific Model (${settings.agentId}): <code>${settings.agentSpecificModel}</code></h4>
                `;

                if (settings.modelOrder && settings.modelOrder.length > 0) {
                    contentHtml += `<h4>Model Failover Order:</h4><ul>`;
                    settings.modelOrder.forEach((model, index) => {
                        contentHtml += `<li>${index + 1}. <code>${model}</code></li>`;
                    });
                    contentHtml += `</ul>`;
                } else {
                    contentHtml += `<p>No specific model failover order defined for this agent.</p>`;
                }

                modelSettingsAgentNameSpan.textContent = currentAgents.find(a => a.id === agentId)?.name || agentId;
                modelSettingsContentDiv.innerHTML = contentHtml;

                showContainer('model-settings-container');

            } catch (error) {
                console.error(`Error fetching model settings for ${agentId}:`, error);
                modelSettingsContentDiv.innerHTML = `<div style="color: red; padding: 1rem;">Failed to load model settings for ${agentId}.</div>`;
            }
        }

        // Event Listeners
        agentSelector.addEventListener('change', (event) => {
            selectedAgentId = event.target.value;
            if (selectedAgentId) {
                fetchAndPopulateFiles(selectedAgentId);
            }
        });

        // Delegated event listener for file content display
        configFileList.addEventListener('click', (event) => {
            const fileNameSpan = event.target.closest('span.oc-link');
            if (fileNameSpan && fileNameSpan.dataset.filePath && selectedAgentId) {
                fetchAndDisplayFileContent(selectedAgentId, fileNameSpan.dataset.filePath);
            }
        });

        backToAgentsButton.addEventListener('click', fetchAndPopulateAgents);
        backToFileListButton.addEventListener('click', () => {
            showContainer('file-list-container');
        });
        backFromHistoryButton.addEventListener('click', () => {
            showContainer('file-list-container');
        });
        backFromModelSettingsButton.addEventListener('click', () => {
            showContainer('file-list-container');
        });

        // Initial load
        document.addEventListener('DOMContentLoaded', fetchAndPopulateAgents);

    </script>
</body>
</html>
