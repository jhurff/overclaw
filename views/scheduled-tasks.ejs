<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">AGENT DASHBOARD</span></a></div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>
  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/scheduled-tasks' }) %>
    <main class="oc-dashboard-area">
      <div class="oc-data-wrap">
        <div class="oc-table-toolbar">
          <input type="search" id="q" class="oc-search-input" placeholder="Search tasks…">
          <select id="f-agent" class="oc-filter-select">
            <option value="">All agents</option>
          </select>
          <select id="f-status" class="oc-filter-select">
            <option value="">All statuses</option>
            <option value="on">Enabled</option>
            <option value="off">Disabled</option>
          </select>
          <span class="oc-count-badge" id="row-count">–</span>
        </div>
        <div class="oc-table-scroll">
          <table class="oc-data-table" id="task-tbl">
            <thead><tr>
              <th data-sort="name">Task</th>
              <th data-sort="schedStr">Schedule</th>
              <th data-sort="agent">Agent</th>
              <th data-sort="enabledSort">Status</th>
            </tr></thead>
            <tbody id="task-tbody">
              <tr><td colspan="4" style="text-align:center;color:#4b5563;padding:1.5rem">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    /* ── sidebar/theme ── */
    (function(){
      const sb=document.getElementById('oc-sidebar'),btn=document.getElementById('sidebar-toggle');
      let col=localStorage.getItem('overclaw-sidebar-collapsed')==='true';
      if(col)sb.classList.add('collapsed');
      btn.addEventListener('click',()=>{col=!col;sb.classList.toggle('collapsed',col);localStorage.setItem('overclaw-sidebar-collapsed',col);});
      const th=document.getElementById('theme-toggle');
      let tm=localStorage.getItem('overclaw-theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
      document.body.classList.add(tm+'-mode');th.textContent=tm==='dark'?'🌙':'☀️';
      th.addEventListener('click',()=>{tm=tm==='light'?'dark':'light';document.body.classList.toggle('light-mode',tm==='light');document.body.classList.toggle('dark-mode',tm==='dark');localStorage.setItem('overclaw-theme',tm);th.textContent=tm==='dark'?'🌙':'☀️';});
    })();

    /* ── Fallback tasks for agents not covered by the live gateway cron API ── */
    let primaryCronAgent = 'North';
    let KNOWN_TASKS = [
      { name:'Daily Status Report', schedStr:'08:00 daily', agent:'West', enabled:true,  desc:'Example status report' },
      { name:'Agent Health Check',  schedStr:'Every 4h',    agent:'West', enabled:true,  desc:'Heartbeat sweep' },
    ];

    let AGENT_COLORS = {};
    let AGENT_BG = {};
    let AGENT_EMOJI = {};

    let allTasks=[], sortKey='agent', sortDir=1;

    function schedFmt(j) {
      if (!j) return '—';
      if (j.schedule) {
        const s = j.schedule;
        if (s.kind==='cron')  return `cron: ${s.expr||''}${s.tz?' '+s.tz:''}`;
        if (s.kind==='every') {
          const ms=s.everyMs||0;
          if (ms<60000)    return `every ${ms/1000}s`;
          if (ms<3600000)  return `every ${Math.round(ms/60000)}m`;
          return `every ${Math.round(ms/3600000)}h`;
        }
        if (s.kind==='at') return `once: ${s.at||''}`;
      }
      return j.schedStr||j.scheduleLabel||'—';
    }

    function agentBadge(name) {
      const c = AGENT_COLORS[name]||'#9ca3af';
      const bg = AGENT_BG[name]||'#1c1917';
      const emoji = AGENT_EMOJI[name]||'';
      return `<span style="display:inline-block;padding:1px 9px;border-radius:9999px;font-size:.7rem;font-weight:700;background:${bg};color:${c}">${emoji} ${name}</span>`;
    }

    function applyAndRender() {
      const q       = document.getElementById('q').value.toLowerCase().trim();
      const agentF  = document.getElementById('f-agent').value;
      const statusF = document.getElementById('f-status').value;

      let vis = allTasks.filter(t => {
        if (agentF  && (t.agent||'').toLowerCase() !== agentF.toLowerCase()) return false;
        if (statusF==='on'  && t.enabled===false)  return false;
        if (statusF==='off' && t.enabled!==false)  return false;
        if (q) {
          const h = [t.name, t.schedStr, t.agent, t.desc||''].join(' ').toLowerCase();
          if (!h.includes(q)) return false;
        }
        return true;
      });

      if (sortKey) {
        vis = [...vis].sort((a,b) => {
          const va=String(a[sortKey]||'').toLowerCase(), vb=String(b[sortKey]||'').toLowerCase();
          return sortDir * va.localeCompare(vb);
        });
      }

      const tbody = document.getElementById('task-tbody');
      tbody.innerHTML = vis.length ? vis.map(t => `
        <tr>
          <td>
            <div style="font-weight:600;color:#e2e8f0">${t.name||'(unnamed)'}</div>
            ${t.desc ? `<div style="font-size:.7rem;color:#6b7280;margin-top:.1rem">${t.desc}</div>` : ''}
          </td>
          <td style="font-family:monospace;font-size:.72rem;color:#94a3b8;white-space:nowrap">${t.schedStr}</td>
          <td>${agentBadge(t.agent||primaryCronAgent||'Agent')}</td>
          <td style="font-size:.72rem;font-weight:600;${t.enabled!==false?'color:#86efac':'color:#6b7280'}">${t.enabled!==false?'● On':'○ Off'}</td>
        </tr>`).join('')
        : `<tr class="oc-empty-row"><td colspan="4">No tasks match.</td></tr>`;

      document.getElementById('row-count').textContent = vis.length+' / '+allTasks.length;
      document.querySelectorAll('#task-tbl th[data-sort]').forEach(th => {
        th.classList.remove('sort-asc','sort-desc');
        if (th.dataset.sort===sortKey) th.classList.add(sortDir>0?'sort-asc':'sort-desc');
      });
    }

    document.getElementById('q').addEventListener('input', applyAndRender);
    document.getElementById('f-agent').addEventListener('change', applyAndRender);
    document.getElementById('f-status').addEventListener('change', applyAndRender);
    document.addEventListener('click', e => {
      const th = e.target.closest('#task-tbl th[data-sort]');
      if (!th) return;
      const k = th.dataset.sort;
      if (sortKey===k) sortDir*=-1; else { sortKey=k; sortDir=1; }
      applyAndRender();
    });

    /* Pre-select agent from URL ?agent=Name */
    (function(){
      const a = new URLSearchParams(window.location.search).get('agent');
      if (a) document.getElementById('f-agent').value = a;
    })();

    async function load() {
      try {
        try {
          const inst = await fetch('/api/instance').then(r=>r.json());
          if (Array.isArray(inst.scheduledTasksFallback) && inst.scheduledTasksFallback.length) {
            KNOWN_TASKS = inst.scheduledTasksFallback;
          }
          if (inst.primaryCronAgent) primaryCronAgent = inst.primaryCronAgent;
          const meta = inst.agentMeta || {};
          for (const [name, m] of Object.entries(meta)) {
            if (m && m.color) AGENT_COLORS[name] = m.color;
            if (m && m.emoji) AGENT_EMOJI[name] = m.emoji;
          }
          const sel = document.getElementById('f-agent');
          const names = Object.keys(meta).length ? Object.keys(meta) : [...new Set((inst.scheduledTasksFallback||[]).map(x=>x.agent).filter(Boolean))];
          if (sel && names.length) {
            sel.innerHTML = '<option value="">All agents</option>' + names.map(n => {
              const em = (meta[n]&&meta[n].emoji) || '';
              return `<option value="${n}">${em} ${n}</option>`;
            }).join('');
          }
        } catch {}
        let cronTasks = [];
        try {
          const raw  = await fetch('/api/cron-jobs').then(r=>r.json());
          const list = Array.isArray(raw) ? raw : (raw.jobs||raw.data||[]);
          cronTasks  = list.map(j => ({
            name:        j.name||j.displayName||j.id||'(unnamed)',
            schedStr:    schedFmt(j),
            agent:       primaryCronAgent,
            enabled:     j.enabled!==false,
            desc:        j.description||'',
            id:          j.id,
            enabledSort: j.enabled!==false ? '0' : '1',
          }));
        } catch(e) { console.warn('Cron API unavailable:', e.message); }

        allTasks = [
          ...cronTasks,
          ...KNOWN_TASKS.map(t => ({...t, enabledSort: t.enabled!==false?'0':'1'})),
        ];
        applyAndRender();
      } catch(e) {
        document.getElementById('task-tbody').innerHTML =
          `<tr><td colspan="4" style="color:#f87171;padding:1rem">⚠️ Failed: ${e.message}</td></tr>`;
      }
    }

    load();
  </script>
</body>
</html>
