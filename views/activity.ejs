<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">AGENT DASHBOARD</span></a></div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>
  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/activity' }) %>
    <main class="oc-dashboard-area">
      <div class="oc-data-wrap">
        <div class="oc-table-toolbar">
          <input type="search" id="q" class="oc-search-input" placeholder="Search activity…">
          <select id="f-type" class="oc-filter-select">
            <option value="">All types</option>
            <option value="heartbeat">💓 Heartbeat</option>
            <option value="alert">🚨 Alert</option>
            <option value="learning">📖 Learning</option>
          </select>
          <select id="f-agent" class="oc-filter-select">
            <option value="">All agents</option>
            <option value="Spike">🦞 Spike</option>
            <option value="Steve">📈 Steve</option>
            <option value="Lex">💻 Lex</option>
            <option value="Bill">🐟 Bill</option>
          </select>
          <span class="oc-count-badge" id="row-count">–</span>
        </div>
        <div class="oc-table-scroll">
          <table class="oc-data-table" id="activity-tbl">
            <thead><tr>
              <th data-sort="typeLabel" style="width:100px">Type</th>
              <th data-sort="title">Event</th>
              <th data-sort="source" style="width:180px">Agent / Machine</th>
              <th data-sort="dateSort" style="width:160px">Date</th>
              <th class="no-sort" style="width:140px">Status</th>
            </tr></thead>
            <tbody id="activity-tbody">
              <tr><td colspan="5" style="text-align:center;color:#4b5563;padding:1.5rem">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    /* ── sidebar/theme ── */
    (function(){
      const sb=document.getElementById('oc-sidebar'),btn=document.getElementById('sidebar-toggle');
      let col=localStorage.getItem('overclaw-sidebar-collapsed')==='true';
      if(col)sb.classList.add('collapsed');
      btn.addEventListener('click',()=>{col=!col;sb.classList.toggle('collapsed',col);localStorage.setItem('overclaw-sidebar-collapsed',col);});
      const th=document.getElementById('theme-toggle');
      let tm=localStorage.getItem('overclaw-theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
      document.body.classList.add(tm+'-mode');th.textContent=tm==='dark'?'🌙':'☀️';
      th.addEventListener('click',()=>{tm=tm==='light'?'dark':'light';document.body.classList.toggle('light-mode',tm==='light');document.body.classList.toggle('dark-mode',tm==='dark');localStorage.setItem('overclaw-theme',tm);th.textContent=tm==='dark'?'🌙':'☀️';});
    })();

    const AGENT_MACHINES = {
      Spike: ['OpenClaw'],
      Steve: ['BrightMove-MBP'],
      Lex:   ['BrightMove-MBP/Cursor'],
      Bill:  ['H2FClanker1'],
    };

    function machineToAgent(machine, subAgent) {
      const key = subAgent ? `${machine}/${subAgent}` : machine;
      for (const [agent, machines] of Object.entries(AGENT_MACHINES)) {
        if (machines.some(m => key.toLowerCase() === m.toLowerCase())) return agent;
      }
      return '';
    }

    let allRows=[], sortKey='dateSort', sortDir=-1;

    function fmtDate(str) {
      if (!str) return '—';
      try { return new Date(str).toLocaleString(); } catch { return str; }
    }

    const TYPE_ICON  = { heartbeat:'💓', alert:'🚨', learning:'📖' };
    const TYPE_LABEL = { heartbeat:'Heartbeat', alert:'Alert', learning:'Learning' };

    function applyAndRender() {
      const q      = document.getElementById('q').value.toLowerCase().trim();
      const typeF  = document.getElementById('f-type').value;
      const agentF = document.getElementById('f-agent').value;

      let vis = allRows.filter(r => {
        if (typeF  && r.type  !== typeF)  return false;
        if (agentF && r.agent !== agentF) return false;
        if (q) {
          const h = [r.title, r.source, r.typeLabel, r.tags||''].join(' ').toLowerCase();
          if (!h.includes(q)) return false;
        }
        return true;
      });

      if (sortKey) {
        vis = [...vis].sort((a,b) => {
          const va=String(a[sortKey]||''), vb=String(b[sortKey]||'');
          return sortDir * va.localeCompare(vb);
        });
      }

      const tbody = document.getElementById('activity-tbody');
      tbody.innerHTML = vis.length ? vis.map(r => {
        const icon  = TYPE_ICON[r.type]  || '•';
        const label = TYPE_LABEL[r.type] || r.type;

        let statusHtml = '';
        if (r.isAlert)   statusHtml += '<span style="display:inline-block;padding:1px 7px;border-radius:9999px;font-size:.68rem;font-weight:700;background:#7f1d1d;color:#fca5a5;margin-right:3px">⚠️ alert</span>';
        if (r.isHandled) statusHtml += '<span style="display:inline-block;padding:1px 7px;border-radius:9999px;font-size:.68rem;font-weight:600;background:#14532d;color:#86efac">✓ handled</span>';
        if (r.tags) {
          r.tags.split(',').forEach(t => {
            const tag = t.trim();
            if (tag) statusHtml += `<span style="display:inline-block;padding:1px 7px;border-radius:9999px;font-size:.68rem;font-weight:600;background:#1a3a2a;color:#6ee7b7;margin-right:2px">${tag}</span>`;
          });
        }

        return `
          <tr style="${r.isAlert ? 'background:rgba(59,26,8,.4)' : ''}">
            <td style="white-space:nowrap;font-size:.8rem">${icon} <span style="color:#6b7280">${label}</span></td>
            <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.85rem;color:#e2e8f0">${r.title}</td>
            <td style="font-size:.78rem;color:#9ca3af;white-space:nowrap">${r.source}</td>
            <td style="font-size:.72rem;color:#6b7280;white-space:nowrap">${fmtDate(r.date)}</td>
            <td>${statusHtml || '<span style="color:#374151;font-size:.7rem">—</span>'}</td>
          </tr>`;
      }).join('')
        : `<tr class="oc-empty-row"><td colspan="5">No activity matches.</td></tr>`;

      document.getElementById('row-count').textContent = vis.length+' / '+allRows.length;
      document.querySelectorAll('#activity-tbl th[data-sort]').forEach(th => {
        th.classList.remove('sort-asc','sort-desc');
        if (th.dataset.sort===sortKey) th.classList.add(sortDir>0?'sort-asc':'sort-desc');
      });
    }

    document.getElementById('q').addEventListener('input', applyAndRender);
    document.getElementById('f-type').addEventListener('change', applyAndRender);
    document.getElementById('f-agent').addEventListener('change', applyAndRender);
    document.addEventListener('click', e => {
      const th = e.target.closest('#activity-tbl th[data-sort]');
      if (!th) return;
      const k = th.dataset.sort;
      if (sortKey===k) sortDir*=-1; else { sortKey=k; sortDir=1; }
      applyAndRender();
    });

    /* Pre-select agent from URL ?agent=Name */
    (function(){
      const a = new URLSearchParams(window.location.search).get('agent');
      if (a) { document.getElementById('f-agent').value = a; }
    })();

    async function load() {
      try {
        const [hbData, learnData] = await Promise.all([
          fetch('/api/vault/activity?limit=200').then(r=>r.json()).catch(()=>[]),
          fetch('/api/learnings').then(r=>r.json()).catch(()=>[]),
        ]);

        const hbRows = (Array.isArray(hbData) ? hbData : []).map(hb => ({
          type:        hb.isAlert ? 'alert' : 'heartbeat',
          typeLabel:   hb.isAlert ? 'Alert' : 'Heartbeat',
          title:       hb.type || hb.filename || 'heartbeat',
          source:      hb.subAgent ? `${hb.machine}/${hb.subAgent}` : (hb.machine||'—'),
          agent:       machineToAgent(hb.machine, hb.subAgent),
          date:        hb.date,
          dateSort:    hb.date||'',
          isAlert:     !!hb.isAlert,
          isHandled:   !!hb.isHandled,
          tags:        '',
        }));

        const learnRows = (Array.isArray(learnData) ? learnData : []).map(l => ({
          type:        'learning',
          typeLabel:   'Learning',
          title:       l.title||'(untitled)',
          source:      l.agent||'—',
          agent:       l.agent||'',
          date:        l.created_at,
          dateSort:    l.created_at||'',
          isAlert:     false,
          isHandled:   false,
          tags:        (l.tags||[]).join(', '),
        }));

        allRows = [...hbRows, ...learnRows];
        applyAndRender();
      } catch(e) {
        document.getElementById('activity-tbody').innerHTML =
          `<tr><td colspan="5" style="color:#f87171;padding:1rem">⚠️ Failed: ${e.message}</td></tr>`;
      }
    }

    load();
    setInterval(load, 60000);
  </script>
</body>
</html>
