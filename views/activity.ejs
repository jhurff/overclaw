<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ── Feed layout ──────────────────────────────────────────────────── */
    .feed-wrap   { display:flex; flex-direction:column; gap:0; }

    /* ── Toolbar ──────────────────────────────────────────────────────── */
    .feed-toolbar { display:flex; align-items:center; gap:8px; flex-wrap:wrap;
                    padding-bottom:14px; border-bottom:1px solid var(--border,#2a2a4a);
                    margin-bottom:14px; }
    .feed-count  { margin-left:auto; font-size:11px; color:#4b5563; white-space:nowrap; }
    .feed-refresh { background:#6366f1; color:#fff; border:none; border-radius:6px;
                    padding:5px 13px; font-size:12px; font-weight:600; cursor:pointer; }
    .feed-refresh:hover { opacity:.85; }
    .feed-filter { background:var(--surface-3,#111122); border:1px solid var(--border,#2a2a4a);
                   border-radius:6px; color:#ccc; padding:5px 9px; font-size:12px; }
    .feed-search { background:var(--surface-3,#111122); border:1px solid var(--border,#2a2a4a);
                   border-radius:6px; color:#ccc; padding:5px 11px; font-size:12px; width:190px; }

    /* ── Live indicator ───────────────────────────────────────────────── */
    .feed-live   { display:flex; align-items:center; gap:5px; font-size:11px; color:#34d399; }
    .feed-pulse  { width:7px; height:7px; border-radius:50%; background:#34d399;
                   animation:pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.8)} }
    .feed-live.stale { color:#6b7280; }
    .feed-live.stale .feed-pulse { background:#6b7280; animation:none; }

    /* ── Event rows ───────────────────────────────────────────────────── */
    .feed-table  { width:100%; border-collapse:collapse; font-size:13px; }
    .feed-table th { text-align:left; padding:7px 10px; font-size:10.5px; font-weight:700;
                     text-transform:uppercase; letter-spacing:.06em; color:#4b5563;
                     border-bottom:1px solid var(--border,#2a2a4a); white-space:nowrap; }
    .feed-table td { padding:8px 10px; border-bottom:1px solid rgba(255,255,255,.03);
                     vertical-align:middle; }
    .feed-table tr:hover td { background:rgba(255,255,255,.02); }
    .feed-table tr.new-row td { animation:flashIn .6s ease-out; }
    @keyframes flashIn { from{background:rgba(99,102,241,.18)} to{background:transparent} }

    /* ── Type pills ───────────────────────────────────────────────────── */
    .ev-pill { display:inline-block; padding:2px 8px; border-radius:8px; font-size:10.5px;
               font-weight:700; white-space:nowrap; }
    .ev-brain_write  { background:rgba(99,102,241,.2);  color:#a5b4fc; }
    .ev-brain_read   { background:rgba(99,102,241,.08); color:#818cf8; }
    .ev-brain_search { background:rgba(16,185,129,.1);  color:#6ee7b7; }
    .ev-brain_list   { background:rgba(75,85,99,.15);   color:#9ca3af; }
    .ev-doc_version  { background:rgba(245,158,11,.15); color:#fcd34d; }
    .ev-heartbeat    { background:rgba(52,211,153,.1);  color:#34d399; }
    .ev-alert        { background:rgba(239,68,68,.15);  color:#fca5a5; }
    .ev-mcp_connect  { background:rgba(59,130,246,.15); color:#93c5fd; }
    .ev-default      { background:rgba(75,85,99,.12);   color:#9ca3af; }

    /* ── Agent chip ───────────────────────────────────────────────────── */
    .ag-chip { display:inline-flex; align-items:center; gap:4px; font-size:11.5px;
               font-weight:600; white-space:nowrap; }

    /* ── Path/detail ──────────────────────────────────────────────────── */
    .ev-detail { font-size:11px; color:#6b7280; font-family:monospace;
                 max-width:320px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ev-summary { color:#d1d5db; max-width:360px; overflow:hidden;
                  text-overflow:ellipsis; white-space:nowrap; }
    .ev-err { color:#f87171; }

    /* ── Time ─────────────────────────────────────────────────────────── */
    .ev-time { font-size:11px; color:#4b5563; white-space:nowrap; }

    /* ── Empty / loading ──────────────────────────────────────────────── */
    .feed-empty { text-align:center; padding:40px; color:#4b5563; font-size:14px; }

    /* ── Light mode ───────────────────────────────────────────────────── */
    body.light-mode .ev-summary { color:#1f2937; }
    body.light-mode .feed-table tr:hover td { background:rgba(0,0,0,.02); }
  </style>
</head>
<body class="oc-body">
  <header class="oc-header">
    <div class="logo">
      <a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer">
        <h1 class="main-title">OVERCLAW</h1>
        <span class="tagline">ACTIVITY FEED</span>
      </a>
    </div>
    <div class="header-controls">
      <button id="sidebar-toggle" class="control-button">&#9776;</button>
      <button id="theme-toggle"   class="control-button">&#9728;&#65039;</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/activity' }) %>
    <main class="oc-dashboard-area">
      <div class="oc-data-wrap">

        <!-- Toolbar -->
        <div class="feed-toolbar">

          <!-- Type filter -->
          <select class="feed-filter" id="typeFilter" onchange="applyFilters()">
            <option value="">All event types</option>
            <option value="brain_write">&#9999;&#65039; Brain writes</option>
            <option value="brain_read">&#128214; Brain reads</option>
            <option value="brain_search">&#128269; Brain searches</option>
            <option value="doc_version">&#128196; Doc versions</option>
            <option value="heartbeat">&#128147; Heartbeats</option>
          </select>

          <!-- Agent filter -->
          <select class="feed-filter" id="agentFilter" onchange="applyFilters()">
            <option value="">All agents</option>
          </select>

          <!-- Text search -->
          <input class="feed-search" id="textSearch" placeholder="&#128269; Filter by text&hellip;" oninput="applyFilters()">

          <!-- Live indicator -->
          <div class="feed-live" id="liveIndicator">
            <div class="feed-pulse"></div>
            <span id="liveLabel">Live</span>
          </div>

          <span class="feed-count" id="feedCount">&ndash;</span>
          <button class="feed-refresh" onclick="loadFeed(true)">&#8635; Refresh</button>
        </div>

        <!-- Table -->
        <div class="oc-table-scroll">
          <table class="feed-table" id="feedTable">
            <thead>
              <tr>
                <th>Time</th>
                <th>Type</th>
                <th>Agent</th>
                <th>Event</th>
                <th>Detail</th>
              </tr>
            </thead>
            <tbody id="feedBody">
              <tr><td colspan="5" class="feed-empty">Loading&hellip;</td></tr>
            </tbody>
          </table>
        </div>

      </div>
    </main>
  </div>

  <script>
    /* ── Sidebar / theme ─────────────────────────────────────────────── */
    (function(){
      const sb=document.getElementById('oc-sidebar'), btn=document.getElementById('sidebar-toggle');
      let col=localStorage.getItem('overclaw-sidebar-collapsed')==='true';
      if(col)sb.classList.add('collapsed');
      btn.addEventListener('click',()=>{col=!col;sb.classList.toggle('collapsed',col);localStorage.setItem('overclaw-sidebar-collapsed',col);});
      const th=document.getElementById('theme-toggle');
      let tm=localStorage.getItem('overclaw-theme')||(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');
      document.body.classList.add(tm+'-mode');th.textContent=tm==='dark'?'\uD83C\uDF19':'\u2600\uFE0F';
      th.addEventListener('click',()=>{
        tm=tm==='light'?'dark':'light';
        document.body.classList.toggle('light-mode',tm==='light');
        document.body.classList.toggle('dark-mode',tm==='dark');
        localStorage.setItem('overclaw-theme',tm);
        th.textContent=tm==='dark'?'\uD83C\uDF19':'\u2600\uFE0F';
      });
    })();

    /* ── Agent meta ──────────────────────────────────────────────────── */
    const AGENT_META = {
      spike:  { emoji:'\uD83E\uDD9E', color:'#f97316', label:'Spike'  },
      steve:  { emoji:'\uD83D\uDCC8', color:'#3b82f6', label:'Steve'  },
      lex:    { emoji:'\uD83D\uDCBB', color:'#a855f7', label:'Lex'    },
      bill:   { emoji:'\uD83D\uDC1F', color:'#10b981', label:'Bill'   },
      luther: { emoji:'\uD83E\uDD16', color:'#eab308', label:'Luther' },
      jhurff: { emoji:'\uD83D\uDC64', color:'#6366f1', label:'Jimmy'  },
      jimmy:  { emoji:'\uD83D\uDC64', color:'#6366f1', label:'Jimmy'  },
      agent:  { emoji:'\uD83E\uDD16', color:'#6b7280', label:'Agent'  },
    };

    const TYPE_LABELS = {
      brain_write:  '\u270F\uFE0F Write',
      brain_read:   '\uD83D\uDCD6 Read',
      brain_search: '\uD83D\uDD0D Search',
      brain_list:   '\uD83D\uDCC2 List',
      doc_version:  '\uD83D\uDCC4 Doc ver',
      heartbeat:    '\uD83D\uDC93 Heartbeat',
      mcp_connect:  '\uD83D\uDD0C MCP',
      alert:        '\uD83D\uDEA8 Alert',
    };

    /* ── State ───────────────────────────────────────────────────────── */
    let allEvents   = [];
    let lastTs      = 0;
    let autoRefresh = null;
    let knownAgents = new Set();

    /* ── Load ────────────────────────────────────────────────────────── */
    async function loadFeed(highlight = false) {
      try {
        const r = await fetch('/api/feed?limit=500');
        if (!r.ok) throw new Error(r.status);
        const data = await r.json();

        const newIds = new Set((data.events||[]).map(e => e.ts + e.agent + e.type));
        const prevIds = new Set(allEvents.map(e => e.ts + e.agent + e.type));
        const hasNew  = [...newIds].some(id => !prevIds.has(id));

        allEvents = data.events || [];

        // Build agent filter list
        allEvents.forEach(e => { if (e.agent) knownAgents.add(e.agent); });
        populateAgentFilter();

        applyFilters(highlight && hasNew);
        setLive(true);
        lastTs = Date.now();
      } catch(e) {
        document.getElementById('feedBody').innerHTML =
          `<tr><td colspan="5" class="feed-empty" style="color:#f87171">\u26A0\uFE0F Failed to load: ${e.message}</td></tr>`;
        setLive(false);
      }
    }

    function populateAgentFilter() {
      const sel = document.getElementById('agentFilter');
      const cur = sel.value;
      sel.innerHTML = '<option value="">All agents</option>';
      [...knownAgents].sort().forEach(a => {
        const m   = AGENT_META[a] || {};
        const opt = document.createElement('option');
        opt.value = a;
        opt.textContent = (m.emoji ? m.emoji + ' ' : '') + (m.label || a);
        if (a === cur) opt.selected = true;
        sel.appendChild(opt);
      });
    }

    /* ── Filter + render ─────────────────────────────────────────────── */
    function applyFilters(flashNew = false) {
      const typeQ  = document.getElementById('typeFilter').value;
      const agentQ = document.getElementById('agentFilter').value;
      const textQ  = document.getElementById('textSearch').value.toLowerCase().trim();

      let vis = allEvents.filter(e => {
        if (typeQ  && !e.type.includes(typeQ))                     return false;
        if (agentQ && e.agent !== agentQ)                          return false;
        if (textQ  && !( (e.summary||'').toLowerCase().includes(textQ) ||
                         (e.detail ||'').toLowerCase().includes(textQ) ||
                         (e.agent  ||'').toLowerCase().includes(textQ) )) return false;
        return true;
      });

      document.getElementById('feedCount').textContent = vis.length + ' event' + (vis.length !== 1 ? 's' : '');

      const tbody = document.getElementById('feedBody');
      if (!vis.length) {
        tbody.innerHTML = `<tr><td colspan="5" class="feed-empty">No events match the current filters</td></tr>`;
        return;
      }

      // Render rows
      const prevTopTs = allEvents.length ? (allEvents[0]?.ts || 0) : 0;
      tbody.innerHTML = vis.map((e, i) => {
        const m       = AGENT_META[e.agent] || { emoji:'\uD83E\uDD16', color:'#6b7280', label: e.agent };
        const typeKey = e.type.replace(/^brain_/, 'brain_');
        const pillCls = 'ev-pill ev-' + (typeKey in TYPE_LABELS ? typeKey : 'default');
        const label   = TYPE_LABELS[e.type] || e.type.replace(/_/g,' ');
        const isNew   = flashNew && i < 10 && e.ts > prevTopTs;
        const errCls  = e.ok === false ? ' ev-err' : '';

        return `<tr${isNew ? ' class="new-row"' : ''}>
          <td class="ev-time">${fmtTime(e.ts)}</td>
          <td><span class="${pillCls}">${label}</span></td>
          <td>
            <span class="ag-chip" style="color:${m.color}">
              ${m.emoji} ${m.label || e.agent}
            </span>
          </td>
          <td><span class="ev-summary${errCls}" title="${esc(e.summary||'')}">${esc(e.summary||'—')}</span></td>
          <td>
            ${e.detail
              ? `<span class="ev-detail" title="${esc(e.detail)}">${esc(shortPath(e.detail))}</span>`
              : '<span style="color:#374151">—</span>'}
          </td>
        </tr>`;
      }).join('');
    }

    /* ── Helpers ─────────────────────────────────────────────────────── */
    function fmtTime(ts) {
      if (!ts) return '—';
      const d   = new Date(ts);
      const now = Date.now();
      const ms  = now - ts;
      const m   = ms / 60000;
      const h   = ms / 3600000;
      if (m  < 1)  return 'just now';
      if (m  < 60) return Math.round(m)  + 'm ago';
      if (h  < 24) return Math.round(h)  + 'h ago';
      // For older: show date+time
      return d.toLocaleDateString('en-US',{month:'short',day:'numeric'}) + ' ' +
             d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',hour12:false});
    }

    function shortPath(p) {
      if (!p || p.length <= 50) return p;
      const parts = p.split('/');
      return parts.length > 2 ? '\u2026/' + parts.slice(-2).join('/') : p.slice(-50);
    }

    function esc(s) {
      return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;')
                          .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function setLive(ok) {
      const el  = document.getElementById('liveIndicator');
      const lbl = document.getElementById('liveLabel');
      if (ok) {
        el.classList.remove('stale');
        lbl.textContent = 'Live';
      } else {
        el.classList.add('stale');
        lbl.textContent = 'Offline';
      }
    }

    /* ── Auto-refresh every 30s ──────────────────────────────────────── */
    function startAutoRefresh() {
      if (autoRefresh) clearInterval(autoRefresh);
      autoRefresh = setInterval(() => {
        // Quietly refresh and flash new rows
        loadFeed(true);
        // Mark stale if no refresh in 90s
        if (Date.now() - lastTs > 90000) setLive(false);
      }, 30000);
    }

    loadFeed(false);
    startAutoRefresh();
  </script>
</body>
</html>
