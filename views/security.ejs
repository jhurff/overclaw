<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/document-head') %>

  <style>
    .oc-main-content { overflow:hidden !important; height:calc(100vh - var(--oc-header-height)); }
    .oc-dashboard-area {
      display:flex !important; flex-direction:column !important;
      grid-template-columns:unset !important;
      overflow-y:auto !important; overflow-x:hidden !important;
      padding:1rem 1.25rem !important; gap:0 !important;
    }
    /* Top bar */
    .sec-topbar { display:flex; align-items:baseline; justify-content:space-between; flex-shrink:0; margin-bottom:1rem; gap:1rem; flex-wrap:wrap; }
    .sec-title   { font-size:1.1rem; font-weight:700; color:var(--oc-text); margin:0; }
    .sec-meta    { font-size:0.73rem; color:var(--oc-text-muted); display:flex; align-items:center; gap:0.75rem; }
    .sec-btn     { font-size:0.72rem; padding:0.18rem 0.6rem; border-radius:4px; border:1px solid var(--oc-border-strong); background:transparent; color:var(--oc-text-muted); cursor:pointer; transition:border-color .15s, color .15s; }
    .sec-btn:hover     { border-color:var(--oc-border-strong); color:var(--oc-text); }
    .sec-btn:disabled  { opacity:.45; cursor:default; }

    /* Section labels */
    .sw-section { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--oc-text-muted); margin:1.1rem 0 0.55rem; display:flex; align-items:center; gap:0.5rem; }
    .sw-section:first-of-type { margin-top:0; }

    /* Error / progress banners */
    .sec-error    { display:none; background:var(--oc-warning-soft); border:1px solid var(--oc-warning); border-radius:6px; padding:0.6rem 1rem; color:var(--oc-warning-text); font-size:0.82rem; margin-bottom:1rem; }
    .sec-progress { display:none; background:var(--oc-accent-soft); border:1px solid var(--oc-accent); border-radius:6px; padding:0.55rem 0.9rem; color:var(--oc-info-text); font-size:0.78rem; margin-bottom:0.75rem; }
    .sec-progress.active { display:block; }

    /* Stat cards */
    .stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; }
    .stat-card  { background:var(--oc-bg-card); border:1px solid var(--oc-border); border-radius:8px; padding:0.65rem 0.85rem; display:flex; flex-direction:column; gap:0.15rem; }
    .sc-top     { display:flex; align-items:baseline; justify-content:space-between; gap:0.4rem; }
    .sc-num     { font-size:1.75rem; font-weight:800; line-height:1; }
    .sc-label   { font-size:0.64rem; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; text-align:right; line-height:1.2; }
    .sc-sub     { font-size:0.66rem; color:var(--oc-text-muted); margin-top:2px; }
    .sc-scan    { border-top:2px solid var(--oc-status-inbox); }
    .sc-scan    .sc-num { color:var(--oc-status-inbox-text); } .sc-scan    .sc-label { color:var(--oc-status-inbox-text); }
    .sc-total   { border-top:2px solid var(--oc-border); }
    .sc-total   .sc-num { color:var(--oc-text-muted); } .sc-total   .sc-label { color:var(--oc-text-muted); }
    .sc-real    { border-top:2px solid var(--oc-danger); }
    .sc-real    .sc-num { color:var(--oc-danger-text); } .sc-real    .sc-label { color:var(--oc-danger-text); }
    .sc-fp      { border-top:2px solid var(--oc-success); }
    .sc-fp      .sc-num { color:var(--oc-success-text); } .sc-fp      .sc-label { color:var(--oc-success-text); }

    /* Findings */
    .finding-card { background:var(--oc-bg-card); border:1px solid var(--oc-border); border-radius:8px; padding:0.8rem 0.95rem; margin-bottom:0.55rem; transition:border-color .15s; }
    .finding-card:hover { border-color:var(--oc-border-strong); }
    .finding-header { display:flex; align-items:center; gap:0.55rem; margin-bottom:0.45rem; flex-wrap:wrap; }
    .finding-name   { font-size:0.88rem; font-weight:700; color:var(--oc-text); }
    .finding-count  { font-size:0.7rem; color:var(--oc-text-muted); background:var(--oc-bg-hover); border-radius:9999px; padding:1px 8px; }
    .finding-date   { font-size:0.67rem; color:var(--oc-text-faint); }
    .finding-files  { display:flex; flex-wrap:wrap; gap:0.3rem; margin-top:0.35rem; }
    .finding-file   { font-size:0.65rem; color:var(--oc-text-muted); background:var(--oc-bg-sunken); border:1px solid var(--oc-border); border-radius:4px; padding:1px 7px; font-family:monospace; }
    .finding-fix    { margin-top:0.45rem; font-size:0.72rem; color:var(--oc-warning-text); background:rgba(251,191,36,0.07); border-left:2px solid var(--oc-warning); padding:0.3rem 0.6rem; border-radius:0 4px 4px 0; line-height:1.45; }

    /* Severity badges */
    .sev        { display:inline-block; padding:2px 8px; border-radius:9999px; font-size:0.67rem; font-weight:700; white-space:nowrap; }
    .sev-high   { background:var(--oc-danger-soft); color:var(--oc-danger-text); }
    .sev-medium { background:var(--oc-warning-soft); color:var(--oc-warning-text); }
    .sev-low    { background:var(--oc-info-soft); color:var(--oc-info-text); }

    /* Recommendations */
    .rec-item  { display:flex; align-items:flex-start; gap:0.65rem; padding:0.6rem 0.8rem; border-radius:7px; margin-bottom:0.4rem; background:var(--oc-bg-card); border:1px solid var(--oc-border); font-size:0.78rem; }
    .rec-icon  { flex-shrink:0; margin-top:1px; }
    .rec-title { font-weight:600; color:var(--oc-text); }
    .rec-desc  { color:var(--oc-text-muted); font-size:0.71rem; margin-top:3px; line-height:1.45; }

    /* History */
    .history-item { display:flex; align-items:center; gap:0.75rem; padding:0.5rem 0.75rem; border-radius:7px; background:var(--oc-bg-card); border:1px solid var(--oc-border); margin-bottom:0.35rem; font-size:0.75rem; flex-wrap:wrap; }
    .hi-date    { font-weight:700; color:var(--oc-status-inbox-text); min-width:90px; }
    .hi-stats   { display:flex; gap:0.6rem; flex-wrap:wrap; }
    .hi-real    { color:var(--oc-danger-text); font-weight:600; }
    .hi-fp      { color:var(--oc-success-text); }
    .hi-total   { color:var(--oc-text-muted); }
    .hi-label   { color:var(--oc-text-faint); font-size:0.67rem; margin-left:auto; }

    /* GitHub features grid */
    .gh-grid    { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem; }
    .gh-feature { background:var(--oc-bg-card); border:1px solid var(--oc-border); border-radius:7px; padding:0.6rem 0.8rem; display:flex; align-items:center; gap:0.5rem; font-size:0.78rem; }
    .gh-label   { color:var(--oc-text); font-weight:600; flex:1; }
    .gh-on      { font-size:0.68rem; font-weight:700; color:var(--oc-success-text); white-space:nowrap; }
    .gh-off     { font-size:0.68rem; font-weight:700; color:var(--oc-danger-text); white-space:nowrap; }

    /* Next scan pill */
    .next-scan-bar { margin-top:0.6rem; font-size:0.72rem; color:var(--oc-text-muted); background:var(--oc-bg-card); border:1px solid var(--oc-border); border-radius:7px; padding:0.5rem 0.85rem; display:none; }
    .next-scan-bar span { color:var(--oc-status-inbox-text); font-weight:600; }

    /* Policy viewer */
    .policy-toggle { font-size:0.7rem; color:var(--oc-text-muted); background:none; border:1px solid var(--oc-border); border-radius:4px; padding:2px 8px; cursor:pointer; margin-left:auto; }
    .policy-toggle:hover { color:var(--oc-text); border-color:var(--oc-border-strong); }
    .policy-box    { background:var(--oc-bg); border:1px solid var(--oc-border); border-radius:8px; padding:1rem 1.1rem; font-size:0.75rem; color:var(--oc-text-muted); line-height:1.65; white-space:pre-wrap; font-family:monospace; max-height:420px; overflow-y:auto; margin-top:0.5rem; }

    /* Swarm security posture */
    .posture-card   { background:var(--oc-bg-card); border:1px solid var(--oc-border); border-radius:8px; padding:0.75rem 0.95rem; margin-bottom:0.5rem; }
    .posture-header { display:flex; align-items:center; gap:0.55rem; margin-bottom:0.5rem; }
    .posture-icon   { font-size:1rem; flex-shrink:0; }
    .posture-name   { font-size:0.84rem; font-weight:700; color:var(--oc-text); flex:1; }
    .posture-badge  { font-size:0.65rem; font-weight:700; padding:2px 8px; border-radius:9999px; white-space:nowrap; }
    .pb-ok          { background:var(--oc-bg-card); color:var(--oc-success-text); }
    .pb-warn        { background:var(--oc-bg-card); color:var(--oc-warning-text); }
    .pb-bad         { background:var(--oc-bg); color:var(--oc-danger-text); }
    .pb-unknown     { background:var(--oc-bg-hover); color:var(--oc-text-muted); border:1px solid var(--oc-border-strong); }
    .posture-checks { display:flex; flex-direction:column; gap:0.3rem; }
    .pc-row         { display:flex; align-items:flex-start; gap:0.4rem; font-size:0.74rem; line-height:1.4; }
    .pc-status      { flex-shrink:0; width:1.1em; }
    .pc-text        { color:var(--oc-text-muted); }
    .pc-text.ok     { color:var(--oc-success-text); }
    .pc-text.warn   { color:var(--oc-warning-text); }
    .pc-text.bad    { color:var(--oc-danger-text); }
    .pc-text.unknown{ color:var(--oc-text-faint); }
  </style>
</head>
<body>
  <%- include('partials/app-header') %>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/security' }) %>

    <main class="oc-dashboard-area">

      <!-- Top bar -->
      <div class="sec-topbar">
        <h1 class="sec-title">🔒 Vault Security</h1>
        <div class="sec-meta">
          <span id="sec-last">Loading…</span>
          <a class="sec-btn" id="sec-full-report" href="#" target="_blank" style="text-decoration:none;display:none;">📋 Full Report</a>
          <button class="sec-btn" id="scan-btn" onclick="runScan()">⚡ Run Scan</button>
        </div>
      </div>

      <div class="sec-error"    id="sec-error"></div>
      <div class="sec-progress" id="sec-progress">⚡ Scanning full commit history… (~5s)</div>

      <!-- Stat cards -->
      <div class="sw-section">📊 Scan Summary</div>
      <div class="stats-grid">
        <div class="stat-card sc-scan">
          <div class="sc-top"><span class="sc-num" id="s-date"> - </span></div>
          <div class="sc-label" style="text-align:left;color:var(--oc-status-inbox-text);font-size:.62rem;">🗓 LAST SCAN</div>
          <div class="sc-sub"  id="s-ver"> - </div>
        </div>
        <div class="stat-card sc-total">
          <div class="sc-top"><span class="sc-num" id="s-total"> - </span><span class="sc-label">TOTAL<br>FOUND</span></div>
          <div class="sc-sub" id="s-commits"> - </div>
        </div>
        <div class="stat-card sc-real">
          <div class="sc-top"><span class="sc-num" id="s-real"> - </span><span class="sc-label">REAL<br>ISSUES</span></div>
          <div class="sc-sub" id="s-real-sub"> - </div>
        </div>
        <div class="stat-card sc-fp">
          <div class="sc-top"><span class="sc-num" id="s-fp"> - </span><span class="sc-label">FALSE<br>POSITIVES</span></div>
          <div class="sc-sub">Suppressed</div>
        </div>
      </div>

      <!-- Open Findings -->
      <div class="sw-section">
        🚨 Open Findings  -  Prioritized
        <span id="findings-count" style="font-size:.68rem;color:var(--oc-text-muted);font-weight:400;text-transform:none;letter-spacing:0;"></span>
      </div>
      <div id="findings-list"><div style="color:var(--oc-text-faint);font-size:.8rem;">Loading…</div></div>

      <!-- Recommendations -->
      <div class="sw-section">💡 Recommendations</div>
      <div id="recs-list"><div style="color:var(--oc-text-faint);font-size:.8rem;">Loading…</div></div>

      <!-- GitHub Security Features -->
      <div class="sw-section">🐙 GitHub Security Features</div>
      <div class="gh-grid">
        <div class="gh-feature"><span>🔒</span><span class="gh-label">Private Repo</span><span class="gh-on">✅ ON</span></div>
        <div class="gh-feature"><span>🔍</span><span class="gh-label">Secret Scanning</span><span class="gh-on">✅ ON</span></div>
        <div class="gh-feature"><span>🛡️</span><span class="gh-label">Push Protection</span><span class="gh-on">✅ ON</span></div>
        <div class="gh-feature"><span>🤖</span><span class="gh-label">Dependabot Alerts</span><span class="gh-on">✅ ON</span></div>
        <div class="gh-feature"><span>📄</span><span class="gh-label">SECURITY.md</span><span class="gh-on">✅ IN PLACE</span></div>
        <div class="gh-feature"><span>🚫</span><span class="gh-label">.gitignore Hardened</span><span class="gh-on">✅ IN PLACE</span></div>
      </div>

      <!-- Swarm Security Posture -->
      <div class="sw-section">🛡️ Swarm Security Posture</div>
      <div id="posture-list"><div style="color:var(--oc-text-faint);font-size:.8rem;">Loading…</div></div>

      <!-- Next scheduled scan -->
      <div class="next-scan-bar" id="next-scan-bar">
        🕒 Next scheduled scan: <span id="next-scan-label">Every Sunday at 9:00 AM ET</span>
      </div>

      <!-- Scan History -->
      <div class="sw-section">
        📋 Scan History
        <a id="sec-history-link" href="#"
           target="_blank" style="font-size:.7rem;color:var(--oc-text-muted);text-decoration:none;font-weight:400;text-transform:none;letter-spacing:0;margin-left:auto;display:none;">Full report →</a>
      </div>
      <div id="history-list"><div style="color:var(--oc-text-faint);font-size:.8rem;">Loading…</div></div>

      <!-- Security Policy -->
      <div class="sw-section">
        📄 Security Policy
        <button class="policy-toggle" id="policy-btn" onclick="togglePolicy()">show ▼</button>
      </div>
      <div class="policy-box" id="policy-box" style="display:none;"></div>

      <div style="height:1.5rem;flex-shrink:0;"></div>
    </main>
  </div>

  <script>


    let policyOpen = false;
    function togglePolicy() {
      policyOpen = !policyOpen;
      document.getElementById('policy-box').style.display = policyOpen ? 'block' : 'none';
      document.getElementById('policy-btn').textContent    = policyOpen ? 'hide ▲' : 'show ▼';
    }

    function esc(s) {
      if (!s) return '';
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function sevBadge(sev) {
      return {
        high:   '<span class="sev sev-high">🔴 HIGH</span>',
        medium: '<span class="sev sev-medium">🟡 MEDIUM</span>',
        low:    '<span class="sev sev-low">🔵 LOW</span>',
      }[sev] || '<span class="sev sev-low">INFO</span>';
    }

    async function load() {
      const errEl = document.getElementById('sec-error');
      try {
        const d = await fetch('/api/security/summary').then(r => r.json());
        if (d.error) { errEl.style.display='block'; errEl.textContent='⚠️ '+(d.details||d.error); return; }
        errEl.style.display = 'none';

        // Stats
        document.getElementById('s-date').textContent    = d.lastScan || ' - ';
        document.getElementById('s-ver').textContent     = d.gitleaksVersion ? 'gitleaks v'+d.gitleaksVersion : ' - ';
        document.getElementById('s-total').textContent   = d.totalFindings ?? ' - ';
        document.getElementById('s-commits').textContent = d.commitCount ? d.commitCount.toLocaleString()+' commits' : ' - ';
        document.getElementById('s-real').textContent    = d.realFindings ?? ' - ';
        document.getElementById('s-real-sub').textContent= d.realFindings === 0 ? '✅ All clear' : d.realFindings+' need attention';
        document.getElementById('s-fp').textContent      = d.falsePositives ?? ' - ';
        document.getElementById('sec-last').textContent  = d.lastScan ? 'Last scan: '+d.lastScan : 'No scan data';

        // Findings
        const fl = document.getElementById('findings-list');
        const fc = document.getElementById('findings-count');
        if (!d.findings || !d.findings.length) {
          fc.textContent = '';
          fl.innerHTML = '<div style="color:var(--oc-text-faint);font-size:.82rem;padding:.4rem 0;">✅ No real findings detected</div>';
        } else {
          fc.textContent = ' -  '+d.findings.length+' rule type'+(d.findings.length>1?'s':'');
          fl.innerHTML = d.findings.map(f => `
            <div class="finding-card">
              <div class="finding-header">
                ${sevBadge(f.severity)}
                <span class="finding-name">${esc(f.label||f.ruleId)}</span>
                <span class="finding-count">${f.count} occurrence${f.count!==1?'s':''}</span>
                ${f.firstDate ? `<span class="finding-date">first seen ${esc(f.firstDate)}</span>` : ''}
              </div>
              ${f.files && f.files.length ? `<div class="finding-files">${f.files.map(fp=>`<span class="finding-file">${esc(fp)}</span>`).join('')}${f.fileCount>f.files.length?`<span class="finding-file" style="color:var(--oc-text-faint)">+${f.fileCount-f.files.length} more</span>`:''}</div>` : ''}
              ${f.remediation ? `<div class="finding-fix">💊 ${esc(f.remediation)}</div>` : ''}
            </div>`).join('');
        }

        // Recommendations
        const recs = buildRecs(d);
        document.getElementById('recs-list').innerHTML = recs.map(r => `
          <div class="rec-item">
            <span class="rec-icon">${r.icon}</span>
            <div><div class="rec-title">${esc(r.title)}</div>${r.desc?`<div class="rec-desc">${esc(r.desc)}</div>`:''}</div>
          </div>`).join('');

        // History
        const hl = document.getElementById('history-list');
        if (!d.auditHistory || !d.auditHistory.length) {
          hl.innerHTML = '<div style="color:var(--oc-text-faint);font-size:.78rem;">No history entries parsed yet</div>';
        } else {
          hl.innerHTML = d.auditHistory.map(h => `
            <div class="history-item">
              <span class="hi-date">📅 ${h.date}</span>
              <div class="hi-stats">
                ${h.commits?`<span style="color:var(--oc-text-faint)">${h.commits} commits</span>`:''}
                ${h.total!=null?`<span class="hi-total">${h.total} total</span>`:''}
                ${h.real!=null?`<span class="hi-real">${h.real} real</span>`:''}
                ${h.fps!=null?`<span class="hi-fp">${h.fps} FP</span>`:''}
              </div>
              <span class="hi-label">${esc(h.label||'')}</span>
            </div>`).join('');
        }

        // Policy
        if (d.policy) document.getElementById('policy-box').textContent = d.policy;

        // Next scan
        document.getElementById('next-scan-bar').style.display = 'block';

      } catch(e) {
        errEl.style.display = 'block';
        errEl.textContent   = '⚠️ ' + e.message;
      }
    }

    function buildRecs(d) {
      const recs = [];
      const hasSlack  = (d.findings||[]).some(f => f.ruleId === 'slack-webhook-url');
      const hasApiKey = (d.findings||[]).some(f => f.ruleId === 'generic-api-key');
      const recCfg = (window.__OC_INSTANCE__ && window.__OC_INSTANCE__.securityRecommendations) || {};
      if (hasSlack)  recs.push({ icon:'🔴', title:'Rotate Slack webhook(s)', desc: recCfg.slackWebhook || 'Webhook URLs were found in git history. Rotate the incoming webhook, store the new URL in your password manager, and never paste it into vault files.' });
      if (hasApiKey) recs.push({ icon:'🟡', title:'Verify unrecognized API key', desc: recCfg.genericApiKey || 'Verify unrecognized API keys. If a value is a public analytics embed, add it to the instance suppression list. If it is a real secret, rotate it and move it to your password manager.' });
      recs.push({ icon:'🟢', title:'SECURITY.md policy in repo root', desc:'In place ✓' });
      recs.push({ icon:'🟢', title:'GitHub push protection enabled', desc:'Blocks future secret commits at push time ✓' });
      recs.push({ icon:'🟢', title:'GitHub secret scanning enabled', desc:'Continuous passive monitoring ✓' });
      recs.push({ icon:'🟢', title:'.gitignore hardened', desc: recCfg.gitignore || '.env, *.key, *.pem, *.token, .ocb-token, *.sqlite, *.db, and runlogs-*.json are blocked by .gitignore.' });
      recs.push({ icon:'🟢', title:'Weekly gitleaks scan active', desc:'Every Sunday at 9 AM ET' });
      if (hasSlack) recs.push({ icon:'🟡', title:'Optional: scrub webhook URLs from git history', desc:'Use git filter-repo to clean commit history. This eliminates the finding permanently.' });
      return recs;
    }

    async function runScan() {
      const btn = document.getElementById('scan-btn');
      const pg  = document.getElementById('sec-progress');
      btn.disabled = true; btn.textContent = '⚡ Scanning…';
      pg.classList.add('active');
      try {
        const r = await fetch('/api/security/scan', { method:'POST' }).then(r => r.json());
        if (r.ok) { pg.textContent = '✅ Scan complete  -  refreshing…'; await load(); }
        else       pg.textContent = '⚠️ Scan failed: ' + (r.error || 'unknown');
      } catch(e) {
        pg.textContent = '⚠️ ' + e.message;
      } finally {
        btn.disabled = false; btn.textContent = '⚡ Run Scan';
        setTimeout(() => { pg.classList.remove('active'); pg.textContent = '⚡ Scanning full commit history… (~5s)'; }, 4000);
      }
    }

    function overallPostureStatus(items) {
      if (items.some(i => i.status === 'bad'))     return 'bad';
      if (items.some(i => i.status === 'warn'))    return 'warn';
      if (items.some(i => i.status === 'unknown')) return 'unknown';
      return 'ok';
    }

    function renderPosture(p) {
      const icon  = { ok: '✅', warn: '⚠️', bad: '❌', unknown: '❓' };
      const badge = { ok: '✅ OK', warn: '⚠️ NEEDS ATTENTION', bad: '❌ ACTION REQUIRED', unknown: '❓ UNKNOWN' };
      function chk(status, text) {
        return `<div class="pc-row"><span class="pc-status">${icon[status]||'❓'}</span><span class="pc-text ${status}">${esc(text)}</span></div>`;
      }
      const domains = [
        {
          icon: '🔑', name: 'Secrets & Credentials',
          items: [
            { status: p.credentials.bwKeyExists ? 'ok' : 'bad',
              text: p.credentials.bwKeyExists ? `Bitwarden master.key present (chmod ${p.credentials.bwKeyMode})` : 'Bitwarden master.key MISSING!' },
            { status: p.credentials.bwKeySecure ? 'ok' : 'warn',
              text: p.credentials.bwKeySecure ? 'master.key permissions 600 ✓' : `master.key is chmod ${p.credentials.bwKeyMode||'?'}  -  should be 600` },
            { status: p.credentials.rotationPolicyExists === null ? 'unknown' : p.credentials.rotationPolicyExists ? 'ok' : 'warn',
              text: p.credentials.rotationPolicyExists ? 'Credential rotation policy in vault ✓' : 'No rotation policy doc  -  create 08-QA/Security/Credential-Rotation-Policy.md' },
            { status: 'warn', text: 'Shared PAT (github-ai-agents-pat) covers all repos  -  replace with per-repo deploy keys (TASK-20260822-002)' },
          ],
        },
        {
          icon: '🌐', name: 'Network Exposure',
          items: [
            { status: p.network.tailscaleActive ? 'ok' : 'warn',
              text: p.network.tailscaleActive ? `Tailscale active${p.network.tailscaleIP ? ' ('+p.network.tailscaleIP+')' : ''}` : 'Tailscale not detected  -  verify VPN access to gateway' },
            { status: p.network.gatewayExposed ? 'bad' : 'ok',
              text: p.network.gatewayExposed ? 'Gateway/OverClaw exposed on 0.0.0.0  -  restrict to Tailscale immediately!' : 'Gateway & OverClaw ports not exposed on public interface ✓' },
          ],
        },
        {
          icon: '🖥️', name: 'Host Hardening',
          items: [
            { status: p.hostHardening.sshPasswordAuth === 'disabled' ? 'ok' : p.hostHardening.sshPasswordAuth === 'unknown' ? 'unknown' : 'bad',
              text: `SSH password auth: ${p.hostHardening.sshPasswordAuth}` },
            { status: p.hostHardening.sshRootLogin === 'no' || p.hostHardening.sshRootLogin === 'prohibit-password' ? 'ok' : p.hostHardening.sshRootLogin === 'yes' ? 'bad' : 'unknown',
              text: `SSH root login: ${p.hostHardening.sshRootLogin}` },
            { status: p.hostHardening.ufwActive === null ? 'unknown' : p.hostHardening.ufwActive ? 'ok' : 'warn',
              text: `UFW firewall: ${p.hostHardening.ufwActive === null ? 'unknown  -  run healthcheck' : p.hostHardening.ufwActive ? 'active ✓' : 'not active'}` },
            { status: p.hostHardening.pendingUpdates === null ? 'unknown' : p.hostHardening.pendingUpdates === 0 ? 'ok' : p.hostHardening.pendingUpdates > 20 ? 'bad' : 'warn',
              text: p.hostHardening.pendingUpdates !== null ? `${p.hostHardening.pendingUpdates} pending apt update(s)` : 'Pending apt updates: unknown  -  run healthcheck' },
          ],
        },
        {
          icon: '📋', name: 'Audit Trail',
          items: [
            { status: p.auditTrail.heartbeatActive ? 'ok' : 'warn',
              text: p.auditTrail.heartbeatActive ? 'Heartbeat state tracked ✓' : 'Heartbeat state file not found' },
            { status: p.auditTrail.gitleaksScheduleActive ? 'ok' : 'bad',
              text: 'Weekly gitleaks vault scan active (Sundays 9am ET) ✓' },
            { status: p.auditTrail.overclawLogCount === null ? 'unknown' : p.auditTrail.overclawLogCount > 0 ? 'ok' : 'warn',
              text: p.auditTrail.overclawLogCount !== null ? `OverClaw logs: ${p.auditTrail.overclawLogCount} file(s)` : 'OverClaw logs directory not found' },
          ],
        },
        {
          icon: '💉', name: 'Prompt Injection',
          items: [
            ...(((window.__OC_INSTANCE__||{}).securityPostureNotes||{}).promptInjection || [
              { status: 'ok',   text: 'Primary runtime: injection guard active (built-in).' },
              { status: 'warn', text: 'Review other agent runtimes for an injection guard in their system prompt or editor rules.' },
            ]),
          ],
        },
        {
          icon: '🤖', name: 'Agent Over-Privilege',
          items: [
            { status: p.agentPrivilege.accessPolicyExists === null ? 'unknown' : p.agentPrivilege.accessPolicyExists ? 'ok' : 'warn',
              text: p.agentPrivilege.accessPolicyExists ? 'Per-agent access policy in vault ✓' : ((((window.__OC_INSTANCE__||{}).securityPostureNotes||{}).accessPolicyMissing) || 'No per-agent access policy  -  decide whether to add one.') },
            { status: 'warn', text: 'Shared PAT in use for vault sync  -  acceptable; per-agent scoping not yet documented' },
            { status: p.agentPrivilege.deployKeysCount > 0 ? 'ok' : 'warn',
              text: p.agentPrivilege.deployKeysCount > 0 ? `${p.agentPrivilege.deployKeysCount} SSH deploy key(s) on host ✓` : 'No per-repo SSH deploy keys found on host yet' },
          ],
        },
      ];
      return domains.map(domain => {
        const s = overallPostureStatus(domain.items);
        return `<div class="posture-card">
          <div class="posture-header">
            <span class="posture-icon">${domain.icon}</span>
            <span class="posture-name">${esc(domain.name)}</span>
            <span class="posture-badge pb-${s}">${badge[s]}</span>
          </div>
          <div class="posture-checks">${domain.items.map(it => chk(it.status, it.text)).join('')}</div>
        </div>`;
      }).join('');
    }

    async function loadPosture() {
      try {
        const p = await fetch('/api/security/swarm-posture').then(r => r.json());
        document.getElementById('posture-list').innerHTML = renderPosture(p);
      } catch(e) {
        document.getElementById('posture-list').innerHTML = `<div style="color:var(--oc-danger-text);font-size:.78rem;">⚠️ Failed to load posture: ${esc(e.message)}</div>`;
      }
    }

    loadPosture();
    load();
  
    fetch('/api/instance').then(r=>r.json()).then(inst=>{
      window.__OC_INSTANCE__ = inst || {};
      const url = inst.securityAuditLogUrl || '';
      ['sec-full-report','sec-history-link'].forEach(id=>{
        const a=document.getElementById(id);
        if (!a) return;
        if (url) { a.href=url; a.style.display=''; }
        else { a.style.display='none'; }
      });
    }).catch(()=>{ window.__OC_INSTANCE__ = {}; });
</script>
<%- include('partials/chrome-end') %>
</body>
</html>
