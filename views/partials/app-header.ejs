<header class="oc-header">
  <div class="logo">
    <a class="logo-link" href="/swarm">
      <h1 class="main-title">OVERCLAW</h1>
      <span class="tagline">AGENT DASHBOARD</span>
    </a>
  </div>
  <div class="header-controls">
    <button type="button" id="rain-toggle" class="control-button" hidden aria-label="Pause or play digital rain">
      <span class="ctrl-icon" aria-hidden="true"></span>
      <span class="ctrl-label">Rain</span>
    </button>
    <a href="/settings/themes" class="control-button" id="theme-link" aria-label="Themes">
      <span class="ctrl-icon" aria-hidden="true">Aa</span>
      <span class="ctrl-label">Theme</span>
    </a>
    <button type="button" id="sidebar-toggle" class="control-button" aria-label="Menu" aria-expanded="false">
      <span class="ctrl-icon" aria-hidden="true">&#9776;</span>
      <span class="ctrl-label">Menu</span>
    </button>
  </div>
</header>
