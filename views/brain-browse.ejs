<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/document-head') %>

  <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
  <style>
    /* ── Two-pane layout ──────────────────────────────────────────────── */
    .bb-wrap  { display:flex; flex:1; overflow:hidden; min-height:0; }

    /* ── File tree ────────────────────────────────────────────────────── */
    .bb-tree       { width:270px; min-width:160px; max-width:380px; background:var(--oc-bg-card);
                     border-right:1px solid var(--oc-border); display:flex; flex-direction:column; overflow:hidden; }
    .bb-tree-head  { padding:10px 12px; border-bottom:1px solid var(--oc-border);
                     display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .bb-tree-title { font-size:12px; font-weight:700; color:var(--oc-text-muted); }
    .bb-tree-filter{ flex:1; background:var(--oc-bg-input); border:1px solid var(--oc-border);
                     border-radius:5px; color:var(--oc-text); padding:4px 8px; font-size:12px; }
    .bb-tree-body  { flex:1; overflow-y:auto; padding:4px 0; }
    .bb-dir  { padding:4px 10px; cursor:pointer; font-size:12px; font-weight:600; color:var(--oc-text-muted);
               display:flex; align-items:center; gap:5px; user-select:none; }
    .bb-dir:hover  { background:var(--oc-bg-hover); }
    .bb-arr  { font-size:9px; width:10px; display:inline-block; transition:transform .15s; }
    .bb-dir.open .bb-arr { transform:rotate(90deg); }
    .bb-kids { display:none; }
    .bb-kids.open  { display:block; }
    .bb-file { padding:3px 10px 3px 24px; cursor:pointer; font-size:12px; color:var(--oc-text-muted);
               white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .bb-file:hover  { background:var(--oc-bg-hover); color:var(--oc-text-muted); }
    .bb-file.active { background:var(--oc-accent-soft); color:var(--oc-accent-text); font-weight:600; }

    /* ── Right pane ───────────────────────────────────────────────────── */
    .bb-main    { flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0; }
    .bb-toolbar { padding:6px 12px; border-bottom:1px solid var(--oc-border);
                  display:flex; align-items:center; gap:6px; flex-wrap:wrap; flex-shrink:0;
                  background:var(--oc-bg-card); }
    .bb-path    { flex:1; font-size:11px; color:var(--oc-text-faint); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bb-dirty   { color:var(--oc-warning-text); font-size:11px; font-weight:700; display:none; }
    .bb-btn     { padding:4px 11px; border-radius:6px; font-size:12px; font-weight:600;
                  cursor:pointer; border:none; transition:opacity .15s; }
    .bb-primary { background:var(--oc-accent); color:var(--oc-text-on-accent); }
    .bb-secondary{ background:var(--oc-bg-input); color:var(--oc-text-muted); border:1px solid var(--oc-border); }
    .bb-btn:hover    { opacity:.85; }
    .bb-btn:disabled { opacity:.4; cursor:default; }
    .bb-doc     { flex:1; overflow:hidden; display:flex; flex-direction:column; }
    .bb-empty   { flex:1; display:flex; align-items:center; justify-content:center;
                  flex-direction:column; gap:8px; color:var(--oc-text-faint); font-size:14px; }

    /* ── Toast UI overrides (dark theme) ──────────────────────────────── */
    .toastui-editor-defaultUI          { height:100% !important; display:flex !important; flex-direction:column !important; }
    .toastui-editor-main               { flex:1 !important; overflow:hidden !important; }
    .toastui-editor-ww-container,
    .toastui-editor-md-container       { height:100% !important; }
    .toastui-editor-toolbar            { background:var(--oc-bg-card) !important;
                                         border-bottom:1px solid var(--oc-border) !important; }
    .toastui-editor-toolbar button     { color:var(--oc-text-muted) !important; }
    .toastui-editor-toolbar button:hover{ background:var(--oc-accent-soft) !important; }
    .toastui-editor-ww-container .ProseMirror {
      background:var(--oc-bg) !important; color:var(--oc-text) !important;
      font-size:15px !important; line-height:1.8 !important; padding:28px 40px !important;
    }
    .toastui-editor-md-container .CodeMirror { background:var(--oc-bg) !important; color:var(--oc-text) !important; height:100% !important; }
    .toastui-editor-contents h1 { font-size:2em; font-weight:800; color:var(--oc-text-on-accent);
      border-bottom:1px solid var(--oc-border); padding-bottom:.3em; }
    .toastui-editor-contents h2 { font-size:1.5em; font-weight:700; color:var(--oc-text);
      border-bottom:1px solid var(--oc-border); }
    .toastui-editor-contents h3 { font-size:1.2em; font-weight:700; color:var(--oc-text); }
    .toastui-editor-contents h4,
    .toastui-editor-contents h5,
    .toastui-editor-contents h6 { font-weight:600; color:var(--oc-text); }
    .toastui-editor-contents p,
    .toastui-editor-contents li { color:var(--oc-text); }
    .toastui-editor-contents a  { color:var(--oc-info-text); }
    .toastui-editor-contents code { background:var(--oc-bg-hover); color:var(--oc-status-inbox-text);
      padding:2px 6px; border-radius:4px; font-size:.87em; }
    .toastui-editor-contents pre  { background:var(--oc-bg); border:1px solid var(--oc-border); border-radius:8px; }
    .toastui-editor-contents blockquote { border-left:3px solid var(--oc-accent);
      background:var(--oc-accent-soft); color:var(--oc-info-text); }
    .toastui-editor-contents table th { background:var(--oc-accent-soft); color:var(--oc-info-text); }
    .toastui-editor-contents table th,
    .toastui-editor-contents table td  { border-color:var(--oc-border); color:var(--oc-text); }

    /* ── New-doc bar ──────────────────────────────────────────────────── */
    .bb-new-bar { display:none; padding:7px 12px; background:var(--oc-bg-input);
                  border-bottom:1px solid var(--oc-border); align-items:center; gap:8px; }
    .bb-new-bar.open { display:flex; }
    .bb-new-input { flex:1; background:var(--oc-bg-card); border:1px solid var(--oc-border);
                    border-radius:6px; color:var(--oc-text); padding:5px 10px; font-size:13px; }

    /* ── Search panel ─────────────────────────────────────────────────── */
    .bb-search { position:fixed; top:60px; right:20px; width:400px;
                 background:var(--oc-bg-card); border:1px solid var(--oc-border);
                 border-radius:10px; padding:14px; z-index:300;
                 box-shadow:0 8px 32px var(--oc-overlay); display:none; }
    .bb-search.open { display:block; }
    .bb-search-input { width:100%; background:var(--oc-bg-input); border:1px solid var(--oc-border);
                       border-radius:6px; color:var(--oc-text); padding:7px 11px; font-size:13px; box-sizing:border-box; }
    .bb-sr     { padding:7px 10px; border-bottom:1px solid var(--oc-border); cursor:pointer; }
    .bb-sr:hover { background:var(--oc-bg-hover); }
    .bb-sr-path { font-size:11px; color:var(--oc-info-text); }
    .bb-sr-snip { font-size:12px; color:var(--oc-accent-text); margin-top:2px; }

    /* ── Stats bar ────────────────────────────────────────────────────── */
    .bb-stats { font-size:11px; color:var(--oc-text-faint); padding:3px 14px 4px; flex-shrink:0;
                border-bottom:1px solid var(--oc-border); }

    /* ── Toast notification ───────────────────────────────────────────── */
    .bb-toast { position:fixed; bottom:24px; right:24px; padding:9px 18px; border-radius:8px;
                font-size:13px; z-index:999; box-shadow:0 4px 16px var(--oc-overlay);
                transition:opacity .3s; color:var(--oc-text-on-accent); pointer-events:none; }

    /* ── Light mode ───────────────────────────────────────────────────── */
    .toastui-editor-ww-container .ProseMirror { background:var(--oc-bg-card) !important; color:var(--oc-text) !important; }
    .toastui-editor-md-container .CodeMirror  { background:var(--oc-bg-card) !important; color:var(--oc-text) !important; }
    .toastui-editor-toolbar { background:var(--oc-bg) !important; }
    .toastui-editor-contents h1,
    .toastui-editor-contents h2,
    .toastui-editor-contents h3,
    .toastui-editor-contents h4,
    .toastui-editor-contents h5,
    .toastui-editor-contents h6 { color:var(--oc-text) !important; }
    .toastui-editor-contents p,
    .toastui-editor-contents li  { color:var(--oc-text-faint) !important; }
    .toastui-editor-contents code { background:var(--oc-overlay) !important; color:var(--oc-info-text) !important; }
    .toastui-editor-contents table td { color:var(--oc-text-faint) !important; }
    .toastui-editor-contents blockquote { color:var(--oc-text-faint) !important; }
    .bb-tree  { background:var(--oc-bg-card); }
    .bb-toolbar { background:var(--oc-bg-card); }

    .bb-dash {
      padding: 0 !important;
      overflow: hidden;
      display: flex !important;
      flex-direction: column;
      min-height: 0;
    }
    .bb-back { display:none; }
    .bb-toolbar-row, .bb-actions { display:contents; }
    .bb-more, .bb-savebar, .oc-focus-exit, .bb-phone-only { display:none; }
    .bb-more {
      align-items:center; justify-content:center;
      width:44px; height:44px; min-width:44px; padding:0;
      border:0; background:transparent; color:var(--oc-text); cursor:pointer; flex-shrink:0;
    }
    .oc-dots {
      width:4px; height:4px; border-radius:50%; background:currentColor;
      box-shadow:0 -7px 0 currentColor, 0 7px 0 currentColor;
    }
    .bb-savebar { align-items:center; padding:4px 8px; background:var(--oc-bg-header); border-top:1px solid var(--oc-border); }
    .bb-savebar-btn {
      flex:1; min-height:40px; border:0; border-radius:6px;
      background:var(--oc-accent); color:var(--oc-text-on-accent);
      font-size:16px; font-weight:700; cursor:pointer;
    }
    .bb-savebar-btn:disabled { opacity:.5; }
    .oc-focus-exit {
      position:fixed; z-index:120;
      top:calc(8px + env(safe-area-inset-top, 0px)); right:8px;
      min-height:36px; padding:6px 12px; border-radius:999px;
      border:1px solid var(--oc-border-strong);
      background:var(--oc-bg-card); color:var(--oc-text);
      font-size:13px; font-weight:700; cursor:pointer;
    }
    .oc-focus-exit[hidden] { display:none !important; }
    .bb-md-input[hidden], .bb-preview[hidden] { display:none !important; }
    .bb-md-input {
      flex:1; min-height:0; width:100%; box-sizing:border-box;
      border:0; resize:none; padding:16px;
      background:var(--oc-bg); color:var(--oc-text);
      font-size:16px; line-height:1.55; font-family:var(--oc-font-mono);
    }
    .bb-preview {
      flex:1; min-height:0; overflow:auto; padding:16px 16px 28px;
      font-size:16px; line-height:1.6; color:var(--oc-text);
      overflow-wrap:break-word; word-break:normal;
    }
    .bb-preview h1, .bb-preview h2, .bb-preview h3, .bb-preview h4 { color:var(--oc-text-heading); line-height:1.25; }
    .bb-preview p, .bb-preview li { color:var(--oc-text); }
    .bb-preview a { color:var(--oc-text-link); }
    .bb-preview code { background:var(--oc-bg-code); padding:2px 6px; border-radius:4px; font-size:0.9em; }
    .bb-code-scroll, .bb-preview pre {
      display:block; max-width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch;
      background:var(--oc-bg-code); border:1px solid var(--oc-border); border-radius:8px;
      padding:12px; margin:0.6rem 0;
      white-space:pre; word-break:normal; overflow-wrap:normal;
    }
    .bb-preview pre code, .bb-code-scroll code {
      background:transparent; padding:0; white-space:pre; word-break:normal; overflow-wrap:normal;
    }
    .bb-table-scroll {
      display:block; width:100%; max-width:100vw; overflow-x:auto;
      -webkit-overflow-scrolling:touch; margin:0.6rem 0;
    }
    .bb-preview table { border-collapse:collapse; width:max-content; min-width:100%; }
    .bb-preview th, .bb-preview td {
      border:1px solid var(--oc-border); padding:6px 8px; text-align:left;
      min-width:9rem; white-space:normal; word-break:normal; overflow-wrap:break-word; vertical-align:top;
    }
    .bb-preview img { max-width:100%; height:auto; }
    .bb-danger { color:var(--oc-danger-text); border-color:var(--oc-danger); }

    @media (max-width: 767px) {
      .bb-wrap { flex:1; min-height:0; flex-direction:column; }
      .bb-tree {
        width:100% !important; max-width:none !important; min-width:0 !important;
        flex:1; min-height:0; border-right:0;
      }
      .bb-main { width:100%; min-width:0; flex:1; min-height:0; }
      body:not(.bb-doc-open) .bb-main { display:none !important; }
      body.bb-doc-open .bb-tree,
      body.bb-doc-open .bb-stats,
      body.bb-doc-open .bb-new-bar { display:none !important; }
      body.bb-doc-open .bb-dash {
        display:block !important; overflow:visible !important; height:auto !important; max-height:none !important;
      }
      body.bb-doc-open .bb-wrap,
      body.bb-doc-open .bb-main,
      body.bb-doc-open .bb-doc {
        display:block; overflow:visible; height:auto; max-height:none; min-height:0;
      }
      body.bb-doc-open .bb-wrap {
        padding-top:calc(48px + env(safe-area-inset-top, 0px));
      }
      body.bb-editing:not(.bb-focus) .bb-wrap {
        padding-bottom:calc(48px + env(safe-area-inset-bottom, 0px) + var(--oc-kb-inset, 0px));
      }
      body.bb-focus .bb-wrap { padding-top:0; padding-bottom:0; }
      .bb-tree-head { padding:10px 12px; }
      .bb-tree-title { font-size:15px; }
      .bb-tree-filter { font-size:16px; min-height:44px; padding:8px 12px; }
      .bb-dir, .bb-file {
        min-height:44px; font-size:16px; padding-top:10px; padding-bottom:10px;
        display:flex; align-items:center;
      }
      .bb-file {
        padding-left:28px;
        white-space:normal;
        overflow:visible;
        text-overflow:unset;
        word-break:break-word;
      }
      body.bb-doc-open .bb-toolbar {
        position:fixed; top:var(--oc-vv-top, 0px); left:0; right:0; z-index:80;
        box-sizing:border-box;
        height:calc(48px + env(safe-area-inset-top, 0px));
        min-height:0; margin:0;
        padding:env(safe-area-inset-top, 0px) 4px 0;
        flex-direction:row; flex-wrap:nowrap; align-items:center; gap:0;
        background:var(--oc-bg-header); border-bottom:1px solid var(--oc-border);
        overflow:visible;
      }
      body.bb-focus .bb-toolbar { display:none !important; }
      body.bb-doc-open .bb-toolbar-row { display:flex; align-items:center; gap:4px; min-width:0; width:100%; height:48px; }
      body.bb-doc-open .bb-more { display:inline-flex; }
      .bb-back {
        display:inline-flex; align-items:center; justify-content:center;
        height:44px; min-height:44px; min-width:44px; padding:0 12px;
        border-radius:6px; border:1px solid var(--oc-border-strong);
        background:var(--oc-bg-input); color:var(--oc-text);
        font-size:16px; font-weight:700; cursor:pointer; flex-shrink:0;
      }
      body.bb-doc-open .bb-path {
        flex:1; min-width:0; font-size:15px; font-weight:700; color:var(--oc-text-header);
        white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
      }
      body.bb-doc-open .bb-more { color:var(--oc-text-header); }
      body.bb-doc-open .bb-dirty {
        flex:0 0 auto; width:8px; height:8px; padding:0; border-radius:50%;
        background:var(--oc-warning); color:transparent; font-size:0; overflow:hidden;
      }
      body.bb-doc-open .bb-actions {
        display:none; position:absolute; top:100%; right:6px;
        width:min(18rem, calc(100vw - 12px));
        flex-direction:column; align-items:stretch; gap:0;
        background:var(--oc-bg-card); border:1px solid var(--oc-border);
        box-shadow:var(--oc-shadow-lg); z-index:90; padding:4px;
      }
      body.bb-doc-open.bb-menu-open .bb-actions { display:flex; }
      body.bb-doc-open .bb-actions .bb-btn,
      body.bb-doc-open.bb-menu-open .bb-actions .bb-phone-only {
        display:flex; align-items:center; justify-content:flex-start;
        min-height:44px; width:100%; padding:8px 12px; font-size:16px; font-weight:700;
        background:transparent; border:0; border-radius:4px; color:var(--oc-text); text-align:left;
      }
      body.bb-doc-open .bb-actions .bb-primary { color:var(--oc-accent-text); }
      body.bb-doc-open .bb-actions .bb-danger { color:var(--oc-danger-text); }
      body.bb-doc-open.bb-menu-open .bb-menu-path {
        display:block; padding:8px 12px 10px; font-size:12px; line-height:1.4;
        color:var(--oc-text-faint); white-space:normal; word-break:break-word;
      }
      body.bb-editing:not(.bb-focus) .bb-savebar {
        display:flex; position:fixed; left:0; right:0; z-index:80;
        bottom:var(--oc-kb-inset, 0px);
        box-sizing:border-box;
        height:calc(48px + env(safe-area-inset-bottom, 0px));
        padding-bottom:env(safe-area-inset-bottom, 0px);
      }
      body.bb-focus .oc-focus-exit:not([hidden]) { display:inline-flex; }
      .bb-md-input, .bb-preview {
        display:block; width:100%; overflow:visible; flex:none;
        min-height:calc(var(--oc-vv-h, 100dvh) - 48px - env(safe-area-inset-top, 0px));
      }
      body.bb-editing:not(.bb-focus) .bb-md-input {
        min-height:calc(var(--oc-vv-h, 100dvh) - 96px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
      }
      body.bb-focus .bb-md-input,
      body.bb-focus .bb-preview { min-height:var(--oc-vv-h, 100dvh); }
      .bb-md-input { overflow:hidden; resize:none; }
      .bb-search {
        left:8px; right:8px; width:auto; top:8px;
        max-height:70dvh;
      }
      .bb-new-bar.open { flex-wrap:wrap; }
      .bb-new-input { font-size:16px; min-height:44px; flex:1 1 100%; }
      .bb-stats { font-size:13px; padding:8px 12px; }
      body.bb-editing .bb-toast { bottom:calc(56px + var(--oc-kb-inset, 0px)); }
      .bb-toast { left:12px; right:12px; bottom:calc(var(--oc-bottom-nav-height) + 12px); text-align:center; }
      .toastui-editor-contents { overflow-wrap:break-word; }
      .toastui-editor-contents pre { overflow-x:auto; max-width:100vw; }
    }
  </style>
</head>
<body class="oc-body bb-page">
  <%- include('partials/app-header') %>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/brain' }) %>
    <main class="oc-dashboard-area bb-dash">

      <!-- Search panel -->
      <div class="bb-search" id="searchPanel">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:13px;font-weight:600;color:var(--oc-info-text);flex:1">Search docs</span>
          <button class="bb-btn bb-secondary" onclick="toggleSearch()" style="font-size:11px;padding:2px 8px">&#10005;</button>
        </div>
        <input class="bb-search-input" id="searchInput" placeholder="Type to search all docs&#8230;" oninput="doSearch(this.value)">
        <div id="searchResults" style="margin-top:8px;max-height:320px;overflow-y:auto"></div>
      </div>

      <!-- New doc bar -->
      <div class="bb-new-bar" id="newBar">
        <span style="font-size:12px;color:var(--oc-text-muted);white-space:nowrap">&#128196; Path:</span>
        <input class="bb-new-input" id="newPathInput" placeholder="e.g. 03 - Agents/notes/my-note.md"
               onkeydown="if(event.key==='Enter')createNewDoc()">
        <button class="bb-btn bb-primary" onclick="createNewDoc()">Create</button>
        <button class="bb-btn bb-secondary" onclick="toggleNew()">Cancel</button>
      </div>

      <!-- Stats -->
      <div class="bb-stats" id="statsBar">Loading&#8230;</div>

      <!-- Two-pane -->
      <div class="bb-wrap">

        <!-- File tree -->
        <div class="bb-tree">
          <div class="bb-tree-head">
            <span class="bb-tree-title">&#128193; Brain</span>
            <input class="bb-tree-filter" id="treeFilter" placeholder="Filter&#8230;" oninput="filterTree(this.value)">
          </div>
          <div class="bb-tree-body" id="treeBody">
            <div style="padding:20px;text-align:center;color:var(--oc-text-faint);font-size:13px">Loading&#8230;</div>
          </div>
        </div>

        <!-- Doc pane -->
        <div class="bb-main">
          <!-- Toolbar (hidden until doc open) -->
          <div class="bb-toolbar" id="docToolbar" style="display:none">
            <div class="bb-toolbar-row">
              <button type="button" class="bb-back" id="docBack" onclick="closeDoc()">Back</button>
              <span class="bb-path" id="docPath"></span>
              <span class="bb-dirty" id="dirtyDot">unsaved</span>
              <button type="button" class="bb-more" id="docMore" aria-label="More actions" aria-haspopup="menu" aria-expanded="false" onclick="toggleDocMenu()">
                <span class="oc-dots" aria-hidden="true"></span>
              </button>
            </div>
            <div class="bb-actions" id="docActions" role="menu">
              <button type="button" class="bb-btn bb-secondary" id="modeBtn" onclick="toggleMode()">Preview</button>
              <button type="button" class="bb-btn bb-primary" id="saveBtn" onclick="saveDoc()">Save</button>
              <button type="button" class="bb-btn bb-secondary" id="historyBtn" onclick="viewHistory()">History</button>
              <button type="button" class="bb-btn bb-secondary bb-danger" id="deleteBtn" onclick="deleteDoc()">Delete</button>
              <button type="button" class="bb-btn bb-secondary bb-phone-only" id="focusBtn" onclick="toggleFocus()">Focus</button>
              <div class="bb-menu-path bb-phone-only" id="docMenuPath"></div>
            </div>
          </div>

          <!-- Doc area -->
          <div class="bb-doc" id="docArea">
            <div class="bb-empty">
              <span style="font-size:2.5em">&#129504;</span>
              Select a document from the tree, or use <strong>&#65291; New</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="bb-savebar" id="docSavebar">
        <button type="button" class="bb-savebar-btn" id="saveBarBtn" onclick="saveDoc()">Save</button>
      </div>
      <button type="button" class="oc-focus-exit" id="focusExit" hidden onclick="toggleFocus(false)">Exit focus</button>

    </main>
  </div>

  <!-- Toast UI Editor -->
  <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>

  <script>


    /* ── State ───────────────────────────────────────────────────────── */
    let currentPath    = null;
    let treeData       = null;
    let editorInst     = null;
    let isDirty        = false;
    let editorMode     = 'wysiwyg';   // 'wysiwyg' | 'markdown'
    let mobileEditor   = false;
    const phoneQuery   = window.matchMedia('(max-width: 767px)');

    function phone() { return phoneQuery.matches; }

    function showTree() {
      document.body.classList.remove('bb-doc-open', 'bb-editing', 'bb-previewing', 'bb-focus', 'bb-menu-open');
      const exit = document.getElementById('focusExit');
      if (exit) exit.hidden = true;
    }

    function docTitle(p) {
      const name = String(p || '').split('/').pop().replace(/\.md$/i, '');
      return name || 'Document';
    }

    function setPathLabel(p) {
      const el = document.getElementById('docPath');
      const menu = document.getElementById('docMenuPath');
      if (el) {
        el.title = p || '';
        el.textContent = phone() ? docTitle(p) : (p || '');
      }
      if (menu) menu.textContent = p || '';
    }

    function syncSaveLabel(text) {
      const btn = document.getElementById('saveBtn');
      const bar = document.getElementById('saveBarBtn');
      if (btn) btn.textContent = text;
      if (bar) bar.textContent = text === 'Saving...' ? 'Saving...' : 'Save';
    }

    function toggleDocMenu(force) {
      if (!phone()) return;
      const open = typeof force === 'boolean' ? force : !document.body.classList.contains('bb-menu-open');
      document.body.classList.toggle('bb-menu-open', open);
      const btn = document.getElementById('docMore');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function toggleFocus(force) {
      const on = typeof force === 'boolean' ? force : !document.body.classList.contains('bb-focus');
      document.body.classList.toggle('bb-focus', on);
      const exit = document.getElementById('focusExit');
      if (exit) exit.hidden = !on;
      const fb = document.getElementById('focusBtn');
      if (fb) fb.textContent = on ? 'Exit focus' : 'Focus';
      toggleDocMenu(false);
      autosizeEditor();
      syncViewport();
    }

    function showDocPane() {
      if (phone()) document.body.classList.add('bb-doc-open');
      else document.body.classList.remove('bb-doc-open', 'bb-editing', 'bb-previewing');
      layoutMobileDoc();
    }

    /* ── Boot ────────────────────────────────────────────────────────── */
    async function boot() {
      loadStats();
      const tree = await api('/api/brain/tree');
      treeData = tree;
      renderTree(tree, document.getElementById('treeBody'));
      const p = new URLSearchParams(location.search).get('path');
      history.replaceState({ ocBrain: p ? 'doc' : 'tree', path: p || null, pushed: false }, '', location.href);
      if (p) openDoc(p, { fromPop: true });
      phoneQuery.addEventListener('change', onPhoneChange);
      window.addEventListener('popstate', onPopState);
      if (window.visualViewport) {
        visualViewport.addEventListener('resize', syncViewport);
        visualViewport.addEventListener('scroll', syncViewport);
      }
    }

    async function loadStats() {
      const s = await api('/api/brain/stats');
      const el = document.getElementById('statsBar');
      if (s && s.documents != null)
        el.textContent = s.documents.toLocaleString() + ' documents \u00b7 ' +
                         s.versions.toLocaleString() + ' versions \u00b7 ' +
                         (s.db_file_bytes/1024/1024).toFixed(1) + ' MB';
      else el.textContent = '';
    }

    /* ── API wrapper  -  always sends credentials (session cookie) ─────── */
    async function api(url, opts = {}) {
      opts.credentials = 'include';   // ← THE FIX: send session cookie on every request
      try {
        const r = await fetch(url, opts);
        if (r.status === 401) { location.href = '/brain/login?next=' + encodeURIComponent(location.pathname + location.search); return {}; }
        return await r.json();
      } catch(e) { return { error: e.message }; }
    }

    /* ── File tree ───────────────────────────────────────────────────── */
    function renderTree(node, container) {
      container.innerHTML = '';
      for (const c of (node.children || [])) {
        if (c.type === 'dir') {
          const wrap = document.createElement('div');
          const head = document.createElement('div');
          head.className = 'bb-dir';
          head.innerHTML = '<span class="bb-arr">\u25B6</span> \uD83D\uDCC1 ' + esc(c.name);
          head.onclick = () => { head.classList.toggle('open'); kids.classList.toggle('open'); };
          const kids = document.createElement('div');
          kids.className = 'bb-kids';
          renderTree(c, kids);
          wrap.appendChild(head); wrap.appendChild(kids);
          container.appendChild(wrap);
        } else {
          const el = document.createElement('div');
          el.className = 'bb-file';
          el.dataset.path = c.path;
          el.textContent  = c.name.replace(/\.md$/, '');
          el.title = c.path;
          el.onclick = () => openDoc(c.path);
          container.appendChild(el);
        }
      }
    }

    function filterTree(q) {
      const body = document.getElementById('treeBody');
      if (!q.trim()) { body.innerHTML=''; renderTree(treeData, body); highlightActive(); return; }
      q = q.toLowerCase();
      const hits = getAllFiles(treeData).filter(f => f.path.toLowerCase().includes(q));
      body.innerHTML = hits.map(f =>
        `<div class="bb-file${f.path===currentPath?' active':''}" data-path="${esc(f.path)}"
              onclick="openDoc('${esc(f.path)}')" title="${esc(f.path)}">${esc(f.path)}</div>`
      ).join('') || '<div style="padding:12px;color:var(--oc-text-faint);font-size:12px">No matches</div>';
    }

    function getAllFiles(node, out=[]) {
      for (const c of (node.children||[])) { if(c.type==='file') out.push(c); else getAllFiles(c,out); }
      return out;
    }

    function highlightActive() {
      document.querySelectorAll('.bb-file').forEach(el => {
        const active = el.dataset.path === currentPath;
        el.classList.toggle('active', active);
        if (active) {
          let p = el.parentElement;
          while (p && p !== document.getElementById('treeBody')) {
            if (p.classList.contains('bb-kids')) p.classList.add('open');
            if (p.classList.contains('bb-dir'))  p.classList.add('open');
            p = p.parentElement;
          }
        }
      });
    }

    /* ── Open doc ────────────────────────────────────────────────────── */
    async function openDoc(docPath, opts) {
      opts = opts || {};
      if (!opts.fromPop && isDirty && currentPath && currentPath !== docPath && !confirm('Unsaved changes. Discard and open the other document?')) return;
      currentPath = docPath;
      isDirty     = false;
      document.body.classList.remove('bb-previewing');
      const url = '/brain?path=' + encodeURIComponent(docPath);
      if (!opts.fromPop) {
        if (phone()) history.pushState({ ocBrain: 'doc', path: docPath, pushed: true }, '', url);
        else history.replaceState({ ocBrain: 'doc', path: docPath, pushed: false }, '', url);
      }
      showDocPane();
      highlightActive();

      document.getElementById('docToolbar').style.display = 'flex';
      setPathLabel(docPath);
      document.getElementById('dirtyDot').style.display = 'none';
      syncSaveLabel('Save');

      const area = document.getElementById('docArea');
      area.innerHTML = '<div class="bb-empty"><span style="font-size:2em">\u23F3</span> Loading\u2026</div>';

      const doc = await api('/api/brain/doc?path=' + encodeURIComponent(docPath));
      const content = (doc && doc.content) ? doc.content : '';
      area.innerHTML = '';
      mountEditor(area, content);
    }

    function closeDoc() {
      if (isDirty && !confirm('Unsaved changes. Leave this document?')) return;
      isDirty = false;
      if (phone() && history.state && history.state.pushed) {
        history.back();
        return;
      }
      showTree();
      if (phone()) history.pushState({ ocBrain: 'tree', path: null, pushed: false }, '', '/brain');
    }

    function onPopState() {
      const path = new URLSearchParams(location.search).get('path');
      if (!path && isDirty) {
        if (!confirm('Unsaved changes. Leave this document?')) {
          history.pushState({ ocBrain: 'doc', path: currentPath, pushed: true }, '', '/brain?path=' + encodeURIComponent(currentPath || ''));
          return;
        }
        isDirty = false;
      }
      if (path) openDoc(path, { fromPop: true });
      else showTree();
    }

    function onPhoneChange() {
      if (currentPath) setPathLabel(currentPath);
      if (!currentPath || document.getElementById('docToolbar').style.display === 'none') {
        showTree();
        return;
      }
      const content = readContent();
      showDocPane();
      const area = document.getElementById('docArea');
      area.innerHTML = '';
      mountEditor(area, content);
    }

    function markDirty() {
      isDirty = true;
      const dot = document.getElementById('dirtyDot');
      if (dot) dot.style.display = '';
      syncSaveLabel('Save*');
    }

    function readContent() {
      if (mobileEditor) {
        const input = document.getElementById('bb-md-input');
        return input ? input.value : '';
      }
      if (editorInst) return editorInst.getMarkdown();
      return '';
    }

    function layoutMobileDoc() {
      const editing = phone() && mobileEditor && document.body.classList.contains('bb-doc-open') && !document.body.classList.contains('bb-previewing');
      document.body.classList.toggle('bb-editing', editing);
      if (phone() && document.body.classList.contains('bb-doc-open')) {
        requestAnimationFrame(() => { syncViewport(); autosizeEditor(); });
      }
    }

    function syncViewport() {
      if (!phone() || !document.body.classList.contains('bb-doc-open')) return;
      const vv = window.visualViewport;
      const top = vv ? vv.offsetTop : 0;
      const height = vv ? vv.height : window.innerHeight;
      const inset = Math.max(0, window.innerHeight - height - top);
      document.documentElement.style.setProperty('--oc-vv-top', top + 'px');
      document.documentElement.style.setProperty('--oc-vv-h', height + 'px');
      document.documentElement.style.setProperty('--oc-kb-inset', inset + 'px');
      autosizeEditor();
      revealCaret();
    }

    function autosizeEditor() {
      const input = document.getElementById('bb-md-input');
      if (!input || input.hidden) return;
      const vv = window.visualViewport;
      const vh = vv ? vv.height : window.innerHeight;
      const focused = document.body.classList.contains('bb-focus');
      const editing = document.body.classList.contains('bb-editing');
      const chrome = (focused ? 0 : 48) + (!focused && editing ? 48 : 0);
      const min = Math.max(160, Math.round(vh - chrome));
      input.style.height = 'auto';
      input.style.height = Math.max(input.scrollHeight, min) + 'px';
    }

    function revealCaret() {
      const input = document.getElementById('bb-md-input');
      if (!input || input.hidden || document.activeElement !== input) return;
      const pos = input.selectionStart || 0;
      const style = getComputedStyle(input);
      const mirror = document.createElement('div');
      mirror.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;white-space:pre-wrap;word-wrap:break-word;overflow:hidden;';
      ['fontFamily','fontSize','fontWeight','lineHeight','letterSpacing','paddingTop','paddingRight','paddingBottom','paddingLeft','borderTopWidth','boxSizing','width'].forEach(prop => {
        mirror.style[prop] = style[prop];
      });
      mirror.textContent = input.value.slice(0, pos);
      const mark = document.createElement('span');
      mark.textContent = input.value.slice(pos, pos + 1) || ' ';
      mirror.appendChild(mark);
      document.body.appendChild(mirror);
      const caretTop = mark.offsetTop;
      const caretH = mark.offsetHeight || 24;
      mirror.remove();
      const rect = input.getBoundingClientRect();
      const vv = window.visualViewport;
      const viewH = vv ? vv.height : window.innerHeight;
      const focused = document.body.classList.contains('bb-focus');
      const topGap = focused ? 12 : 56;
      const bottomGap = focused ? 12 : 56;
      const caretY = window.scrollY + rect.top + caretTop;
      const visibleTop = window.scrollY + topGap;
      const visibleBottom = window.scrollY + viewH - bottomGap;
      if (caretY < visibleTop) window.scrollTo(0, Math.max(0, caretY - topGap));
      else if (caretY + caretH > visibleBottom) window.scrollTo(0, caretY + caretH - viewH + bottomGap);
    }

    function simpleMarkdown(src) {
      const lines = String(src || '').replace(/\r\n/g, '\n').split('\n');
      let html = '';
      let i = 0;
      const inline = (s) => s
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      while (i < lines.length) {
        const line = lines[i];
        if (line.startsWith('```')) {
          const buf = [];
          i++;
          while (i < lines.length && !lines[i].startsWith('```')) { buf.push(esc(lines[i])); i++; }
          if (i < lines.length) i++;
          html += '<pre class="bb-code-scroll"><code>' + buf.join('\n') + '</code></pre>';
          continue;
        }
        if (line.includes('|') && i + 1 < lines.length && /^\s*\|?\s*:?-{3,}/.test(lines[i + 1])) {
          const rows = [];
          while (i < lines.length && lines[i].includes('|')) { rows.push(lines[i]); i++; }
          const body = rows.filter((_, idx) => idx !== 1).map((row, idx) => {
            const cells = row.replace(/^\|/, '').replace(/\|$/, '').split('|');
            const tag = idx === 0 ? 'th' : 'td';
            return '<tr>' + cells.map(c => '<' + tag + '>' + inline(esc(c.trim())) + '</' + tag + '>').join('') + '</tr>';
          }).join('');
          html += '<div class="bb-table-scroll"><table>' + body + '</table></div>';
          continue;
        }
        const heading = line.match(/^(#{1,6})\s+(.*)$/);
        if (heading) {
          const level = heading[1].length;
          html += '<h' + level + '>' + inline(esc(heading[2])) + '</h' + level + '>';
          i++;
          continue;
        }
        if (/^\s*[-*]\s+/.test(line)) {
          html += '<ul>';
          while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) {
            html += '<li>' + inline(esc(lines[i].replace(/^\s*[-*]\s+/, ''))) + '</li>';
            i++;
          }
          html += '</ul>';
          continue;
        }
        if (!line.trim()) { i++; continue; }
        html += '<p>' + inline(esc(line)) + '</p>';
        i++;
      }
      return html;
    }

    function renderMarkdownHtml(md) {
      let html;
      if (window.marked && typeof marked.parse === 'function') {
        try { html = marked.parse(md); }
        catch (e) { html = simpleMarkdown(md); }
      } else html = simpleMarkdown(md);
      const holder = document.createElement('div');
      holder.innerHTML = html;
      holder.querySelectorAll('pre').forEach(pre => pre.classList.add('bb-code-scroll'));
      holder.querySelectorAll('table').forEach(table => {
        if (table.parentElement && table.parentElement.classList.contains('bb-table-scroll')) return;
        const wrap = document.createElement('div');
        wrap.className = 'bb-table-scroll';
        table.parentNode.insertBefore(wrap, table);
        wrap.appendChild(table);
      });
      return holder.innerHTML;
    }

    function renderMobilePreview() {
      const preview = document.getElementById('bb-preview');
      if (!preview) return;
      preview.innerHTML = renderMarkdownHtml(readContent());
    }

    /* ── Editor ──────────────────────────────────────────────────────── */
    function mountEditor(container, content) {
      if (editorInst) { try { editorInst.destroy(); } catch(e){} editorInst = null; }
      mobileEditor = phone();
      container.style.cssText = mobileEditor
        ? 'display:block;overflow:visible;height:auto;min-height:0'
        : 'flex:1;display:flex;flex-direction:column;overflow:hidden;min-height:0';
      container.innerHTML = '';

      if (mobileEditor) {
        const input = document.createElement('textarea');
        input.id = 'bb-md-input';
        input.className = 'bb-md-input';
        input.value = content;
        input.spellcheck = false;
        input.autocomplete = 'off';
        input.autocapitalize = 'off';
        input.setAttribute('aria-label', 'Markdown editor');
        input.addEventListener('input', () => { markDirty(); autosizeEditor(); revealCaret(); });
        input.addEventListener('keyup', revealCaret);
        input.addEventListener('focus', () => { layoutMobileDoc(); syncViewport(); revealCaret(); });
        const preview = document.createElement('div');
        preview.id = 'bb-preview';
        preview.className = 'bb-preview';
        preview.hidden = true;
        container.appendChild(input);
        container.appendChild(preview);
        container.addEventListener('keydown', e => {
          if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveDoc(); }
        });
        document.body.classList.remove('bb-previewing');
        layoutMobileDoc();
        updateModeBtn();
        requestAnimationFrame(autosizeEditor);
        return;
      }

      const host = document.createElement('div');
      host.style.cssText = 'flex:1;display:flex;flex-direction:column;overflow:hidden;height:100%';
      container.appendChild(host);

      editorInst = new toastui.Editor({
        el:               host,
        initialValue:     content,
        initialEditType:  editorMode,
        previewStyle:     'tab',
        height:           '100%',
        usageStatistics:  false,
        toolbarItems: [
          ['heading','bold','italic','strike'],
          ['hr'],
          ['ul','ol','task','indent','outdent'],
          ['table','link'],
          ['code','codeblock'],
          ['scrollSync'],
        ],
        events: { change: markDirty },
      });

      host.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveDoc(); }
      }, true);

      updateModeBtn();
    }

    /* ── Mode toggle ─────────────────────────────────────────────────── */
    function toggleMode() {
      if (mobileEditor) {
        const previewing = document.body.classList.contains('bb-previewing');
        const input = document.getElementById('bb-md-input');
        const preview = document.getElementById('bb-preview');
        if (previewing) {
          document.body.classList.remove('bb-previewing');
          if (input) input.hidden = false;
          if (preview) preview.hidden = true;
        } else {
          renderMobilePreview();
          document.body.classList.add('bb-previewing');
          if (input) { input.hidden = true; input.blur(); }
          if (preview) preview.hidden = false;
        }
        layoutMobileDoc();
        updateModeBtn();
        toggleDocMenu(false);
        return;
      }
      editorMode = editorMode === 'wysiwyg' ? 'markdown' : 'wysiwyg';
      if (editorInst) editorInst.changeMode(editorMode);
      updateModeBtn();
    }
    function updateModeBtn() {
      const btn = document.getElementById('modeBtn');
      if (!btn) return;
      if (mobileEditor) {
        const previewing = document.body.classList.contains('bb-previewing');
        btn.textContent = previewing ? 'Edit' : 'Preview';
        btn.setAttribute('aria-pressed', previewing ? 'true' : 'false');
        return;
      }
      btn.textContent = editorMode === 'wysiwyg' ? 'Markdown' : 'WYSIWYG';
    }

    /* ── Save ────────────────────────────────────────────────────────── */
    async function saveDoc() {
      toggleDocMenu(false);
      if (!currentPath || (!editorInst && !mobileEditor)) return;
      const content = readContent();
      const btn = document.getElementById('saveBtn');
      const bar = document.getElementById('saveBarBtn');
      btn.disabled = true;
      if (bar) bar.disabled = true;
      syncSaveLabel('Saving...');
      const result = await api(
        '/api/brain/doc?path=' + encodeURIComponent(currentPath),
        {
          method:  'PUT',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ content }),
        }
      );
      btn.disabled = false;
      if (bar) bar.disabled = false;
      if (result.ok) {
        isDirty = false;
        document.getElementById('dirtyDot').style.display = 'none';
        syncSaveLabel('Save');
        showToast('Saved', 'var(--oc-accent)');
      } else {
        syncSaveLabel('Save*');
        showToast(result.error || 'Save failed', 'var(--oc-danger)');
      }
    }

    /* ── Delete ──────────────────────────────────────────────────────── */
    async function deleteDoc() {
      if (!currentPath || !confirm('Delete "' + currentPath + '"?\n\nThis cannot be undone.')) return;
      const r = await api(
        '/api/brain/doc?path=' + encodeURIComponent(currentPath),
        { method: 'DELETE' }
      );
      if (r && r.ok !== false) {
        currentPath = null; isDirty = false;
        mobileEditor = false;
        if (editorInst) { try { editorInst.destroy(); } catch(e){} editorInst = null; }
        document.getElementById('docArea').innerHTML = '<div class="bb-empty"><span>\uD83D\uDDD1</span> Deleted</div>';
        document.getElementById('docToolbar').style.display = 'none';
        showTree();
        history.replaceState({ ocBrain: 'tree', path: null, pushed: false }, '', '/brain');
        const tree = await api('/api/brain/tree');
        treeData = tree;
        renderTree(tree, document.getElementById('treeBody'));
        showToast('Deleted', 'var(--oc-text-faint)');
      }
    }

    /* ── History ─────────────────────────────────────────────────────── */
    function viewHistory() {
      if (currentPath) location.href = '/brain/history?path=' + encodeURIComponent(currentPath);
    }

    /* ── New doc ─────────────────────────────────────────────────────── */
    function toggleNew() {
      const bar = document.getElementById('newBar');
      bar.classList.toggle('open');
      if (bar.classList.contains('open')) document.getElementById('newPathInput').focus();
    }
    async function createNewDoc() {
      let p = document.getElementById('newPathInput').value.trim();
      if (!p) return;
      if (!p.endsWith('.md')) p += '.md';
      const name = p.split('/').pop().replace(/\.md$/, '');
      const result = await api(
        '/api/brain/doc?path=' + encodeURIComponent(p),
        { method:'PUT', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ content: '# ' + name + '\n\n' }) }
      );
      if (result.ok) {
        toggleNew();
        document.getElementById('newPathInput').value = '';
        const tree = await api('/api/brain/tree');
        treeData = tree;
        renderTree(tree, document.getElementById('treeBody'));
        openDoc(p);
      } else {
        showToast('\u274C ' + (result.error || 'Create failed'), 'var(--oc-danger)');
      }
    }

    /* ── Search ──────────────────────────────────────────────────────── */
    let _searchTimer;
    function toggleSearch() {
      const p = document.getElementById('searchPanel');
      p.classList.toggle('open');
      if (p.classList.contains('open')) document.getElementById('searchInput').focus();
    }
    function doSearch(q) {
      clearTimeout(_searchTimer);
      const el = document.getElementById('searchResults');
      if (!q.trim()) { el.innerHTML=''; return; }
      _searchTimer = setTimeout(async () => {
        const r = await api('/api/brain/search?q=' + encodeURIComponent(q) + '&limit=20');
        el.innerHTML = (r.results && r.results.length)
          ? r.results.map(item =>
              `<div class="bb-sr" onclick="openDoc('${esc(item.path)}');toggleSearch()">
                <div class="bb-sr-path">${esc(item.path)}</div>
                <div class="bb-sr-snip">${item.snippet||''}</div>
              </div>`).join('')
          : '<div style="padding:10px;color:var(--oc-text-faint);font-size:13px">No results</div>';
      }, 220);
    }

    /* ── Auth ────────────────────────────────────────────────────────── */
    async function logout() {
      await fetch('/auth/logout', { method:'POST', credentials:'include' });
      location.href = '/brain/login';
    }

    /* ── Utilities ───────────────────────────────────────────────────── */
    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function showToast(msg, bg) {
      const t = document.createElement('div');
      t.className = 'bb-toast';
      t.textContent = msg;
      t.style.background = bg || 'var(--oc-accent)';
      document.body.appendChild(t);
      setTimeout(() => { t.style.opacity='0'; setTimeout(()=>t.remove(), 320); }, 2200);
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        document.getElementById('searchPanel').classList.remove('open');
        document.getElementById('newBar').classList.remove('open');
        if (document.body.classList.contains('bb-focus')) toggleFocus(false);
        else toggleDocMenu(false);
      }
    });
    document.addEventListener('click', e => {
      if (!document.body.classList.contains('bb-menu-open')) return;
      if (e.target.closest && e.target.closest('#docToolbar')) return;
      toggleDocMenu(false);
    });
    document.addEventListener('selectionchange', () => {
      if (document.activeElement && document.activeElement.id === 'bb-md-input') revealCaret();
    });

    boot();
  </script>
  <%- include('partials/chrome-end') %>
</body>
</html>
