<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <!-- Toast UI Editor — Obsidian-style WYSIWYG markdown editor -->
  <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
  <!-- highlight.js for code block syntax highlighting in preview -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
  <style>
    /* ── Two-pane layout ─────────────────────────────────────────────────── */
    .bb-wrap   { display: flex; flex: 1; overflow: hidden; min-height: 0; }

    /* ── File tree ───────────────────────────────────────────────────────── */
    .bb-tree   { width: 270px; min-width: 180px; max-width: 380px; background: var(--surface-2, #1a1a2e);
                 border-right: 1px solid var(--border, #2a2a4a); display: flex; flex-direction: column; overflow: hidden; }
    .bb-tree-head { padding: 10px 12px; border-bottom: 1px solid var(--border, #2a2a4a); display: flex; align-items: center; gap: 8px; }
    .bb-tree-search { flex: 1; background: var(--surface-3,#111122); border: 1px solid var(--border,#2a2a4a);
                      border-radius: 5px; color: #ccc; padding: 5px 9px; font-size: 12.5px; }
    .bb-tree-body  { flex: 1; overflow-y: auto; padding: 6px 0; }
    .bb-dir  { padding: 4px 10px; cursor: pointer; font-size: 12.5px; font-weight: 600; color: #9098b8;
               display: flex; align-items: center; gap: 5px; user-select: none; }
    .bb-dir:hover { background: rgba(255,255,255,.04); }
    .bb-dir .arrow { font-size: 9px; transition: transform .15s; display: inline-block; width: 10px; }
    .bb-dir.open .arrow { transform: rotate(90deg); }
    .bb-file { padding: 3px 10px 3px 26px; cursor: pointer; font-size: 12px; color: #6a7490;
               white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bb-file:hover { background: rgba(255,255,255,.04); color: #b0b8d8; }
    .bb-file.active { background: rgba(99,102,241,.15); color: #9fa8f8; font-weight: 600; }
    .bb-children { display: none; }
    .bb-children.open { display: block; }

    /* ── Right pane ──────────────────────────────────────────────────────── */
    .bb-main  { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
    .bb-top-bar { padding: 7px 12px; border-bottom: 1px solid var(--border,#2a2a4a);
                  display: flex; align-items: center; gap: 8px; flex-wrap: wrap; flex-shrink: 0; background: var(--surface-2,#1a1a2e); }
    .bb-path-display { flex: 1; font-size: 11.5px; color: #555; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bb-btn { padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: none; }
    .bb-btn-primary   { background: #6366f1; color: #fff; }
    .bb-btn-secondary { background: var(--surface-3,#111122); color: #aaa; border: 1px solid var(--border,#2a2a4a); }
    .bb-btn:hover     { opacity: .85; }
    .bb-btn:disabled  { opacity: .4; cursor: default; }
    .bb-doc   { flex: 1; display: flex; overflow: hidden; position: relative; }

    /* ── Toast UI editor overrides ───────────────────────────────────────── */
    .bb-editor-host { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .toastui-editor-defaultUI { flex: 1 !important; display: flex !important; flex-direction: column !important; overflow: hidden !important; height: 100% !important; }
    .toastui-editor-main      { flex: 1 !important; overflow: hidden !important; }
    .toastui-editor-ww-container, .toastui-editor-md-container { height: 100% !important; }
    .toastui-editor-toolbar   { background: var(--surface-2,#1a1a2e) !important; border-bottom: 1px solid var(--border,#2a2a4a) !important; }
    .toastui-editor-toolbar button { color: #9098b8 !important; }
    .toastui-editor-toolbar button:hover { background: rgba(99,102,241,.15) !important; }
    .toastui-editor-defaultUI-toolbar { padding: 4px 8px !important; }
    /* Dark editor background */
    .toastui-editor-ww-container .ProseMirror {
      background: #0c0c1a !important; color: #c8d4e8 !important;
      font-size: 15px !important; line-height: 1.8 !important; padding: 28px 40px !important;
    }
    .toastui-editor-md-container .toastui-editor { background: #0c0c1a !important; color: #c8d4e8 !important; }
    .toastui-editor-md-container .CodeMirror { background: #0c0c1a !important; color: #c8d4e8 !important; height: 100% !important; }
    .toastui-editor-contents h1 { font-size: 2em; font-weight: 800; color: #e8ecf8; border-bottom: 1px solid var(--border,#2a2a4a); padding-bottom: .3em; }
    .toastui-editor-contents h2 { font-size: 1.5em; font-weight: 700; color: #dde3f5; border-bottom: 1px solid var(--border,#2a2a4a); }
    .toastui-editor-contents h3 { font-size: 1.2em; font-weight: 700; color: #d0d8f0; }
    .toastui-editor-contents a  { color: #818cf8; }
    .toastui-editor-contents code { background: rgba(255,255,255,.07); color: #a5b4fc; padding: 2px 6px; border-radius: 4px; font-size: .87em; }
    .toastui-editor-contents pre { background: #0d0d1a; border: 1px solid var(--border,#2a2a4a); border-radius: 8px; }
    .toastui-editor-contents blockquote { border-left: 3px solid #6366f1; background: rgba(99,102,241,.07); color: #a0a8c0; }
    .toastui-editor-contents table th { background: rgba(99,102,241,.12); color: #a0aaff; }
    .toastui-editor-contents table th, .toastui-editor-contents table td { border-color: var(--border,#2a2a4a); }
    /* Toolbar toggle buttons highlight */
    .toastui-editor-defaultUI .tab-item.active { border-bottom: 2px solid #6366f1 !important; color: #a0aaff !important; }
    /* Frontmatter shown as code block */
    .bb-frontmatter-notice { font-size: 11px; color: #6a7490; padding: 4px 14px; background: rgba(99,102,241,.05);
                             border-bottom: 1px solid var(--border,#2a2a4a); }

    /* ── Empty / loading states ──────────────────────────────────────────── */
    .bb-empty { display: flex; align-items: center; justify-content: center; flex: 1; color: #555; font-size: 14px; flex-direction: column; gap: 8px; }

    /* ── Global search overlay ───────────────────────────────────────────── */
    .bb-search-panel { position: fixed; top: 60px; right: 20px; width: 420px; background: var(--surface-2,#1a1a2e);
                       border: 1px solid var(--border,#2a2a4a); border-radius: 10px; padding: 14px;
                       z-index: 300; box-shadow: 0 8px 32px rgba(0,0,0,.6); display: none; }
    .bb-search-panel.open { display: block; }
    .bb-search-input { width: 100%; background: var(--surface-3,#111122); border: 1px solid var(--border,#2a2a4a);
                       border-radius: 6px; color: #ccc; padding: 8px 12px; font-size: 13px; box-sizing: border-box; }
    .bb-sr { padding: 8px 10px; border-bottom: 1px solid var(--border,#2a2a4a); cursor: pointer; }
    .bb-sr:hover { background: rgba(255,255,255,.04); }
    .bb-sr-path { font-size: 11px; color: #6366f1; }
    .bb-sr-snip { font-size: 12px; color: #999; margin-top: 2px; }
    .bb-sr-snip mark { background: rgba(99,102,241,.3); color: #a0aaff; border-radius: 2px; }

    /* ── New-doc bar ─────────────────────────────────────────────────────── */
    .bb-new-bar { display: none; padding: 7px 14px; background: var(--surface-3,#111122);
                  border-bottom: 1px solid var(--border,#2a2a4a); align-items: center; gap: 8px; }
    .bb-new-bar.open { display: flex; }
    .bb-new-input { flex: 1; background: var(--surface-2,#1a1a2e); border: 1px solid var(--border,#2a2a4a);
                    border-radius: 6px; color: #ccc; padding: 5px 10px; font-size: 13px; }

    /* ── Stats bar ───────────────────────────────────────────────────────── */
    .bb-stats { font-size: 11px; color: #555; padding: 3px 14px 5px; border-bottom: 1px solid var(--border,#2a2a4a); flex-shrink: 0; }

    /* ── Light mode ──────────────────────────────────────────────────────── */
    body.light-mode .toastui-editor-ww-container .ProseMirror { background: #fff !important; color: #1f2937 !important; }
    body.light-mode .toastui-editor-md-container .toastui-editor { background: #fff !important; color: #1f2937 !important; }
    body.light-mode .toastui-editor-md-container .CodeMirror { background: #fff !important; color: #1f2937 !important; }
    body.light-mode .toastui-editor-toolbar { background: #f8fafc !important; }
    body.light-mode .toastui-editor-contents h1,
    body.light-mode .toastui-editor-contents h2,
    body.light-mode .toastui-editor-contents h3 { color: #111827 !important; }
    body.light-mode .toastui-editor-contents code { background: rgba(0,0,0,.06) !important; color: #4338ca !important; }
    body.light-mode .toastui-editor-contents pre  { background: #f8fafc !important; }
    body.light-mode .bb-tree   { background: #f0f4ff; }
    body.light-mode .bb-top-bar { background: #f0f4ff; }
    body.light-mode .bb-dir  { color: #374151; }
    body.light-mode .bb-file { color: #4b5563; }
    body.light-mode .bb-file.active { color: #3730a3; }
  </style>
</head>
<body class="oc-body">
  <header class="oc-header">
    <div class="logo"><a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer"><h1 class="main-title">OVERCLAW</h1><span class="tagline">AI BRAIN</span></a></div>
    <div class="header-controls" style="display:flex;align-items:center;gap:8px">
      <button class="bb-btn bb-btn-secondary" onclick="toggleSearch()" style="padding:4px 10px;font-size:12px">🔍 Search</button>
      <button class="bb-btn bb-btn-secondary" onclick="toggleNew()"    style="padding:4px 10px;font-size:12px">＋ New Doc</button>
      <% if (actor.type === 'user') { %>
        <span style="color:#666;font-size:11px"><%= actor.name %></span>
        <button class="bb-btn bb-btn-secondary" onclick="logout()" style="padding:4px 10px;font-size:12px">Sign out</button>
      <% } %>
      <button id="sidebar-toggle" class="control-button">☰</button>
      <button id="theme-toggle" class="control-button">☀️</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/brain' }) %>
    <main class="oc-dashboard-area" style="padding:0!important;overflow:hidden!important;display:flex!important;flex-direction:column!important">

      <!-- Global search panel -->
      <div class="bb-search-panel" id="searchPanel">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:13px;font-weight:600;color:#c0c8e0;flex:1">Search documents</span>
          <button class="bb-btn bb-btn-secondary" onclick="toggleSearch()" style="padding:2px 8px;font-size:11px">✕</button>
        </div>
        <input class="bb-search-input" id="searchInput" placeholder="Type to search all docs…" oninput="doSearch(this.value)">
        <div id="searchResults" style="margin-top:8px;max-height:340px;overflow-y:auto"></div>
      </div>

      <!-- New doc bar -->
      <div class="bb-new-bar" id="newBar">
        <span style="font-size:13px;color:#aaa;white-space:nowrap">📄 New doc path:</span>
        <input class="bb-new-input" id="newPathInput" placeholder="e.g. 03 - Agents/notes/my-note.md"
               onkeydown="if(event.key==='Enter')createNewDoc()">
        <button class="bb-btn bb-btn-primary"    onclick="createNewDoc()">Create</button>
        <button class="bb-btn bb-btn-secondary"  onclick="toggleNew()">Cancel</button>
      </div>

      <!-- Stats bar -->
      <div class="bb-stats" id="statsBar">Loading…</div>

      <!-- Two-pane -->
      <div class="bb-wrap">
        <!-- File tree -->
        <div class="bb-tree">
          <div class="bb-tree-head">
            <span style="font-size:12.5px;font-weight:700;color:#b0b8d8">📁 Brain</span>
            <input class="bb-tree-search" id="treeFilter" placeholder="Filter…" oninput="filterTree(this.value)">
          </div>
          <div class="bb-tree-body" id="treeBody">
            <div style="padding:20px;text-align:center;color:#555;font-size:13px">Loading…</div>
          </div>
        </div>

        <!-- Doc pane -->
        <div class="bb-main">
          <!-- Doc toolbar -->
          <div class="bb-top-bar" id="docToolbar" style="display:none">
            <span class="bb-path-display" id="docPathDisplay"></span>
            <span id="unsavedDot" style="display:none;color:#f59e0b;font-size:11px;font-weight:700">● unsaved</span>
            <button class="bb-btn bb-btn-primary"   id="saveBtn"   onclick="saveDoc()" style="display:none">💾 Save</button>
            <button class="bb-btn bb-btn-secondary" id="wysiBtn"   onclick="setMode('wysiwyg')" style="display:none">✏️ WYSIWYG</button>
            <button class="bb-btn bb-btn-secondary" id="mdBtn"     onclick="setMode('markdown')" style="display:none">⌨️ Markdown</button>
            <button class="bb-btn bb-btn-secondary"                onclick="viewHistory()">⏱ History</button>
            <button class="bb-btn bb-btn-secondary"                onclick="deleteDoc()">🗑 Delete</button>
          </div>
          <div class="bb-doc" id="docArea">
            <div class="bb-empty">
              <span style="font-size:2em">🧠</span>
              Select a document from the tree, or use <strong>＋ New Doc</strong>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Toast UI Editor JS -->
  <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>
  <!-- highlight.js for code blocks -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

  <script>
    // ── State ─────────────────────────────────────────────────────────────
    let currentPath    = null;
    let currentContent = '';
    let editorInst     = null;    // Toast UI Editor instance
    let treeData       = null;
    let isDirty        = false;

    // ── Boot ──────────────────────────────────────────────────────────────
    async function boot() {
      loadStats();
      const tree = await fetchJSON('/api/brain/tree');
      treeData = tree;
      renderTree(tree, document.getElementById('treeBody'));
      const params = new URLSearchParams(location.search);
      const initPath = params.get('path') || params.get('doc');
      if (initPath) openDoc(initPath);
    }

    async function loadStats() {
      const s = await fetchJSON('/api/brain/stats');
      if (s && s.documents != null) {
        document.getElementById('statsBar').textContent =
          `${(s.documents||0).toLocaleString()} documents · ${(s.versions||0).toLocaleString()} versions · ${((s.db_file_bytes||0)/1024/1024).toFixed(1)} MB`;
      } else {
        document.getElementById('statsBar').textContent = '';
      }
    }

    // ── File tree ─────────────────────────────────────────────────────────
    function renderTree(node, container) {
      container.innerHTML = '';
      for (const child of (node.children || [])) {
        if (child.type === 'dir') {
          const wrap = document.createElement('div');
          const head = document.createElement('div');
          head.className = 'bb-dir';
          head.dataset.path = child.path;
          head.innerHTML = `<span class="arrow">▶</span> 📁 ${esc(child.name)}`;
          head.onclick = () => {
            head.classList.toggle('open');
            kids.classList.toggle('open');
          };
          const kids = document.createElement('div');
          kids.className = 'bb-children';
          renderTree(child, kids);
          wrap.appendChild(head);
          wrap.appendChild(kids);
          container.appendChild(wrap);
        } else {
          const el = document.createElement('div');
          el.className = 'bb-file';
          el.dataset.path = child.path;
          el.textContent = child.name.replace(/\.md$/, '');
          el.title = child.path;
          el.onclick = () => openDoc(child.path);
          container.appendChild(el);
        }
      }
    }

    function filterTree(q) {
      const container = document.getElementById('treeBody');
      if (!q.trim()) {
        container.innerHTML = '';
        renderTree(treeData, container);
        if (currentPath) highlightTreeFile(currentPath);
        return;
      }
      q = q.toLowerCase();
      const all = getAllFiles(treeData);
      const filtered = all.filter(f => f.path.toLowerCase().includes(q));
      container.innerHTML = filtered.map(f =>
        `<div class="bb-file${f.path===currentPath?' active':''}" data-path="${esc(f.path)}"
              onclick="openDoc('${esc(f.path)}')" title="${esc(f.path)}">${esc(f.path)}</div>`
      ).join('') || '<div style="padding:12px;color:#555;font-size:12px">No matches</div>';
    }

    function getAllFiles(node, out = []) {
      for (const c of (node.children || [])) {
        if (c.type === 'file') out.push(c);
        else getAllFiles(c, out);
      }
      return out;
    }

    function highlightTreeFile(docPath) {
      document.querySelectorAll('.bb-file').forEach(el => {
        el.classList.toggle('active', el.dataset.path === docPath);
        if (el.dataset.path === docPath) {
          // expand ancestors
          let p = el.parentElement;
          while (p && p !== document.getElementById('treeBody')) {
            if (p.classList.contains('bb-children')) { p.classList.add('open'); }
            if (p.classList.contains('bb-dir'))      { p.classList.add('open'); }
            p = p.parentElement;
          }
        }
      });
    }

    // ── Open document ─────────────────────────────────────────────────────
    async function openDoc(docPath) {
      if (isDirty && currentPath) {
        if (!confirm('You have unsaved changes. Discard and open new document?')) return;
      }
      currentPath = docPath;
      isDirty = false;
      history.replaceState(null, '', '/brain?path=' + encodeURIComponent(docPath));

      document.getElementById('docToolbar').style.display = 'flex';
      document.getElementById('docPathDisplay').textContent = docPath;
      document.getElementById('unsavedDot').style.display = 'none';
      document.getElementById('saveBtn').style.display = '';
      document.getElementById('wysiBtn').style.display = '';
      document.getElementById('mdBtn').style.display = '';

      highlightTreeFile(docPath);

      const area = document.getElementById('docArea');
      area.innerHTML = '<div class="bb-empty"><span style="font-size:2em">⏳</span> Loading…</div>';

      const doc = await fetchJSON('/api/brain/doc?path=' + encodeURIComponent(docPath));
      currentContent = (doc && doc.content) ? doc.content : '';

      area.innerHTML = '';
      mountEditor(area, currentContent);
    }

    // ── Toast UI Editor ───────────────────────────────────────────────────
    function mountEditor(container, mdContent) {
      if (editorInst) {
        try { editorInst.destroy(); } catch(e) {}
        editorInst = null;
      }

      const host = document.createElement('div');
      host.className = 'bb-editor-host';
      container.appendChild(host);

      const isDark = !document.body.classList.contains('light-mode');

      editorInst = new toastui.Editor({
        el: host,
        initialValue: mdContent,
        initialEditType: 'wysiwyg',   // start in WYSIWYG mode (Obsidian-like)
        previewStyle: 'tab',           // tab between edit / preview
        height: '100%',
        usageStatistics: false,
        theme: isDark ? 'dark' : '',
        toolbarItems: [
          ['heading', 'bold', 'italic', 'strike'],
          ['hr'],
          ['ul', 'ol', 'task', 'indent', 'outdent'],
          ['table', 'link'],
          ['code', 'codeblock'],
          ['scrollSync'],
        ],
        events: {
          change: () => {
            isDirty = true;
            document.getElementById('unsavedDot').style.display = '';
            document.getElementById('saveBtn').textContent = '💾 Save*';
          }
        },
        hooks: {},
      });

      // Ctrl+S / Cmd+S to save
      host.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
          e.preventDefault();
          saveDoc();
        }
      });
    }

    // ── Editor mode toggle ────────────────────────────────────────────────
    function setMode(mode) {
      if (editorInst) editorInst.changeMode(mode === 'wysiwyg' ? 'wysiwyg' : 'markdown');
    }

    // ── Save ──────────────────────────────────────────────────────────────
    async function saveDoc() {
      if (!currentPath || !editorInst) return;
      const content = editorInst.getMarkdown();
      const saveBtn = document.getElementById('saveBtn');
      saveBtn.disabled = true;
      saveBtn.textContent = '⏳ Saving…';
      try {
        const r = await fetch('/api/brain/doc?path=' + encodeURIComponent(currentPath), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content })
        });
        if (r.status === 401) { location.href = '/brain/login'; return; }
        const data = await r.json();
        if (data.ok) {
          currentContent = content;
          isDirty = false;
          document.getElementById('unsavedDot').style.display = 'none';
          saveBtn.textContent = '💾 Save';
          showToast('Saved ✓');
        } else {
          showToast('❌ Save failed: ' + (data.error || 'unknown error'), 'error');
          saveBtn.textContent = '💾 Save*';
        }
      } catch (e) {
        showToast('❌ Save error: ' + e.message, 'error');
        saveBtn.textContent = '💾 Save*';
      } finally {
        saveBtn.disabled = false;
      }
    }

    // ── Delete ────────────────────────────────────────────────────────────
    async function deleteDoc() {
      if (!currentPath || !confirm(`Delete "${currentPath}"?\n\nThis cannot be undone.`)) return;
      const r = await fetch('/api/brain/doc?path=' + encodeURIComponent(currentPath), { method: 'DELETE' });
      if (r.ok) {
        currentPath = null; isDirty = false;
        destroyEditor();
        document.getElementById('docArea').innerHTML = '<div class="bb-empty"><span>🗑</span> Document deleted</div>';
        document.getElementById('docToolbar').style.display = 'none';
        const tree = await fetchJSON('/api/brain/tree');
        treeData = tree;
        renderTree(tree, document.getElementById('treeBody'));
        showToast('Deleted');
      }
    }

    function destroyEditor() {
      if (editorInst) { try { editorInst.destroy(); } catch(e) {} editorInst = null; }
    }

    // ── History ───────────────────────────────────────────────────────────
    function viewHistory() {
      if (currentPath) location.href = '/brain/history?path=' + encodeURIComponent(currentPath);
    }

    // ── New document ──────────────────────────────────────────────────────
    function toggleNew() {
      const bar = document.getElementById('newBar');
      bar.classList.toggle('open');
      if (bar.classList.contains('open')) document.getElementById('newPathInput').focus();
    }

    async function createNewDoc() {
      const p = document.getElementById('newPathInput').value.trim();
      if (!p) return;
      const docPath = p.endsWith('.md') ? p : p + '.md';
      const name = docPath.split('/').pop().replace(/\.md$/, '');
      const r = await fetch('/api/brain/doc?path=' + encodeURIComponent(docPath), {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content: `# ${name}\n\n` })
      });
      const data = await r.json().catch(() => ({}));
      if (data.ok) {
        toggleNew();
        document.getElementById('newPathInput').value = '';
        const tree = await fetchJSON('/api/brain/tree');
        treeData = tree;
        renderTree(tree, document.getElementById('treeBody'));
        openDoc(docPath);
      } else {
        showToast('❌ ' + (data.error || 'Create failed'), 'error');
      }
    }

    // ── Global search ─────────────────────────────────────────────────────
    let searchTimer;
    function toggleSearch() {
      const p = document.getElementById('searchPanel');
      p.classList.toggle('open');
      if (p.classList.contains('open')) { document.getElementById('searchInput').focus(); }
    }

    function doSearch(q) {
      clearTimeout(searchTimer);
      const res = document.getElementById('searchResults');
      if (!q.trim()) { res.innerHTML = ''; return; }
      searchTimer = setTimeout(async () => {
        const r = await fetchJSON('/api/brain/search?q=' + encodeURIComponent(q) + '&limit=20');
        const html = (r && r.results && r.results.length)
          ? r.results.map(item =>
              `<div class="bb-sr" onclick="openDoc('${esc(item.path)}');toggleSearch()">
                <div class="bb-sr-path">${esc(item.path)}</div>
                <div class="bb-sr-snip">${item.snippet || ''}</div>
              </div>`
            ).join('')
          : '<div style="padding:10px;color:#555;font-size:13px">No results</div>';
        res.innerHTML = html;
      }, 220);
    }

    // ── Auth ──────────────────────────────────────────────────────────────
    async function logout() {
      await fetch('/auth/logout', { method: 'POST' });
      location.href = '/brain/login';
    }

    // ── Utilities ─────────────────────────────────────────────────────────
    async function fetchJSON(url, opts) {
      try {
        const r = await fetch(url, opts);
        if (r.status === 401) { location.href = '/brain/login'; return {}; }
        return await r.json();
      } catch { return {}; }
    }

    function esc(s) {
      return String(s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function showToast(msg, type = 'ok') {
      const t = document.createElement('div');
      t.textContent = msg;
      const bg = type === 'error' ? '#dc2626' : '#6366f1';
      t.style.cssText = `position:fixed;bottom:24px;right:24px;background:${bg};color:#fff;
        padding:9px 18px;border-radius:8px;font-size:13px;z-index:999;
        box-shadow:0 4px 16px rgba(0,0,0,.4);transition:opacity .3s;`;
      document.body.appendChild(t);
      setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 2500);
    }

    // Close search panel on Escape
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        document.getElementById('searchPanel').classList.remove('open');
        document.getElementById('newBar').classList.remove('open');
      }
    });

    boot();
  </script>
  <%- include('partials/theme-sidebar') %>
</body>
</html>
