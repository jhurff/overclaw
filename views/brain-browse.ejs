<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css">
  <style>
    /* ── Two-pane layout ──────────────────────────────────────────────── */
    .bb-wrap  { display:flex; flex:1; overflow:hidden; min-height:0; }

    /* ── File tree ────────────────────────────────────────────────────── */
    .bb-tree       { width:270px; min-width:160px; max-width:380px; background:var(--surface-2,#1a1a2e);
                     border-right:1px solid var(--border,#2a2a4a); display:flex; flex-direction:column; overflow:hidden; }
    .bb-tree-head  { padding:10px 12px; border-bottom:1px solid var(--border,#2a2a4a);
                     display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .bb-tree-title { font-size:12px; font-weight:700; color:#b0b8d8; }
    .bb-tree-filter{ flex:1; background:var(--surface-3,#111122); border:1px solid var(--border,#2a2a4a);
                     border-radius:5px; color:#ccc; padding:4px 8px; font-size:12px; }
    .bb-tree-body  { flex:1; overflow-y:auto; padding:4px 0; }
    .bb-dir  { padding:4px 10px; cursor:pointer; font-size:12px; font-weight:600; color:#9098b8;
               display:flex; align-items:center; gap:5px; user-select:none; }
    .bb-dir:hover  { background:rgba(255,255,255,.04); }
    .bb-arr  { font-size:9px; width:10px; display:inline-block; transition:transform .15s; }
    .bb-dir.open .bb-arr { transform:rotate(90deg); }
    .bb-kids { display:none; }
    .bb-kids.open  { display:block; }
    .bb-file { padding:3px 10px 3px 24px; cursor:pointer; font-size:12px; color:#6a7490;
               white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .bb-file:hover  { background:rgba(255,255,255,.04); color:#b0b8d8; }
    .bb-file.active { background:rgba(99,102,241,.15); color:#9fa8f8; font-weight:600; }

    /* ── Right pane ───────────────────────────────────────────────────── */
    .bb-main    { flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0; }
    .bb-toolbar { padding:6px 12px; border-bottom:1px solid var(--border,#2a2a4a);
                  display:flex; align-items:center; gap:6px; flex-wrap:wrap; flex-shrink:0;
                  background:var(--surface-2,#1a1a2e); }
    .bb-path    { flex:1; font-size:11px; color:#555; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bb-dirty   { color:#f59e0b; font-size:11px; font-weight:700; display:none; }
    .bb-btn     { padding:4px 11px; border-radius:6px; font-size:12px; font-weight:600;
                  cursor:pointer; border:none; transition:opacity .15s; }
    .bb-primary { background:#6366f1; color:#fff; }
    .bb-secondary{ background:var(--surface-3,#111122); color:#aaa; border:1px solid var(--border,#2a2a4a); }
    .bb-btn:hover    { opacity:.85; }
    .bb-btn:disabled { opacity:.4; cursor:default; }
    .bb-doc     { flex:1; overflow:hidden; display:flex; flex-direction:column; }
    .bb-empty   { flex:1; display:flex; align-items:center; justify-content:center;
                  flex-direction:column; gap:8px; color:#555; font-size:14px; }

    /* ── Toast UI overrides (dark theme) ──────────────────────────────── */
    .toastui-editor-defaultUI          { height:100% !important; display:flex !important; flex-direction:column !important; }
    .toastui-editor-main               { flex:1 !important; overflow:hidden !important; }
    .toastui-editor-ww-container,
    .toastui-editor-md-container       { height:100% !important; }
    .toastui-editor-toolbar            { background:var(--surface-2,#1a1a2e) !important;
                                         border-bottom:1px solid var(--border,#2a2a4a) !important; }
    .toastui-editor-toolbar button     { color:#9098b8 !important; }
    .toastui-editor-toolbar button:hover{ background:rgba(99,102,241,.15) !important; }
    .toastui-editor-ww-container .ProseMirror {
      background:#0c0c1a !important; color:#c8d4e8 !important;
      font-size:15px !important; line-height:1.8 !important; padding:28px 40px !important;
    }
    .toastui-editor-md-container .CodeMirror { background:#0c0c1a !important; color:#c8d4e8 !important; height:100% !important; }
    .toastui-editor-contents h1 { font-size:2em; font-weight:800; color:#e8ecf8;
      border-bottom:1px solid var(--border,#2a2a4a); padding-bottom:.3em; }
    .toastui-editor-contents h2 { font-size:1.5em; font-weight:700; color:#dde3f5;
      border-bottom:1px solid var(--border,#2a2a4a); }
    .toastui-editor-contents h3 { font-size:1.2em; font-weight:700; color:#d0d8f0; }
    .toastui-editor-contents a  { color:#818cf8; }
    .toastui-editor-contents code { background:rgba(255,255,255,.07); color:#a5b4fc;
      padding:2px 6px; border-radius:4px; font-size:.87em; }
    .toastui-editor-contents pre  { background:#0d0d1a; border:1px solid var(--border,#2a2a4a); border-radius:8px; }
    .toastui-editor-contents blockquote { border-left:3px solid #6366f1;
      background:rgba(99,102,241,.07); color:#a0a8c0; }
    .toastui-editor-contents table th { background:rgba(99,102,241,.12); color:#a0aaff; }
    .toastui-editor-contents table th,
    .toastui-editor-contents table td  { border-color:var(--border,#2a2a4a); }

    /* ── New-doc bar ──────────────────────────────────────────────────── */
    .bb-new-bar { display:none; padding:7px 12px; background:var(--surface-3,#111122);
                  border-bottom:1px solid var(--border,#2a2a4a); align-items:center; gap:8px; }
    .bb-new-bar.open { display:flex; }
    .bb-new-input { flex:1; background:var(--surface-2,#1a1a2e); border:1px solid var(--border,#2a2a4a);
                    border-radius:6px; color:#ccc; padding:5px 10px; font-size:13px; }

    /* ── Search panel ─────────────────────────────────────────────────── */
    .bb-search { position:fixed; top:60px; right:20px; width:400px;
                 background:var(--surface-2,#1a1a2e); border:1px solid var(--border,#2a2a4a);
                 border-radius:10px; padding:14px; z-index:300;
                 box-shadow:0 8px 32px rgba(0,0,0,.6); display:none; }
    .bb-search.open { display:block; }
    .bb-search-input { width:100%; background:var(--surface-3,#111122); border:1px solid var(--border,#2a2a4a);
                       border-radius:6px; color:#ccc; padding:7px 11px; font-size:13px; box-sizing:border-box; }
    .bb-sr     { padding:7px 10px; border-bottom:1px solid var(--border,#2a2a4a); cursor:pointer; }
    .bb-sr:hover { background:rgba(255,255,255,.04); }
    .bb-sr-path { font-size:11px; color:#6366f1; }
    .bb-sr-snip { font-size:12px; color:#999; margin-top:2px; }

    /* ── Stats bar ────────────────────────────────────────────────────── */
    .bb-stats { font-size:11px; color:#555; padding:3px 14px 4px; flex-shrink:0;
                border-bottom:1px solid var(--border,#2a2a4a); }

    /* ── Toast notification ───────────────────────────────────────────── */
    .bb-toast { position:fixed; bottom:24px; right:24px; padding:9px 18px; border-radius:8px;
                font-size:13px; z-index:999; box-shadow:0 4px 16px rgba(0,0,0,.4);
                transition:opacity .3s; color:#fff; pointer-events:none; }

    /* ── Light mode ───────────────────────────────────────────────────── */
    body.light-mode .toastui-editor-ww-container .ProseMirror { background:#fff !important; color:#1f2937 !important; }
    body.light-mode .toastui-editor-md-container .CodeMirror  { background:#fff !important; color:#1f2937 !important; }
    body.light-mode .toastui-editor-toolbar { background:#f8fafc !important; }
    body.light-mode .bb-tree  { background:#f0f4ff; }
    body.light-mode .bb-toolbar { background:#f0f4ff; }
  </style>
</head>
<body class="oc-body">
  <header class="oc-header">
    <div class="logo">
      <a href="/swarm" style="text-decoration:none;color:inherit;display:contents;cursor:pointer">
        <h1 class="main-title">OVERCLAW</h1>
        <span class="tagline">AI BRAIN</span>
      </a>
    </div>
    <div class="header-controls" style="display:flex;align-items:center;gap:6px">
      <button class="bb-btn bb-secondary" onclick="toggleSearch()" style="font-size:11px;padding:4px 9px">&#128269; Search</button>
      <button class="bb-btn bb-secondary" onclick="toggleNew()"    style="font-size:11px;padding:4px 9px">&#65291; New</button>
      <% if (typeof actor !== 'undefined' && actor.type === 'user') { %>
        <span style="color:#555;font-size:11px"><%= actor.name %></span>
        <button class="bb-btn bb-secondary" onclick="logout()" style="font-size:11px;padding:4px 9px">Sign out</button>
      <% } %>
      <button id="sidebar-toggle" class="control-button">&#9776;</button>
      <button id="theme-toggle"   class="control-button">&#9728;&#65039;</button>
    </div>
  </header>

  <div class="oc-main-content">
    <%- include('partials/sidebar', { currentPath: '/brain' }) %>
    <main class="oc-dashboard-area" style="padding:0!important;overflow:hidden!important;display:flex!important;flex-direction:column!important">

      <!-- Search panel -->
      <div class="bb-search" id="searchPanel">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:13px;font-weight:600;color:#c0c8e0;flex:1">Search docs</span>
          <button class="bb-btn bb-secondary" onclick="toggleSearch()" style="font-size:11px;padding:2px 8px">&#10005;</button>
        </div>
        <input class="bb-search-input" id="searchInput" placeholder="Type to search all docs&#8230;" oninput="doSearch(this.value)">
        <div id="searchResults" style="margin-top:8px;max-height:320px;overflow-y:auto"></div>
      </div>

      <!-- New doc bar -->
      <div class="bb-new-bar" id="newBar">
        <span style="font-size:12px;color:#aaa;white-space:nowrap">&#128196; Path:</span>
        <input class="bb-new-input" id="newPathInput" placeholder="e.g. 03 - Agents/notes/my-note.md"
               onkeydown="if(event.key==='Enter')createNewDoc()">
        <button class="bb-btn bb-primary" onclick="createNewDoc()">Create</button>
        <button class="bb-btn bb-secondary" onclick="toggleNew()">Cancel</button>
      </div>

      <!-- Stats -->
      <div class="bb-stats" id="statsBar">Loading&#8230;</div>

      <!-- Two-pane -->
      <div class="bb-wrap">

        <!-- File tree -->
        <div class="bb-tree">
          <div class="bb-tree-head">
            <span class="bb-tree-title">&#128193; Brain</span>
            <input class="bb-tree-filter" id="treeFilter" placeholder="Filter&#8230;" oninput="filterTree(this.value)">
          </div>
          <div class="bb-tree-body" id="treeBody">
            <div style="padding:20px;text-align:center;color:#555;font-size:13px">Loading&#8230;</div>
          </div>
        </div>

        <!-- Doc pane -->
        <div class="bb-main">
          <!-- Toolbar (hidden until doc open) -->
          <div class="bb-toolbar" id="docToolbar" style="display:none">
            <span class="bb-path" id="docPath"></span>
            <span class="bb-dirty" id="dirtyDot">&#9679; unsaved</span>
            <button class="bb-btn bb-secondary" id="modeBtn"  onclick="toggleMode()">&#9000;&#65039; Markdown</button>
            <button class="bb-btn bb-primary"   id="saveBtn"  onclick="saveDoc()">&#128190; Save</button>
            <button class="bb-btn bb-secondary"               onclick="viewHistory()">&#9201; History</button>
            <button class="bb-btn bb-secondary"               onclick="deleteDoc()">&#128465; Delete</button>
          </div>

          <!-- Doc area -->
          <div class="bb-doc" id="docArea">
            <div class="bb-empty">
              <span style="font-size:2.5em">&#129504;</span>
              Select a document from the tree, or use <strong>&#65291; New</strong>
            </div>
          </div>
        </div>
      </div>

    </main>
  </div>

  <!-- Toast UI Editor -->
  <script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

  <script>
    /* ── Sidebar / theme ─────────────────────────────────────────────── */
    (function(){
      const sb  = document.getElementById('oc-sidebar');
      const btn = document.getElementById('sidebar-toggle');
      let col = localStorage.getItem('overclaw-sidebar-collapsed') === 'true';
      if (col) sb.classList.add('collapsed');
      btn.addEventListener('click', () => { col=!col; sb.classList.toggle('collapsed',col); localStorage.setItem('overclaw-sidebar-collapsed',col); });
      const th = document.getElementById('theme-toggle');
      let tm = localStorage.getItem('overclaw-theme') || (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
      document.body.classList.add(tm+'-mode'); th.textContent = tm==='dark' ? '\uD83C\uDF19' : '\u2600\uFE0F';
      th.addEventListener('click', () => {
        tm = tm==='light' ? 'dark' : 'light';
        document.body.classList.toggle('light-mode', tm==='light');
        document.body.classList.toggle('dark-mode',  tm==='dark');
        localStorage.setItem('overclaw-theme', tm);
        th.textContent = tm==='dark' ? '\uD83C\uDF19' : '\u2600\uFE0F';
      });
    })();

    /* ── State ───────────────────────────────────────────────────────── */
    let currentPath    = null;
    let treeData       = null;
    let editorInst     = null;
    let isDirty        = false;
    let editorMode     = 'wysiwyg';   // 'wysiwyg' | 'markdown'

    /* ── Boot ────────────────────────────────────────────────────────── */
    async function boot() {
      loadStats();
      const tree = await api('/api/brain/tree');
      treeData = tree;
      renderTree(tree, document.getElementById('treeBody'));
      const p = new URLSearchParams(location.search).get('path');
      if (p) openDoc(p);
    }

    async function loadStats() {
      const s = await api('/api/brain/stats');
      const el = document.getElementById('statsBar');
      if (s && s.documents != null)
        el.textContent = s.documents.toLocaleString() + ' documents \u00b7 ' +
                         s.versions.toLocaleString() + ' versions \u00b7 ' +
                         (s.db_file_bytes/1024/1024).toFixed(1) + ' MB';
      else el.textContent = '';
    }

    /* ── API wrapper — always sends credentials (session cookie) ─────── */
    async function api(url, opts = {}) {
      opts.credentials = 'include';   // ← THE FIX: send session cookie on every request
      try {
        const r = await fetch(url, opts);
        if (r.status === 401) { location.href = '/brain/login?next=' + encodeURIComponent(location.pathname + location.search); return {}; }
        return await r.json();
      } catch(e) { return { error: e.message }; }
    }

    /* ── File tree ───────────────────────────────────────────────────── */
    function renderTree(node, container) {
      container.innerHTML = '';
      for (const c of (node.children || [])) {
        if (c.type === 'dir') {
          const wrap = document.createElement('div');
          const head = document.createElement('div');
          head.className = 'bb-dir';
          head.innerHTML = '<span class="bb-arr">\u25B6</span> \uD83D\uDCC1 ' + esc(c.name);
          head.onclick = () => { head.classList.toggle('open'); kids.classList.toggle('open'); };
          const kids = document.createElement('div');
          kids.className = 'bb-kids';
          renderTree(c, kids);
          wrap.appendChild(head); wrap.appendChild(kids);
          container.appendChild(wrap);
        } else {
          const el = document.createElement('div');
          el.className = 'bb-file';
          el.dataset.path = c.path;
          el.textContent  = c.name.replace(/\.md$/, '');
          el.title = c.path;
          el.onclick = () => openDoc(c.path);
          container.appendChild(el);
        }
      }
    }

    function filterTree(q) {
      const body = document.getElementById('treeBody');
      if (!q.trim()) { body.innerHTML=''; renderTree(treeData, body); highlightActive(); return; }
      q = q.toLowerCase();
      const hits = getAllFiles(treeData).filter(f => f.path.toLowerCase().includes(q));
      body.innerHTML = hits.map(f =>
        `<div class="bb-file${f.path===currentPath?' active':''}" data-path="${esc(f.path)}"
              onclick="openDoc('${esc(f.path)}')" title="${esc(f.path)}">${esc(f.path)}</div>`
      ).join('') || '<div style="padding:12px;color:#555;font-size:12px">No matches</div>';
    }

    function getAllFiles(node, out=[]) {
      for (const c of (node.children||[])) { if(c.type==='file') out.push(c); else getAllFiles(c,out); }
      return out;
    }

    function highlightActive() {
      document.querySelectorAll('.bb-file').forEach(el => {
        const active = el.dataset.path === currentPath;
        el.classList.toggle('active', active);
        if (active) {
          let p = el.parentElement;
          while (p && p !== document.getElementById('treeBody')) {
            if (p.classList.contains('bb-kids')) p.classList.add('open');
            if (p.classList.contains('bb-dir'))  p.classList.add('open');
            p = p.parentElement;
          }
        }
      });
    }

    /* ── Open doc ────────────────────────────────────────────────────── */
    async function openDoc(docPath) {
      if (isDirty && currentPath && !confirm('Unsaved changes — discard and open new doc?')) return;
      currentPath = docPath;
      isDirty     = false;
      history.replaceState(null, '', '/brain?path=' + encodeURIComponent(docPath));
      highlightActive();

      document.getElementById('docToolbar').style.display = 'flex';
      document.getElementById('docPath').textContent = docPath;
      document.getElementById('dirtyDot').style.display = 'none';
      document.getElementById('saveBtn').textContent = '\uD83D\uDCBE Save';

      const area = document.getElementById('docArea');
      area.innerHTML = '<div class="bb-empty"><span style="font-size:2em">\u23F3</span> Loading\u2026</div>';

      const doc = await api('/api/brain/doc?path=' + encodeURIComponent(docPath));
      const content = (doc && doc.content) ? doc.content : '';
      area.innerHTML = '';
      mountEditor(area, content);
    }

    /* ── Editor ──────────────────────────────────────────────────────── */
    function mountEditor(container, content) {
      if (editorInst) { try { editorInst.destroy(); } catch(e){} editorInst = null; }

      const host = document.createElement('div');
      host.style.cssText = 'flex:1;display:flex;flex-direction:column;overflow:hidden;height:100%';
      container.style.cssText = 'flex:1;display:flex;flex-direction:column;overflow:hidden';
      container.appendChild(host);

      editorInst = new toastui.Editor({
        el:               host,
        initialValue:     content,
        initialEditType:  editorMode,
        previewStyle:     'tab',
        height:           '100%',
        usageStatistics:  false,
        toolbarItems: [
          ['heading','bold','italic','strike'],
          ['hr'],
          ['ul','ol','task','indent','outdent'],
          ['table','link'],
          ['code','codeblock'],
          ['scrollSync'],
        ],
        events: {
          change: () => {
            isDirty = true;
            document.getElementById('dirtyDot').style.display = '';
            document.getElementById('saveBtn').textContent = '\uD83D\uDCBE Save*';
          }
        },
      });

      // Ctrl/Cmd+S
      host.addEventListener('keydown', e => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveDoc(); }
      }, true);

      updateModeBtn();
    }

    /* ── Mode toggle ─────────────────────────────────────────────────── */
    function toggleMode() {
      editorMode = editorMode === 'wysiwyg' ? 'markdown' : 'wysiwyg';
      if (editorInst) editorInst.changeMode(editorMode);
      updateModeBtn();
    }
    function updateModeBtn() {
      const btn = document.getElementById('modeBtn');
      if (!btn) return;
      btn.textContent = editorMode === 'wysiwyg' ? '\u2328\uFE0F Markdown' : '\u270F\uFE0F WYSIWYG';
    }

    /* ── Save ────────────────────────────────────────────────────────── */
    async function saveDoc() {
      if (!currentPath || !editorInst) return;
      const content = editorInst.getMarkdown();
      const btn = document.getElementById('saveBtn');
      btn.disabled = true; btn.textContent = '\u23F3 Saving\u2026';
      const result = await api(
        '/api/brain/doc?path=' + encodeURIComponent(currentPath),
        {
          method:  'PUT',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ content }),
        }
      );
      btn.disabled = false;
      if (result.ok) {
        isDirty = false;
        document.getElementById('dirtyDot').style.display = 'none';
        btn.textContent = '\uD83D\uDCBE Save';
        showToast('Saved \u2713', '#6366f1');
      } else {
        btn.textContent = '\uD83D\uDCBE Save*';
        showToast('\u274C ' + (result.error || 'Save failed'), '#dc2626');
      }
    }

    /* ── Delete ──────────────────────────────────────────────────────── */
    async function deleteDoc() {
      if (!currentPath || !confirm('Delete "' + currentPath + '"?\n\nThis cannot be undone.')) return;
      const r = await api(
        '/api/brain/doc?path=' + encodeURIComponent(currentPath),
        { method: 'DELETE' }
      );
      if (r && r.ok !== false) {
        currentPath = null; isDirty = false;
        if (editorInst) { try { editorInst.destroy(); } catch(e){} editorInst = null; }
        document.getElementById('docArea').innerHTML = '<div class="bb-empty"><span>\uD83D\uDDD1</span> Deleted</div>';
        document.getElementById('docToolbar').style.display = 'none';
        const tree = await api('/api/brain/tree');
        treeData = tree;
        renderTree(tree, document.getElementById('treeBody'));
        showToast('Deleted', '#374151');
      }
    }

    /* ── History ─────────────────────────────────────────────────────── */
    function viewHistory() {
      if (currentPath) location.href = '/brain/history?path=' + encodeURIComponent(currentPath);
    }

    /* ── New doc ─────────────────────────────────────────────────────── */
    function toggleNew() {
      const bar = document.getElementById('newBar');
      bar.classList.toggle('open');
      if (bar.classList.contains('open')) document.getElementById('newPathInput').focus();
    }
    async function createNewDoc() {
      let p = document.getElementById('newPathInput').value.trim();
      if (!p) return;
      if (!p.endsWith('.md')) p += '.md';
      const name = p.split('/').pop().replace(/\.md$/, '');
      const result = await api(
        '/api/brain/doc?path=' + encodeURIComponent(p),
        { method:'PUT', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ content: '# ' + name + '\n\n' }) }
      );
      if (result.ok) {
        toggleNew();
        document.getElementById('newPathInput').value = '';
        const tree = await api('/api/brain/tree');
        treeData = tree;
        renderTree(tree, document.getElementById('treeBody'));
        openDoc(p);
      } else {
        showToast('\u274C ' + (result.error || 'Create failed'), '#dc2626');
      }
    }

    /* ── Search ──────────────────────────────────────────────────────── */
    let _searchTimer;
    function toggleSearch() {
      const p = document.getElementById('searchPanel');
      p.classList.toggle('open');
      if (p.classList.contains('open')) document.getElementById('searchInput').focus();
    }
    function doSearch(q) {
      clearTimeout(_searchTimer);
      const el = document.getElementById('searchResults');
      if (!q.trim()) { el.innerHTML=''; return; }
      _searchTimer = setTimeout(async () => {
        const r = await api('/api/brain/search?q=' + encodeURIComponent(q) + '&limit=20');
        el.innerHTML = (r.results && r.results.length)
          ? r.results.map(item =>
              `<div class="bb-sr" onclick="openDoc('${esc(item.path)}');toggleSearch()">
                <div class="bb-sr-path">${esc(item.path)}</div>
                <div class="bb-sr-snip">${item.snippet||''}</div>
              </div>`).join('')
          : '<div style="padding:10px;color:#555;font-size:13px">No results</div>';
      }, 220);
    }

    /* ── Auth ────────────────────────────────────────────────────────── */
    async function logout() {
      await fetch('/auth/logout', { method:'POST', credentials:'include' });
      location.href = '/brain/login';
    }

    /* ── Utilities ───────────────────────────────────────────────────── */
    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                      .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function showToast(msg, bg) {
      const t = document.createElement('div');
      t.className = 'bb-toast';
      t.textContent = msg;
      t.style.background = bg || '#6366f1';
      document.body.appendChild(t);
      setTimeout(() => { t.style.opacity='0'; setTimeout(()=>t.remove(), 320); }, 2200);
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        document.getElementById('searchPanel').classList.remove('open');
        document.getElementById('newBar').classList.remove('open');
      }
    });

    boot();
  </script>
  <%- include('partials/theme-sidebar') %>
</body>
</html>
