# OverClaw Configuration

# Port to listen on (default: 8355)
PORT=8355

# Vault path — the Obsidian vault used as the shared coordination layer for your agent swarm.
# All agents should have read/write access to this vault.
VAULT_PATH=/home/user/my-vault

# OpenClaw Gateway (optional — for live Spike/OpenClaw data only)
# If not set, the app runs in vault-only mode with graceful degradation.
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_API_TOKEN=your-token-here
